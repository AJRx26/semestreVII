@INPROCEEDINGS{10835636,
  author={Chernyshev, Maxim and Baig, Zubair and Doss, Robin},
  booktitle={2024 IEEE 6th International Conference on Trust, Privacy and Security in Intelligent Systems, and Applications (TPS-ISA)}, 
  title={[Short Paper] Forensic Analysis of Indirect Prompt Injection Attacks on LLM Agents}, 
  year={2024},
  volume={},
  number={},
  pages={409-411},
  abstract={Large language model (LLM) agents are vulnerable to a range of evolving attacks including Indirect Prompt Injection (IPI). Digital investigations involving IPI attacks on LLM agents are challenging due to growing data volumes and agent flow complexity. We introduce a novel approach for forensic analysis of LLM agent execution logs to identify IPI attacks. We implement a custom digital forensic analysis framework featuring a realistic agentic task benchmark to generate agent logs, for subsequent analysis using 12 state-of-the-art LLMs. Our preliminary results show promising potential for malicious trail detection, with varying performance across domain-specific test suites. We discuss key findings, limitations, and future work directions to support the empirical evaluation of LLMs for digital forensic applications.},
  keywords={Privacy;Large language models;Digital forensics;Benchmark testing;Complexity theory;Security;Intelligent systems;LLM;agent;indirect prompt injection;digital forensics},
  doi={10.1109/TPS-ISA62245.2024.00053},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11461745,
  author={Zhang, Ziyang and Lin, Yuechen and An, Xuanxuan and Wan, Mingyang and Jiang, Caigui and Ding, Ning},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={ATTN-Defense: Attention-Guided Detection, Location and Removal for Indirect Prompt Injection}, 
  year={2026},
  volume={},
  number={},
  pages={17532-17536},
  abstract={Large language models (LLMs) have been severely affected by prompt injection attacks due to their strong instruction-following capabilities. Among these, indirect prompt injection (IPI) attacks pose broader security threats, as their injection occurs outside the model’s system boundary. Recent research efforts to defend against such attacks primarily focus on detection and prevention strategies. However, existing detection methods often degrade user experience by directly rejecting inputs after attack identification, while prevention approaches face inherent security and utility trade-off. To address this issue, this paper proposes Attn-Defense, an IPI removal method based on the LLM attention weight. Our approach extracts attention sequence features generated during input processing to achieve both detection and location of IPI attacks, followed by precise sentence-level removal operations. This enables accurate defense implementation without compromising the model’s ability to fulfill legitimate user instructions. Our method demonstrates consistent superiority across various models, jailbreak attacks, and datasets, achieving a 10.1% lower Attack Success Rate and 14.8% higher F1 Difference compared to existing approaches on two extended and augmented datasets. Furthermore, we validate the robustness of our framework and the effectiveness of its individual components through comprehensive experiments.},
  keywords={Feeds;Antennas;Wide area networks;Protocols;Communication systems;Computer networks;HTTP;Location awareness;Mobile communication;Pins;Large Language Models;Indirect Prompt Injection;Attention Mechanism},
  doi={10.1109/ICASSP55912.2026.11461745},
  ISSN={2379-190X},
  month={May},}@ARTICLE{11655601,
  author={Jang, Hyeonji and Lee, Eunseong and Kim, Kyungbaek and Kim, Misoo},
  journal={IEEE Access}, 
  title={Execution-Aware Stage-Wise Evaluation Framework for Indirect Prompt Injection in LLM-Based Email Agents}, 
  year={2026},
  volume={14},
  number={},
  pages={127029-127048},
  abstract={Indirect prompt injection (IPI) attacks have emerged as a critical security threat to large language model (LLM)-based email agents. However, existing evaluation benchmarks largely rely on simulated environments that cannot verify whether an attack will actually succeed in practice, often determining attack success solely based on tool invocation, which leads to frequent misclassifications of attack outcomes. In this paper, we propose execution-aware stage-wise evaluation (EASE) as an automated framework that quantitatively assesses the vulnerability of email agents to IPI attacks in a realistic environment integrated with the Gmail application programming interface (API) and multiple LLM APIs. EASE automates the entire pipeline of delivering attack emails, triggering the LLM agent, and collecting tool invocation logs, and judges attack success by whether the delivered email actually fulfills the attacker’s intent, using tool invocation only as a proxy baseline. Additionally, EASE’s modular architecture allows new LLMs, defense prompts, and attack datasets to be plugged in or replaced independently, and a Streamlit-based web interface makes the framework accessible to non-developers. To validate EASE’s effectiveness, we conducted 15,336 experiments using 639 attack samples across six LLMs under four defense conditions. The results demonstrate that executing attacks in the live service reveals what proxy-based judgment misses: 13.9% of proxy-judged successes are actually failures when the execution outcome is verified. We also observe that the same defense prompt can paradoxically increase the attack success rate for certain LLMs, underscoring the need for execution-grounded evaluation tools such as EASE. EASE is released as an open-source package on GitHub so that email agent developers and security researchers can adopt it immediately.},
  keywords={Electronic mail;Modeling;Large language models;Tools;Application programming interfaces;Ranking (statistics);Generative Pre-trained transformer;Security;Automatic speech recognition;Artificial intelligence;AI agent security;email security;evaluation framework;indirect prompt injection;LLM-based agents},
  doi={10.1109/ACCESS.2026.3723800},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{10987374,
  author={Omri, Sihem and Abdelkader, Manel and Hamdi, Mohamed},
  booktitle={2024 IEEE Eleventh International Conference on Communications and Networking (ComNet)}, 
  title={MalPID: Malicious Prompt Injection Detection Dataset for Large Language Model based Applications}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={Despite the significant transformation made by large language model (LLM)-based chatbots in the field of conversational artificial intelligence (AI), these systems are vulnerable to the attack known as prompt injection by malicious users to make them ignore their guardrails and generate objectionable content. However, few previous works have been addressing this issue using complex and costly mechanisms and there is a lack of large dataset that deal with prompt injection examples. In this work, we introduce MalPID, a novel dataset for malicious prompt injection detection. This benchmark contains various malicious and legitimate prompts collected from different sources and labelled manually. Our systematic evaluation of models trained on our dataset has shown impressive results in detecting prompt injection data. In the future, MalPID could be a valuable resource for advancing the creation of safe conversational AI systems.},
  keywords={Ethics;Systematics;Large language models;Prevention and mitigation;Machine learning;Benchmark testing;Chatbots;Data models;chatbot;prompt injection;classification;LLM;conversational AI;dataset;AI application},
  doi={10.1109/ComNet64071.2024.10987374},
  ISSN={2473-7585},
  month={Nov},}@INPROCEEDINGS{11395889,
  author={Ruparel, Ritesh and Jatavallabha, Aravinda and Maringanti, Srinivasa},
  booktitle={2026 IEEE 5th International Conference on AI in Cybersecurity (ICAIC)}, 
  title={Prompting for LLM Security and RAG: A Survey from Zero-Shot to Automatic Prompt Optimization (APO) and Prompt-Injection Defenses}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Large Language Models (LLMs) are increasingly embedded in security-sensitive workflows such as incident triage, code review, threat hunting, and retrieval-augmented assistants. In these settings, prompting is not only a performance tool but also a security control surface: LLMs may consume untrusted content (tickets, logs, web pages, retrieved documents) that can adversarially manipulate outputs via prompt injection. This paper presents a structured, practitioner-oriented survey that unifies (i) core prompting methods (zero-shot, few-shot), (ii) reasoning-structured prompting (chains/trees/graphs of thought), (iii) robustness methods (self-consistency), (iv) efficiency workflows (skeleton-of-thought), and (v) automatic prompt optimization (APO) and learned prompting (directional stimulus prompting). We additionally synthesize cybersecurity-specific research on prompt injection, indirect prompt injection benchmarks, retrieval-augmented generation (RAG) poisoning, coordinated Prompt–RAG attacks, and interface-level defenses (structured queries). We provide a taxonomy, summary tables, and a decision guide for selecting prompting strategies under accuracy– cost–security constraints.},
  keywords={Surveys;Reviews;Prevention and mitigation;Large language models;Taxonomy;Retrieval augmented generation;Web pages;Robustness;Prompt engineering;Optimization;Prompt engineering;prompt injection;retrieval-augmented generation (RAG);LLM security;automatic prompt optimization;survey},
  doi={10.1109/ICAIC67076.2026.11395889},
  ISSN={},
  month={Feb},}@ARTICLE{11664419,
  author={Chen, Jingyi and Lu, Rongqing},
  journal={IEEE Access}, 
  title={TrustTrace: Provenance-Aware Tracing of Indirect Prompt Injection Propagation in LLM-Assisted Learning Workflows}, 
  year={2026},
  volume={14},
  number={},
  pages={141501-141531},
  abstract={Indirect prompt injection can persist through retrieval, generation, and revision after the visible payload disappears. Existing defenses primarily detect suspicious inputs or constrain immediate actions, but they provide less evidence about which source influenced which final-artifact span through a temporally valid route. This paper presents TrustTrace, a provenance-aware framework for source-to-artifact tracing in LLM-assisted learning workflows. TrustTrace constructs a heterogeneous temporal graph over sources, retrieved contexts, prompts, responses, revision operations, and artifact spans. A dual-flow encoder separates legitimate evidence transmission from unauthorized control transmission, while differentiable reachability supports source attribution, contaminated-span localization, activation-stage estimation, and complete-path recovery. A bounded counterfactual verifier performs fact-preserving neutralization, suffix replay, calibrated set-valued attribution, and abstention. The primary pipeline uses procedurally separated GPT-5.5 profiles; construct validity is therefore tested with independent human ratings, a Qwen3-235B-A22B-Instruct generation set, and an independent Qwen3 neutralization-and-judging stack. On the independently audited EduTrace-IPI subset, TrustTrace improves strict Complete-Path F1@3 from 0.631 to 0.684 over the architecture-matched terminal-supervision baseline and from 0.659 to 0.716 after disagreement-flagged workflows are excluded. Human ratings of 800 stratified artifact spans correlate with the continuous contamination score at Spearman  $\rho =0.78$ , and an independent Qwen3 verifier preserves most of the primary result (Span-F1 0.731 and Complete-Path F1@3 0.671). On Qwen3-generated workflows, TrustTrace obtains Span-F1 0.681 and Complete-Path F1@3 0.598 without retraining. Binary detection gains remain comparatively small, and specialized guards remain stronger on selected native input- or action-level metrics. The evidence supports TrustTrace as a complementary forensic layer for calibrated span and path tracing rather than a replacement for preventive defenses.},
  keywords={Modeling;Labeling;Testing;Large language models;Generative Pre-trained transformer;Fluid flow;Licenses;Tools;Propagation;Security;Indirect prompt injection;provenance graph;large language model security;attack propagation tracing;counterfactual verification},
  doi={10.1109/ACCESS.2026.3726909},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11744796,
  author={Nasar, Abu and Krishnan, Niket and Rajeev, Devi and Kolil, Vysakh Kani},
  booktitle={2026 5th International Conference on Innovative Mechanisms for Industry Applications (ICIMIA)}, 
  title={Beyond Text: A Render-Aware, Semantically-Fused Defence Against Indirect Prompt Injection in Enterprise RAG Pipelines}, 
  year={2026},
  volume={},
  number={},
  pages={1046-1051},
  abstract={Formatting-based prompt-injection attacks hide malicious instructions inside PDFs, creating machine-extractable yet human-invisible threats that evade existing text-only defences. A render-aware hidden-text detector is introduced as the core contribution-the first component to identify adversarial prompt-injection instructions concealed through PDF formatting obfuscation across six technique families (zero-point fonts, white-on-white text, low-contrast rendering, and off-page placement), attack vectors fully machine-extractable yet invisible to human reviewers and unreachable by all existing text-based defences. This detector forms Layer 2 of a four-layer hybrid framework that additionally integrates VirusTotal file reputation (Layer 1), fine-tuned DistilBERT semantic classification (Layer 3), and an XGBoost fusion classifier producing a unified risk score in [0.0, 1.0]. An expanded hybrid benchmark of 11,050 samples is constructed spanning HackAPrompt text injections (10,000), synthetically obfuscated PDFs across six technique variants (1,000), and VirusTotal-verified malware ($\approx \mathbf{5 0}$). The system achieves macro $F_{1}=0.8770$ and ROC-AUC $=0.9390$ (10-fold CV: $F_{1}=$ 0.8845±0.0105; bootstrap 95 % CI: [0.8627, 0.8918]). Adversarial robustness evaluation identifies a detection threshold between hidden-content scores of 0.10 and 0.20: single-technique obfuscation evades the framework, while two or more simultaneous render techniques are reliably detected. Multilingual evaluation across 514 verified non-English samples spanning 29 languages yields $F_{1}=0.9143$ (ROC-AUC $=0.9672$). SHAP analysis confirms modality-specific complementarity: semantic_score dominates globally (mean $|\mathrm{SHAP}|=2.80$) while hidden_score delivers decisive signals exclusively for formatting-obfuscated samples. End-to-end latency is 837 ms, within the 2,000 ms target.},
  keywords={Rendering (computer graphics);Modeling;Printing;Signal detection;Large language models;Malware;Multilingual;Portable document format;Security;Conferences;Indirect Prompt Injection;LLM Security;Render-Aware Detection;DistilBERT;XGBoost;Document Security;Fusion Classification;SHAP;RAG Security;Adversarial Machine Learning},
  doi={10.1109/ICIMIA69818.2026.11744796},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11581043,
  author={Starukh, Kirill and Koshelev, Anton},
  booktitle={2026 IEEE Ural-Siberian Conference on Biomedical Engineering, Radioelectronics and Information Technology (USBEREIT)}, 
  title={Evaluating a Multilayered Defense Against Prompt Injection in LLM-Augmented Educational Systems}, 
  year={2026},
  volume={},
  number={},
  pages={1-4},
  abstract={Prompt injection attacks represent a persistent threat to production systems built on large language models (LLMs), particularly in educational environments where system integrity and student data protection are critical. This work investigates the effectiveness of a multilayered defensive architecture against prompt injection in an LLM-augmented educational bot deployed in a university setting. The proposed approach combines pattern-based input validation, prompt engineering via a sandwich technique, and LLM-based semantic post-filtering as sequential defense layers. We consider both direct user-crafted attacks and instruction-like content that can be embedded in external text, reflecting the broadened attack surface of modern LLM applications. The architecture is evaluated under two complementary regimes: synthetic prompts covering representative attack patterns and benign queries, and real-world interactions collected during a controlled in-vivo red-team exercise with student participants. The analysis reports overall blocking behavior together with per-layer contributions and identifies typical bypass mechanisms and operational failure modes observed in deployment. The findings suggest that a coordinated defense-in-depth strategy can distribute the protective burden across stages, improving robustness to paraphrase, obfuscation, and previously unseen variants. The paper contributes deploymentoriented evidence supporting architectural diversity as a practical principle for securing educational LLM systems.},
  keywords={Modeling;Large language models;Filtering;Filters;Printing;Safety;Measurement;prompt injection;LLM security;multilayered defense;AI safety;educational technology},
  doi={10.1109/USBEREIT70063.2026.11581043},
  ISSN={2769-3635},
  month={May},}@INPROCEEDINGS{11011372,
  author={Joshi, Tanaya and Naik, Vaishnavi and Mistry, Isha and Mangrulkar, Ramchandra},
  booktitle={2025 3rd International Conference on Advancement in Computation & Computer Technologies (InCACCT)}, 
  title={Prevention of Prompt Injection Attacks Over Financial Applications Integrated with LLM}, 
  year={2025},
  volume={},
  number={},
  pages={225-230},
  abstract={Prompt injection is a growing concern in financial applications integrated with Large Language Models. These attacks pose a critical risk to financial applications leading to data breaches, confidential data loss and financial losses by manipulating input prompts to cause unintended or harmful outputs. Existing defense strategies include utilizing filters f or input and output, and delimiters, however, these techniques have been proven inadequate. This paper builds upon existing mechanisms and proposes an enhanced security system that incorporates role-based access, jailbreak attack detection, validating inputs and securely passing prompts to LLM. This is done by developing a pre-processing layer at both ends-the client and LLMs-through the identification of critical as well as destructive keywords. The experimental results show that blocking of that malicious prompt ensures that only authenticated and authorized commands are processed. The measures, therefore, allow financial institutions to significantly reduce the probability of prompt injection attacks besides increasing data protection and confidence i n AI-based financial applications.},
  keywords={Authorization;Filters;Large language models;Prevention and mitigation;Computational modeling;Finance;Data protection;Data breach;Prompt engineering;Computer security;Authorization;Finance;Jailbreak;LLMs;Prompt Engineering;Security;Signing},
  doi={10.1109/InCACCT65424.2025.11011372},
  ISSN={},
  month={April},}@INPROCEEDINGS{11755159,
  author={Shatnawi, Amani and Alhathli, Manal and Karajeh, Ola and Al-Abdullah, Muhammad},
  booktitle={2026 International Conference on Cybersecurity and AI-Based Systems (Cyber-AI)}, 
  title={Hijacking Tool-Integrated LLM Agents via Indirect Prompt Injection: A Benchmark Scaffold and Threat Taxonomy}, 
  year={2026},
  volume={},
  number={},
  pages={419-426},
  abstract={Tool-integrated large language model (LLM) agents compose privileged actions — file reads, email dispatch, shell invocation — from the reasoning traces of a probabilistic model. Because the same channel carries both task data and latent instruction, any adversary who can place text into the data pipeline gains a tool-call influence that is bounded only by the agent's authorization envelope. Indirect prompt injection exploits this conflation. The security properties of such agents are not yet well characterized in the open literature: reports exist, but reproducible infrastructure, statistically grounded protocols, and explicit threat decompositions remain scarce. This paper does not claim a novel attack. It contributes three artifacts that the prior reports lack: (i) a reproducible benchmark scaffold for indirect prompt injection against a LangChain-style ReAct agent, parameterized over model, tool set, and injection medium; (ii) a consolidated threat taxonomy that unifies the HTML-comment, Base64, and hidden-CSS vectors introduced by Greshake et al. [1] with a supervisor-reframing adaptive variant designed to defeat system-prompt defenses in the sense of Perez and Ribeiro [2]; and (iii) an evaluation protocol specifying trial counts, confidence intervals, position-sensitivity ablations, and detection-latency measurements that a downstream empirical study can execute against real Llama 3 8B and 70B endpoints [3]. The scaffold is designed to be composable with InjecAgent [4] and AgentDojo [5]. We explicitly decline to report attack-success rates in this paper: the full empirical pass against live model endpoints is the next release of the artifact. What we do provide is the apparatus, the power analysis, and the qualitative behavioral shape of representative ReAct traces collected during scaffold development, clearly labeled as such. The contribution is infrastructural, not declarative.},
  keywords={Modeling;Tools;Printing;Protocols;Automatic speech recognition;Radio access networks;Regional area networks;Large language models;Security;Electronic mail;Large language models;agentic AI;indirect prompt injection;tool use;benchmark;confused deputy;ReAct;security evaluation},
  doi={10.1109/Cyber-AI70573.2026.11755159},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11727885,
  author={Almamoori, Hayder and Candemir, Cemre},
  booktitle={2026 10th International Artificial Intelligence and Data Processing Symposium (IDAP)}, 
  title={MAMORI: A Cross-Lingual Benchmark for Indirect Prompt Injection in Tool-Using LLM Agents}, 
  year={2026},
  volume={},
  number={},
  pages={1-5},
  abstract={Language-model agents that call tools can be hijacked through indirect prompt injection; an attacker hides instructions inside the data that agent later reads and follows. Almost all of the attacks, benchmarks and defenses for this problem have been built and tested in English, which leaves a basic question open. If a defense stops an English injection, does it still work when the same injection is written in another language? To find out, we built MAMORI (Multilingual Agent Measurement Of Robustness to Injection), an extension of the AgentDojo environment that rewrites one attack across six languages and three scripts and also produces code-switched and transliterated forms. MAMORI records how each payload was translated, so a drop in safety cannot be blamed on a bad translation. Evaluating GPT-4o-mini in two simulated environments, we find that the weakness is not a low-resource problem but an English one. High-resource German is compromised 97.5% of the time, as often as mid-resource Turkish, Korean, and Arabic at 100%, while English alone holds out at 35%. None of the four English-tuned defenses we tried, namely a neural detector, structured delimiting, prompt repetition and tool filtering have lowered attack success in any non-English language and several raise it. Knowing that the attacker picks the language, a single-language score is misleading. We therefore propose Adversarial Cross-Lingual Robustness (ACLR), the agent’s resistance in its weakest language and the Multilingual Safety Illusion (MSI), the gap between an English score and that worst case. On the undefended agent, an English-only test reports 65% security while ACLR is 0% and MSI is 0.65.},
  keywords={Modeling;Multilingual;Tools;Detectors;Security;Cross lingual;Automatic speech recognition;Printing;Safety;Writing;LLM agents;indirect prompt injection;agent security;cross-lingual robustness;multilingual NLP;tool use;trustworthy AI;red-teaming},
  doi={10.1109/IDAP71869.2026.11727885},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11635183,
  author={Wang, Leilei and Li, Hongying},
  booktitle={2026 IEEE 3rd International Conference on Computer Vision and Deep Learning (DLCV)}, 
  title={LLM Security Defense Using Unsupervised Learning and Deep Reinforcement Learning}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={With the widespread deployment of large language models (LLMs) in intelligent systems, security threats such as prompt injection, jailbreaking, data poisoning, and hidden backdoor attacks have become increasingly severe. Traditional rule-based filtering and static detection methods are unable to capture implicit semantic attacks and hidden-space anomalies, and lack adaptability to evolving adversarial behaviors. To address these challenges,, unsupervised feature learning, deep reinforcement learning, and human-computer interaction. The framework leverages contrastive unsupervised feature learning to mine hidden-space anomalies in multi-modal inputs (text, images, and video), and employs proximal policy optimization (PPO)-based deep reinforcement learning to implement adaptive runtime defense strategies. A multi-modal dataset AISafe-36M is constructed to support the validation of implicit attack detection, jailbreaking interception, and cross-modal robustness. Extensive experiments show that the proposed method achieves 94.8% accuracy in implicit anomaly detection, reduces the attack success rate (ASR) of jailbreaking to below 1.6%, and maintains an average end-to-end latency of 28 ms, fully meeting the performance requirements of industrial applications. The framework realizes the organic integration of computer vision, deep learning, and security defense, and provides a systematic solution for the secure deployment of large language models.},
  keywords={Modeling;Security;Computers;Deep reinforcement learning;Signal detection;Human computer interaction;Computer vision;Representation learning;Printing;Large language models;Large Language Model Security;Computer Vision;Unsupervised Feature Learning;Deep Reinforcement Learning;Multi-modal Detection;Human-Computer Interaction;Behavior Recognition},
  doi={10.1109/DLCV69906.2026.11635183},
  ISSN={},
  month={June},}@INPROCEEDINGS{11728563,
  author={Gong, Guangyu and Deng, Zizhuang},
  booktitle={2026 International Joint Conference on Neural Networks (IJCNN)}, 
  title={PlanGuard: Defending Agents against Indirect Prompt Injection via Planning-based Consistency Verification}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Large Language Model (LLM) agents are increasingly integrated into critical systems, leveraging external tools to interact with the real world. However, this capability exposes them to Indirect Prompt Injection (IPI), where attackers embed malicious instructions into retrieved content to manipulate the agent into executing unauthorized or unintended actions. Existing defenses predominantly focus on the pre-processing stage, neglecting the monitoring of the model’s actual behavior. In this paper, we propose PlanGuard, a training-free defense framework based on the principle of Context Isolation. Unlike prior methods, PlanGuard introduces an isolated Planner that generates a reference set of valid actions derived solely from user instructions. In addition, we design a Hierarchical Verification Mechanism that first enforces strict hard constraints to block unauthorized tool invocations, and subsequently employs an Intent Verifier to validate whether parameter deviations are benign formatting variances or malicious hijacking. Experiments on the InjecAgent benchmark demonstrate that PlanGuard effectively neutralizes these attacks, reducing the Attack Success Rate (ASR) from 72.8% to 0%, while maintaining an acceptable False Positive Rate of 1.49%. Furthermore, our method is model-agnostic and highly compatible.},
  keywords={Modeling;Tools;Large language models;Context;Printing;Security;Equations;Automatic speech recognition;Planning;Training;Large Language Model Agent;Indirect Prompt Injection;Context Isolation;AI Security},
  doi={10.1109/IJCNN69854.2026.11728563},
  ISSN={2161-4407},
  month={June},}@ARTICLE{11626887,
  author={Nkoro, Ebuka Chinaechetam and Yu, Wei and Liao, Weixian},
  journal={IEEE Internet of Things Journal}, 
  title={RAPID: A Resource-Aware Prompt Injection Defense for LLM-Enabled Threat Detection}, 
  year={2026},
  volume={13},
  number={19},
  pages={44663-44674},
  abstract={The burgeoning interest in large language models (LLMs) has demonstrated significant utility across diverse domains, including intrusion detection systems (IDSs). However, they are prone to severe security threats, including prompt injection attacks (PIAs), where adversaries subtly manipulate input prompts or input logs to mislead the LLM into producing erroneous or inappropriate output, undermining its prompt quality. The current literature fails to account for PIA in real-time scenarios where LLMs are applied to IDSs. Given their utmost demand for security, optimal functionality, and token exhaustion, PIA undermines the overall practicability of the security application. To tackle this issue, we first evaluate the efficacy of LLMs for IDS, then examine the impact of a novel recursive PIA that poisons the LLM with unauthorized, repetitive tasks, thereby undermining real-time IDS and achieving a stealthy, wasteful, exhaustive, and time-evasive attack success rate. To defend against this recursive PIA, a resource-aware prompt injection defense (RAPID) is proposed in this article, with the core aim of sanitizing training data (network traffic) input being fed into the LLM, enforcing optimal token utility, and real-time constraints of the LLM-enabled IDS. RAPID distinguishes itself from extant PIA defenses by uniquely targeting recursive adversarial patterns with a lightweight, pre-execution sanitization layer that simultaneously restores semantic integrity and enforces strict computational bounds, thereby neutralizing the latency-driven evasion windows and resource-exhaustion vulnerabilities inherent in deploying LLMs for real-time IDS. Our empirical evaluation results not only verify the viability of RAPID but also demonstrate its ability to secure LLM-enabled IDSs against PIA.},
  keywords={Modeling;Large language models;Internet of Things;Security;Timing;Computer security;Signal detection;Measurement;Accuracy;Safety;Cybersecurity;intrusion detection;large language models (LLMs);prompt injection attacks (PIAs)},
  doi={10.1109/JIOT.2026.3717740},
  ISSN={2327-4662},
  month={Oct},}@INPROCEEDINGS{11661842,
  author={Awal, Md Abdul and Nishita Aktar, Mst. and Rahman, Kh. Mustafizur and Hossain, Afzal and Sakib, Md.Nazmus},
  booktitle={2026 International Conference on Power, Electronics, Communications, Computing, and Intelligent Infrastructure (PECCII)}, 
  title={Hybrid Feature Representation and Deep Anomaly Detection for Jailbreak Prompt Defense}, 
  year={2026},
  volume={},
  number={},
  pages={1-5},
  abstract={Prompt-based jailbreak attacks remain a practical threat to the safe deployment of large language models, as adversaries can bypass moderation policies using carefully crafted instructions and obfuscation. This paper investigated whether anomaly detection can serve as a lightweight defense for identifying malicious prompts without relying on continuously updated labeled attack sets. Study developed a hybrid feature representation that combined word-level and character-level TF–IDF (Term Frequency–Inverse Document Frequency) features with embedding vectors, and evaluated TruncatedSVD and PCA for dimensionality reduction. Three anomaly detectors—Isolation Forest, One-Class SVM, and a deep autoencoder trained primarily on benign prompts—were assessed on a public prompt-injection dataset using ROC-based threshold selection. The deep autoencoder with SVD achieved the strongest overall performance, reaching 0.94 recall and 0.31 F1-score, while exhibiting a conservative detection behavior with elevated false positives. These results suggest that deep reconstruction-based anomaly scoring can function as a high-recall first-stage safety filter for jailbreak prompt defense, with future improvements focused on calibration to reduce benign misclassifications. Rather than being a stand-alone classifier, the suggested approach is meant to serve as a high-recall, first-stage safety filter to support subsequent moderating techniques. The primary limitation is the false-positive rate, which motivates threshold calibration and layered moderation as future work.},
  keywords={Modeling;Signal detection;Printing;Anomaly detection;Labeling;Principal component analysis;Large language models;Filtering;Filters;Safety;Large language model safety;jailbreak detection;prompt injection;anomaly detection;deep autoencoder;TF–IDF;dimensionality reduction},
  doi={10.1109/PECCII70991.2026.11661842},
  ISSN={},
  month={June},}@INPROCEEDINGS{11221566,
  author={Esugo, Martin and Alao, Oluwatobi and Mahmoud, Haitham},
  booktitle={IECON 2025 – 51st Annual Conference of the IEEE Industrial Electronics Society}, 
  title={SHIELD: Security against Harmful Prompt Injection Evaluation and Language Detection Leveraging Ensemble Approach}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Large Language Models (LLMs) are increasingly deployed in domains such as finance, healthcare, and cybersecurity, exposing them to adversarial threats, most notably prompt-injection attacks, which exploit the way LLMs interpret and respond to user instructions. In this paper, we: (1) propose Security against Harmful Prompt Injection Evaluation and Language Detection Leveraging Ensemble Approach (SHIELD), a hybrid detection pipeline that combines supervised learning, zero-shot inference, and rule-based heuristics; (2) construct two cybersecurity-themed prompt-injection datasets of differing complexity, derived from an extensive survey of recent research; and (3) systematically review prompt-injection attacks on LLMs indexed in the Scopus database. Experimental results show that ensemble approaches outperform individual models, especially on complex adversarial inputs, whereas purely rule-based methods suffer from high false-negative rates. Our findings supply an accurate benchmark dataset for future studies and underscore the need for multi-pronged detection frameworks.},
  keywords={Surveys;Reviews;Prevention and mitigation;Supervised learning;Pipelines;Finance;Medical services;Pressing;Safety;Ensemble learning;Prompt Injection;Adversarial attacks;LLM},
  doi={10.1109/IECON58223.2025.11221566},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11401933,
  author={Lee, Youngjoon and Park, Taehyun and Lee, Yunho and Gong, Jinu and Kang, Joonhyuk},
  booktitle={2025 IEEE International Conference on Big Data (BigData)}, 
  title={Exploring Potential Prompt Injection Attacks in Federated Military LLMs and Their Mitigation}, 
  year={2025},
  volume={},
  number={},
  pages={6436-6440},
  abstract={Federated Learning (FL) is increasingly being adopted in military collaborations to develop Large Language Models (LLMs) while preserving data sovereignty. However, prompt injection attacks—malicious manipulations of input prompts—pose new threats that may undermine operational security, disrupt decision-making, and erode trust among allies. This perspective paper highlights four vulnerabilities in federated military LLMs: secret data leakage, free-rider exploitation, system disruption, and misinformation spread. To address these risks, we propose a human–AI collaborative framework with both technical and policy countermeasures. On the technical side, our framework uses red/blue team wargaming and quality assurance to detect and mitigate adversarial behaviors of shared LLM weights. On the policy side, it promotes joint AI–human policy development and verification of security protocols.},
  keywords={Quality assurance;Protocols;Federated learning;Large language models;Systems operation;Prevention and mitigation;Decision making;Collaboration;Security;Fake news;federated learning;large language;model;adversarial attack;military policy},
  doi={10.1109/BigData66926.2025.11401933},
  ISSN={2573-2978},
  month={Dec},}@INPROCEEDINGS{11300550,
  author={R S, Amogh and Muthudhanush, A R and M D, Shwetha},
  booktitle={2025 International Conference on Intelligent Systems and Pioneering Innovations in Robotics and Electric Mobility (INSPIRE)}, 
  title={Modern Day LLMs : A GOLDMINE or a LANDMINE ?}, 
  year={2025},
  volume={},
  number={},
  pages={513-520},
  abstract={This paper presents a systematic analysis of Indirect Prompt Injection (IPI) attacks on Large Language Models (LLMs), examining their dual role as enablers of advanced AI applications and as sources of significant security risk. The study addresses three core research objectives: (1) identifying adversarial techniques that enable effective IPI execution, (2) comparing vulnerabilities across leading LLM architectures, and (3) evaluating the efficacy of existing mitigation strategies. Through empirical testing of Blackbox AI 3.1.6, ChatGPT 3.5, and Gemini 2.0, we find that multi-turn escalation, privilege manipulation, and role-conditioning consistently bypass baseline safety defenses. Our results reveal critical weaknesses in refusal consistency and context-aware filtering. To address these issues, we propose a structured evaluation framework for benchmarking model resilience and outline mitigation pathways with direct deployment relevance, contributing to adversarial robustness research and safer LLM design.},
  keywords={Technological innovation;Landmine detection;Systematics;Prevention and mitigation;Large language models;Closed box;Chatbots;Robustness;Safety;Security;Indirect Prompt Injection Attacks;LLM Security;AI Goldmine to Landmine;Adversarial Robustness;Model Vulnerabilities;Jailbreak Techniques;AI Ethics and Safety;Multi-Turn Attack Mitigation;Large Language Model Exploits},
  doi={10.1109/INSPIRE67328.2025.11300550},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11401900,
  author={Ikbarieh, Seif and Aryal, Kshitiz and Gupta, Maanak},
  booktitle={2025 IEEE International Conference on Big Data (BigData)}, 
  title={RAG-Targeted Adversarial Attack on LLM-Based Threat Detection and Mitigation Framework}, 
  year={2025},
  volume={},
  number={},
  pages={6577-6586},
  abstract={The rapid expansion of the Internet of Things (IoT) is reshaping communication and operational practices across industries, but it also broadens the attack surface and increases susceptibility to security breaches. Artificial Intelligence has become a valuable solution in securing IoT networks, with Large Language Models (LLMs) enabling automated attack behavior analysis and mitigation suggestion in Network Intrusion Detection Systems (NIDS). Despite advancements, the use of LLMs in such systems further expands the attack surface, putting entire networks at risk by introducing vulnerabilities such as prompt injection and data poisoning. In this work, we attack an LLM-based IoT attack analysis and mitigation framework to test its adversarial robustness. We construct an attack description dataset and use it in a targeted data poisoning attack that applies word-level, meaning-preserving perturbations to corrupt the Retrieval-Augmented Generation (RAG) knowledge base of the framework. We then compare pre-attack and post-attack mitigation responses from the target model, ChatGPT-5 Thinking, to measure the impact of the attack on model performance, using an established evaluation rubric designed for human experts and judge LLMs. Our results show that small perturbations degrade LLM performance by weakening the linkage between observed network traffic features and attack behavior, and by reducing the specificity and practicality of recommended mitigations for resource-constrained devices.},
  keywords={Performance evaluation;Prevention and mitigation;Perturbation methods;Large language models;Retrieval augmented generation;Network intrusion detection;Telecommunication traffic;Threat assessment;Robustness;Internet of Things;Adversarial Poisoning Attack;Internet of Things (IoT) Security;Large Language Model;Retrieval-Augmented Generation;Cybersecurity},
  doi={10.1109/BigData66926.2025.11401900},
  ISSN={2573-2978},
  month={Dec},}@INPROCEEDINGS{11454256,
  author={Won, Seyeon and Pak, Wooguil},
  booktitle={2026 International Conference on Artificial Intelligence in Information and Communication (ICAIIC)}, 
  title={Prompt Injection Detection via Key Feature Integration in Large Language Models}, 
  year={2026},
  volume={},
  number={},
  pages={679-682},
  abstract={This study proposes Total-Layer Detection (TLD), a novel framework that integrally utilizes all layers of a Large Language Model to detect prompt injection attacks effectively. To address the computational inefficiency arising from high-dimensional data, we selectively utilized only the core features decisive for attack identification. Experiments demonstrated that TLD achieves higher accuracy and superior efficiency compared to single-layer approaches by efficiently reducing the feature dimensionality from the concatenated total-layer vector while enhancing detection precision.},
  keywords={Accuracy;High dimensional data;Large language models;Computational modeling;Feature extraction;Vectors;Safety;Large Language Models (LLMs);Prompt Injection;Total-Layer Detection;Feature Selection},
  doi={10.1109/ICAIIC68212.2026.11454256},
  ISSN={2831-6983},
  month={Feb},}@INPROCEEDINGS{10771340,
  author={Zhang, Wenxiao and Kong, Xiangrui and Dewitt, Conan and Braunl, Thomas and Hong, Jin B.},
  booktitle={2024 IEEE 35th International Symposium on Software Reliability Engineering Workshops (ISSREW)}, 
  title={A Study on Prompt Injection Attack Against LLM-Integrated Mobile Robotic Systems}, 
  year={2024},
  volume={},
  number={},
  pages={361-368},
  abstract={The integration of Large Language Models (LLMs) like GPT-4o into robotic systems represents a significant advancement in embodied artificial intelligence. These models can process multi-modal prompts, enabling them to generate more context-aware responses. However, this integration is not without challenges. One of the primary concerns is the potential security risks associated with using LLMs in robotic navigation tasks. These tasks require precise and reliable responses to ensure safe and effective operation. Multi-modal prompts, while enhancing the robot’s understanding, also introduce complexities that can be exploited maliciously. For instance, adversarial inputs designed to mislead the model can lead to incorrect or dangerous navigational decisions. This study investigates the impact of prompt injections on mobile robot performance in LLM-integrated systems and explores secure prompt strategies to mitigate these risks. Our findings demonstrate a substantial overall improvement of approximately 30.8% in both attack detection and system performance with the implementation of robust defence mechanisms, highlighting their critical role in enhancing security and reliability in mission-oriented tasks.},
  keywords={Navigation;System performance;Prevention and mitigation;Large language models;Conferences;Software reliability;Security;Mobile robots;Robots;Context modeling;LLM;Mobile Robot;Embodied AI;Security;Prompt Engineering},
  doi={10.1109/ISSREW63542.2024.00103},
  ISSN={2994-810X},
  month={Oct},}@INPROCEEDINGS{11378619,
  author={S, Aswin Mallessh N and A, Ilavendhan},
  booktitle={2025 IEEE Pune Section International Conference (PuneCon)}, 
  title={Input Moderation and Injection Filtering in Large Language Model via Llama Guard Integration}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Large Language Models (LLMs) have recently gained attention in the field of natural language processing owing to their impressive capabilities. However, as their use becomes more widespread, new security challenges have emerged, most notably prompt injection attacks. These attacks exploit the instruction-following nature of models such as Llama, which are particularly vulnerable. In this study, proposed a mitigation strategy in which user prompts were first filtered through Llama Guard, a policy-driven safeguard mechanism that acted as a mediator between the user and the LLM. This approach utilizes predefined safety rules (policies) and blocks malicious prompt manipulation using the LlamaGuard interface. Experimental evaluation on the DeepSet dataset demonstrated improvements in security across multiple models. With LlamaGuard integration, the 8B version maintained a high recall (91.25 %) and F1-score (77.29 %) while achieving an accuracy (78.70%) and precision (67.03%). The accuracy of the 8 B model improved by 4.23 % and that of the 1B model by 1.16 % when combined with LlamaGuard, according to the results, which proved a boost in performance.},
  keywords={Accuracy;Filtering;Large language models;Prevention and mitigation;Natural language processing;Safety;Security;Large Language Models;Input Moderation;Prompt Injection;LlamaGuard;AI Security;Model Defense},
  doi={10.1109/PuneCon67554.2025.11378619},
  ISSN={2831-5022},
  month={Dec},}@INPROCEEDINGS{11670085,
  author={Guo, Hengqi and Zhou, Yuebing and Li, Rongzhen and Duan, Qiang},
  booktitle={2026 IEEE International Conference on Web Services (ICWS)}, 
  title={Loki's Gaze: An Efficient Detection Method of LLM Backdoor with Prompt Injection Attacks}, 
  year={2026},
  volume={},
  number={},
  pages={1-11},
  abstract={Backdoor attacks pose a significant threat to large language models (LLMs), as attackers can implant hidden triggers to manipulate model outputs. Existing defense methods are primarily designed for classification tasks and prove ineffective against LLMs' autoregressive nature and massive output spaces, resulting in poor performance and high latency. To overcome these limitations, we delve into the interaction between backdoor models and prompt injection attacks. We discovered that when a backdoored model encounters a simple prompt injection attack, it ignores both triggers and commands, instead generating incoherent outputs. This distinctive behavioral anomaly reflects the cognitive dissonance of the autoregressive LLM when simultaneously subjected to backdoor triggers and prompt injection instructions, serving as a key feature that differentiates backdoored models from clean ones. Building upon this observation, we propose “Loki's Gaze”, a lightweight and efficient model backdoor detection method. Extensive experiments demonstrate that our method achieves an average 97.36% true positive rate (TPR) and a negligible false positive rate (FPR) across most scenarios. Crucially, this approach is simple, effective, and enables real-time detection with negligible additional latency, making it a practical backdoor defense solution for realworld LLM deployments.},
  keywords={Modeling;Signal detection;Large language models;Printing;Sequences;Sequential analysis;Conferences;Equations;Training;Accuracy;Backdoor Detection;LLM;Prompt Injection Attacks;Perplexity;Service Privacy},
  doi={10.1109/ICWS72778.2026.00072},
  ISSN={2836-3868},
  month={July},}@INPROCEEDINGS{11723765,
  author={Tikekar, Priyanka C. and Gawande, Apeksha R. and Bhad, Prajakta A.},
  booktitle={2026 1st International Conference on Computer, Mechatronics, Robotics & Artificial Intelligence (ICCMRAI)}, 
  title={Introduction to AI Security: Understanding Prompt Injection Attack}, 
  year={2026},
  volume={},
  number={},
  pages={1-5},
  abstract={When large language model system interacts with external sources for performing complex task new attack namely prompt injection is introduced. Now a day, Prompt injection attack becomes significant threat. By injecting instructions in execution of system, attacker is able to override the task that is given by someone else. As Large Language model become more used in real life systems, new security issues have come up & one of the most important in them is the prompt injection attack. These attack takes advantage of LLM inability to distinguish between reliable system instruction & unreliable user inputs. In this chapter, Details study of prompt injection attack including introduction, prompt injection attack, its types, literature, prompt injection attack detection techniques, its comparative study, system architecture, proposed defense framework, experimental analysis & results are discussed. Experimental evaluation demonstrates the effectiveness of layered defense mechanism.},
  keywords={Modeling;Large language models;Security;Artificial intelligence;Aluminum;Signal detection;Conferences;Timing;Filtering;Filters;AI Security;Prompt Injection;Literature;System architecture;Framework},
  doi={10.1109/ICCMRAI67732.2026.11723765},
  ISSN={},
  month={July},}@INPROCEEDINGS{11670120,
  author={Zhao, Zhenghao and Zeng, Qingwen and Yang, Yitian and Chen, Huaming},
  booktitle={2026 IEEE International Conference on Web Services (ICWS)}, 
  title={Mitigating Semantic Confusion in LLM-Integrated Web Services via Dynamic Dual-Stream Intent Matching}, 
  year={2026},
  volume={},
  number={},
  pages={1219-1221},
  abstract={Large Language Models (LLMs) are increasingly used as tool-using agents in web services, but this integration exposes service workflows to Indirect Prompt Injection (IPI) attacks, where malicious tool-retrieved content can hijack downstream actions. Existing inference-time defenses often rely on masked re-execution and similarity-based comparison over complete tool calls. However, treating the function name and its arguments as a single semantic object can cause Semantic Confusion, where dominant function-level semantics obscure subtle but security-critical payload changes and lead to overdefense. To address this problem, we propose D2IM (Dynamic Dual-Stream Intent Matching), a lightweight defense framework that decouples tool calls into a Function Stream and a Payload Stream. D2IM combines Structural Disentanglement, Semantic Anchors, and an Adaptive Weighting Router for structureaware comparison. Evaluation on AgentDojo across multiple service domains and attack settings shows that D2IM improves the security-utility trade-off over representative inference-time baselines.},
  keywords={Tools;Payloads;Streams;Modeling;Security;Web services;Large language models;Printing;LLM-Integrated Web Services;Indirect Prompt Injection;Agent Security;Tool-Call Matching;Semantic Confusion},
  doi={10.1109/ICWS72778.2026.00153},
  ISSN={2836-3868},
  month={July},}@INPROCEEDINGS{11618608,
  author={Tripathi, Mukesh Mani and Dhital, Damodar and Aryal, Himal},
  booktitle={2026 IEEE/ACIS 24th International Conference on Software Engineering Research, Management and Applications (SERA)}, 
  title={Prompt Injection as a Systemic Vulnerability in LLM-Based Tools: Threat Models, Empirical Analysis, and Mitigation Strategies}, 
  year={2026},
  volume={},
  number={},
  pages={291-296},
  abstract={Large language models (LLMs) deployed as autonomous agents with tool access, retrieval pipelines, and persistent memory expose an expanded attack surface. We formalize prompt injection as a control-boundary violation arising from the conflation of trusted instructions and untrusted data within LLM context windows. We introduce a threat model spanning user input, retrieval pipelines, tool outputs, and persistent memory, and develop a structured taxonomy of attack vectors. We conduct a controlled empirical evaluation across three system architectures (chatbot, retrieval-augmented system, autonomous agent) and three major LLM families (GPT-4, Claude 3.5 Sonnet, Gemini 1.5 Pro), totaling 2,100 trials ($N=50$ per configuration). Results show a monotonic increase in attack success as system autonomy expands, with memory poisoning reaching 94% (95% CI: 83.8-98.2%) in autonomous configurations. Through systematic ablation of six mitigation strategies, we find that prompt-level defenses provide limited protection $(\leq 3.2$ percentage points), while architectural controls-specifically tool permission gating, memory write filtering, and provenance tracking-reduce memory poisoning from 94% to 11%. These findings provide strong empirical evidence that prompt injection is best understood as a system-level vulnerability requiring external policy enforcement rather than prompt engineering alone.},
  keywords={Modeling;Memory;Tools;Large language models;Equations;Printing;Toxicology;Architecture;Computer architecture;Signal detection;Prompt Injection;Large Language Models;AI Security;Autonomous Agents;Systems Security;Software Architecture},
  doi={10.1109/SERA69989.2026.11618608},
  ISSN={2770-8209},
  month={May},}@INPROCEEDINGS{11735682,
  author={Anbazhagan, Gobika and S, Priyanga and S, Dinakar Jose},
  booktitle={2026 International Conference on Science Technology Engineering and Management (ICSTEM)}, 
  title={Zero Trust Framework for Detecting and Preventing Prompt Injection Attacks in Enterprise AI Chatbots}, 
  year={2026},
  volume={},
  number={},
  pages={1-8},
  abstract={Large Language Models (LLMs) are increasingly integrated into enterprise applications but remain vulnerable to direct and indirect prompt injection attacks. Existing defense mechanisms often rely on static filtering and lack continuous verification. This paper proposes AdaptiveTrustGuard, a Zero Trust framework that integrates prompt validation, semantic similarity detection, retrieval verification, context isolation, adaptive trust scoring, temporal attack analysis, and policy enforcement, continuously verifying each interaction before it reaches the LLM. Initial evaluation on a manually labelled set achieved 60% recall, but testing on the independent deepset/prompt-injections benchmark exposed poor generalization (8.3% recall). Replacing fixed thresholds with a classifier trained on prompt embeddings and calibrated via a validation split recovered strong performance (78.3% recall, 92.2% precision, ROC-AUC 0.943 on deepset), exceeding an external baseline detector, while achieving 61.7% recall on the larger, more realistic PromptShield benchmark. These findings demonstrate the applicability of Zero Trust principles to LLM security while highlighting the necessity of multi-benchmark validation},
  keywords={Security;Modeling;Artificial intelligence;Poles and zeros;Zero Trust;Context;Printing;Large language models;Signal detection;Engines;Zero Trust Framework;Enterprise AI Security;Prompt Injection Attacks;Indirect Prompt Injection;Large Language Models;Secure AI Chatbots;Retrieval Augmented Generation Security;Context Isolation;Continuous Verification;Trust Management},
  doi={10.1109/ICSTEM68144.2026.11735682},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11648022,
  author={Abzal, Shuktaev and Bakhtiyar, Karabalin and Sultan, Orynbasar and Orlova, Olga and Korochkina, Elena Aleksandrovna and Borashova, Sholpan},
  booktitle={2026 International Conference on Cybersecurity, Digital Forensics, and AI Applications (ICCSDFAI)}, 
  title={Prompt Injection as the New SQL Injection: The Emergence of Attacks on AI Reasoning}, 
  year={2026},
  volume={},
  number={},
  pages={1009-1014},
  abstract={The introduction of Large Language Models (LLMs) into enterprise application pipelines represents both a blessing and a curse — the same versatility in following instructions that enables conversational assistants, code copilots, and autonomous agents also erodes the distinction between trusted instruction and untrusted data. In this paper, we argue that Prompt Injection (PI) follows SQL Injection (SQLi) as a fundamental class of attack on machine learning systems. While SQLi leveraged the absence of distinction between code and data in relation queries, PI leverages the absence of separation between system instruction and contextual data in natural language reasoning. The target domain has shifted from syntactic parsing to semantic interpretation, and classic defenses — escaping, parameterization, and whitelisting — are insufficient because natural language lacks a formal grammar to sanitize. We perform a narrative analysis of relevant peer-reviewed and preprint publications within the period 2023–2026, structured around three major dimensions: (i) the taxonomy of direct and indirect prompt injection attacks, (ii) the tactics that PI employs to overcome defenses provided by Reinforcement Learning from Human Feedback (RLHF) and guardrails, and (iii) the elevated threat landscape of agentic LLM applications with tool capabilities. We formalize the attacker’s strategic edge through a success rate model and offer comparative studies with SQLi, a severity scale for different modes of operation, and guidance for Chief Information Security Officers (CISOs). Our core thesis is that PI represents a paradigm shift, necessitating defense strategies beyond input sanitization toward workflow isolation and defensive LLMs.},
  keywords={Modeling;Large language models;Printing;Electronic mail;Tools;Aluminum;SQL injection;Artificial intelligence;Security;Codes;prompt injection;large language models;AI security;indirect prompt injection;agentic AI;adversarial machine learning;SQL injection analogy;defensive LLMs},
  doi={10.1109/ICCSDFAI70505.2026.11648022},
  ISSN={},
  month={June},}@INPROCEEDINGS{10813380,
  author={Tien, Le Anh and Van Huong, Pham},
  booktitle={2024 1st International Conference On Cryptography And Information Security (VCRIS)}, 
  title={Optimizing Transformer Models for Prompt Jailbreak Attack Detection in AI Assistant Systems}, 
  year={2024},
  volume={},
  number={},
  pages={1-4},
  abstract={Integrating AI-powered assistants in different areas has changed how people retrieve information. Users can now get quick responses, use the service whenever needed, and handle inquiries well. However, relying on these systems has increasingly raised worries about their safety and reliability, especially when facing threats like prompt injection or jailbreak attacks. These attacks take advantage of the weaknesses of large language models (LLMs) by changing input prompts to create harmful, biased, or misleading results. This paper examines prompt jailbreak attacks in ChatGPT-based assistant chatbots, especially in education. It examines the weaknesses in these systems and suggests ways to detect these attacks by fine-tuning various Transformer models. The research also includes adding prompt jailbreak attack detection in a virtual assistant application for university use. This aims to ensure teachers and students can interact safely and rely on the system. Through rigorous experimentation and evaluation, we demonstrate the practicality and effectiveness of our detection methods, providing reassurance and confidence in the face of AI security challenges. Our studies emphasize the need for robust AI chatbots and offer practical solutions to preserve the integrity of AI-driven tools.},
  keywords={Training;Virtual assistants;Large language models;Refining;Information security;Transformers;Chatbots;Reliability engineering;Safety;Faces;chatbot;prompt engineering;prompt injection attack;transformer;LLM},
  doi={10.1109/VCRIS63677.2024.10813380},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11390931,
  author={Tortora, Fabio and De Angelis, Vincenzo},
  booktitle={2025 12th International Conference on Social Networks Analysis, Management and Security (SNAMS)}, 
  title={An Experimental Evaluation of Prompt Injection Attacks on LLM-Based Content Moderation Systems}, 
  year={2025},
  volume={},
  number={},
  pages={12-16},
  abstract={Large Language Models (LLMs) are increasingly deployed to automate content moderation on social platforms, offering efficiency and scalability far beyond human capabilities. However, they are highly vulnerable to prompt injection—maliciously crafted inputs designed to manipulate model behavior and bypass intended safeguards. In this paper, we experimentally evaluate the robustness of three widely used LLMs—OpenAI, Gemini, and Mistral—against direct prompt injection attacks in a controlled moderation setting. Under identical system prompts and attack conditions, the three models displayed different levels of robustness. Initial results showed varying performance impacts, with some models experiencing more noticeable degradation than others. Moreover, a refined injection using a differently concatenated user prompt was able to further reduce the effectiveness of the moderator when considering the model that initially achieved the best performance, suggesting that subtle variations in attack design can significantly influence outcomes. These findings highlight significant differences in model robustness and underscore the importance of rigorous evaluation and informed model selection for highstakes content moderation applications, where failures can have real-world consequences.},
  keywords={Degradation;Training;Adaptation models;Analytical models;Social networking (online);Large language models;Scalability;User-generated content;Robustness;Security;LLM;Content Moderation;Prompt Injection;Model Robustness;Social Networks},
  doi={10.1109/SNAMS67467.2025.11390931},
  ISSN={2831-7343},
  month={Nov},}@INPROCEEDINGS{11064209,
  author={Joseph, Jefferson Kanjirakkattu and Daniel, Esther and Kathiresan, V and M.A.P, Manimegalai},
  booktitle={2025 International Conference on Electronics, Computing, Communication and Control Technology (ICECCC)}, 
  title={Prompt Injection in Large Language Model Exploitation: A Security Perspective}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={With the rapid growth of AI technologies, ensuring the security of open-source Large Language Models (LLMs) is crucial to maintaining their reliability and trustworthiness. The paper presents a detailed framework to evaluate the security risks of these models in today's fast-changing technological world. This framework includes generators, probes, detectors, and evaluation methods, all centered around the Prompt Inject framework, which helps identify vulnerabilities and possible attacks on LLMs. By using this approach, organizations, researchers, and developers can assess how easily these models can be manipulated and take steps to improve their security. The paper highlights important applications like security testing, penetration testing, compliance checks, and continuous monitoring, ensuring that LLMs remain safe and reliable. This research is valuable for strengthening cybersecurity efforts in the era of open-source AI, helping to build safer and more trustworthy AI systems.},
  keywords={Analytical models;Privacy;Reviews;Large language models;Prevention and mitigation;Threat assessment;Robustness;Artificial intelligence;Probes;Testing;Prompt Injection;Large Language Models;Security Vulnerability;Adversarial Attacks;Open-source AI;Ethical AI;Threat Detection;Prompt Security},
  doi={10.1109/ICECCC65144.2025.11064209},
  ISSN={},
  month={May},}@INPROCEEDINGS{11493291,
  author={R, Likitha and D C, Dhanyashree and H R, Lavanya and Preeti},
  booktitle={2026 International Conference on Emerging Smart Computing and Informatics (ESCI)}, 
  title={AI Prompt Injection Attack Tester}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Large Language Models are widely integrated into chatbots, enterprise applications, and automation systems. However, these systems are vulnerable to prompt injection attacks - malicious instructions embedded in text, files, images, or translated content, attempting to override system rules. This paper presents the design and implementation of the AI Prompt Injection Attack Tester: a multi-modal system for detecting and mitigating Prompt Injection attempts against Large Language Models. While the ubiquitous deployment of LLMs has introduced a critical security vulnerability, where untrusted user input hijacks the model’s policy and system prompt, we introduce the following concept: a Heuristic-Based Prompt Injection Detection Engine integrated into a pre-processing guardrail layer. The PIDE applies a specialized ruleset, which includes instruction-overriding pattern matching and sensitive keyword identification, to incoming data for a risk score. Importantly, the system normalizes and scans inputs from four different modalities: direct text, embedded code comments/literals, image text via OCR, and text that has been processed through a mock translation service. On detection, a Mitigation Pipeline applies sequential steps of sanitization, instruction stripping, and policy-based blocking prior to any input reaching the LLM. As confirmed within a safe, mock environment for LLMs, experimental results validate that this approach provides both successful detection and neutralization of malicious instructions across all types of input tested in this work. This paper confirms that a robust, multi-modal pre-processing policy layer is required as an integral component of a broad defense-in-depth strategy against sophisticated Prompt Injection attacks.},
  keywords={Feedback;Filtering;Circuits;Filters;Graphical user interfaces;Product development;Internet;Bot (Internet);Protocols;Communication systems;Prompt Injection;LLM Security;OCR;AI Safety;Streamlit;Multi-Modal Detection},
  doi={10.1109/ESCI68015.2026.11493291},
  ISSN={2996-1815},
  month={March},}@INPROCEEDINGS{11502216,
  author={Ganiga, Divija Vijaya},
  booktitle={2026 IEEE International conference on Advanced Systems and Emergent Technologies (IC_ASET)}, 
  title={Defensive Architectures for LLM-Based Fraud Detection Against Data Poisoning and Prompt Injection}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={The increasing adoption of Large Language Models (LLMs) in financial fraud detection has enhanced institutional capabilities for identifying sophisticated and dynamic fraudulent activities within large-scale transaction systems. However, the implementation of LLM-driven systems introduces critical security vulnerabilities, particularly data poisoning during training and prompt injection attacks during inference, which threaten the reliability and integrity of automated fraud detection. This paper proposes a Resilient Defensive Architecture for LLMbased Fraud Detection (RDA-LLM), a multi-layered framework designed to protect against adversarial manipulation while maintaining high detection accuracy. The proposed architecture integrates data sanitization, semantic prompt purification, auxiliary adversarial detection, ensemble-based validation, and uncertainty-aware decision gating into a unified defensive framework. Extensive experiments on the Kaggle Credit Card Fraud Detection dataset demonstrate that RDA-LLM outperforms state-of-the-art LLM-based fraud detection models, including LLM40FD and LLM-MalDetect, across several key performance measures such as accuracy, precision, recall, false positive rate, and resistance to adversarial attacks. The results confirm that RDA-LLM provides enhanced resilience without prohibitive inference latency overhead, making it suitable for realtime deployment. This work contributes to enhancing the stability, security, and technological advancement of U.S. financial systems by developing secure, reliable, and scalable solutions that mitigate critical security vulnerabilities in LLM-based systems.},
  keywords={Integrated circuits;Circuits;Filtering;Feedback;Filters;Protocols;HTTP;Communication systems;Data communication;Radio access networks;Large Language Models (LLMs);Fraud Detection;Adversarial Machine Learning;Data Poisoning Attacks;Prompt Injection Defense;Financial Security;Resilient AI Architecture;Credit Card Fraud Detection;Cyber-Resilient Systems;U.S. Financial Systems},
  doi={10.1109/IC_ASET69920.2026.11502216},
  ISSN={},
  month={March},}@INPROCEEDINGS{11657880,
  author={Abughallous, Abdallah M. and Abufakher, Somia},
  booktitle={2026 IEEE Jordan Conference on Applied Electrical Engineering and Computing Technologies (AEECT)}, 
  title={SemGuard: A Triple-Anchor Semantic Security Gateway for Multilingual Prompt Attack Detection in Large Language Models}, 
  year={2026},
  volume={},
  number={},
  pages={143-147},
  abstract={The threat posed by adversarial prompts to large language models is becoming harder to ignore. Problems including prompt injection, jailbreaking, phishing, and Unicode-based attacks are now widespread. Most existing solutions protect against only one threat type, operate in English only, and provide no explanation for their decisions. We present SemGuard, a multilingual security gateway using Triple-Anchor Semantic Threat Modeling, which simultaneously evaluates each input against three semantic reference sets: attack, safe, and destructive. SemGuard detects four threat types concurrently in Arabic, Arabizi, and English. We expand the original Arabic Security Dataset from 319 to 807 validated examples across seven threat categories, using three independent LLM judges (GPT-4o, Grok-4, Llama 3.3 70B) achieving Fleiss' $\kappa=0.839$. After retraining on the expanded dataset, SemGuard achieves a mean F1-score of 0.989 and recall of 0.991, representing a 13.7% improvement over the original implementation. Analysis of 527 rejected examples reveals quantitative evidence of threat-category ambiguity, with impersonation exhibiting a 98.2% inter-judge disagreement rate, validating the necessity of the Triple-Anchor framework. This work also presents the first Arabic LLM security dataset with a formal LLM-as-Judge annotation protocol.},
  keywords={Modeling;Security;Multilingual;Large language models;Triples (Data structure);Printing;Phishing;Equations;Head;Signal detection;LLM Security;Prompt Injection;Jailbreak Detection;Arabic NLP;Semantic Security;Explainable AI;Triple-Anchor;Dataset Augmentation;LLM-as-Judge;Fleiss' Kappa;Harmful Content Detection},
  doi={10.1109/AEECT69724.2026.11657880},
  ISSN={2378-4911},
  month={July},}@INPROCEEDINGS{10755823,
  author={Muliarevych, Oleksandr},
  booktitle={2024 IEEE 17th International Conference on Advanced Trends in Radioelectronics, Telecommunications and Computer Engineering (TCSET)}, 
  title={Enhancing System Security: LLM-Driven Defense Against Prompt Injection Vulnerabilities}, 
  year={2024},
  volume={},
  number={},
  pages={420-423},
  abstract={This article examines cybersecurity vulnerabilities in systems utilizing Language Model Interfaces, focusing on the challenges of building secure systems. It provides an overview of current interfaces and their associated risks. A key contribution is the design of a prompt analysis and injection detection subsystem, which assesses input relevance and security. The integration of an additional Filter level in the system safeguards against prompt injection attacks by pre-processing user requests and post-processing responses. This level includes a Prompt Analyzer for input wrapping, and an Attack Validator module using the LLM to classify prompts. The study evaluates various prompt injection attacks across different system setups, including core GPT -3 and GPT-4 models without additional security layers, a Fuzzy Search method, and systems using an Attack Validator based on GPT-3 and GPT -4 models.},
  keywords={Fault tolerance;Search methods;Focusing;Market research;Distance measurement;Telecommunications;Time factors;Computer security;Wrapping;Cyberattack;language model;prompt injection attack;cybersecurity for LLMs;ChatGPT;security layer integration},
  doi={10.1109/TCSET64720.2024.10755823},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11454261,
  author={Kwon, Hyeokjin and Pak, Wooguil},
  booktitle={2026 International Conference on Artificial Intelligence in Information and Communication (ICAIIC)}, 
  title={Defending Against Prompt Injection Attacks Using Automatic System Prompt Engineering}, 
  year={2026},
  volume={},
  number={},
  pages={1200-1203},
  abstract={Large language models are vulnerable to jailbreak and prompt injection attacks, and most existing defenses rely on a single, human-crafted global system prompt. This paper proposes a method that automatically optimizes only the suffix of the system prompt on a per-cluster basis while keeping the model parameters and the global prefix fixed. We cluster attack prompts using k-means on the model's final hidden states, and, for each cluster, learn a suffix through an Analyzer-Rebuilder loop. In evaluations that combine an LLM judge with watermark-based detection, our method reduces the test attack success rate (ASR) from about 0.42 to $\text{0. 2 8}$.},
  keywords={Analytical models;Sensitivity analysis;Large language models;Clustering methods;Optimization methods;Benchmark testing;Prompt engineering;Prompt Injection Defense;Large Language Model;System Prompt;Clustering},
  doi={10.1109/ICAIIC68212.2026.11454261},
  ISSN={2831-6983},
  month={Feb},}@INPROCEEDINGS{10932638,
  author={Raj, Gaurav and Hamzah and Raj, Nikhil and Ranjan, Nikhil},
  booktitle={2025 2nd International Conference on Computational Intelligence, Communication Technology and Networking (CICTN)}, 
  title={Hacking LLMs: A Technical Analysis of Security Vulnerabilities and Defense Mechanisms}, 
  year={2025},
  volume={},
  number={},
  pages={555-560},
  abstract={Large Language Models (LLMs) such as GPT-4 and Google’s Gemini have revolutionized the landscape of artificial intelligence, enabling sophisticated natural language processing capabilities across diverse domains. However, the rapid adoption of these models has unveiled a spectrum of security vulnerabilities exploitable by adversaries [1], [2]. This paper presents a comprehensive analysis of various attack vectors targeting LLMs, including prompt injection, data poisoning, model inversion, and side-channel attacks. We examine real-world incidents and vulnerabilities discovered in widely-used LLMs like ChatGPT and Gemini [3], highlighting the intricate mechanisms through which these attacks compromise model integrity and user trust. Furthermore, we explore existing defense mechanisms and best practices, emphasizing runtime protection systems, adversarial training approaches, and robust access control systems [4], [5]. Building upon these foundations, we introduce a novel Multi-Layer Defense Framework with Dynamic Trust Scoring, designed to enhance the security and robustness of LLM deployments through dynamic evaluation and adaptive response systems. By dissecting recent advancements in LLM security research and proposing innovative defense strategies, this paper aims to guide the development of resilient defenses against the evolving landscape of AI-driven threats.},
  keywords={Training;Access control;Analytical models;Runtime;Large language models;Scalability;Side-channel attacks;Data models;Vectors;Protection;Large Language Models;LLM Security;Prompt Injection;Data Poisoning;Model Inversion;Side-Channel Attacks;Adversarial Training;Runtime Protection;Multi-Layer Defense Framework;Dynamic Trust Scoring},
  doi={10.1109/CICTN64563.2025.10932638},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11391215,
  author={Gosmar, Diego and Dahl, Deborah A. and Gosmar, Dario},
  booktitle={2025 3rd International Conference on Foundation and Large Language Models (FLLM)}, 
  title={Prompt Injection Detection and Mitigation with AI Multiagent NLP-based Agentic Frameworks}, 
  year={2025},
  volume={},
  number={},
  pages={923-930},
  abstract={Prompt injection is a significant challenge for generative AI systems because it can lead to unintended outputs. We introduce a Multiagent NLP-based experimental framework, specifically designed to address prompt injection vulnerabilities through layered detection and metadata mechanisms. The framework orchestrates specialized AI agents to generate responses, detect vulnerabilities, and mitigate injection effects. An empirical evaluation of 500 engineered injection prompts was conducted, with ten different prompt injection categories properly generated and shuffled (50 prompts for each injection attack category). The experimental results show a significant reduction in the injection score and an increased detection of prompt injection markers, indicating potential applications for mitigation. Novel metrics—including Injection Success Rate (ISR), Policy Override Frequency (POF), Prompt Sanitization Rate (PSR), and Compliance Consistency Score (CCS)—are proposed to derive a composite Total Injection Vulnerability Score (TIVS). The system utilizes the vendor-independent OFP (Open Floor Protocol) framework for agentic AI communication via structured JSON messages. It encapsulates APIs using natural language while also comparing and extending a previously established multiagent experiment on hallucination mitigation to address the specific challenges of prompt injection.},
  keywords={Optical fibers;Agentic AI;Protocols;Prevention and mitigation;Pipelines;Natural languages;Metadata;Security;Prompt engineering;Observability;Agentic AI;Prompt injection;multiagent systems;LLM security;AI interoperability;Prompt Engineering;AI Security},
  doi={10.1109/FLLM67465.2025.11391215},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11431088,
  author={Mamidwar, Piyush and Rajuarkar, Rani and Deshmukh, Niharika},
  booktitle={2025 International Conference on Computer and Applications (ICCA)}, 
  title={Beyond Individual Defenses: Evaluating Defense Combinations Against Prompt Injection Attacks}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Large Language Models process all input as natural language, creating a fundamental vulnerability: the inability to distinguish trusted instructions from untrusted user content. This architectural design—central to LLMs’ flexibility—simultaneously enables prompt injection attacks that manipulate model behavior through carefully crafted inputs. Despite the proliferation of defense mechanisms, a critical gap persists: defenses are evaluated in isolation, leaving practitioners without guidance for production deployments balancing security against latency and complexity.This paper presents the first systematic empirical evaluation of defense mechanism combinations. Testing 15 configurations against 50 diverse attacks, we reveal combined defenses outperform individual mechanisms by 18.5% (p<0.01), yet certain pairings waste resources without security gains. We identify three Pareto-optimal strategies: PromptShield + Spotlighting (78% defense success, 215ms), PromptShield + Instruction Hierarchy (75%, 245ms), and Perplexity Filter (55%, 85ms). However, even optimal combinations achieve only 78% effectiveness with 22% residual vulnerability, degrading under adaptive attacks. We provide evidence-based deployment guidelines and identify architectural challenges requiring instruction-data separation and adaptive orchestration for advancing LLM security.},
  keywords={Systematics;Large language models;Standards organizations;Natural languages;Production;Organizations;Machine learning;Security;Guidelines;Testing;Large Language Models;Prompt Injection;Jailbreaking;AI Security;Adversarial Attacks;RAG Systems;Machine Learning Security},
  doi={10.1109/ICCA66035.2025.11431088},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11430791,
  author={Syed, Toqeer Ali and Almutairi, Mishal Ateeq and Moaty, Mahmoud Abdel},
  booktitle={2025 International Conference on Computer and Applications (ICCA)}, 
  title={Cross-Agent Multimodal Provenance-Aware Framework for Robust Prompt Injection Defense in Large Language and Vision-Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Large Language Models (LLMs), VisionLanguage Models (VLMs), and new agentic AI systems (e.g., LangChain and GraphChain) allow autonomous systems to reason and plan, and to coordinate between an assortment of tools and agents. Nevertheless, this feature also brings vulnerability to multimodal prompt injection (PI) attacks, in which hidden or malicious instructions that are embedded in text, images, metadata, or interagent messages can spread throughout the agent graph, triggering unintended behavior or policy violation, or corrupting a state. To mitigate these threats, this paper will present a Cross-Agent Multimodal Provenance-Aware Defense Framework that will sanitize any user- or agent-generated prompts and validate the output of the LLM independently, prior to their delivery to downstream nodes. The framework incorporates a text sanitizer agent, visual sanitizer agent and an output validator agent which are synchronized by a provenance ledger which documents modality, source and trust metadata throughout the agent network. The architecture implements ordered trust boundaries, so that an injected instruction cannot spread out via LangChain- or GraphChain-style workflows. There are better multimodal PI detection accuracy, lower trust leakage between agents, and more stable agentic execution pathways, all of which are experimentalized. This framework can build secure, interpretable, and reliable agentic AI systems by augmenting the established provenance tracking and validation systems to multi-agent orchestration.},
  keywords={Agentic AI;Visualization;Large language models;Pipelines;Metadata;Nonhomogeneous media;Safety;Reliability;Synchronization;Multi-agent systems;Prompt Injection;Multi-Agent Systems;Provenance Tracking;LLM Security;Trust Validation;AI Safety},
  doi={10.1109/ICCA66035.2025.11430791},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11402845,
  author={Mishra, Anupama and Preet, Shiv and Gupta, Brij B. and Rawat, Satyendra Singh and Arya, Varsha and Katiyar, Vivek},
  booktitle={2025 5th International Conference on Internet of Things: Smart Innovation and Usages (IoT-SIU)}, 
  title={Mitigating Prompt Injection Attacks in ModelAgnostic Networks (MAN)}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Large Language Models (LLMs) are being used progressively in the fields like healthcare, finance, education, and cybersecurity. As they depend on natural language prompts, they are more prone to prompt injection attacks. Most traditional cyber-attacks are known and handled with latest defending tools and technology, however the prompt attacks impact severely the world. The attacks such as Jailbreaks, role overrides, and hidden injections are pretty good to steal private and personal information. The existing defense mechanisms use model-specific filters or expensive retraining, which makes them unreliable. We present MAP-Defense, a Model-Agnostic Prompt Attack Detection Framework founded on ModelAgnostic Networks (MAN). The framework includes preprocessing, semantic embedding analysis, context integrity checking, and policy enforcement to find prompts that are meant to be harmful while keeping the query’s fidelity. Tests on GPT-, BERT-, and T5-based models with more than 8,000 prompts show that MAP-Defense has an average precision of 91.7% and an F1-score of 90.5%, which is better than rule-based baselines. The results show that it can be scaled up, used with different models, and applied in real time, making it a strong defense against new prompt injection threats.},
  keywords={Training;Resistance;Technological innovation;Large language models;Semantics;Pipelines;Natural languages;Medical services;Real-time systems;Low latency communication;Prompt Injection;Model-Agnostic Networks;LLM Security;Adversarial NLP;Trustworthy AI},
  doi={10.1109/IOT-SIU65919.2025.11402845},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11694445,
  author={Ban, Qiucheng and Fu, Yun and Cao, Gang and Chen, Lin},
  booktitle={2026 2nd International Conference on Electronic Information, Computer and Aerospace Remote Sensing (EICARS)}, 
  title={SCD-Net: A Deep Semantic Contrastive Defense Network Against Prompt Injection in Power Grid LLMs}, 
  year={2026},
  volume={},
  number={},
  pages={277-280},
  abstract={The integration of Large Language Models (LLMs) into power grid Supervisory Control and Data Acquisition (SCADA) systems introduces unprecedented operational efficiencies but exposes critical infrastructure to stealthy prompt injection attacks. Conventional defenses, such as statistical gateways and general-domain perplexity filters, suffer from severe domain mismatches when applied to specialized industrial contexts, resulting in an irreconcilable trade-off between system usability and security. To address this fundamental limitation, we propose the Deep Semantic Contrastive Defense Network (SCD-Net). By projecting unstructured instructions into a normalized contrastive space, SCD-Net's fail-safe prototype mechanism accurately measures cosine disparities to intercept out-of-distribution (OOD) semantic camouflage attacks. Furthermore, we introduce PowerAdv, a large-scale, high-fidelity SCADA LLM security benchmark featuring zero-shot deceptive payloads. Extensive empirical evaluations demonstrate that SCD-Net effectively compresses the OOD Gateway Attack Success Rate (GASR) to a highly robust 16.42% while maintaining a near-zero In-Distribution False Positive Rate (ID FPR) of 0.39% and an exceptional OOD FPR of 11.97%, drastically outperforming existing baselines. Our framework provides a highly reliable zero-shot anomaly routing paradigm for securing intelligent middleware in critical infrastructure.},
  keywords={Modeling;Large language models;Security;Equations;Poles and zeros;Power grids;Prototypes;Filtering;Filters;Printing;Large Language Models;Prompt Injection;SCADA Security;Semantic Camouflage;Contrastive Learning;Zero-Shot Defense},
  doi={10.1109/EICARS71536.2026.11694445},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11755172,
  author={Sison, Branden and Al-Hamadani, Mustafa and Fernando, Brendan and Choubey, Parth and Elmorsy, Mohammed and Abougamila, Salwa},
  booktitle={2026 International Conference on Cybersecurity and AI-Based Systems (Cyber-AI)}, 
  title={A Hybrid LLM Firewall for Direct Prompt Injection and Instruction Smuggling Defense}, 
  year={2026},
  volume={},
  number={},
  pages={711-717},
  abstract={We present a Hybrid Large Language Model (LLM) firewall that integrates policy-based safeguards, a DeBERTa-v3 semantic classifier, and response verification into a unified defense against direct prompt injection and instruction smuggling. The firewall inspects each prompt before it reaches the target LLM, either rejecting it or allowing it to proceed through a two-stage screening pipeline. In the first stage, a policy-based filter detects prompt injection and data exfiltration attempts using rule- and keyword-driven checks, complemented by outbound filtering to mitigate leakage in generated responses. Prompts that pass this stage are then evaluated by our DeBERTa-v3-based model, which classifies requests based on inferred intent to capture smuggling attempts that may evade keyword triggers while maintaining intent-aware analysis. Experimental results demonstrate that the proposed hybrid approach improves instruction smuggling detection over policy-only and model-only baselines, while maintaining low false-positive rates through intent-aware classification.},
  keywords={Modeling;Large language models;Firewalls (computing);Encoding;Printing;Accuracy;Design methodology;Training;Security;Decoding;Artificial intelligence;firewall;hybrid firewall;Large Language Model;machine learning;Prompt injection},
  doi={10.1109/Cyber-AI70573.2026.11755172},
  ISSN={},
  month={Sep.},}@ARTICLE{11769714,
  author={Cao, Yang},
  journal={Artificial Intelligence Science and Engineering}, 
  title={Fuzzing Large Language Model Agents: A Taxonomy, Engineering Framework, and Evaluation Protocol}, 
  year={2026},
  volume={2},
  number={3},
  pages={295-310},
  abstract={Agents powered by large language models (LLMs) increasingly operate as closed-loop decision systems that retrieve external context and memory, plan actions, invoke tools, and alter environment state. This autonomy creates trajectory-level risks, including indirect prompt injection, memory poisoning, unsafe tool invocation, authorization violations, and erroneous environment-conditioned actions, which cannot be assessed adequately by prompt-level testing alone. This paper presents a taxonomy and engineering framework for fuzz-testing LLM-based agents. We formulate agent fuzzing as structured perturbation over user instructions, retrieved context, memory states, tool parameters, and environment feedback, and organize the design space by interaction surface, mutation strategy, execution environment, behavioral safety evaluator, and behavioral coverage objective. The framework integrates seed construction, semantics-aware mutation, trajectory-guided exploration, sandboxed execution, runtime monitoring, behavioral coverage feedback, risk scoring, and failure reproduction. A controlled study with 900 sandboxed trajectories across file-management, retrieval-augmented generation (RAG), email, and database scenarios illustrates the workflow. It shows that semantics-aware and state-guided mutation strategies uncover more testbed failures than rule-based mutation. We further discuss evaluator reliability, long-horizon testing, memory safety, multi-agent interactions, scalability, and external validity.},
  keywords={Fuzzing;Large language models;Memory;Modeling;Safety;Tools;Trajectory;Electronic mail;Printing;Testing;agentic AI safety;AI security;fuzz-testing;LLM-based agents;trajectory-level testing;indirect prompt injection;behavioral evaluation;tool invocation},
  doi={10.23919/AISE.2026.000016},
  ISSN={2097-5104},
  month={Sep.},}@INPROCEEDINGS{11364988,
  author={Yadav, Hritesh and Singh, Varun and Sharma, Kshitij},
  booktitle={2025 Seventh International Conference on Research in Computational Intelligence and Communication Networks (ICRCICN)}, 
  title={Adversial Prompt Injection in Large Language Models: Taxonomy, Exploits, and Mitigation Frameworks}, 
  year={2025},
  volume={},
  number={},
  pages={244-251},
  abstract={Adversarial prompt injection attacks pose a critical security threat to Large Language Models (LLMs) by manipulating model instructions through malicious inputs. In this paper, we present a comprehensive analysis of prompt injection vulnerabilities in LLMs. We develop a taxonomy encompassing direct, indirect, and multi-stage (chained) prompt injection attacks, detailing various exploits from simple “ignore previous instructions” overrides to covert multi-turn schemes. Through case studies and experimental evidence from recent literature, we demonstrate that even state-of-the-art models (e.g. GPT-4) can be consistently coerced into producing disallowed content, leaking confidential data, or executing unintended actions. We evaluate real-world risks via documented incidents (such as system prompt leaks and compromised LLM-integrated applications) and quantitative benchmarks, finding adversarial success rates exceeding $80 \%$ in many scenarios. To address these threats, we propose a defense-in-depth mitigation framework. Our framework combines prompt sanitization (input filtering and normalization), context isolation (segregating user input from system instructions and external data), and model hardening (enhanced alignment tuning and adversarial training) to substantially reduce injection success. We also outline practical defensive strategies including role-based privilege restriction, output validation, and continuous red-teaming. Finally, we discuss the broader implications of prompt injection for AI safety, ethics, and policy, and highlight directions for future work in building robust, secure LLM systems.},
  keywords={Training;Ethics;Filtering;Large language models;Prevention and mitigation;Taxonomy;Data models;Safety;Security;Tuning;Adversarial Prompt Injection;Large Language Models;Jailbreak Attacks;Taxonomy;LLM Security;Input Sanitization;Model Alignment;AI Safety},
  doi={10.1109/ICRCICN68210.2025.11364988},
  ISSN={2832-3645},
  month={Dec},}@INPROCEEDINGS{11526251,
  author={Hossain, S M Asif and Shayoni, Ruksat Khan and Ameen, Mohd Ruhul and Islam, Akif and Mridha, M. F. and Shin, Jungpil},
  booktitle={2025 IEEE International Women in Engineering (WIE) Conference on Electrical and Computer Engineering (WIECON-ECE)}, 
  title={A Multi-Agent LLM Defense Pipeline Against Prompt Injection Attacks}, 
  year={2025},
  volume={},
  number={},
  pages={207-212},
  abstract={Prompt injection attacks represent a major vulnerability in Large Language Model (LLM) deployments, where malicious instructions embedded in user inputs can override system prompts and induce unintended behaviors. This paper presents a novel multi-agent defense framework that employs specialized LLM agents in coordinated pipelines to detect and neutralize prompt injection attacks in real-time. We evaluate our approach using two distinct architectures: a sequential chain-ofagents pipeline and a hierarchical coordinator-based system. Our comprehensive evaluation on 55 unique prompt injection attacks, grouped into 8 categories and totaling 400 attack instances across two LLM platforms (ChatGLM and Llama2), demonstrates significant security improvements. Without defense mechanisms, baseline Attack Success Rates (ASR) reached $\mathbf{3 0 \%}$ for ChatGLM and 20 % for Llama2. Our multi-agent pipeline achieved 100 % mitigation, reducing ASR to 0 % across all tested scenarios. The framework demonstrates robustness across multiple attack categories including direct overrides, code execution attempts, data exfiltration, and obfuscation techniques, while maintaining system functionality for legitimate queries.},
  keywords={Modeling;Large language models;Pipelines;Automatic speech recognition;Printing;Architecture;Computer architecture;Taxonomy;Security;Filtering;Large Language Models;Prompt Injection;Multi-Agent Systems;Cybersecurity;AI Safety},
  doi={10.1109/WIECON-ECE69386.2025.11526251},
  ISSN={2837-8245},
  month={Dec},}@INPROCEEDINGS{11729999,
  author={Seyhan, Fadime Zeliha and Soleymanzadeh, Katira and Cengiz, Mustafa Oğuz and Ecevit, Alp and Arkhmammadova, Roya and Kaya, Elif Tansu},
  booktitle={2026 International Joint Conference on Neural Networks (IJCNN)}, 
  title={Assessing Defenses Against Prompt Injection Attacks in LLM Systems}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Prompt injection poses a critical security and compliance risk for large language model (LLM)-integrated systems. This paper treats prompt injection as a system-level governance challenge and introduces a model-agnostic guardrail architecture that performs prompt-level risk assessment prior to LLM inference. As a core component, we develop a dedicated prompt injection detector trained using Adaptive Layer LoRA on an in-house annotated dataset. Experiments across Gemma and Qwen model families show that baseline prompted LLMs exhibit unstable precision-recall tradeoffs and elevated false positive rates, while increasing prompt complexity alone does not improve robustness. In contrast, LoRA fine-tuned models achieve deployment-grade performance, reaching up to 99.05% accuracy with substantially reduced false positives, false negatives, and attack success rates.},
  keywords={Modeling;Large language models;Tuning;Printing;LoRa;Signal detection;Architecture;Computer architecture;Robustness;Training;Prompt Injection;Guardrail Systems;LLM Safety},
  doi={10.1109/IJCNN69854.2026.11729999},
  ISSN={2161-4407},
  month={June},}@INPROCEEDINGS{11568284,
  author={Qassim, Qais Saif and Mazumder, Dilwar},
  booktitle={2026 International Conference on Sustainable Engineering and Digital Innovation (ICSEDI)}, 
  title={Study the Effectiveness of Existing Detection Mechanisms Against Prompt Injection in LLMs}, 
  year={2026},
  volume={},
  number={},
  pages={1-8},
  abstract={Prompt injection attacks pose a significant security risk to large language models (LLMs) by allowing adversaries to manipulate model behavior through crafted inputs or external context. This paper presents a structured survey and comparative analysis of recent detection mechanisms for prompt injection attacks. Using a systematic review approach, relevant studies from 2023–2025 were identified, screened, and evaluated based on reported metrics, threat models, latency overhead, and deployment constraints. The survey categorizes detection approaches into syntactic, semantic, attention-based, and ensemble methods, highlighting their strengths, limitations, and practical trade-offs. Results show that recent semantic and ensemble detectors achieve high detection rates but often introduce additional latency, while attention-based methods offer deeper insight at the cost of requiring model internals. The paper concludes with best-practice recommendations and key research challenges for developing robust and scalable prompt injection detection strategies.},
  keywords={Modeling;Signal detection;Large language models;Printing;Security;Conferences;Syntactics;Detectors;Filtering;Filters;Prompt injection detection;large language models (LLMs);adversarial attacks;jailbreak attacks;semantic filtering;ensemble detection;LLM security evaluation},
  doi={10.1109/ICSEDI66420.2026.11568284},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11767142,
  author={Shewale, Krutika and Todgire, Srushti and Dadas, Ruturaj and Watti, Tushar and Sanap, Madhura and Wankhade, Shalini},
  booktitle={2026 IEEE World Skills Conference on Universal Data Analytics and Sciences (WorldSUAS)}, 
  title={Prompt Injection in LLMs: Taxonomy, Detection and Adaptive Defense Mechanisms}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Large Language Models (LLMs) and AI-based chat systems are now ubiquitous in commercial and research domains. Nevertheless, these systems can easily be fooled by a variety of malicious assaults. These attacks involve changing the instructions, modifying the role of the AI, stealing prompts, injecting unwanted information, and understanding the model’s structure, among other things. These kinds of attacks can break security rules. Make confidential information public. This survey looks at research on injection and manipulation attacks like prompt hacking and prompt leash. It also shows where we do not have information on this topic. A new framework has been made to give a name to a given prompt. The framework has steps like getting the prompt ready figuring out what it means looking at the risks making decisions and applying fixes. The survey also includes studies on attacks that use language come from big language models and are done by AI systems that work on their own. The goal is to make a tool that will help people make applications using intelligence in a safe way. Prompt injection is a form of input manipulation that could be used to get the AI to perform actions or return incorrect responses when they should not have. This survey will discuss injection and its application as an attack on AI, along with prompt injection and its countermeasures.},
  keywords={Modeling;Artificial intelligence;Large language models;Security;Printing;Signal detection;Agentic AI;Aluminum;Natural language processing;Filtering;Prompt Injection;Prompt Manipulation;LLM Security;Agentic AI;Risk Scoring;Adaptive Mitigation;Adversarial NLP;AI Safety;Instruction Override;Jailbreaking},
  doi={10.1109/WorldSUAS70880.2026.11767142},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11231998,
  author={ElSaify, Basma and Baderelden, Mohamed},
  booktitle={2025 2nd International Generative AI and Computational Language Modelling Conference (GACLM)}, 
  title={Adversarial and Multilingual Threats in Retrieval-Augmented Generation: From Prompt Injection to Model Exploitation}, 
  year={2025},
  volume={},
  number={},
  pages={155-162},
  abstract={Retrieval-Augmented Generation (RAG) systems have emerged as a cornerstone of modern generative AI by coupling large language models (LLMs) with external knowledge retrieval, thereby enabling more grounded, accurate, and context-aware outputs. Yet this paradigm simultaneously broadens the attack surface—extending vulnerabilities from generation into retrieval pipelines, language interfaces, and exposed APIs. In this paper, we propose a comprehensive threat taxonomy and adversarial framework targeting both conventional and agentic RAG systems, in which LLMs autonomously plan and execute multi-step tasks using retrieved knowledge. Our analysis spans a wide spectrum of adversarial techniques, including prompt injection, jailbreak exploits, API-driven model extraction, and multilingual prompt manipulation. Unlike prior work that primarily focuses on English-only vulnerabilities, we show that multilingual RAG pipelines—particularly those involving language blending (e.g., Arabic-English code-switching)—introduce novel attack vectors that bypass safety filters and induce unintended behaviors. To study these risks, we develop a multilingual adversarial benchmark suite that integrates both synthetic and real-world corpora across English, Arabic, and Spanish. Through systematic evaluation, we demonstrate how the retrieval layer not only amplifies leakage and inversion risks but also enables adversaries to infer system logic, extract private data from vector stores, and manipulate autonomous agent behavior through tool-integrated APIs. To mitigate these threats, we assess multiple defense strategies, including prompt sanitization, cross-lingual content filtering, retriever-stage anomaly detection, and behavior-based profiling of API interactions. Our findings reveal that existing safeguards are insufficient—particularly in agentic or low-resource language scenarios—underscoring the need for architecture-specific and multilingual defenses. This work fills a critical gap in GenAI security by presenting the first holistic, multilingual, and agent-aware security framework for RAG, offering actionable guidance for building robust and trustworthy generative AI applications across diverse linguistic and deployment contexts.},
  keywords={Filters;Generative AI;Large language models;Computational modeling;Retrieval augmented generation;Pipelines;Vectors;Multilingual;Security;Context modeling;Retrieval-Augmented Generation (RAG);Large Language Models (LLMs);Secure Generative AI;Agentic AI;Prompt Injection;Multilingual NLP;Multilingual Prompt Exploits;Generative AI Security;Model Extraction;Jailbreak Attacks;API Abuse;Contextual Prompt Injection;LLM Systems Defense Strategies;Trustworthy Generative AI and LLM Systems},
  doi={10.1109/GACLM67198.2025.11231998},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11652076,
  author={Bhavya and Ghazi, Mohd. Rehan and Nagpal, Rahul and Mandal, Shruti and Topwal, Shruti and Singh, Akhand Pratap},
  booktitle={2026 International Conference on NextGen Data Science and Analytics (ICNDSA)}, 
  title={Intelligent prompt injection attack detection using transformer and multi-layer perceptron architectures}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Large language models have been increasingly popular in many jobs in recent years, which has led to both new security challenges and opportunities. The main security concerns we can observe these days is prompt injection, which uses carefully constructed inputs to change the behavior of the model and may lead to violation of people privacy, misuse of data, or unstable systems. This study shows how to classify and identify different type of prompt injection attack types, this include act_as, safe prompts, and jailbreaking. In this research two models were used to detect the type of prompt that are transformers and Multi-layer perceptron (MLP).The hyperparameters were used to get maximum accuracy. The model’s performance was evaluated to see if it could effectively recognize various prompt types. The accuracy of both the models in the multi-classification challenge for identifying various prompt types was 99.0% and 99.3%. The outcomes unequivocally demonstrate the model’s performance in identifying various prompt types.},
  keywords={Modeling;Printing;Signal detection;Large language models;Conferences;Robustness;Security;Transformers;Machine learning;Training;Prompt injection;Large Language model;Multi-layer Perceptron;Transformers},
  doi={10.1109/ICNDSA68777.2026.11652076},
  ISSN={},
  month={April},}@INPROCEEDINGS{11536987,
  author={Güler, Songül Erdem and Aydın, Muhammed Ali},
  booktitle={2026 8th International Congress on Human-Computer Interaction, Optimization and Robotic Applications (ICHORA)}, 
  title={Visual and Structural Prompt Injection in Medical Rag Systems: a Comparative Robustness Analysis}, 
  year={2026},
  volume={},
  number={},
  pages={1-7},
  abstract={The integration process of Large Language Models (LLM) into the healthcare ecosystem is demonstrating a shift from cloud-based systems towards local (on-premise) and opensource Retrieval-Augmented Generation (RAG) architectures due to data privacy regulations such as GDPR and HIPAA. However, these architectures harbor critical vulnerabilities against indirect prompt injection attacks that target parsing gaps in the document processing layer and manipulate model behavior. In this study, the resilience of 6 distinct local models, including Llama-3, Gemma-3, and Meditron, against visual and structural injection vectors has been quantitatively and qualitatively analyzed. Within the scope of the study, visual-semantic mismatch (white-text), micro-typography, and metadata manipulation techniques were tested on $\mathbf{1 0 0}$ original clinical discharge summaries generated via Google Gemini 2.5 Flash and dynamic prompt engineering. In the threat model, the objective was to have the model diagnose a false septic shock and prescribe meropenem, a high-risk antibiotic with no clinical indication, by suppressing a stable patient profile (context suppression). Analyses involving a total of 2,400 unique experimental steps revealed that standard RAG parsers failed to detect visual payloads hidden from human perception, and the models could be manipulated with an average Attack Success Rate (ASR) of 47.78 %. The most significant finding of the study is the security asymmetry between models. While the generalpurpose Gemma-3 model exhibited the highest vulnerability with 96.33 % ASR, the Meditron-7B model, trained specifically for the medical domain, demonstrated superior resistance with 8.67 % ASR. The results indicate that domain-specific training establishes a natural security shield (inherent robustness) against injection attacks. On the other hand, the use of general-purpose models in clinical decision support processes without visual sanitization mechanisms poses serious risks in terms of patient safety.},
  keywords={Modeling;Printing;Visualization;Retrieval augmented generation;Security;Architecture;Computer architecture;Vectors;Large language models;Antibiotics;Indirect Prompt Injection;Medical RAG Systems;Healthcare AI Security;Adversarial Robustness;LLM Security;On-Premise LLMs;Visual Injection Attacks;Clinical Decision Support Systems},
  doi={10.1109/ICHORA69329.2026.11536987},
  ISSN={2996-4393},
  month={May},}@INPROCEEDINGS{11206147,
  author={Dubey, Shreyash R and Lamkuche, Hemraj Shobharam},
  booktitle={2025 International Conference on Emerging Information Technology and Engineering Solutions (EITES)}, 
  title={Breaking the Shield: Adversarial Jailbreak Attacks and Defense Mechanisms in Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={82-86},
  abstract={Large Language Models (LLMs) are increasingly used across diverse applications, raising security concerns, especially regarding jail-break attacks that bypass safety measures. This paper presents a systematic security evaluation of LLMs, exploring the effectiveness of jail-break detection methods, the security progression across model versions, the relationship between model size and vulnerability, and the impact of combined defense strategies. We evaluate both open-source (e.g., LLama, Mistral) and proprietary models (e.g., GPT-4) using four state-of-the-art attack techniques and three novel defenses. Our findings offer insights into the trade-offs between performance and safety in LLM deployment.},
  keywords={Systematics;Large language models;Robustness;Safety;Security;Information technology;LLM security;jailbreak attacks;prompt injection;hybrid defenses;model robustness},
  doi={10.1109/EITES66543.2025.00023},
  ISSN={},
  month={July},}@INPROCEEDINGS{11068353,
  author={Wang, Zhilong and Nagaraja, Neha and Zhang, Lan and Bahsi, Hayretdin and Patil, Pawan and Liu, Peng},
  booktitle={2025 55th Annual IEEE/IFIP International Conference on Dependable Systems and Networks - Supplemental Volume (DSN-S)}, 
  title={To Protect the LLM Agent Against the Prompt Injection Attack with Polymorphic Prompt}, 
  year={2025},
  volume={},
  number={},
  pages={22-28},
  abstract={LLM agents are widely used as agents for customer support, content generation, and code assistance. However, they are vulnerable to prompt injection attacks, where adversarial inputs manipulate the model’s behavior. Traditional defenses like input sanitization, guard models, and guardrails are either cumbersome or ineffective. In this paper, we propose a novel, lightweight defense mechanism called Polymorphic Prompt Assembling (PPA), which protects against prompt injection with near-zero overhead. The approach is based on the insight that prompt injection requires guessing and breaking the structure of the system prompt. By dynamically varying the structure of system prompts, PPA prevents attackers from predicting the prompt structure, thereby enhancing security without compromising performance. We conducted experiments to evaluate the effectiveness of PPA against existing attacks and compared it with other defense methods.},
  keywords={Degradation;Adaptation models;Codes;Particle separators;Manuals;Security;Multi-agent systems;Genetic algorithms;LLM;Prompt Injection},
  doi={10.1109/DSN-S65789.2025.00037},
  ISSN={2833-292X},
  month={June},}@INPROCEEDINGS{11670372,
  author={Lan, Qianlong and Kaul, Anuj and Jones, Shaun and Westrum, Stephanie},
  booktitle={2026 IEEE International Conference on Electro Information Technology (eIT)}, 
  title={Silent Egress: When Implicit Prompt Injection Makes LLM Agents Leak without a Trace}, 
  year={2026},
  volume={},
  number={},
  pages={071-076},
  abstract={Agentic large language model systems increasingly automate tasks by retrieving URLs and calling external tools. We show that this workflow gives rise to implicit prompt injection: adversarial instructions embedded in automatically generated URL previews, including titles, metadata, and snippets, can introduce a system-level risk that we refer to as silent egress. Using a fully local and reproducible testbed, we demonstrate that a malicious web page can induce an agent to issue outbound requests that exfiltrate sensitive runtime context, even when the final response shown to the user appears harmless. In 480 experimental runs with a qwen2.5:7b-based agent, the attack succeeds with high probability $(P(\text{egress})\ \approx 0.89)$, and 95% of successful attacks are not detected by output-based safety checks. We also introduce sharded exfiltration, where sensitive information is split across multiple requests to avoid detection. This strategy reduces single-request leakage metrics by 73% (Leak@1) and bypasses simple data loss prevention mechanisms. Our ablation results indicate that defenses applied at the prompt layer offer limited protection, while controls at the system and network layers, such as domain allowlisting and redirect-chain analysis, are considerably more effective. These findings suggest that network egress should be treated as a first-class security outcome in agentic LLM systems. We outline architectural directions, including provenance tracking and capability isolation, that go beyond prompt-level hardening.},
  keywords={Modeling;Tools;Security;Context;Printing;Large language models;Radio access networks;Regional area networks;Uniform resource locators;Surfaces;LLM security;Agentic Systems;Prompt Injection;Data Exfiltration;Network Egress},
  doi={10.1109/eIT68936.2026.11670372},
  ISSN={2154-0373},
  month={May},}@INPROCEEDINGS{11684636,
  author={Cao, Xin and Bao, Yiping},
  booktitle={2026 12th International Conference on Big Data and Information Analytics (BigDIA)}, 
  title={A Systematic Survey of Prompt Injection Attacks and Defenses in LLM-Integrated Applications and Agentic Systems}, 
  year={2026},
  volume={},
  number={},
  pages={16-26},
  abstract={Prompt injection (PI), listed as LLM01:2025 by OWASP, converts a data-representation problem into an execution-control problem: untrusted content is processed alongside privileged instructions, while large language models lack a native instruction/data boundary. Unlike jailbreaking, which primarily targets content-safety policies, PI targets application control flow and can induce unauthorized tool calls, information disclosure, or persistent-state corruption. This Systematization of Knowledge (SoK) studies PI from a provenance and information-flow perspective. It contributes (1) a three-tier attack taxonomy organized by contamination vector, attacker capability, and persistence; (2) a critical comparison of four defense lines and their trust assumptions; and (3) a cross-benchmark reporting audit together with Safe Utility Ratio (SUR), a metric for exposing security gains obtained by sacrificing task utility. We formalize PI as low-integrity data influencing high-integrity control flow, separate this integrity failure from subsequent confidentiality leakage, and identify evidence gaps in adaptive and stateful-agent evaluation.},
  keywords={Modeling;Tools;Security;Large language models;Printing;Memory;Electronic mail;Toxicology;Fluid flow;Conferences;Prompt Injection;LLM Security;Information-Flow Control;Agentic Systems;Defense Taxonomy;Undecidability;Safe Utility Ratio},
  doi={10.1109/BigDIA71496.2026.11684636},
  ISSN={2771-6902},
  month={Aug},}@INPROCEEDINGS{11746808,
  author={Tamilselvan, P and Aslam, M S Shuraim},
  booktitle={2026 International Conference on Secure IoT and Cybersecurity (ICOSICS)}, 
  title={Confidence-Guided Heterogeneous Detection for Jailbreak and Prompt Injection Attacks in Large Language Models}, 
  year={2026},
  volume={},
  number={},
  pages={1731-1737},
  abstract={The quick adaptation of Large Language Models (LLMs) into conversational agents, decision support systems, and enterprise systems has greatly enhanced human-computer interaction. Nevertheless, the advancement of adversarial prompting techniques such as jailbreaks and prompt injection poses potential risks to the security, reliability, and credibility of the model. Traditional methods to guard against adversarial prompting are mostly based on one type of detection method like rule-based filtering, transformer-based classifiers, or semantic similarities, thus rendering the defenses vulnerable against novel attacks that can exploit weaknesses in one particular defense method. In order to address this problem, this paper proposes a confidence guided heterogeneous detection approach to detect adversarial prompts prior to their execution by the targeted LLM. The system consists of three different detection modules: a rule-based pattern matching engine that identifies any attack signature, a fine-tuned RoBERTa classifier for contextual intent identification, and a semantic similarity engine for detecting paraphrased/adversarial prompts not seen before. The output of these heterogeneous modules are combined using a confidence guided fusion mechanism that adjusts the contribution of each detection module according to predefined confidence thresholds. The architecture is built on the basis of the following tools: Python, FastAPI, Hugging Face Transformers, Sentence-Transformers, and Scikit-learn. According to experimental results, the suggested architecture ensures increased robustness in the presence of adversarial prompts while keeping acceptable inference latency and good performance levels. The modularity of the architecture allows the easy integration of the architecture into existing LLM applications.},
  keywords={Modeling;Signal detection;Modules (abstract algebra);Large language models;Transformers;Training;Printing;Tuning;Architecture;Computer architecture;Large Language Models;Jailbreak Detection;Prompt Injection;AI Security;RoBERTa;Semantic Similarity;Heterogeneous Detection;Prompt Classification;Confidence-Guided Fusion;LLM Safety},
  doi={10.1109/ICOSICS70095.2026.11746808},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11023476,
  author={Liu, Yupei and Jia, Yuqi and Jia, Jinyuan and Song, Dawn and Gong, Neil Zhenqiang},
  booktitle={2025 IEEE Symposium on Security and Privacy (SP)}, 
  title={DataSentinel: A Game-Theoretic Detection of Prompt Injection Attacks}, 
  year={2025},
  volume={},
  number={},
  pages={2190-2208},
  abstract={LLM-integrated applications and agents are vulnerable to prompt injection attacks, where an attacker injects prompts into their inputs to induce attacker-desired outputs. A detection method aims to determine whether a given input is contaminated by an injected prompt. However, existing detection methods have limited effectiveness against state-of-the-art attacks, let alone adaptive ones. In this work, we propose DataSentinel, a game-theoretic method to detect prompt injection attacks. Specifically, DataSentinel fine-tunes an LLM to detect inputs contaminated with injected prompts that are strategically adapted to evade detection. We formulate this as a minimax optimization problem, with the objective of fine-tuning the LLM to detect strong adaptive attacks. Furthermore, we propose a gradient-based method to solve the minimax optimization problem by alternating between the inner max and outer min problems. Our evaluation results on multiple benchmark datasets and LLMs show that DataSentinel effectively detects both existing and adaptive prompt injection attacks. Our code and data are available at: https://github.com/liu00222/Open-Prompt-Injection.},
  keywords={Data privacy;Codes;Benchmark testing;Security;Optimization;llm defense;prompt injection},
  doi={10.1109/SP61157.2025.00250},
  ISSN={2375-1207},
  month={May},}@INPROCEEDINGS{11500704,
  author={Yadav, Mohit},
  booktitle={2025 3rd International Conference on Sustainable Computing and Smart Systems (ICSCSS)}, 
  title={The Role of Large Language Models in Cybersecurity: Strengths, Vulnerabilities, and Mitigation Strategies}, 
  year={2025},
  volume={},
  number={},
  pages={1983-1990},
  abstract={Large Language Models (LLMs) have transformed cybersecurity by enhancing threat detection, predictive analysis, and automated security response. These models analyse vast cybersecurity datasets, identify anomalies, and support real-time decision-making in applications such as phishing detection, malware classification, and intrusion detection. However, despite their advantages, LLMs pose critical risks, including adversarial attacks, data leakage, and biased decision-making. Cybercriminals actively exploit these vulnerabilities through prompt injection, model inversion, and misinformation generation. Traditional cybersecurity approaches rely on rule-based systems and signature-based detection methods, which struggle against evolving threats such as zero-day attacks and polymorphic malware. The increasing complexity and volume of cyber threats demand more adaptive solutions. Recent advancements in AI-driven security have integrated LLMs with deep learning (DL) techniques, improving detection accuracy and response efficiency. Transfer learning (TL), adversarial training, and fine-tuning techniques have enhanced the adaptability and robustness of LLM-based cybersecurity frameworks. This research explores the role of LLMs in cybersecurity, analysing their strengths, vulnerabilities, and mitigation strategies. It evaluates key challenges, including adversarial robustness, privacy risks, and model bias, while investigating AI-driven solutions to enhance security operations. Research highlights the effectiveness of LLMs in improving automated threat detection and response, with recommendations for enhancing model interpretability, mitigating security risks, and integrating hybrid AI frameworks to develop scalable cybersecurity solutions. By addressing the evolving domain of AI-driven cybersecurity, this research provides valuable insights into the optimization of LLMs for cyber threat detection, resilience against adversarial attacks, and the future of AI-enhanced security infrastructure.},
  keywords={Feeds;Antennas;Radio broadcasting;Frequency modulation;Filtering;System-on-chip;Filters;Circuits;Feedback;Application specific integrated circuits;Large Language Models;Cybersecurity;Threat Detection;Adversarial Attacks;Mitigation Strategies;AI-Driven Security},
  doi={10.1109/ICSCSS64956.2025.11500704},
  ISSN={},
  month={Aug},}@ARTICLE{11551573,
  author={Woesle, Christian and Buettner, Ricardo},
  journal={IEEE Access}, 
  title={A Systematic Literature Review of Prompt Injection Attacks in LLM-Integrated Systems}, 
  year={2026},
  volume={14},
  number={},
  pages={86797-86818},
  abstract={Prompt injection exploits a fundamental property of large language models: the inability to distinguish trusted instructions from untrusted content when both are processed as natural language tokens. As these models are integrated into tool-augmented and memory-enabled systems, the attack surface expands beyond the prompt interface, yet no existing review maps this landscape against standardised adversarial frameworks or analyses the balance between offensive and defensive research. This review follows the Preferred Reporting Items for Systematic Reviews and Meta-Analyses (PRISMA) guidelines. We searched IEEE Xplore, ACM Digital Library, and ScienceDirect for peer-reviewed studies published between 2015 and October 2025, yielding 89 included publications of which 81 form the analytical corpus. Aligned to the MITRE Adversarial Threat Landscape for AI Systems framework (version 5.4.0), each paper was coded along three axes: trust boundary, attacker objective, and research orientation with attacker objectives further classified into seventeen operational patterns aligned to MITRE ATLAS techniques. The corpus is dominated by research on the prompt interface and by two attacker objectives, Instruction Hijack and Policy Bypass, leaving underexplored boundaries lacking both attack characterization and defence proposals. This architectural narrowness does not reflect the multi-component architecture of production LLM systems. The three-axis framework and coded corpus establish a baseline for tracking how coverage evolves as deployment architectures expand. The concentration reflects a research incentive structure that favours reproducible prompt-level experiments over architecturally complex assessments at tool and memory boundaries. The field exhibits a maturity gradient in which defence development is concentrated at the prompt interface while other boundaries remain in early or absent characterization. The corpus treats prompt injection as a model-level property rather than a system-level vulnerability.},
  keywords={Conferences;Large language models;Licenses;Modeling;Nuclear facility regulation;Security;Codes;Tools;Reviews;Weighted sum model;Prompt injection;large language models;LLM security;trust boundaries;adversarial attacks;MITRE ATLAS;jailbreaking;attack-defence analysis;retrieval-augmented generation;systematic literature review},
  doi={10.1109/ACCESS.2026.3700492},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11743566,
  author={Yue, GuanJi and Li, Xiang and Liu, GuiTang},
  booktitle={2026 7th International Conference on Computer Engineering and Application (ICCEA)}, 
  title={CarrierGuard-Java: Carrier-Aware Zero-Trust Code Ingestion Defense for LLM-Assisted Static Analysis Alert Triage}, 
  year={2026},
  volume={},
  number={},
  pages={1023-1030},
  abstract={Traditional static application security testing (SAST) has long suffered in real-world projects from noisy alerts and high manual review costs. Although large language models (LLMs) can assist triage, they may mistake indirect prompt injections embedded in comments, Javadoc, and strings as high-priority instructions. This paper proposes CarrierGuard-Java, a zero-trust code ingestion architecture for already reported CodeQL alerts that constructs safe triage input packages for downstream models through carrier-aware scanning, risk-evaluator judgment, and line-stable reconstruction. We systematically compare this method against three baselines—raw, strip_comments, and regex_sanitize—on CWE-Bench-Java and decontaminated Juliet Java. The results show that CarrierGuard-Java improves the accuracy on positive samples in CWE-Bench-Java under suppression attacks from 0.8448 to 0.9138, and raises the accuracy on negative samples in Juliet under promotion attacks from 0.0294 to 0.3333, demonstrating that input-side guardrails are necessary and effective for LLM-assisted SAST triage.},
  keywords={Java;Modeling;Codes;Large language models;Security;Poles and zeros;Zero Trust;Printing;Natural languages;Labeling;LLM-assisted SAST;indirect prompt injection;alert triage;CodeQL;Java;carrier-aware defense;zero-trust code ingestion},
  doi={10.1109/ICCEA69962.2026.11743566},
  ISSN={2159-1288},
  month={May},}@INPROCEEDINGS{10971722,
  author={Alla, Srikar and Sichani, Ali Shiri},
  booktitle={SoutheastCon 2025}, 
  title={Cyberattacks on Large Language Models - Attack Detection and Architecture Adaptability}, 
  year={2025},
  volume={},
  number={},
  pages={143-148},
  abstract={Large Language Models (LLMs) like GPT and $PaLM$ have transformed natural language processing, enabling advancements in text generation, language translation, and conversational AI. However, their increasing adoption has exposed critical vulnerabilities, making them susceptible to cyberattacks such as prompt injection, data poisoning, and Distributed Denial of Service (DDoS) attacks. These threats compromise the security, reliability, and integrity of LLM applications in real-world scenarios. To mitigate these challenges, advanced defense mechanisms such as attack detectors and attack libraries play a crucial role. Attack detectors analyze input patterns and monitor model responses to identify anomalies and potential security breaches. These systems rely on attack libraries that act as structured repositories of predefined attack patterns, known exploits, and evolving threats. The attack library functions as a dynamic lookup table, enabling real-time vulnerability detection and rapid response to existing and novel threats. By integrating systematic vulnerability detection techniques and structured attack analysis, these mechanisms strengthen LLM security. Attack detectors and libraries provide a comprehensive approach to identifying, classifying, and mitigating security risks. This framework ensures the safe deployment of LLMs in various industries, strengthening their resilience and minimizing exposure to emerging cyber threats in sensitive applications.},
  keywords={Translation;Systematics;Large language models;Detectors;Libraries;Real-time systems;Security;Reliability;Computer crime;Resilience;Cyberattacks;LLM;Security;Threats;GPT},
  doi={10.1109/SoutheastCon56624.2025.10971722},
  ISSN={1558-058X},
  month={March},}@INPROCEEDINGS{11368582,
  author={Saklani, Sumit and Chohan, Deepak Kumar and Sharma, Raman and Varshney, Niharika and Gupta, Atika and Bagla, Piyush},
  booktitle={2025 IEEE 6th Global Conference for Advancement in Technology (GCAT)}, 
  title={LLM-Guarded Clouds: Leveraging Generative AI for Proactive Threat Hunting and Adaptive Defense in Hybrid Cloud Environments}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={The ability to scale within hybrid and multi cloud infrastructures enhances liquid resource availability, However, this also dramatically increases the attack surface, leaving trivially configured defenses completely obsolete, particularly for attack sophistication levels identified as low to mid. Deploying Large Language Models brings unique risks, such as prompt injection and exposing unreasoned system vulnerability gaps. This is the focus of the research: integrating LLM-Guarded Clouds with preemptive, nonlinear, adaptive threat defense hybrid cloud frameworks with strong attack surface generative AI. This LLM system manages multi-stage attacks with GNNs, feeds LLMs through Controlled Authoring Tier Restricted Processor/Graph-Reduced PAXs for reasoning Focused Inferencing, and applies federated learning within TEEs for classified, low-surveillance, and safe reasoning operationally secure LLM inferencing. Our analysis of the UNSW-NB15, CIC-IDS2018 and AWS CloudTrail logs demonstrates an accuracy rate 96.5%, F1 score of 95.4% and 3.4% false positive rate – outperforming ML, CNN-LSTM and LLM only baselines by almost 15%. Robustness testing indicates 72% improvement in adversarial resilience against prompt injection. Overall, LLM-Guarded Clouds improves accuracy, resilience, and explainability in detection, providing a novel automated defense solution for hybrid cloud environments.},
  keywords={Accuracy;Adaptive systems;Upper bound;Federated learning;Generative AI;Large language models;Hybrid power systems;Cognition;Graph neural networks;Resilience;Hybrid Cloud Security;Large Language Models (LLMs);Threat Hunting;Graph Neural Networks (GNNs);Retrieval-Augmented Generation (RAG);Federated Learning;Trusted Execution Environments (TEEs)},
  doi={10.1109/GCAT66372.2025.11368582},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11599973,
  author={Manoj, Neha and S G, Deepak and Pranav, Turala and Rajeev, Devi},
  booktitle={2026 Fourth International Conference on Secure Cyber Computing and Communications (ICSCCC)}, 
  title={Ensemble Deep Learning for Robust Prompt Injection Detection in Banking LLMs}, 
  year={2026},
  volume={},
  number={},
  pages={1254-1259},
  abstract={The threat of prompt injection to banking Large Language Model (LLM) systems is severe, as it allows malicious instructions to be injected, potentially leading to information leakage or unauthorized operations. Current solutions are mostly rule-based or single-model solutions, which are vulnerable to paraphrasing and domain-specific language. In this paper, a domain-aligned transformer ensemble is proposed, which combines logits from BERT, RoBERTa, and DistilBERT models, with SHAP-based token explanations to facilitate auditability. The model is trained on a carefully selected banking dataset of 154,374 samples, and it achieves 86.93% accuracy, 99.98% recall, and an F1 score of 88.43%. The high recall value ensures that there are very few missed injections, and SHAP explanations facilitate compliance-driven analysis of model outputs. Code and processing scripts are provided for reproducibility.},
  keywords={Modeling;Printing;Banking;Signal detection;Transformers;Large language models;Bit error rate;Robustness;Training;Security;Prompt Injection;Large Language Models;Banking Security;Transformer Ensemble;SHAP Explainability;Adversarial Evaluation;Cybersecurity},
  doi={10.1109/ICSCCC69031.2026.11599973},
  ISSN={},
  month={May},}@INPROCEEDINGS{11689044,
  author={Wadibhasme, Sanz and Abhyankar, Janvi and Tikale, Vanshika and Shingote, Atharva and Bhasme, Shreeya and Hajare, Shital},
  booktitle={2026 7th International Conference On Computational Vision and Bio Inspired Computing (ICCVBIC)}, 
  title={Semantic Consistency Drift Monitoring for Training-Free Adversarial Prompt Injection Detection in Agentic LLM Pipelines}, 
  year={2026},
  volume={},
  number={},
  pages={1444-1449},
  abstract={Large language model (LLM) agents that autonomously retrieve external content and execute multi-step action plans are increasingly deployed in enterprise and safetycritical settings. This architecture exposes a critical attack surface: adversarial content embedded within retrieved documents can silently redirect agent behavior away from the original user intent—a threat known as prompt injection. Existing defenses rely on keyword filtering, fine-tuned classifiers, or full model access, making them brittle against semantically obfuscated payloads and costly to deploy. We propose the Semantic Consistency Drift Monitor (SCDM), a training-free, model-agnostic detection framework that measures the cosine distance between latent semantic representations of the agent's pre-retrieval goal statement and its post-retrieval action plan. A statistically significant divergence beyond a calibrated threshold signals a potential injection. We evaluate SCDM on a controlled corpus of 40 samples spanning 15 operational domains across 20 adversarial scenarios. SCDM achieves an ROC-AUC of 0.7950, an F1-score of 0.7907, precision of 0.7391, and recall of 0.8500, with an inference latency of 1.22 ms per decision. Statistical analysis confirms strong class separation (Cohen's $d=1.19, p<0.001$). SCDM outperforms Jaccard bag-of-words (AUC $=0.715$), raw TF-IDF cosine $(\mathbf{A U C}=\mathbf{0. 7 7 3})$, and random baselines (AUC $=\mathbf{0. 5 4 5}$), while requiring no model retraining, no API access, and no labeled injection corpus. These results establish semantic consistency probing as a practical, lightweight safety primitive for agentic AI deployments.},
  keywords={Modeling;Planning;Large language models;Printing;Labeling;Signal detection;Cleaning;Pipelines;Monitoring;Safety;prompt injection;agentic AI;LLM security;semantic drift;AI safety;retrieval-augmented generation},
  doi={10.1109/ICCVBIC71195.2026.11689044},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11308512,
  author={Depuru, SivaKumar and Lakshmi, Kurugunda Radha and Chandrahas, Gopa and Chetana, Mopuri and Reddy, Madduri Vinay Krishna},
  booktitle={2025 International Conference on Sustainable Communication Networks and Application (ICSCN)}, 
  title={Adaptive and Privacy-Preserving Detection of Evolving Prompt Injection Attacks in Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={1445-1450},
  abstract={Large Language Models (LLMs) have demonstrated impressive abilities but are extremely vulnerable to prompt injection attacks where malicious inputs bypass the intended instructions, bypass safety mechanisms, or leak sensitive data. Current defences have two severe shortcomings: they are fixed and unresponsive to new attack techniques like obfuscation and multi-turn manipulation, and frequently they impact the privacy of the user by sending unprocessed queries to third-party validation services. Such constraints render existing solutions inappropriate to real-world, privacy-aware activities. This research suggests a privacy-sensitive and adaptive detection architecture that combines continual learning and context-sensitive embeddings, and federated detection pipelines. The framework becomes flexible to new adversarial actions and provides local data confidentiality. According to experimental findings, the detection accuracy is 94.8% and the false positive rate is 4.1, which is higher than that of baseline methods, meanwhile, the obfuscation attack and multi-turn attacks are detected more, with gains of 12.4 and 15.7 percentage points respectively, and latency is real-time (112 ms/query). The model provides a measurable and reliable framework of securing systems powered by LLM.},
  keywords={Resistance;Continuing education;Data privacy;Steganography;Accuracy;Large language models;Semantics;Pipelines;Vectors;Safety;Large Language Models (LLMs);Prompt Injection Attacks;Privacy-Preserving Machine Learning;Continual Learning;Federated Detection;Adversarial Robustness},
  doi={10.1109/ICSCN67106.2025.11308512},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11554850,
  author={P, Pramila and T, Nadana Ravishankar},
  booktitle={2026 7th International Conference on Intelligent Communication Technologies and Virtual Mobile Networks (ICICV)}, 
  title={Intelligent Multi-Agent Reinforcement Sanitizer for Securing LLM Systems}, 
  year={2026},
  volume={},
  number={},
  pages={1720-1727},
  abstract={LMs are increasingly vulnerable to prompt poisoning, where adversarial instructions cause the model to behave unexpectedly. Current defense mechanisms have been inadequate against attacks that are paraphrased or in another language, as well as against multimodal or multi-turn attacks, and generally lack reliable mechanisms for protecting hidden prompts from the system. This paper describes IMARS, a new multi-agent defense pipeline designed to help defend against prompt poisoning of large language models (LLMs). IMARS integrates multiple elements, including semantic contrastive detection, attention-based anomaly scoring, cryptographic integrity verification, iterative sanitization, temporal analysis, and explainability, to form a new pipeline to protect LLMs. IMARS integrates text and OCR inputs to provide multimodal data for the inspection, while also using drift-aware contextual reasoning to detect changes in attack patterns over time. The goal of IMARS is to create a reliable, near real-time, and interpretable security framework that improves LLM safety against sophisticated prompt poisoning attacks while allowing for transparency in the decision-making process. Experimental validation of IMARS effectiveness in the detection and mitigation of sophisticated prompt injection attempts has shown success across a variety of attack conditions.},
  keywords={Modeling;Signal detection;Large language models;Multilingual;Toxicology;Timing;Transformers;Modules (abstract algebra);Security;Printing;Prompt Injection;LLM Security;Multimodal Attacks;Multi-Agent Systems;AI Safety},
  doi={10.1109/ICICV68925.2026.11554850},
  ISSN={},
  month={May},}@INPROCEEDINGS{11395786,
  author={Vinay, Vaishali},
  booktitle={2026 IEEE 5th International Conference on AI in Cybersecurity (ICAIC)}, 
  title={Jailbreaking Large Language Models: Techniques, Trends, Defenses, and Open Challenges}, 
  year={2026},
  volume={},
  number={},
  pages={1-8},
  abstract={Large language models (LLMs) are rapidly becoming embedded in everyday applications, security workflows, and decision-support systems. Along with their capabilities, we have also seen a rise in techniques aimed at bypassing their guardrails. This paper presents a consolidated analysis of recent jailbreaks attacks and groups them into three high-order categories based on their underlying mechanism. Unlike prior surveys, this work introduces a mechanism-grounded taxonomy and an explicit attack-to-defense mapping that unifies cognitive, representational, and system-level jailbreak pathways. We highlight the emerging trends that make modern jailbreaks more effective and discuss where current defenses tend to fail in practice. Building on these insights, we outline practical, engineering-focused best practices to lower jailbreak risk in deployed systems. The paper closes with key open challenges—from benchmark gaps to reproducibility issues and agentic safety—that must be addressed to build more robust and dependable LLM safety architectures.},
  keywords={Surveys;Large language models;Prevention and mitigation;Taxonomy;Pipelines;Market research;Reproducibility of results;Safety;Windows;Standards;jailbreak;LLM;adversarial prompting;agentic systems;defense mechanisms;prompt injection;llm vulnerabilities},
  doi={10.1109/ICAIC67076.2026.11395786},
  ISSN={},
  month={Feb},}@ARTICLE{11405858,
  author={Shao, Yangguang and Yu, Jiahao and Miao, Hanwen and Gou, Gaopeng and Li, Zhen and Shi, Junzheng},
  journal={IEEE Transactions on Information Forensics and Security}, 
  title={PromptFuzz: Harnessing Fuzzing Techniques for Robust Testing of Prompt Injection in LLMs}, 
  year={2026},
  volume={21},
  number={},
  pages={2727-2741},
  abstract={Large Language Models (LLMs) have gained widespread use in various applications due to their powerful capability to generate human-like text. However, prompt injection attacks, which involve overwriting a model’s original instructions with malicious prompts to manipulate the generated text, have raised significant concerns about the security and reliability of LLMs. In this paper, we propose PromptFuzz, a novel testing framework that leverages fuzzing techniques to systematically assess the robustness of LLMs against prompt injection attacks. Inspired by software fuzzing, PromptFuzz selects promising seed prompts and generates a diverse set of prompt injections to evaluate the target LLM’s resilience. PromptFuzz operates in two stages: the prepare phase, which involves selecting promising initial seeds and collecting few-shot examples, and the focus phase, which uses the collected examples to generate diverse, high-quality prompt injections. By deploying the generated attack prompts from PromptFuzz in a real-world competition, we achieved the 7th ranking out of over 4000 participants (top 0.14%) within 2 hours, demonstrating PromptFuzz’s effectiveness compared to experienced human attackers. Additionally, we also deploy the generated attack prompts on 50 popular LLM-integrated online applications, including those from Coze and OpenAI, and found that 92% of them can be exploited by PromptFuzz. We also run PromptFuzz on 15 online LLM-based resume judging applications and found that 13 of these applications’ responses can be hijacked by PromptFuzz.},
  keywords={Fuzzing;Robustness;Security;Testing;Closed box;Manuals;Large language models;Transformers;Resumes;Natural language processing;Prompt injection;fuzzing;large language model;red teaming},
  doi={10.1109/TIFS.2026.3666893},
  ISSN={1556-6021},
  month={},}@INPROCEEDINGS{11635191,
  author={Jiang, Junyong},
  booktitle={2026 11th International Symposium on Advances in Electrical, Electronics and Computer Engineering (ISAEECE)}, 
  title={Runtime Protection Practice for LLM Agent Security: An On-Demand Behavioral Sandbox Approach}, 
  year={2026},
  volume={},
  number={},
  pages={587-590},
  abstract={Large language model (LLM) agents with toolcalling capabilities are exposed to execution-level security risks because tool actions may produce OS-level side effects before the final textual response is generated. Existing defenses mainly rely on semantic filtering, runtime rule enforcement, or permission control, but they do not explicitly verify the OS-level side effects of a pending action before real execution. This paper presents a runtime protection framework that incorporates an on-demand behavioral sandbox into the LLM-agent tool-execution workflow. When an action is evaluated as ambiguous or high-risk, it is first executed in an isolated sandbox, where its file, network, process, and privilege-related effects are monitored; only actions that pass this inspection are released to the real environment. In our evaluation on 200 high-risk tasks drawn from LITMUS and AgentDojo, the full framework reduces the execution hallucination rate (EHR) to 0.0%, with a total median latency of 660 ms and an additional sandbox-induced latency of about 350 ms compared with the two-layer variant.},
  keywords={Tools;Large language models;Runtime;Permission;Printing;Electronic mail;Protection;Security;Monitoring;LLM agent security;prompt injection;execution hallucination;behavioral sandbox;runtime protection},
  doi={10.1109/ISAEECE70502.2026.11635191},
  ISSN={},
  month={June},}@INPROCEEDINGS{11103606,
  author={Lan, Qianlong and Kaul, Anuj and Jones, Shaun and Westrum, Stephanie and Pandurangan, Vinothini and Das Pattanaik, Nishant Kumar and Pattanayak, Piyush},
  booktitle={2025 IEEE International Conference on Electro Information Technology (eIT)}, 
  title={Hybrid Constitutional Classifiers for Prompt Injection Defense}, 
  year={2025},
  volume={},
  number={},
  pages={225-229},
  abstract={In this paper, we propose a novel hybrid constitutional classifier system that combines a lightweight input classifier with a fine-tuned generative LLM to enhance security while maintaining efficiency. Our approach integrates a DeBERTa-based classifier for filtering adversarial prompts before they reach the model and a small LLM that performs response monitoring to prevent unsafe completions in real time. Through extensive benchmarking, we demonstrate that our hybrid approach effectively mitigates adversarial inputs while significantly reducing inference latency compared to large-scale models like LLaMA-2 13B. We further explore optimization techniques such as model quantization and knowledge distillation to improve system performance with minimal degradation in classification accuracy. Our results indicate that the hybrid system achieves detection accuracy of 96.97% for inputs and 78.79% for the outputs, maintaining robust safe filtering capabilities while offering 67% lower latency in overall compared to conventional large LLM classifiers. The deployment of a hybrid constitutional classifier system for real-time AI applications enhances LLM security by providing a scalable, high-performance defense against prompt injection attacks, enabling safer AI interactions in critical domains.},
  keywords={Degradation;Adaptation models;Accuracy;Quantization (signal);Filtering;Benchmark testing;Real-time systems;Security;Low latency communication;Optimization;Prompt Injection Defense;Constitutional Classifier;Lightweight Language Models},
  doi={10.1109/eIT64391.2025.11103606},
  ISSN={2154-0373},
  month={May},}@ARTICLE{11359704,
  author={Damacena Duarte, Jaqueline and Cândido, Guilherme D. and De Britto Filho, José Ricardo A. and Souza Neto, João and Da Costa, Elena J. and Da Costa, João Paulo Javidi and Peotta De Melo, Laerte},
  journal={IEEE Access}, 
  title={A Systematic Review of Prompt Injection Attacks on Large Language Models: Trends, Taxonomy, Evaluation, Defenses, and Opportunities}, 
  year={2026},
  volume={14},
  number={},
  pages={12875-12899},
  abstract={Large Language Models (LLMs) are increasingly integrated into various infrastructure and interactive applications. However, their inherent linguistic flexibility introduces security vulnerabilities, particularly through Prompt Injection (PI) attacks. This systematic review provides a comprehensive synthesis of the evolving landscape of PI attacks, including their development trends, classification schemes, evaluation methodologies, defense strategies, and areas for future research. We analyze the evolution of attacks from basic natural language overrides to complex multi-turn manipulations, indirect injections using structured formats such as JSON and XML, and tool-assisted exploits involving automated prompt generation and multi-modal inputs like images. PI attacks are categorized by the level of manipulation, including character, word, sentence, and semantic levels, and by adversarial intent, such as prompt leaking and harmful content generation. The study analyzes these techniques within different LLM architectures and application contexts, including machine translation and Chain of Thought reasoning. It also reviews common evaluation benchmarks, datasets, and metrics. Mitigation strategies examined include automated red teaming frameworks, input validation, content filtering, and alignment through training. It differentiates itself from previous works by conducting a systematic review specifically focused on immediate injection, organizing its attacks, defenses and research gaps. Finally, this review identifies major research challenges and suggests critical directions for improving LLM safety and robustness.},
  keywords={Artificial intelligence;Cognition;Transformers;Prompt engineering;Security;Large language models;Training;Safety;Computational modeling;Training data;Large language models (LLMs);prompt attack;prompt injection;artificial intelligence;security},
  doi={10.1109/ACCESS.2026.3656849},
  ISSN={2169-3536},
  month={},}@ARTICLE{11207588,
  author={Emekci, Hakan and Budakoglu, Gülsüm},
  journal={IEEE Access}, 
  title={Securing With Dual-LLM Architecture: ChatTEDU an Open Access Chatbot’s Defense}, 
  year={2025},
  volume={13},
  number={},
  pages={183156-183170},
  abstract={Open access chatbots face escalating cybersecurity risks due to adversarial exploitation. This paper presents the case of ChatTEDU, a dual-LLM architecture designed to protect open-access AI systems from sophisticated adversarial attacks while maintaining the user experience quality. During a two-month deployment at TED University, we analyzed 4501 unique real-world interactions, including 180 malicious attempts targeting the system through prompt injection, jailbreaking, and content manipulation attacks. Our dual-layer security approach separates content moderation from response generation by using two specialized language models. The first model (LLM-1) acts as a security filter, analyzing incoming queries for threats, whereas the second model (LLM-2) generates educational responses only after validation. This architecture successfully blocked 100% of the identified attacks, with only 0.28% false positives, demonstrating robust protection without compromising legitimate educational interactions. The system handles over 100 concurrent users during peak registration periods without security breaches or performance degradation. Attack analysis of the case revealed that 77.8% of the threats used technical exploitation rather than content-based manipulation, with multilingual attacks comprising 15% of the attempts. The dual-LLM approach introduced only 18% latency overhead, while providing comprehensive protection against prompt injection, jailbreaking, spam insertion, and denial-of-service attacks. This study provides practical guidance for implementing robust security measures in public-faced AI deployments worldwide.},
  keywords={Security;Chatbots;Microservice architectures;Vectors;Retrieval augmented generation;Protection;Prevention and mitigation;Open Access;Large language models;Databases;Adversarial attacks;artificial intelligence security;open access chatbot security;large language models;prompt injection},
  doi={10.1109/ACCESS.2025.3623268},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11233258,
  author={AlSobeh, Anas and Gwarzo, Zahraddeen and Shatnawi, Amani},
  booktitle={2025 International Conference on Cybersecurity and AI-Based Systems (Cyber-AI)}, 
  title={ShadowPlay: Engineering Defenses Against Role-Based Prompt Injection and Dependency Hallucination in LLM-Powered Development}, 
  year={2025},
  volume={},
  number={},
  pages={317-325},
  abstract={Large Language Models (LLMs) have revolutionized software development by providing intelligent code generation and assistance capabilities. However, their integration into development workflows introduces critical security vulnerabilities that traditional cybersecurity measures fail to address. This paper presents ShadowPlay, a novel multi-layered defense framework specifically engineered to detect and mitigate two emerging threat vectors: role-based prompt injection attacks and dependency hallucination vulnerabilities. Our approach combines formal verification techniques with Machine Learning (ML)-based behavioral analysis to create a comprehensive security solution. The framework employs four integrated components: a semantic prompt analysis engine, a real-time dependency verification system, a behavioral monitoring module, and a response validation layer. Through extensive evaluation on over 20,000 attack scenarios across diverse threat categories, ShadowPlay demonstrates superior performance with 95.1% overall accuracy, 97.2% precision, and only 1.8% false positive rate, while maintaining an average response latency of 127 milliseconds. Our contributions include the first formal mathematical model for these attack vectors, a production-ready defense architecture, and comprehensive empirical validation demonstrating significant improvements over existing approaches.},
  keywords={Large language models;Semantics;Machine learning;Vectors;Software;Real-time systems;Mathematical models;Computer security;Monitoring;Software development management;Large Language Models;Prompt Injection;Software Security;ML Security;Dependency Management;Behavioral Analysis},
  doi={10.1109/Cyber-AI66431.2025.11233258},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11391009,
  author={Thaqi, Rrezearta and Martiri, Edlira and Rexha, Blerim},
  booktitle={2025 3rd International Conference on Foundation and Large Language Models (FLLM)}, 
  title={A Real-Time Framework for Prompt Injection Attacks Detection on Cloud-Hosted Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={718-723},
  abstract={This paper addresses the emerging threat of prompt injection attacks in cloud-hosted large language models (LLMs). These attacks manipulate LLM inputs, causing models to reveal sensitive information, generate harmful outputs, or perform unauthorized actions, significantly undermining data security and user trust. To counteract these threats, we introduce a real-time, modular detection framework that leverages advanced machine learning and natural language processing techniques. Our approach classifies input prompts as benign or malicious using a lightweight DistilBERT-based model, deployed on AWS SageMaker for scalable, low-latency inference. When malicious prompts are identified with high confidence, they are blocked at the gateway layer before reaching the LLM runtime, and structured telemetry events are forwarded to CloudWatch for alerting and auditing. Extensive evaluations in a realistic AWS environment demonstrate that DistilBERT not only exceeds the precision of larger state-of-the-art transformers (such as BERT-base, RoBERTa-large, and DeBERTa-v3) but also provides significantly lower inference latency and reduced deployment costs compared with traditional machine learning algorithms. The system design ensures extensibility, seamless integration with cloud-native services, and supports explainability, as well as potential future enhancements such as reinforcement learning-based adaptive detection. The proposed framework thus offers a practical and reliable defense mechanism against evolving adversarial threats, thereby strengthening the security posture and fostering trust in cloud-based AI technologies across various industries.},
  keywords={Runtime;Machine learning algorithms;Large language models;Machine learning;Transformers;Real-time systems;Natural language processing;Telemetry;Reliability;System analysis and design;prompt injection;LLM;security;cloud;AI},
  doi={10.1109/FLLM67465.2025.11391009},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11745232,
  author={Yılmaz, Şule and Bilgin, Ahmet Faruk and Özçam, Berkay and Aydın, Muhammed Ali},
  booktitle={2026 11th International Conference on Computer Science and Engineering (UBMK)}, 
  title={Deep Learning-Based Detection of Prompt Injection Attacks in Turkish Inputs}, 
  year={2026},
  volume={},
  number={},
  pages={60-65},
  abstract={Large Language Models (LLMs) are increasingly deployed across critical domains such as software development, education, healthcare, finance, and cybersecurity. However, their rapid adoption has introduced novel security risks, particularly prompt injection attacks, in which adversarial inputs are used to manipulate system instructions and bypass safety mechanisms. While existing detection studies have predominantly focused on English- language datasets, Turkish-language cybersecurity resources remain scarce, and direct translation methods often compromise the semantic integrity of technical terminology in morphologically rich languages such as Turkish. To address these gaps, this study proposes a data-driven detection methodology that evaluates seven model configurations. These configurations combine TF-IDF and BERT-based vectorization strategies with classical classifiers (Logistic Regression, XGBoost, CatBoost) as well as a fine-tuned Transformer model for detecting prompt injection attacks in Turkish natural language inputs. A hybrid Turkish dataset consisting of 3,096 samples, comprising 1,570 malicious and 1,526 benign prompts, was constructed by combining open-source datasets, platform-based web scraping from Reddit and Discord, and synthetic generation methods. To mitigate semantic degradation during translation, a novel technical term masking algorithm was developed, which identifies cybersecurity-specific terms and preserves them through controlled substitution prior to multilingual translation. The fine-tuned BERTurk (dbmdz/bert-base-turkish-cased) model achieved a mean accuracy of 95.57% and a mean F1-score of 95.59% under 5-fold cross-validation, consistent with the 95.37% F1- score obtained on the held-out test set. Among classical configurations, BERT Embedding combined with Logistic Regression attained the highest F1-score of 92.11% under 5-fold cross-validation. Five of the seven evaluated configurations surpassed the existing Turkish baseline of 87% F1-score reported in the literature, demonstrating that high- quality, language-aware datasets combined with targeted preprocessing strategies can substantially advance cybersecurity-oriented NLP for morphologically complex languages.},
  keywords={Modeling;Bit error rate;Signal detection;Large language models;Security;Architecture;Computer architecture;Computer security;Printing;Manuals;cybersecurity;large language model;natural language processing;prompt injection},
  doi={10.1109/UBMK71847.2026.11745232},
  ISSN={2521-1641},
  month={Sep.},}@INPROCEEDINGS{11130138,
  author={Jadhav, Gaurav and Singh, Amit Kumar and Khanam, Zeba and Hercock, Robert},
  booktitle={2025 IEEE International Conference on Cyber Security and Resilience (CSR)}, 
  title={A Novel GNN-based Approach for Detection of Prompt Injection Attacks}, 
  year={2025},
  volume={},
  number={},
  pages={77-82},
  abstract={Prompt injection attacks manipulate language model inputs to bypass intended constraints, extract sensitive information, or generate misleading responses, posing a significant security risk in real-world applications. To address this challenge, we propose a Graph Neural Network (GNN)based approach that integrates sentiment features and Bidirectional Encoder Representations from Transformers (BERT) embeddings to effectively detect malicious prompt injections. By transforming textual data into structured graph representations, our approach captures both semantic and contextual relationships that conventional models often overlook. We evaluated our approach against traditional machine learning techniques, including Random Forest, Logistic Regression, and XGBoost, demonstrating its superior performance. Experimental results show that our approach achieves a high detection accuracy of $98.70 \%$ and an F1-score of 0.9799, significantly outperforming conventional methods. Additionally, we provide an in-depth analysis of computational efficiency, highlighting the trade-offs between detection effectiveness and model complexity, ensuring a practical balance between security and performance.},
  keywords={Training;Logistic regression;Accuracy;Large language models;Semantics;Feature extraction;Transformers;Graph neural networks;Computational efficiency;Random forests;GNN;Random Forest;GPT-4;Prompt Injection;Neural Network;Large Language Model;BERT;Semantic analysis;Sentiment Analysis},
  doi={10.1109/CSR64739.2025.11130138},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11739836,
  author={Wang, Ju},
  booktitle={2026 7th International Conference on Intelligent Computing and Human-Computer Interaction (ICHCI)}, 
  title={Knowledge-Guided Adversarial Modeling of Prompt Injection Attacks for Power Generation Safety Large Language Models}, 
  year={2026},
  volume={},
  number={},
  pages={128-131},
  abstract={Large language models (LLMs) have been increasingly applied in power generation safety scenarios, including regulation retrieval, operational assistance, and risk analysis. However, the open-ended interaction mechanism of LLMs introduces new security risks. Prompt injection attacks can manipulate input instructions to bypass safety constraints and induce models to generate unreliable responses. To address the limitations of existing prompt injection attack generation methods, including insufficient domain knowledge utilization, weak scenario authenticity, and ineffective perturbations during optimization, this paper proposes KTA-Prompt, a knowledge-guided adversarial framework for prompt injection attack sample generation in power generation safety LLMs. The proposed framework first extracts logical anchors from power safety regulations to construct structured domain knowledge. Then, Rule Violation Chains (RVCs) are introduced to generate attack samples with explicit relationships among safety violations, operational behaviors, and potential consequences. Finally, a domain-constrained adversarial optimization strategy is developed to improve attack effectiveness while preserving semantic consistency. An electric power prompt injection dataset (EP-Prompt) is constructed for security evaluation. Experimental results demonstrate that KTA-Prompt can generate domain-relevant prompt injection samples and provide effective support for security assessment of industrial LLM applications.},
  keywords={Modeling;Optimization;Safety;Equations;Large language models;Regulation;Manuals;Power systems;Tagging;Security;Large language models;Prompt injection attacks;Adversarial optimization;Power generation safety;Artificial intelligence security;Attack sample generation},
  doi={10.1109/ICHCI71425.2026.11739836},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11208433,
  author={Özçam, Berkay and Solmaz, Berksu Ant and Amasyali, Mehmet Fatih and Kara, Mustafa and Aydın, Muhammed Ali and Balık, Hasan Hüseyin},
  booktitle={2025 Innovations in Intelligent Systems and Applications Conference (ASYU)}, 
  title={Prompt Injection Attack Detection with Machine Learning}, 
  year={2025},
  volume={},
  number={},
  pages={1-1},
  abstract={The introduction of large language models into our lives has created a revolution, allowing artificial intelligence to be easily used and accessible by everyone. With this opportunity, large language models are now used in every step of our lives, from education to economy, agriculture to health, and are on their way to becoming a part of us. This widespread use of large language models attracts the attention of malicious people and brings with it security problems and concerns. Despite this rapid growth and expanding attack surface area, the precautions taken by model publishers are inadequate. This study focuses on the current inadequacy in the relevant field and presents a detection suggestion against 'Prompt Injection' attacks, one of the most commonly used attacks against large language models. Within this scope, 10 different models developed using various approaches were used to analyze the input text and classify whether or not it contained attacks. The tests showed that the most successful results were obtained with the BERT-based model, achieving 88 % accuracy and an F1 score of 87 %. The most important feature that distinguishes the study from existing studies is that, unlike existing detection models, it has the ability to detect in Turkish.},
  keywords={Large language models;Logistics;Reactive power;Machine learning;Logistic regression;Transformers;Support vector machines;Social networking (online);Security;Natural language processing;large language model;machine learning;prompt injection;natural language processing},
  doi={10.1109/ASYU67174.2025.11208433},
  ISSN={2770-7946},
  month={Sep.},}@INPROCEEDINGS{11755138,
  author={Chokshi, Sunny},
  booktitle={2026 International Conference on Cybersecurity and AI-Based Systems (Cyber-AI)}, 
  title={Analyze the Code, Not the Comments: Comment-Stripped Analysis Fully Defends LLM-Based Code Vulnerability Detectors Against Adversarial Comment Injection}, 
  year={2026},
  volume={},
  number={},
  pages={785-790},
  abstract={Large language models are increasingly used to detect security vulnerabilities in source code, but recent work has shown that adversarial comments embedded in the code under review can suppress detection, causing a model to miss genuine vulnerabilities. Because these attacks operate entirely through natural-language comments while leaving the executable code unchanged, they suggest a correspondingly simple defense: remove the comments before analysis. This paper presents the first empirical evaluation of comment-stripped analysis as a defense against adversarial comment injection. Across 480 adversarial trials on two open-source code models and eight adversarial comment strategies, we compare detection on clean code, on adversarially commented code, and on the same adversarial code with all comments removed. Under attack, detection fell from a clean baseline of 90.0% to 75.2%. With comment-stripped analysis, detection returned to 90.0%, recovering 100% of the detection lost to the attack. A matched-pairs McNemar test confirms the improvement is highly significant (chi-square = 65.33, $\mathrm{p}<0.001$): the defense recovered 73 vulnerabilities the attack had hidden while sacrificing only 2. The defense requires no model retraining and no access to model internals. It adds only a single analysis pass. These results show that a trivially deployable, model-agnostic input transformation fully neutralizes adversarial comment injection in the evaluated setting.},
  keywords={Codes;Modeling;Signal detection;Strips;Large language models;Cleaning;Security;Reviews;Artificial intelligence;Context;vulnerability detection;adversarial machine learning;LLM code review;prompt injection;defense;input sanitization;AI security},
  doi={10.1109/Cyber-AI70573.2026.11755138},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11626451,
  author={Maio, Carmen De and Senatore, Sabrina and Fei, Hao},
  booktitle={2026 IEEE International Conference on Fuzzy Systems (FUZZ-IEEE)}, 
  title={Linguistic Pattern–Enriched Transformers for Prompt Injection Detection in LLM Systems}, 
  year={2026},
  volume={},
  number={},
  pages={1-8},
  abstract={Nowadays, Large Language Models (LLMs) are widely included in many daily applications and services, where they play a crucial role in supporting users for automated decision-making tasks. As their adoption grows, so does their vulnerability to prompt injection attacks, which use natural language instructions to bypass safety constraints and also manipulate model behavior. To address these issues, the paper proposes a hybrid framework for prompt injection detection that combines domain-adaptive pretraining (DAPT) of RoBERTa encoder with a set of rule-based text patterns to detect suspicious adversarial interaction modes within prompt inputs. The proposed approach is evaluated through an empirical analysis across multiple prompt injection datasets. Experimental results show that the hybrid model outperforms text-only baselines and maintains reasonable performance under distributional shift. An ablation study is conducted to evaluate the individual component contribution.},
  keywords={Modeling;Training;Labeling;Signal detection;Large language models;Printing;Vectors;Testing;Equations;Fuzzing;Prompt Injection Detection;Large Language Models;Domain-Adaptive Pretraining;Prompt Vulnerability},
  doi={10.1109/FUZZ69877.2026.11626451},
  ISSN={1558-4739},
  month={June},}@INPROCEEDINGS{11662091,
  author={Hossain, Md. Shojib and Adnan, Md Nasim and Sheikh, Mohammad Nowsin Amin and Rahman, Muhammad Towfiqur},
  booktitle={2026 International Conference on Power, Electronics, Communications, Computing, and Intelligent Infrastructure (PECCII)}, 
  title={Prompt Firewalls for Securing Large Language Model Systems: Threats, Architectures, and Design Trade-offs}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Large Language Models are increasingly deployed as core components of enterprise automation platforms, retrieval-augmented generation systems, and autonomous agentic work-flows. While these systems enable advanced reasoning and decision-making, they also introduce a new attack surface rooted in natural language interaction. Prompt injection and indirect prompt injection attacks exploit the instruction-following behavior of these models, allowing adversaries to manipulate system behavior through untrusted inputs and external context.Prompt Firewalls have emerged as a security mechanism that intercepts and constrain prompt construction before or during model inference. Existing approaches range from lexical filtering and policy enforcement to semantic validation, role-aware parsing, and stateful monitoring across multi-step workflows, each presenting distinct architectural trade-offs.This survey provides a structured and implementation-oriented review of Prompt Firewall research. We examine attack models, design principles, deployment strategies, and enforcement mechanisms, and compare representative approaches to identify strengths, limitations, and open challenges in securing Large Language Model systems.},
  keywords={Modeling;Firewalls (computing);Large language models;Security;Retrieval augmented generation;Tools;Printing;Filtering;Filters;Signal detection;Prompt Firewall;Large Language Models;Prompt Injection;Retrieval-Augmented Generation Security;Agentic AI Security},
  doi={10.1109/PECCII70991.2026.11662091},
  ISSN={},
  month={June},}@ARTICLE{11594973,
  author={Chen, Wenjing and Cui, Jie and Huang, Wenjie and Zhang, Jing and Wei, Lu and Min, Geyong},
  journal={IEEE Transactions on Dependable and Secure Computing}, 
  title={Efficient Prompt Security Detection for LLM Service Deployment in Edge-Cloud Networks}, 
  year={2026},
  volume={23},
  number={5},
  pages={11069-11083},
  abstract={While Large Language Models (LLMs) have achieved revolutionary advancements in natural language processing, their inherent vulnerability to prompt injection attacks has raised significant security concerns. Existing security detection approaches for LLM deployment often fail to fully leverage edge-cloud collaboration and largely overlook the issue of user heterogeneity, resulting in reduced detection efficiency and security risks. To address these challenges, this paper proposes a Belief-updating and User-aware Security (BUUAS) framework for LLM service deployment in edge–cloud networks. BUUAS integrates a Bayesian-inspired belief update method with a belief-weighted contextual multi-armed bandit (BWCB) mechanism to achieve dynamic and user-aware scheduling of security detection tasks. This design enables the system to prioritize high-risk requests while improving overall task allocation and execution efficiency. Extensive experimental results demonstrate that BUUAS outperforms state-of-the-art methods in terms of detection accuracy, network throughput, and resource efficiency in dynamic network conditions characterized by fluctuating user loads and varying malicious user ratios.},
  keywords={Modeling;Security;Signal detection;Large language models;Clouds;Detectors;Bismuth;Business intelligence;Schedules;Scheduling;Large language models (LLMs);prompt injection attacks;edge-cloud networks;security detection;resource optimization},
  doi={10.1109/TDSC.2026.3709894},
  ISSN={1941-0018},
  month={Sep.},}@INPROCEEDINGS{11475941,
  author={Lan, Qianlong and Kaul, Anuj and Jones, Shaun and Westrum, Stephanie},
  booktitle={SoutheastCon 2026}, 
  title={Secure by Design: Quantifying Architectural Resilience and the Agents Rule of two}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={The transition of Large Language Models (LLMs) into autonomous agents equipped with tools necessitates a security paradigm shift. Current defenses typically rely on prompt engineering, which has proven insufficient to defend against Indirect Prompt Injection (IPI). This paper presents a quantitative evaluation of architectural defense patterns specifically Plan-then-Execute (P-t-E) and Context-Minimization (Context-Min), which are integrated under the strategic guidance of the Agents Rule of Two (R2). Advanced attack vectors on four distinct agent architectures, including IPI parameter hijacking and Attractive Metadata Attacks (AMA) were conducted. Our findings challenge the “Defense Tax” assumption while highlighting the limitations of a single defense mechanism. The baseline System Under Test (SUT) A proved highly vulnerable, 65% Attack Success Rate (ASR) to IPI, 100% to AMA and inefficient (3.02s latency). SUT B reduced the IPI success rate to 25% and latency to 0.50s, a 6x speed improvement. SUT C offered the highest security (21.2% ASR) but doubled the latency (1.02s) compared to SUT B. The results show that P-tE is the essential baseline for achieving efficiency and partial security and demonstrate that a layered “defense-in-depth” approach is required to fully mitigate parameter-level attacks.},
  keywords={Large language models;Autonomous agents;Prompt engineering;Metadata;Cyberattack;Trusted computing;Failure analysis;Security information and event management;Benchmark testing;Data integrity;Inference mechanisms;Software testing;LLM Agents;Agent Security;Indirect Prompt Injection;Architectural Security;Agents Rule of Two;Control Flow Integrity;Attack Surface Reduction},
  doi={10.1109/SoutheastCon63549.2026.11475941},
  ISSN={1558-058X},
  month={Feb},}@INPROCEEDINGS{11566062,
  author={Shen, Minyang and Fan, Xinggang and Zou, Haodong and Wang, Ruihao and Huang, Haiyang},
  booktitle={2026 International Conference on Sensor-Cloud and Edge Computing System (SCECS)}, 
  title={An Edge–Cloud Collaborative Framework for Latency Optimization in Prompt Injection Defense}, 
  year={2026},
  volume={},
  number={},
  pages={36-40},
  abstract={Prompt injection is a major input-side risk in Large Language Model (LLM) services. In edge-cloud deployments, a natural design is to let the edge perform lightweight detection and send hard-to-judge requests to the cloud for stronger checking. However, when many such requests are forwarded, cloud-side checking itself can become a queueing bottleneck, substantially increasing end-to-end delay, especially tail latency under heavy load. This paper studies how edge-side risk stratification can be used to decide which requests should receive further cloud-side checking, without scaling the provisioned cloud checking tier. We deploy a lightweight edge detector to divide requests into low-, medium-, and high-risk groups. High-risk requests are blocked at the edge, low-risk requests proceed directly, and medium-risk requests are selectively sent to the cloud or downgraded to a restricted execution mode according to both request risk and congestion state. We formulate this process as an online decision problem and show that it is NP-hard. Based on this formulation, we propose Q-TRiG, a low-overhead queue-aware gating policy for medium-risk traffic. Discrete-event simulations show that Q-TRiG reduces cloud queueing delay, suppresses 99th percentile latency spikes, and enlarges the stable operating region under heavy load. The results suggest that risk-stratified selective cloud checking is an effective way to reduce delay in prompt-injection detection pipelines.},
  keywords={Clouds;Modeling;Printing;Timing;Tail;Media;Detectors;Loading;Signal detection;Equations;Prompt Injection;Edge-Cloud Collaboration;Queue-aware Gating;Tail Latency;Large Language Models},
  doi={10.1109/SCECS69812.2026.11566062},
  ISSN={},
  month={May},}@INPROCEEDINGS{11717029,
  author={Guchhait, Pradyut and Saini, G.L.},
  booktitle={2026 IEEE 5th World Conference on Applied Intelligence and Computing (AIC)}, 
  title={Experimental Analysis of Adversarial Attacks on Agentic AI Systems with Layered Defense Mechanisms}, 
  year={2026},
  volume={},
  number={},
  pages={536-541},
  abstract={Agentic AI architectures leverage LLMs, tool execution, and decision-making mechanisms to handle a variety of tasks that go beyond text generation. The ability of these agents to accomplish such non-textual tasks poses new security concerns, particularly against adversarial prompting attacks. In this paper, we present a reproducible setup to investigate prompt-injection-like attacks on an agentic system locally, with the option to turn on and off the safety pipeline to facilitate comparative studies. Our architecture implements a keyword-based filtering approach to prompt injection, risk-weighting, and policy-based gating mechanisms for critical tools. We evaluate the proposed framework using a dataset of 108 prompts, including 104 adversarial and 4 benign prompts. Experimental results show that enabling the layered defense reduces the attack success rate from 72.5% to 18.3% while maintaining acceptable usability. Although effective against explicit attacks, the framework remains vulnerable to semantic paraphrasing and context-aware adversarial prompts, highlighting the need for semantic defense mechanisms.},
  keywords={Modeling;Security;Tools;Printing;Large language models;Filtering;Filters;Safety;Agentic AI;Aluminum;Agentic AI;Prompt Injection;LLM Security;Adversarial Evaluation;Tool Safety;Local LLM;Risk Scoring;Defensive Orchestration},
  doi={10.1109/AIC70896.2026.11717029},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11582512,
  author={Liu, Shi and Tang, Xuehai and Yang, Xikang and Lin, Liang and Zhou, Biyu and Xiao, Wenjie and Liu, Wantao},
  booktitle={2026 29th International Conference on Computer Supported Cooperative Work in Design (CSCWD)}, 
  title={When the Manual Lies: A Realistic Benchmark to Evaluate MCP Poisoning Attacks for LLM Agents}, 
  year={2026},
  volume={},
  number={},
  pages={2090-2095},
  abstract={The rise of tool-using Large Language Model (LLM) agents, standardized by protocols like the Model Context Protocol (MCP), has unlocked unprecedented autonomous execution capabilities for LLM Agents by integrating external open-domain knowledge and tools [1]. However, this interoperability introduces a covert attack surface targeting the agent’s cognitive planning layer. This paper systematically investigates Tool Description Poisoning (TDP), a novel semantic attack. In TDP, malicious instructions are not embedded in a tool’s executable code, but rather covertly injected into its descriptive metadata — the very "manual" an agent relies on for secure planning and decision-making. To rigorously and systematically evaluate this emerging threat, we introduce the MCP-TDP Security Benchmark. This high-fidelity sandbox environment comprises 32 realistic, real-world test cases spanning 6 distinct risk categories. Our evaluation of 8 mainstream LLMs reveals severe vulnerabilities, with leading models like GPT-4o exhibiting a nearly 100% Attack Success Rate (ASR) in six high-risk scenarios. Furthermore, our findings demonstrate that common prompt-guardrail defenses are largely ineffective and can, counterintuitively, even be counterproductive (a phenomenon which we term the "Firewall Fallacy"). Crucially, we also propose a defense mechanism: "Reactive Self-Correction," where an agent autonomously detects and reverts its own malicious actions post-execution. This work provides the first specialized security benchmark tailored for TDP, offering essential insights for securing the cognitive and planning layers of advanced agentic systems.},
  keywords={Modeling;Tools;Large language models;Printing;Automatic speech recognition;Aluminum;Security;Planning;Testing;Protocols;LLM Agents;AI Security;Model Context Protocol;Tool Description Poisoning;Indirect Prompt Injection},
  doi={10.1109/CSCWD68734.2026.11582512},
  ISSN={2768-1904},
  month={May},}@INPROCEEDINGS{11742976,
  author={Kavitha, S. and Anchitaalagammai, J.V. and Murali, S. and Roophavani, K. and Sree, L.T.M. Aashiga and Rasika, S.},
  booktitle={2026 International Conference on Emerging in Computing Technologies (INCECT)}, 
  title={A Multi-Stage Hybrid Framework for Prompt Injection Detection, Localization, and Recovery in LLM Systems}, 
  year={2026},
  volume={},
  number={},
  pages={1-5},
  abstract={Large Language Models (LLMs) have made tremendous progress in advancing the applications of artificial intelligence, but they have also posed severe threats to security. In particular, one of the emerging security concerns is prompt injection attacks, whereby attackers inject inputs that instruct the models to act contrary to the system designers' intended behaviour. Prompt injection may take either a direct approach (jailbreaking) or an indirect approach from external sources such as retrieval-augmented generation (RAG) pipelines, web pages, and API responses. Current research indicates that only a small number of malicious examples could be sufficient for achieving a high success rate of attacks. As agentic LLMs are increasingly deployed nowadays, prompt injection attacks would cause remote code execution, data exfiltration, and the spread of AI worms. This paper provides an overview of prompt injection attacks and defence mechanisms and proposes a hybrid defence method, which combines rule-based filtering, embedding-based classification, and architectural isolation methods.},
  keywords={Modeling;Signal detection;Large language models;Training;Printing;Security;Pipelines;Filtering;Artificial intelligence;Logistic regression;Prompt Injection;Large Language Models;Adversarial Attacks;AI Security;Jailbreaking;Natural Language Processing;Retrieval-Augmented Generation;Agentic AI},
  doi={10.1109/INCECT72370.2026.11742976},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11475947,
  author={Jadav, VasanthRao and Bussari, Shravya and Aurangabadkar, Mukesh and Garg, Anshul},
  booktitle={SoutheastCon 2026}, 
  title={Red-Team Prompt Injection Defense Using Multi-Context Protocol (MCP)}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Prompt injection attacks represent a critical security risk in Large Language Model (LLM)–powered applications, enabling adversaries to manipulate model behavior, bypass safety controls, and trigger unauthorized actions. Existing defenses predominantly rely on prompt hardening or output filtering, which remain brittle against adaptive and indirect attack techniques. This paper introduces a red-team–driven defense framework based on a Multi-Context Protocol (MCP) that enforces strict isolation and validation of prompt layers. MCP separates system, developer, retrieval, and user prompts into independently trusted contexts and applies context validation, version control, semantic consistency checks, and input reputation scoring prior to model inference. Through empirical evaluation using representative prompt injection attacks, the proposed approach demonstrates a significant reduction in successful injection attempts while preserving low latency and minimal false positives. The framework is model-agnostic and designed for secure deployment in enterprise and regulated LLM environments.},
  keywords={Filtering;Filters;Circuits and systems;Protocols;HTTP;Communication systems;Artificial intelligence;Large language models;Retrieval augmented generation;Logic;Prompt Injection;Large Language Models;AI Security;Red Teaming;Multi-Context Protocol;Context Isolation;Input Validation;Secure LLM Systems},
  doi={10.1109/SoutheastCon63549.2026.11475947},
  ISSN={1558-058X},
  month={Feb},}@INPROCEEDINGS{11498071,
  author={Khac, Lilian Tai Do and Mezger, Marc Fabian and Thürck, Daniel},
  booktitle={2026 International Conference on Advances in Artificial Intelligence and Machine Learning (AAIML)}, 
  title={Hold the Prompt (HODPOT): Defense Design for Securing the System Prompt of LLM Agents}, 
  year={2026},
  volume={},
  number={},
  pages={142-147},
  abstract={Since the public release of ChatGPT, generative AI (GenAI) models have become increasingly functional and autonomous, spurring their integration into a wide range of products. This integration introduces substantial security risks, most notably prompt-injection attacks that can manipulate model outputs and expose proprietary data. A less-studied variant—prompt-theft, where an adversary who fully controls the user prompt extracts the system prompt or a semantically equivalent paraphrase—remains viable even against state-of-the-art models. We formalise this threat under an attacker model that can issue arbitrary user inputs and observe the model’s responses. Our defense is a lightweight post-inference similarity filter: each generated output is compared using text similarity measures with a calibrated threshold that determines whether the response is returned unchanged, sanitized, or blocked. Experiments on eight LLMs and two “guard”-type models show that the filter reduces successful prompt extraction two-third of occurences while preserving above $90 \%$ of benign responses. These findings, given the the increasing usage of fully-autonomous GenAI agents, re-highlight prompt theft as a pressing research problem and motivate further work on adaptive thresholds, multi-modal prompts, and compositional leakage.},
  keywords={Payloads;Radio broadcasting;Frequency modulation;Filtering;Filters;Feedback;Circuits;Circuits and systems;Radio access networks;Regional area networks;Data security;Large Language Models;LLM attacks;Prompt injection;LLM vulnerabilities},
  doi={10.1109/AAIML67890.2026.11498071},
  ISSN={},
  month={March},}@INPROCEEDINGS{11745222,
  author={Güler, Ali Kerem and Aydin, Muhammed Ali},
  booktitle={2026 11th International Conference on Computer Science and Engineering (UBMK)}, 
  title={LLM-as-a-Judge Vulnerabilities in Review Summarization and a Reasoning-based Defense against Cross-Lingual Prompt Injection}, 
  year={2026},
  volume={},
  number={},
  pages={144-149},
  abstract={Large language models are increasingly deployed to summarize user-generated content and to evaluate other models’ outputs as automated judges. Both roles process attacker-controlled text, which exposes them to prompt-injection attacks hidden inside the content itself. This threat was studied in a realistic, non-English setting by summarizing Turkish restaurant reviews from the Protel Check and Place platform. Three model families (Gemma, Qwen, Llama) were compared under an unprotected zero-shot mode and a lightweight reasoning guardrail that instructed the model to inspect the input for language changes and hidden override commands prior to summarization. Utilizing an attack corpus of 500 reviews poisoned with English, Spanish, and Turkish payloads, 24,000 responses were analyzed to measure attack success rates, latency overheads, and the vulnerability of automated judges. Vulnerability was found to depend on model capacity rather than release recency. The reasoning guardrail sharply reduced successful attacks on most models by an average of 23.0 percentage points. However, the guardrail backfired on the smallest model by surfacing the malicious instruction into its working context, driving the attack success rate from 5.5% up to 55.3%. Automated judges were subverted in inverse proportion to their capability, exhibiting a cross-lingual asymmetry prominent in Spanish payloads. These results caution against assuming that either newer models or model-based judges are safe by default.},
  keywords={Modeling;Large language models;Printing;Cognition;Cognitive systems;Reviews;Automatic speech recognition;Multilingual;Cross lingual;Payloads;prompt injection;large language models;LLM-as-a-Judge;cross-lingual security;text summarization;reasoning guardrails},
  doi={10.1109/UBMK71847.2026.11745222},
  ISSN={2521-1641},
  month={Sep.},}@INPROCEEDINGS{11765792,
  author={Ma, Wenkai and Fauzi, Fariza},
  booktitle={2026 6th International Conference on Smart Sensors and Applications (ICSSA)}, 
  title={Constitutional Sanitization and Fine-Tuning for Robustness to Prompt Injection in LLM-Based Log Analysis}, 
  year={2026},
  volume={},
  number={},
  pages={84-89},
  abstract={Large language models (LLMs) are increasingly used in log-analysis workflows to summarize operational logs, alerts, tickets, and other external records. Because these records are untrusted data, they may contain malicious instructions. This paper studies indirect prompt injection in a scoped LLM-based loganalysis task where the model must preserve forensic information while refusing instruction-like text embedded in logs. We evaluate Qwen2.5-7B-Instruct and Llama 3.1 8B Instruct under No Defense, Delimiter-based Datamarking, Constitutional Sanitization, and low-rank adaptation (LoRA)-based supervised fine-tuning (SFT) conditions. Evaluation uses a frozen 1,000-row external validation set with 600 attacks and 400 benign logs, with source-lineage and near-duplicate checks against the original training and pilot data. On this set, Qwen SFT plus Sanitization reduces attack success rate (ASR) from 519/600 (86.50%) to 251/600 (41.83%), while Llama Sanitization reduces ASR from 329/600 (54.83%) to 59/600 (9.83%). These gains are not cost-free: Llama Sanitization blocks or refuses 97/400 benign logs, and its explanation BERTScore, a metric based on Bidirectional Encoder Representations from Transformers (BERT), is 0.6492 versus 0.8561 for No Defense. The results support a scoped defense strategy: sanitize untrusted log content, report security and utility together, and treat residual ASR and benign blocking as deployment-relevant trade-offs rather than claims of absolute security.},
  keywords={Modeling;Automatic speech recognition;Large language models;Printing;Training;Security;LoRa;Payloads;Robustness;Testing;prompt injection;large language models;log analysis;sanitization;datamarking;LoRA;supervised fine-tuning;LLM security},
  doi={10.1109/ICSSA70263.2026.11765792},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11710859,
  author={Naveed, Muhammad and Li, Wenjia},
  booktitle={2026 International Conference on Future and Intelligent Networking (FINE)}, 
  title={Battling Prompt Injection Attacks on LLM-Enabled Autonomous Vehicles}, 
  year={2026},
  volume={},
  number={},
  pages={105-112},
  abstract={The integration of Large Language Models (LLMs) as semantic co-pilots in Autonomous Driving Systems (ADS) represents a significant paradigm shift for analyzing vehicles and perceiving what reasonably lies ahead. Preliminary works already demonstrate that incorporating LLM-based context-awareness into Vehicle-to-Everything (V2X) planning can benefit the actions and derived consequences. However, this creates a significant and underexplored security vulnerability. In LLM enabled V2X communication, we validate message origin and physical plausibility through a layered architecture that fuses cryptographic authentication with kinematic misbehavior detection. These layers indicate who sent a message and its physical possibility, but neither looks at what a message means semantically. This architectural design creates a gap by eliminating the need for content validation of V2X payloads, which are introduced directly into LLM prompts without checks or censors. In this paper, we empirically simulate prompt-injection attacks from V2X message free-text fields for LLMs used in autonomous vehicles. We develop a taxonomy of three attack classes Override Injection, Suppression Injection, and Phantom-Obstacle Injection, all carrying spoofed, simulated signals in the form of Basic Safety Messages (BSM), Traveler Information Messages (TIM), and Local Dynamic Map (LDM). We measure evasion rates against signature verification and a kinematics-only Misbehavior Detection Systems (MBDS) using Monte Carlo experiment involving three attacker classes with 27,000 trials. The results demonstrate that attackers can gain access to the LLM input stage with valid credentials in 92% of cases across each attacked message type and channel, without detection. Our experiments reveal a fundamental weakness in V2X security, which escalates with the introduction of LLMs to the autonomous driving pipeline.},
  keywords={Large language models;Vehicle-to-everything;Modeling;Security;Autonomous driving;Equations;Printing;Planning;Signal detection;Autonomous vehicles;Autonomous vehicles;Large Language Models (LLMs);V2X communication;prompt injection attack;Vehicular Networks},
  doi={10.1109/FINE71157.2026.00030},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11689544,
  author={Gentyala, Sunil and Reddy, N.Sudhakar and Deepthi, Kothapalli Chaitanya and Saroja, Pathapati and Achari, Kammara Venkatarangaiah and Shaik, Ruhisulthana},
  booktitle={2026 7th International Conference On Computational Vision and Bio Inspired Computing (ICCVBIC)}, 
  title={Agentic Security Validation Framework for Retrieval-Augmented and Tool-Enabled Large Language Model Systems}, 
  year={2026},
  volume={},
  number={},
  pages={1001-1011},
  abstract={The attack surface of an enterprise large language model deployment is no longer a single completion endpoint. Production systems chain LLMs with retrieval databases, Model Context Protocol (MCP) tool servers, and subordinate agents, creating a graph of trust boundaries that static probe-and-detect scanners cannot traverse. This paper introduces ARGUS (Agentic Red-team and Governance Unified Scanner), an opensource framework designed around three observations: attack strategy must adapt to target behavior in real time; payload generation must be structurally novel on every attempt to defeat memorization-based guardrails; and security findings must map directly to regulatory obligations to be actionable. ARGUS replaces the static probe schedule with a closed-loop multi-agent architecture. A Planner agent, backed by a reasoning-capable LLM, formulates and continuously revises the attack plan after each evaluation cycle. An Attacker agent synthesizes payloads subject to an embedding-space diversity constraint that enforces structural novelty across the batch. An Evaluator applies three independent detection layers (semantic proximity scoring, structured LLM-as-judge assessment, and pipeline behavioral trace analysis), eliminating the dependence on keyword signatures that caps detection depth in existing tools. A CVSSv4.0 scoring engine, validated to exact parity with the official FIRST reference implementation across a 48 -vector test battery, assigns versioned severity vectors to every confirmed finding. A compliance mapper links each finding to specific obligations in seven regulatory frameworks: NIST AI RMF, NIST SP 800-228, EU AI Act, US Executive Order 14110, UK AISI evaluation pillars, India CERT-In, and ISO/IEC 42001. Architectural coverage analysis, verified directly against garak v0.15.x source, shows module-level alignment with all ten OWASP LLM Top 10 (2025) categories, compared with full coverage of two categories and partial or no coverage of the remaining eight in garak; a live-target pilot on open-weight models reports real precision, recall, and false-positive rates for two of the ten categories, with full-scale empirical validation left as future work. Native SARIF v2.1 output enables zeroconfiguration integration with GitHub Actions, GitLab CI, and Azure DevOps pipelines.},
  keywords={Modeling;Large language models;Artificial intelligence;Tools;Pipelines;Probes;Surfaces;Payloads;Security;Printing;LLM security;agentic AI;red-team automation;prompt injection;CVSS;OWASP LLM Top 10;NIST AI RMF;EU AI Act;MCP security},
  doi={10.1109/ICCVBIC71195.2026.11689544},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11582854,
  author={Shanid, Mohammed and Prasad, Gaurav and Bawgi, Veeresh and Gowda, Srujan},
  booktitle={2026 IEEE International Conference on Emerging Synergy Science and Technology (ICESST)}, 
  title={MedRAGShield: A Three-Tier Defense Framework Against Document Poisoning and Adversarial Attacks in Medical Retrieval-Augmented Generation Systems}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Retrieval-Augmented Generation (RAG) systems deployed in medical question-answering applications introduce novel attack surfaces not addressed by existing large language model (LLM) safety mechanisms. This research presents MedRAGShield, a three-tier middleware defense framework designed to detect and neutralise document injection poisoning, hallucination exploitation, prompt injection, and jailbreak attacks against medical RAG pipelines. The proposed system operates across three independently togglable defense modes: a baseline mode with no filtering, a confidence and hallucination gating mode, and a full defense mode augmenting the prior modes with Domain-Aware Sanity Check (DASC) rules that apply medical ontological constraints to generated outputs. This experiment constructs a 40-query adversarial evaluation dataset spanning four attack categories and conducts an empirical evaluation on a clinical pharmacology RAG system built on Llama 3.2:3B and ChromaDB. Results demonstrate that confidence-based defenses alone are insufficient against high-similarity document poisoning attacks, which achieve retrieval confidence exceeding 0.85 while delivering clinically dangerous misinformation, a phenomenon this research terms the high-confidence poisoning paradox. The full MedRAGShield defense reduces Attack Success Rate (ASR) from 13.2% (undefended) to 0.0%, with block rate increasing from 0% to 62.5%, while maintaining sub-second query latency. This work establishes a reproducible evaluation methodology for medical RAG security and identifies domain-specific semantic rule checking as a critical missing layer in current LLM defense architectures. Code, dataset, and defense rules are openly available.},
  keywords={Modeling;Retrieval augmented generation;Large language models;Toxicology;Drugs;Printing;Safety;Automatic speech recognition;Drug interactions;Middleware;retrieval-augmented generation;medical AI safety;document poisoning;adversarial machine learning;large language models;prompt injection;hallucination detection;drugdrug interaction safety},
  doi={10.1109/ICESST69086.2026.11582854},
  ISSN={},
  month={April},}@INPROCEEDINGS{11050591,
  author={Jang Bahadur, Sunil Kumar and Dhar, Gopala and Nigam, Lavi},
  booktitle={2025 IEEE Conference on Artificial Intelligence (CAI)}, 
  title={GenAI Security: Outsmarting the Bots with a Proactive Testing Framework}, 
  year={2025},
  volume={},
  number={},
  pages={610-612},
  abstract={The increasing sophistication and integration of Generative AI (GenAI) models into diverse applications introduce new security challenges that traditional methods struggle to address. This research explores the critical need for proactive security measures to mitigate the risks associated with malicious exploitation of GenAI systems. We present a framework encompassing key approaches, tools, and strategies designed to outmaneuver even advanced adversarial attacks, emphasizing the importance of securing GenAI innovation against potential liabilities. We also empirically prove the effectiveness of the said framework by testing it against the SPML Chatbot Prompt Injection Dataset. This work highlights the shift from reactive to proactive security practices essential for the safe and responsible deployment of GenAI technologies,},
  keywords={Technological innovation;Correlation;Generative AI;Prevention and mitigation;Organizations;Chatbots;Complexity theory;Security;Faces;Testing;GenAI;Security;Agents;Prompt Injection;Red Teaming;Blue Teaming;LLM},
  doi={10.1109/CAI64502.2025.00112},
  ISSN={},
  month={May},}@INPROCEEDINGS{11746820,
  author={R, Saranya and N, Gowtham and Hariharan, Nithish and K, Dharun Raj},
  booktitle={2026 International Conference on Secure IoT and Cybersecurity (ICOSICS)}, 
  title={An Intelligent Prompt Injection Detection System Using Large Language Models and Contextual Analysis}, 
  year={2026},
  volume={},
  number={},
  pages={1749-1754},
  abstract={Large Language Models (LLMs) are increasingly embedded in conversational systems, retrieval-augmented applications, software tools, and autonomous services. This expansion also introduces prompt injection risks, in which adversarial instructions attempt to override intended behavior, disclose protected information, or redirect an application toward an unintended objective. Rule-based and keyword-oriented filters can identify known patterns but may miss attacks expressed through semantic reformulation or contextual manipulation. This paper presents a Context-Aware Semantic Risk Detection Framework (CSRDF) that evaluates incoming prompts using linguistic indicators, semantic representations, contextual consistency, risk fusion, and binary threat classification before the prompt reaches the target LLM. The reported evaluation contains 2,000 samples, comprising 985 benign and 1,015 malicious prompts, as derived from the reported confusion-matrix counts. The proposed framework achieves 98.0% accuracy, 97.2% precision, 96.7% recall, and 96.9% F1-score on the reported evaluation set. The study also reports an ROC-AUC of 1.00. Because independent-dataset and cross-attack validation were not included in the reported experiment, these results are interpreted as evidence of performance on the evaluated dataset rather than as proof of generalization to unseen attack strategies. The framework provides a multi-signal defense mechanism for improving the security and reliability of LLM-based applications.},
  keywords={Modeling;Large language models;Security;Signal detection;Printing;Bit error rate;Accuracy;Equations;Context;Confusion matrices;Large Language Models (LLMs);Prompt Injection Detection;Contextual Analysis;Natural Language Processing;Cybersecurity;Adversarial Prompt Detection;Semantic Feature Extraction;Machine Learning},
  doi={10.1109/ICOSICS70095.2026.11746820},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11591776,
  author={Siddiqui, Hania and Taj, Rizwan and Yasin, Qadeer and Shahid, Muhammad Sarfraz and Mehfooz, Saba and Bibi, Assma},
  booktitle={2026 5th International Conference on Computing, Mathematics and Engineering Technologies (iCoMET)}, 
  title={A Hybrid Neural Semantic Framework for Prompt Injection Detection in LLMs}, 
  year={2026},
  volume={},
  number={},
  pages={1-5},
  abstract={Prompt injection attacks imply that they lead to a very severe risk to the dependability of Large Language Model (LLM) systems by allowing a user to control the behavior of the model using constructed inputs. This paper proposes a Hybrid-PI neural-semantic architecture to improve the detection of these attacks. Hybrid-PI with the DeepSet prompt-injection dataset uses a neural prompt encoder with a Semantic Consistency Oracle to jointly learn surface and higher-level semantic inconsistencies via a trade-off between the two. The experimental findings indicate that Hybrid-PI performs much better than the classical and transformer-based baselines, achieving 97.4% accuracy and 97.5% F1-score, with significantly reduced false positives. The robustness tests also indicate the ability to withstand paraphrase and obfuscation-based adversarial variations. The results suggest that Hybrid-PI is a viable and scalable approach to strengthening safety controls around LLMs against emerging threats such as prompt injection.},
  keywords={Modeling;Large language models;Accuracy;Equations;Signal detection;Training;Printing;Tagging;Conferences;Labeling;Prompt Injection Detection;Large Language Models (LLMs);Adversarial Attacks;Security for AI models;Hybrid Neural–Semantic Framework},
  doi={10.1109/iCoMET69771.2026.11591776},
  ISSN={2996-1688},
  month={May},}@INPROCEEDINGS{11395708,
  author={Yazdani, Faran and Antezana, Stephen and Gebril, Mohamed and Abdelhamid, Sherif},
  booktitle={2026 IEEE 5th International Conference on AI in Cybersecurity (ICAIC)}, 
  title={Multi-Layered Defense Proxy for Home Assistant utilizing Large Language Models}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={The ever-increasing integration of large language models, LLMs, in IoT environments necessitates the implementation of robust security measures. Because such systems have access to physical devices, attacks against them can have real-world consequences. Therefore, to address the growing need for security in this realm, we propose a proxy that leverages LLMs to detect prompt injection attempts in a home IoT setting. In this paper, various methods of performing prompt injections on LLMs that have been given access to control physical IoT devices in a home are investigated. We will discuss the relationship between our work and related efforts aimed at securing LLMs, and provide an overview of the contributions this work makes to the field. We will discuss the benefits of our approach and briefly outline potential extensions to our work, both in the realm of IoT devices and in other contexts where LLMs are used.},
  keywords={Performance evaluation;Large language models;Prevention and mitigation;Smart homes;Oral communication;User experience;History;Monitoring;Context modeling;Industrial Internet of Things;Home assistant;large language model;prompt injection},
  doi={10.1109/ICAIC67076.2026.11395708},
  ISSN={},
  month={Feb},}
