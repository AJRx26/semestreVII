  title={The Reproduction Number of AI Worms: Epidemic Modeling of Adversarial Attacks in LLM Agent Ecosystems}, 
  year={2026},
  volume={},
  number={},
  pages={2-12},
  abstract={Adversarial worms propagate through large language model agent networks via prompt injection, retrieval poisoning, and tool outputs. We adapt an epidemic model with poisoned-reservoir and preexecution interception states, derive the agent reproduction number, and map concrete defenses to model parameters.},
  keywords={Modeling;Reservoirs;Toxicology;Computer worms;Grippers;Artificial intelligence;Payloads;Tools;Large language models;Propagation},
  doi={10.1109/MSEC.2026.3713527},
  ISSN={1558-4046},
  month={},}@INPROCEEDINGS{11140522,
  author={Al Ahmed, Yazan and Osman, Abdulla and Ahmed, Abrar Hamdi and Omar Salem, Dina and Al Ahmad, Yanal},
  booktitle={2025 5th Intelligent Cybersecurity Conference (ICSC)}, 
  title={From Transaction to Transformation: AI and Machine Learning in FinTech}, 
  year={2025},
  volume={},
  number={},
  pages={187-196},
  abstract={Artificial Intelligence technology and Machine Learning operate in FinTech industries by automating processes while giving complete risk assessments, plus private customized solutions. This research studies how AI and ML technology support modern FinTech business functions, specifically fraud prevention, business credit rating, automated investment advice, and automatic market trades. The research conducts the empirical evaluation of Large Language Model integration within Zero Trust security structures by using adversarial testing together with case studies and explainability assessment methods. Research indicates that LLMs improve threat detection performance by 21% and traditional systems yet they fail in 38% of cases when prompt injection happens. The study highlights the need for adversarial training combined with fairness auditing and regulatory oversight in order to establish AI deployment safety in cybersecurity. The research pairs contemporary studies with specific examples to uncover AI and ML's main advantages of better results, less manual work, and better services for customers. This study researches both data protection risks and official rules while looking at the weaknesses of programmed systems. Through research the paper determines how applications based on AI machine learning propel financial services toward automated systems that adjust their behavior for optimal results. The analysis generates new ideas to develop FinTech innovation models and provides useful directions for business creators plus oversight agencies plus financial establishments. This study brings a new method to view AI/ML integration while showing the need to align ethical and legal rules in future FinTech systems.},
  keywords={Training;Ethics;Fintech;Computational modeling;Threat assessment;Fraud;Zero Trust;Artificial intelligence;Computer security;Business;FinTech;AI;ML;Fraud Detection;Loan Prediction;Customer Segmentation},
  doi={10.1109/ICSC65596.2025.11140522},
  ISSN={},
  month={May},}@INPROCEEDINGS{11580105,
  author={Bandara, Eranga and Hass, Amin and Shetty, Sachin and Mukkamala, Ravi and Gore, Ross and Rajapakse, Sachini and Liang, Xueping and Bouk, Safdar H.},
  booktitle={2026 International Wireless Communications and Mobile Computing (IWCMC)}, 
  title={ASTRIDE: A Security Threat Modeling Platform for Agentic-AI Applications}, 
  year={2026},
  volume={},
  number={},
  pages={386-393},
  abstract={AI agent-based systems are becoming increasingly integral to modern software architectures, enabling autonomous decision-making, dynamic task execution, and multimodal interactions through large language models (LLMs). However, these systems introduce novel and evolving security challenges, including prompt injection attacks, context poisoning, model manipulation, and opaque agent-to-agent communication that are not effectively captured by traditional threat modeling frameworks. In this paper, we introduce ASTRIDE, an automated threat modeling platform purpose-built for AI agent-based systems. ASTRIDE extends the classical STRIDE framework by introducing a new threat category, A for AI Agent–Specific Attacks, which encompasses emerging vulnerabilities such as prompt injection, unsafe tool invocation, and reasoning subversion, unique to agent-based applications. To automate threat modeling, ASTRIDE integrates a consortium of fine-tuned vision-language models (VLMs) with the OpenAI-gpt-oss reasoning LLM to perform end-to-end analysis directly from visual agent architecture diagrams, such as data flow diagrams (DFDs). The consortium-based approach enables consensus-driven reasoning, where predictions from multiple VLMs are systematically evaluated, reconciled, and refined by the reasoning LLM. This process mitigates single-model bias, enforces policy and safety constraints, and produces transparent, traceable, and explainable threat assessments. Our evaluations demonstrate that ASTRIDE provides accurate, scalable, and explainable threat modeling for next-generation intelligent systems. To the best of our knowledge, ASTRIDE is the first framework to both extend STRIDE with AI-specific threat categories and integrate a consortium of fine-tuned vision-language models with a reasoning LLM to fully automate diagram-driven threat modeling for AI agent-based applications, while explicitly supporting Responsible and Explainable AI requirements.},
  keywords={Modeling;Threat modeling;Cognition;Cognitive systems;Large language models;Artificial intelligence;Tuning;Generative Pre-trained transformer;Printing;Vision language model;Agentic AI;Responsible AI;Explainable AI;Vision-Language-Model;Threat-Modeling;STRIDE},
  doi={10.1109/IWCMC69287.2026.11580105},
  ISSN={2376-6506},
  month={June},}@INPROCEEDINGS{11581051,
  author={Sodankoor, Prerana and Joshi, Sampada and K, Vinodha},
  booktitle={2025 IEEE 7th International Conference on Cybernetics, Cognition and Machine Learning Applications (ICCCMLA)}, 
  title={SecurePrompt – Detecting and Mitigating Prompt Attacks}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Prompt injection attacks pose serious security and privacy risks in applications that use large language models (LLMs) and sensitive data. Conventional techniques that rely on input validation at the single layer are unable to identify intricate attack vectors or stop the disclosure of private information. To solve these issues in LLM-based systems, a multi-layer defense architecture is suggested. The design adds a Response layer and a Prompt Validation layer. To assess the safety of prompts and responses, each layer combines machine learning models with static rule-based classification. Unsafe instances are either blocked or referred for further administrative review. Feedback loops facilitate continuous filtering rule improvement. The architecture incorporates administrative interfaces for updating validation criteria and integrates with the current LLM infrastructure. To lessen the possibility that private information will be exposed by outside retrieval methods, the system supports retrieval augmented generation settings. According to preliminary tests, injection attempts can be detected more accurately than with baseline methods while preserving tolerable latency and user performance.},
  keywords={Modeling;Large language models;Retrieval augmented generation;Filtering;Machine learning;Filters;Architecture;Computer architecture;Finance;Pipelines;Large Language Models;Prompt Injection;Input Validation;Response Filtering;Secure NLP;Retrieval Augmented Generation;AI Safety;Machine Learning Security;Content Moderation;Adversarial Attacks},
  doi={10.1109/ICCCMLA66092.2025.11581051},
  ISSN={},
  month={Nov},}@ARTICLE{11595140,
  author={Ma, Wanlun and Han, Qing-Long and Zhu, Xiaogang and Zhou, Wei and Xiong, Junwu and Ren, Zhihang and Wen, Sheng and Xiang, Yang},
  journal={IEEE/CAA Journal of Automatica Sinica}, 
  title={OpenClaw in the Wild: Security Analysis of Autonomous Agents}, 
  year={2026},
  volume={13},
  number={6},
  pages={1257-1273},
  abstract={Autonomous self-hosted AI agent platforms are rapidly evolving from prompt-response assistants into persistent systems that can maintain long-lived state, invoke tools, ingest external content, and execute environment-changing actions. While this transition enables practical automation, it also introduces lifecycle security risks that cannot be fully explained by prompt-level analysis alone. In this paper, a security analysis of OpenClaw is presented, with OpenClaw serving as a representative autonomous agent operating environment and a concrete case study for broader security challenges in emerging agent ecosys-tems. A trust-boundary-first perspective is adopted to examine how attacks propagate across five boundary classes: Channel-Access, Session-and-State, Tool-Execution, External-Content, and Extension Supply-Chain. The results presented in this paper show that threats such as indirect prompt injection, memory poisoning, unsafe tool invocation, data exfiltration, and malicious skill abuse are not isolated anomalies; rather, they are stage-specific mani-festations of a common systems problem in which untrusted influence progressively crosses into higher-privilege contexts. Based on this analysis, the defense-in-depth implications for OpenClaw deployments are discussed, including boundary-aware isolation, capability-scoped tool mediation, memory integrity controls, extension governance, and evidence-oriented operational oversight. This study provides a practical framework for evaluating and hardening long-running, tool-capable, autonomous AI agents in realistic deployment settings.},
  keywords={Memory;Modeling;Security;Tools;Printing;Artificial intelligence;Context;Large language models;Runtime;Design methodology;Agent security;Agentic AI;autonomous systems;LLM agents;tool-use safety},
  doi={10.1109/JAS.2026.126209},
  ISSN={2329-9274},
  month={June},}@ARTICLE{11574655,
  author={Leburu, Nandakishore},
  journal={IEEE Access}, 
  title={Trust-Aware Orchestration Architecture for LLM-Assisted Workflows in Multi-Tenant Enterprise Systems}, 
  year={2026},
  volume={14},
  number={},
  pages={97094-97117},
  abstract={Large language models (LLMs) now call tools and APIs in enterprise systems, creating concrete risks: hallucinated parameters, cross-tenant data leakage, and prompt injection. This paper presents an orchestration architecture for multi-tenant deployments where the LLM proposes actions and a deterministic control plane validates and executes them, organized as three hard enforcement gates (authentication and tenant resolution, role-based tool authorization, and schema validation), four advisory filters (input sanitization, retrieval scoping, execution monitoring, output compliance), and append-only audit logging. The hard gates provide three structural guarantees (tenant isolation, tool-allowlist enforcement, schema conformance) specified as deterministic predicates and verified at the logical control-plane level; they do not defend against within-scope intent manipulation, in which an authorized role invokes an authorized tool with schema-valid parameters for a malicious purpose. A 20-prompt adaptive case study shows within-scope attacks succeed on every one of five LLMs tested, at point-estimate rates of 30%–70%, including the three frontier Claude models (Haiku 4.5, Sonnet 4, Opus 4.6). The structural guarantees hold uniformly across 14,885 evaluations: 1,497 custom prompts plus adversarial prompts from two established benchmarks (683 TensorTrust and 777 AgentDojo across three domains and three attack strategies) and a 20-prompt adaptive case study. Targeted attack-success rate on AgentDojo is  $\leq 1.9\%$  across all five models, comparable to published defended baselines. Deterministic syntax recovery reduces the 3B model’s false rejection rate from 52% to 15.2% at zero latency cost; frontier models achieve 0%. Input sanitization flagged injection patterns in only 10.2% of injection prompts without solo-rejecting any, confirming pattern-based detection is insufficient. Within-scope intent manipulation remains an open problem the hard gates do not address. The architecture targets enterprise systems requiring explainability, safety, and regulatory compliance.},
  keywords={Modeling;Tools;Large language models;Architecture;Computer architecture;Pipelines;Filtering;Retrieval augmented generation;Filters;Artificial intelligence;Large language models;trust-aware systems;orchestration architecture;multi-tenant systems;retrieval-augmented generation;schema validation;AI governance;guardrails;enterprise AI safety},
  doi={10.1109/ACCESS.2026.3706063},
  ISSN={2169-3536},
  month={},}@ARTICLE{11048579,
  author={Mo, Yonghua and Tang, Maoyang and Lin, Ruohan and Zhou, Bohao and Li, Xiaojian},
  journal={IEEE Access}, 
  title={Broken Bags: Disrupting Service Through the Contamination of Large Language Models With Misinformation}, 
  year={2025},
  volume={13},
  number={},
  pages={109607-109623},
  abstract={Large language models (LLMs) have progressively become essential production tools in contemporary society, owing to their formidable natural language generation and contextual reasoning skills. To facilitate the development of current responses by LLMs, individuals have used retrieval-augmented generation (RAG) technology, which extracts material from the corpus to assist large language models in producing relevant replies. The extensive utilization of huge language models necessitates urgent RAG security research. Conventional RAG attack techniques exhibit inadequate hiding and a substantial volume of harmful messages. Consequently, we have introduced an innovative attack mechanism termed “Broken Bags,” which adeptly injects a minimal quantity of toxic text to mislead large language models. The attack is executed through a hybrid approach that incorporates artificial prompt templates, toxic content generated by LLMs, and filtering mechanisms. For instance, when the RAG system engages with publicly available knowledge bases, adversaries can take advantage of the accessibility of these RAG knowledge bases to introduce malicious texts into the retrieval database, so as to intentionally alter the model’s behavior. This work employs the linguistic similarity between toxic content and the geographical vector characteristics of the “query question” to influence the information returned by RAG, hence preventing the LLM from generating responses to the target questions. We developed and refined an artificial prompt template to render toxic language more akin to authentic human expressions and less detectable. Experimental data indicates that our attack success rate attains 94%. Ultimately, we systematically evaluate state-of-the-art defenses (including perplexity-based detection and knowledge extension, among others), and the findings indicate that these measures are unable to counter “Broken Bags,” hence significantly enhancing the success rate of assaults on RAG systems.},
  keywords={Security;Large language models;Internet;Knowledge based systems;Databases;Computer crime;Information technology;Generators;Fake news;Writing;Information security;information retrieval;large language models;RAG attack;prompt injection attacks},
  doi={10.1109/ACCESS.2025.3582519},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11768476,
  author={Stankovski, Dragan},
  booktitle={2026 XXXV International Scientific Conference Electronics (ET)}, 
  title={The Cost of AI when the Bill Comes Due: Inside the AI Industry's Spending Hangover}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={This article examines the evolution of the artificial intelligence (AI) market during the first half of 2026, a period marked by rapid consolidation, mounting structural changes, and extensive reorganization across the technology sector, with particularly acute effects on the telecommunications industry. It traces the key events shaping this period, from Apple's adoption of Google's Gemini models for Siri and the Stanford findings on training data reproduction, to the intensifying rivalry between U.S. and Chinese AI laboratories, the temporary export control suspension of Claude Fable 5 and Claude Mythos 5, and the shift of major tools such as GitHub Copilot to usage based pricing, and introduces LLM proxy and AI gateway architectures including data loss prevention filtering, prompt injection protection, centralized cost governance.},
  keywords={Artificial intelligence;Modeling;Companies;Costing;Pricing;Large language models;Manuals;Timing;Security;Internet;Artificial Intelligence;Hardware Shortage;LLM Gateway;Token Pricing},
  doi={10.1109/ET72079.2026.11768476},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11569620,
  author={Roy, Ayan and Warburton, Tyler},
  booktitle={2026 IEEE World AI IoT Congress (AIIoT)}, 
  title={Securing in-Vehicle Large Language Models: A Taxonomy of Integration, Threats, and Trustworthiness}, 
  year={2026},
  volume={},
  number={},
  pages={0618-0624},
  abstract={Large Language Models (LLMs) are increasingly integrated into in-vehicle systems to support conversational interfaces, diagnostics, and driver assistance. However, the security and safety implications of LLMs operating within the in-vehicle systems remain underexplored. In this paper, we present a taxonomy-driven analysis of in-vehicle LLM integration, categorizing systems by integration depth, modality, and functional role. Using this taxonomy, we identify key threat surfaces and failure modes, including hallucination-induced misguidance, prompt injection, adversarial manipulation, and data leakage. We further examine the challenge of grounding LLM outputs in deterministic control logic, highlighting risks of post-hoc rationalization in safety-critical settings. Based on these insights, we derive design guidelines emphasizing architectural isolation, mediated actuation, and runtime assurance. Our work provides a focused foundation for securing in-vehicle LLM deployments.},
  keywords={Large language models;Modeling;Vehicles;Safety;Security;Design methodology;Privacy;Taxonomy;Manuals;Context;Large Language Models (LLMs);In-Vehicle Systems;Autonomous Vehicles;Intelligent Transportation Systems (ITS);Vehicular Security;Explainable AI;Embedded AI},
  doi={10.1109/AIIoT68874.2026.11569620},
  ISSN={},
  month={May},}@INPROCEEDINGS{10389637,
  author={Song, Gan and Wu, Zelin and Pundak, Golan and Chandorkar, Angad and Joshi, Kandarp and Velez, Xavier and Caseiro, Diamantino and Haynor, Ben and Wang, Weiran and Siddhartha, Nikhil and Rondon, Pat and Sim, Khe Chai},
  booktitle={2023 IEEE Automatic Speech Recognition and Understanding Workshop (ASRU)}, 
  title={Contextual Spelling Correction with Large Language Models}, 
  year={2023},
  volume={},
  number={},
  pages={1-8},
  abstract={Contextual Spelling Correction (CSC) models are used to improve automatic speech recognition (ASR) quality given userspecific context. Typically, context is modeled as a large set of text spans to compare against a given ASR hypothesis using some distance measure (text, phonetic, or neural embedding). In this work we propose a CSC system based on a single Large Language Model (LLM) adapted with prompt tuning. Our approach is shown to be data efficient, and does not require dedicated serving. Our system exhibits advanced contextualization capabilities, such as support for phonetic spellings, cross-lingual scripts, and context specified as topics, with little to no data engineering. On voice assistant datasets, our system achieves $7.8 \%$ absolute word error rate reduction from a reference ASR system with relevant context and improving upon other contextualization solutions. Finally, we test our system in a prompt-injection attack scenario and report vulnerabilities and mitigations.},
  keywords={Adaptation models;Error analysis;Conferences;Training data;Phonetics;Data engineering;Data models;speech recognition;contextual adaptation},
  doi={10.1109/ASRU57964.2023.10389637},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11200929,
  author={Shivadekar, Samit},
  booktitle={2025 4th International Conference on Innovative Mechanisms for Industry Applications (ICIMIA)}, 
  title={Red Teaming LLMs: A Stackelberg Game Approach to AI Safety}, 
  year={2025},
  volume={},
  number={},
  pages={1147-1154},
  abstract={Artificial Intelligence (AI) models such as large language models (LLM) have demonstrated substantial advancements in recent years. Along with capabilities, researchers have started to study the potential risks of AI generated content. These risks encompass reflective bias, toxic outputs, factually incorrect information, and adversarial outputs. However, in these existing works the focus has primarily been on the assessment of AI models not on the analysis of adversarial use-cases of these models. Red teaming research has focused in considerable depth on the adversarial use-case of conventional AI models, however very few works explore in detail the game-theoretic aspects of the red-teaming task for LLMs. LLMs can provide responses to questions posed in natural language, necessitating exploration of ways in which uncommon or non-obvious questions could be generated. Constructing an effective ensemble policy that ensures diversity and uncertainty in the query responses from different LLMs is non-trivial, as it requires a game-theoretic formulation to evaluate the selection of policies. In this work, a novel red teaming game framework (RTG) for LLMs and the Game-Theoretic Red Teaming System (GRTS) solver to balance the textual LLM policies is proposed. GRTS is guaranteed to converge to a Nash equilibrium (NE) when inner iterations converge and also incorporates lie detection for robustness against gradient leakage. The effectiveness of GRTS is demonstrated in extensive experiments in query generation and diverse query selection tasks, as well as a case study showing GRTS-LLM could generate effective adversarial prompts to find zero-shot prompt injection attacks on internal systems of LLMs.},
  keywords={Adaptation models;Analytical models;Uncertainty;Stochastic processes;Games;Nash equilibrium;Mathematical models;Robustness;Safety;Artificial intelligence;Red Teaming;LLMs;NE;GRTS;AI Safety;Game Theory;Adversarial Robustness;Nash Equilibrium},
  doi={10.1109/ICIMIA67127.2025.11200929},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11573638,
  author={Zhao, Shuli and Hou, Qinsheng and Zhan, Zihan and Wang, Yanhao and Xie, Yuchong and Guo, Yu and Chen, Libo and Li, Shenghong and Xue, Zhi},
  booktitle={2026 IEEE Symposium on Security and Privacy (SP)}, 
  title={Parasites in the Toolchain: A Large-Scale Analysis of Attacks on the MCP Ecosystem}, 
  year={2026},
  volume={},
  number={},
  pages={138-155},
  abstract={Large language models (LLMs) are increasingly integrated with external systems through the Model Context Protocol (MCP), which standardizes tool invocation and has rapidly become a backbone for LLM-powered applications. While this paradigm enhances functionality, it also introduces a fundamental security shift: LLMs transition from passive information processors to autonomous orchestrators of taskoriented toolchains, expanding the attack surface, elevating adversarial goals from manipulating single outputs to hijacking entire execution flows. In this paper, we identify and characterize a systematic privacy-leakage attack pattern, termed Parasitic Toolchain Attacks, instantiated as MCP Unintended Privacy Disclosure (MCP-UPD). These attacks require no direct victim interaction; instead, adversaries embed malicious instructions into external data sources that LLMs access during legitimate tasks. Unlike traditional prompt injection and tool poisoning attacks, our attack targets the interconnected toolchain itself, assembling multiple legitimate tools into a coordinated workflow whose combined behavior accomplishes malicious objectives. In MCP-UPD, the malicious logic infiltrates the toolchain and unfolds in three phases: Parasitic Ingestion, Privacy Collection, and Privacy Disclosure, culminating in stealthy exfiltration of private data. Our root cause analysis reveals that MCP lacks both context-tool isolation and least-privilege enforcement, enabling adversarial instructions to propagate unchecked into sensitive tool invocations. To assess the severity, we design MCP-SEC and conduct the first large-scale security census of the MCP ecosystem, analyzing 12,230 tools across 1,360 servers. Our findings show that the MCP ecosystem is rife with real-world exploitable gadgets and diverse attack methods, underscoring systemic risks in MCP platforms and the urgent need for defense mechanisms in LLM-integrated environments.},
  keywords={Large language models;Modeling;Privacy;Servers;Tools;Security;Ecosystems;Printing;Context;Electronic mail},
  doi={10.1109/SP63933.2026.00154},
  ISSN={2375-1207},
  month={May},}@INPROCEEDINGS{11670052,
  author={Abuadbba, Alsharif and Sultan, Nazatul and Nepal, Surya and Jha, Sanjay},
  booktitle={2026 IEEE International Conference on Web Services (ICWS)}, 
  title={Human Society-Inspired Approaches to Agentic AI Security: The 4C Framework}, 
  year={2026},
  volume={},
  number={},
  pages={1304-1314},
  abstract={AI is moving from domain-specific autonomy in closed, predictable settings to large-language-model-driven agents that plan and act in open, cross-organizational environments. As a result, the cybersecurity risk landscape is changing in fundamental ways. Agentic AI systems can plan, act, collaborate, and persist over time. It is now functioning as participants in complex socio-technical ecosystems rather than as isolated software components. Although recent work has strengthened defenses against model and pipeline level vulnerabilities such as prompt injection, data poisoning, and tool misuse, these system-centric approaches may fail to capture risks that arise from autonomy, interaction, and emergent behavior. This article introduces the “4C Framework” for multi-agent AI security, inspired by societal governance. Our 4C Framework organizes agentic risks across four interdependent dimensions: Core (system, infrastructure, and environmental integrity), Connection (communication, coordination, and trust), Cognition (belief, goal, and reasoning integrity), and Compliance (ethical, legal, and institutional governance). Our 4C Framework shifts AI security from a narrow focus on system-centric protection to the broader preservation of behavioral integrity and intent. It complements existing AI security strategies and offers a principled foundation for building agentic AI systems that are trustworthy, governable, and aligned with human values.},
  keywords={Modeling;Security;Artificial intelligence;Cognition;Tools;Agentic AI;Large language models;Printing;Planning;Cognitive systems;Agentic AI;Human Society-Inspired Security;Behavioral Governance;Trustworthy AI},
  doi={10.1109/ICWS72778.2026.00164},
  ISSN={2836-3868},
  month={July},}@INPROCEEDINGS{11720885,
  author={Wang, Zhuoyang and Li, Gen and Zhang, Bowei and Guo, Linke},
  booktitle={2026 IEEE Conference on Communications and Network Security (CNS)}, 
  title={Exposing and Securing LLMs Against Hypocrisy-Induced Manipulation}, 
  year={2026},
  volume={},
  number={},
  pages={1-9},
  abstract={Large language models (LLMs) remain vulnerable to jailbreaks, prompt injection, and bias exploitation, which can lead to harmful content generation, erode public trust, and compromise platform credibility. As LLMs become increasingly integrated into networked AI services and online interactive systems, it may also introduce broader risks to computer and network security. Existing defenses often require extensive retraining and fail on adversarial strategies such as role-playing and justification-based exploits. One work illustrates how adversarial moral framing interacts with harmful behavior during successful jailbreaks. Inspired by the psychological concept of cognitive self-consistency theory, for the first time, this work identifies inconsistencies between the virtuous persona constructed by adversarial prompts and the LLM’s actual responses as induced-hypocrisy. This phenomenon reveals that harmful outputs, bias, and disinformation often stem from the model’s manipulated self-justification, where it rationalizes its behavior under a misleading moral frame. Therefore, we propose HYPOAlign, a framework to mitigate such threats through moral alignment based on moral foundation theory and psychological cognitive dissonance while enabling realtime response steering without requiring model retraining. Extensive experimental results have demonstrated HYPOAlign reduces on average of 77.21% jailbreak attack success rate across four mainstream LLMs, as well as an overall decrease in generation toxicity and biases. Warning: This paper contains examples of harmful language that could be triggering.},
  keywords={Ethics;Modeling;Large language models;Printing;Mean field theory;Security;Cognition;Cognitive systems;Conferences;Design methodology;Large Language Models;Jailbreak;Safeguard;Networking Safety;Moral Alignment},
  doi={10.1109/CNS69863.2026.11720885},
  ISSN={2994-5895},
  month={Sep.},}
