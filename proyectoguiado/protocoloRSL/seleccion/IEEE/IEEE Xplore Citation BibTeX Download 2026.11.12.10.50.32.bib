@INPROCEEDINGS{11755211,
  author={Ram, Dayanand},
  booktitle={2026 International Conference on Cybersecurity and AI-Based Systems (Cyber-AI)}, 
  title={Trustworthy AI: A Zero-Trust Architecture for LLM Integration and Agentic AI in Enterprise Environments}, 
  year={2026},
  volume={},
  number={},
  pages={632-637},
  abstract={As large language models (LLMs) and agentic AI systems transition from experimental pilots to core enterprise infrastructure, they introduce an unprecedented attack surface. Traditional security perimeters fail when confronted with non-deterministic models that process instructions and data within the same channel. This paper presents a Zero-Trust AI (ZTAI) architecture designed to securely integrate commercial and open-weight LLMs into corporate environments. The framework shifts governance from static documentation to dynamic, real-time telemetry. It enables organizations to maintain strict data sovereignty, neutralize advanced prompt injection attacks, and achieve compliance with global mandates such as the EU AI Act.},
  keywords={Artificial intelligence;Modeling;Large language models;Security;Organizations;Printing;Poles and zeros;Computer security;Cryptography;Zero Trust;Cybersecurity;zero-trust AI;agentic AI security;LLM governance;enterprise security;AI risk management;autonomous agents;cryptography},
  doi={10.1109/Cyber-AI70573.2026.11755211},
  ISSN={},
  month={Sep.},}@ARTICLE{11598769,
  author={Hossain, Elias and Nipu, Md. Mehedi Hasan Bhuiyan and Mahmood, Mohammad Sakib and Hossen, Md. Jakir and Mridha, M. F.},
  journal={IEEE Transactions on Systems, Man, and Cybernetics: Systems}, 
  title={Safe and Scalable Collaboration in Multiagent LLM Systems: A Comprehensive Review}, 
  year={2026},
  volume={56},
  number={10},
  pages={6139-6155},
  abstract={Large language model (LLM)-based multiagent systems are a rapidly evolving frontier of artificial intelligence that enables complex coordination, communication, and autonomous reasoning across distributed agents. This article presents a comprehensive review of multiagent LLM ecosystems, organized around four foundational pillars: coordination strategies, communication frameworks, safety challenges, and trust and alignment mechanisms. We synthesize a range of architectural approaches to agent interaction, including shared latent representations, strategic autonomy, task decomposition, and neuro-symbolic communication protocols. We then systematically examine the critical vulnerabilities distinctive to multiagent environments, namely prompt injection, perceptual adversarial attacks, reward misalignment, and operational overreach. To address these issues, we propose the trust stack: a multilayered trust framework spanning epistemic reliability, behavioral alignment, role awareness, social accountability, and institutional governance. Beyond synthesizing the literature, this review contributes a novel integrated perspective. It models the interdependencies among these four pillars, formalizes the trust stack as an operational framework with runtime-computable metrics, and derives design principles from a cross-system analysis of real multiagent deployment failures—contributions absent from prior surveys. We further investigate the prospects for superalignment through constitutional AI principles, multiagent value aggregation, and dynamic preference shaping. Collectively, this work establishes a theoretical and practical foundation for the secure, reliable, and dependable deployment of multiagent LLM systems and offers a roadmap for future research at the intersection of coordination, communication, and alignment.},
  keywords={Modeling;Large language models;Multi-agent systems;Safety;Artificial intelligence;Collaboration;Cognition;Cognitive systems;Learning (artificial intelligence);Stacking;Alignment and superalignment;cognitive security;communication protocols;coordination strategies;distributed reasoning;large language models (LLMs);multiagent systems;preference shaping;safety and robustness;trust stack},
  doi={10.1109/TSMC.2026.3704902},
  ISSN={2168-2232},
  month={Oct},}@INPROCEEDINGS{11711481,
  author={Czajkowski, Jan and Graliński, Filip},
  booktitle={2026 21st Conference on Computer Science and Intelligence Systems (FedCSIS)}, 
  title={A Real-World Dataset of LLM Jailbreak Prompts from a Capture-the-Flag Challenge}, 
  year={2026},
  volume={},
  number={},
  pages={55-64},
  abstract={We introduce a real-world dataset for studying prompt injection and jailbreak behavior in Large Language Models (LLMs), collected during Capture the Flag (CTF) events in which participants attempted to extract a hidden secret string protected by defensive prompts. Unlike benchmark data generated primarily through automated methods, the corpus captures human-authored offensive and defensive prompts produced in a realistic educational and competitive setting. The raw dataset contains roughly 8,000 interaction records; through filtering for successful, non-trivial, and analytically useful cases, we derive a curated subset of 115 examples for detailed study. We analyze both defensive and offensive prompts as interacting linguistic artifacts and show that defensive strategies are relatively concentrated, while offensive prompts display substantially greater structural diversity. Clustering identifies three major families of defensive prompts and eight clusters of offensive prompts, reflecting an asymmetry between reusable protection templates and varied attack strategies. The dataset supports qualitative and quantitative research on prompt injection, including the study of secrecy-preserving prompt design, attack typology, and the security-usability trade-off in LLM-based systems.},
  keywords={Modeling;Large language models;Recording;Context;Printing;Application programming interfaces;Weighted sum model;Arrays;Metadata;Filtering},
  doi={10.15439/2026F5600},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11638145,
  author={Silva, Rafael and Duarte, Luiz},
  booktitle={2026 IEEE 12th International Conference on Intelligent Data and Security (IDS)}, 
  title={Securing LLM Software Supply Chains: A Layered Lifecycle Framework with Hybrid Post-Quantum Artifact Signing}, 
  year={2026},
  volume={},
  number={},
  pages={8-15},
  abstract={Large Language Models (LLMs) are increasingly embedded in production systems, creating complex development and deployment pipelines that resemble modern software supply chains. These pipelines span dataset ingestion, training workflows, model artifacts, distribution registries, inference infrastructure, and downstream application integration. While prior work has extensively examined model-centric threats such as extraction, inversion, and prompt injection, the security of the complete LLM lifecycle remains insufficiently addressed.Existing software supply chain frameworks, including Sigstore, in-toto, Supply-chain Levels for Software Artifacts (SLSA), and The Update Framework (TUF), provide strong guarantees for artifact integrity and provenance. However, these mechanisms were designed primarily for conventional software artifacts and do not fully capture AI-specific lifecycle threats such as data poisoning, training pipeline compromise, and retrieval-augmented prompt manipulation. In addition, most artifact signing infrastructures rely on classical cryptography that may face long-term risk from quantum adversaries.This paper proposes a layered security framework for LLM software supply chains. The framework models LLM security as a lifecycle control problem spanning five layers: Data, Training, Model, Inference, and Application. For each layer, the framework identifies representative assets, threat classes, and defensive controls. The paper further analyzes the role of hybrid post-quantum signatures combining classical digital signatures with post-quantum schemes such as ML-DSA to strengthen artifact integrity at the model distribution stage.To complement the conceptual framework, we include a prototype-oriented evaluation describing how the proposed controls can be instantiated in a reproducible pipeline and quantify the practical overhead of hybrid post-quantum artifact signing. The proposed framework provides a structured model for analyzing threat propagation across the LLM lifecycle while remaining compatible with established supply chain technologies. We contribute a formal threat taxonomy, a comparative analysis against existing frameworks, and an evidence-informed evaluation demonstrating why artifact integrity alone is insufficient for securing LLM supply chains.},
  keywords={Modeling;Training;Large language models;Security;Supply chains;Software;Printing;Pipelines;Toxicology;Artificial intelligence;Large Language Models;AI Supply Chain Security;Post-Quantum Cryptography;Hybrid Signatures;Model Integrity;Provenance;Secure ML Lifecycle},
  doi={10.1109/IDS69480.2026.00011},
  ISSN={},
  month={May},}@ARTICLE{11471677,
  author={Garcia, Pedro Henrique Sachete and de Souza, Paulo Silas Severo and Luizelli, Marcelo Caggiani and Mombach, Jaline Gonçalves and Sachete, Andréia Dos Santos and Rossi, Fábio Diniz},
  journal={IEEE Access}, 
  title={The New Web Attack Surface: A Taxonomy of Semantic and Agentic Threats in AI Browsers}, 
  year={2026},
  volume={14},
  number={},
  pages={54109-54126},
  abstract={AI-enabled web browsers are redefining how users search, read, and interact with online information. By embedding Large Language Models (LLMs) directly into the browsing pipeline, these systems evolve from passive rendering engines into intelligent, context-aware assistants capable of summarization, reasoning, task automation, and multi-step workflow execution. While this shift unlocks significant opportunities for productivity and seamless human–computer interaction, it also introduces a new and largely unexplored attack surface. Because AI browsers semantically interpret the Document Object Model (DOM), previously inert elements such as hidden text, ARIA labels, metadata, and JSON structures can serve as covert channels for adversarial prompt injection, model steering, data exfiltration, and unintended autonomous actions. Existing security taxonomies do not adequately capture these semantic and agentic threats. This article provides the first comprehensive survey of AI-enabled browsers and analyzes their architectural principles, functional capabilities, and security implications. We introduce AIA-WEB, a novel threat taxonomy comprising four macroclasses and twelve attack categories specifically tailored to the AI-augmented web environment. Each category is illustrated with a minimal HTML example that demonstrates how linguistic manipulation can target the embedded model. We further compare AIA-WEB with traditional cybersecurity frameworks, highlight critical gaps, and propose mitigation strategies spanning prompt firewalls, semantic sanitization, LLM wrappers, and action gating. Finally, we outline future research directions to guide the development of safe, interpretable, and robust AI browsing ecosystems. Our survey and taxonomy establish a foundational reference for understanding and securing the next generation of intelligent browsers.},
  keywords={Payloads;Low earth orbit satellites;Military aircraft;Space technology;Artificial satellites;Feeds;Antennas;Feedback;Circuits;Filtering;AI browsers;large language models;semantic security;prompt injection;browser security},
  doi={10.1109/ACCESS.2026.3680147},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11628890,
  author={Marko, Ing. Richard and Hitka, Bc. Patrik},
  booktitle={2026 Information Technology Scientific Research Conference (IIT.SRC)}, 
  title={Designing AI Agents for Personal Assistance: Human Perceptions and Design Considerations}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Large language models enable agentic workflows that can draft emails, propose calendar meetings, extract tasks from messages, and summarize long documents. Yet, deploying such agents in personal information management raises practical and ethical challenges: users must remain in control, privacy-sensitive data must be minimized, and the system must be transparent about what it did and why. This paper presents a human-centered design for a “Personal Assistant Agent” that orchestrates specialized AI agents for email, calendar scheduling, task management, and summarization while enforcing an explicit Approve/Edit/Reject decision loop. We combine related work on agentic LLM systems with perception-driven requirements, describe an end-to-end architecture including policy checks, consent management, audit logging, and defenses against prompt injection, and present evaluation checks plus a protocol to measure trust, usefulness, and reliability boundaries in realistic workflows.},
  keywords={Artificial intelligence;Electronic mail;Modeling;Proposals;Design methodology;Tools;Printing;Privacy;Minimization;Conferences;AI agents;personal assistant;human-in-the-loop;trust;privacy;orchestration;tool calling;prompt injection;RAG},
  doi={10.1109/IIT.SRC67760.2026.11628890},
  ISSN={},
  month={April},}@INPROCEEDINGS{11122258,
  author={Muliarevych, Oleksandr},
  booktitle={2024 14th International Conference on Dependable Systems, Services and Technologies (DESSERT)}, 
  title={Mitigating Input Prompt Attack Vulnerabilities in Systems with a Language Model Interface}, 
  year={2024},
  volume={},
  number={},
  pages={1-8},
  abstract={The article is devoted to the study of the cybersecurity vulnerabilities in systems utilizing Language Model Interfaces, particularly focusing on the challenges and solutions in constructing secure systems. The paper includes an overview of the current Language Model Interface and issues with their utilization in typical systems, and because of the conducted analysis, proposes a multi-level structural schema of cybersecurity frameworks and standards, that could be applied to cover the different types of risks. The suggested prompt analysis and injection detection sub-system design, in which evaluates whether the input is relevant and appropriate from the security point of view. The additional Filter cybersecurity level integrated into the system with the Language Model Interface allows protection from prompt injection attacks during the pre-processing of user requests and post-processing of responses. The Filter level consists mainly of a Prompt Analyzer, which wraps pre-processed input prompt; an Attack Validator module using a helper Large Language Model, which classifies if the prompt is risky or safe; Elasticsearch cluster for logging and monitoring purposes. During testing different types of prompt injection attacks were evaluated in different types of system setups: core GPT-3 and GPT-4 models without additional security layer; Fuzzy Search with attacking prompt pattern vocabulary; a system with Attack Validator in two modes - based on GPT-3 model and GPT-4 model. The article shows the relative strengths and weaknesses of each approach, contributing valuable insights into the development of more secure systems with Language Model Interface.},
  keywords={Vocabulary;Analytical models;Large language models;Focusing;Chatbots;Computer security;Protection;Standards;Monitoring;Testing;language model;prompt injection attack;cybersecurity for LLMs;ChatGPT;security layer integration},
  doi={10.1109/DESSERT65323.2024.11122258},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11395696,
  author={French, Edward and Aryal, Samyam and Singh, Aman and More, Komal Subhash and Hammond, Joe and Spanier, Mark},
  booktitle={2026 IEEE 5th International Conference on AI in Cybersecurity (ICAIC)}, 
  title={Zero-Shot Tokenizer Transfer for Targeted Attacks on Retrieval-Augmented Generation}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Retrieval-Augmented Generation (RAG) is widely used to improve the reliability of Large Language Models (LLMs) by grounding responses in external documents. However, RAG systems that ingest content from internet sources remain vulnerable to prompt injection attacks embedded within retrieved documents. We introduce ZBEAST, an adaptation of Beam Search-Based Adversarial Attacks (BEAST), designed to generate malicious documents specifically for RAG settings.We evaluate ZBEAST using an embedding-based heuristic built on BAAI-BGE-base-v1.5 and compare it against the state-of-the-art BEAST approach, which relies on an instruction-tuned LLM during search. ZBEAST replaces the generator’s tokenizer with that of the embedding model via Zero-Shot Tokenizer Transfer (ZeTT), enabling more effective adversarial document optimization. Our results show that ZBEAST scales reliably with beam size, while the baseline approach exhibits diminishing returns. We further demonstrate that ZBEAST-generated documents evade common filtering mechanisms used in RAG pipelines. These findings expose an underexplored vulnerability in RAG systems and suggest existing defenses may be insufficient against optimized adversarial document generation.},
  keywords={Vocabulary;Filtering;Grounding;Large language models;Retrieval augmented generation;Pipelines;Reliability;Computer security;Optimization;Surface treatment;Retrieval-Augmented Generation (RAG);Large Language Models (LLMs);Prompt injection attacks;Adversarial document generation;Beam search;LLM security},
  doi={10.1109/ICAIC67076.2026.11395696},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11401523,
  author={Biswas, Milon and Yu, Wei and Wang, Qianlong and Liao, Weixian},
  booktitle={2025 IEEE International Conference on Big Data (BigData)}, 
  title={Quantifying Privacy Leakage in Multi-Agent LLMs: A Unified Theoretical and Empirical Analysis}, 
  year={2025},
  volume={},
  number={},
  pages={1685-1694},
  abstract={Large Language Models (LLMs) are increasingly used in multi-agent systems, where autonomous agents collaborate on complex tasks through distributed reasoning and communication. While existing work focuses on privacy in single-agent or API-bound settings, inter-agent communication introduces new privacy leakage pathways that remain underexplored. This paper proposes a unified framework for quantifying and mitigating privacy leakage in multi-agent LLMs. It unifies Mutual Information (MI), Bayesian Inference Gain (BIG), and Rényi Differential Privacy (RDP) to jointly quantify empirical leakage, belief refinement, and worst-case privacy loss in multi-agent LLMs. MI captures statistical dependence between private inputs and observable messages, detecting unintended memorization or semantic correlation. BIG models adversarial belief refinement and complements MI by offering a posteriorcentric interpretation of leakage. RDP provides formal privacy guarantees across multi-turn dialogues, quantifying divergence under repeated queries and enabling DP-style defense via output perturbation. We simulate LLM agents with distinct prompts and introduce probing adversaries capable of membership inference, prompt injection, and extraction attacks. The empirical results show that the proposed combined defense reduces MI from 0.35 to 0.10 and the attack success rate (ASR) from 82% to 29%, with minimal Bilingual Evaluation Understudy (BLEU) drop. The combined defense achieves strong privacy with acceptable utility. These findings highlight the importance of privacy-aware agent design and protocol-level defense under black-box threats in multi-agent LLMs.},
  keywords={Privacy;Differential privacy;Correlation;Large language models;Perturbation methods;Semantics;Cognition;Security;Mutual information;Multi-agent systems;Security;Privacy;Large Language Model},
  doi={10.1109/BigData66926.2025.11401523},
  ISSN={2573-2978},
  month={Dec},}@INPROCEEDINGS{11469093,
  author={Tripathi, Padmesh and Arora, Pridhi and Paroha, Krishna Kumar and Kumar, Devesh and Manisha and Katiyar, Preeti},
  booktitle={2026 2nd International Conference on Cognitive Computing in Engineering, Communications, Sciences and Biomedical Health Informatics (IC3ECSBHI)}, 
  title={Guardrail-Based Approaches for Enhancing Safety, Security, and Privacy in Large Language Models}, 
  year={2026},
  volume={},
  number={},
  pages={1619-1624},
  abstract={Large Language Models are increasingly deployed in real-world applications because of their generative and reasoning capabilities. With their deployment, they also bring the risk related to safety, security and privacy. Safety concerns arise when the model generates hallucinated output, biased or harmful content. Security concerns arise with the prompt injection and jailbreaking attacks. The impact of these issues can be seen in various safety-critical domains such as healthcare, finance and legal decision-making and may cause significant harm. This paper focuses on guardrail mechanisms at the system level for handling risk concerns, including safety, security and privacy in the LLMs. The guardrail is enforced from the input level to continuous monitoring while the user is interacting with the LLM and the output level. A conceptual architecture integrating these stages is proposed. In addition, the paper proposes the evaluation criteria to assess the effectiveness of the guardrail in the real environment.},
  keywords={Filtering;Feedback;Filters;Circuits;Circuits and systems;Contacts;Protocols;Radio access networks;Regional area networks;HTTP;Large Language Models;Guardrail mechanism;AI Security;AI Safety;Privacy Protection;Prompt injection;Hallucination;Evaluation Framework},
  doi={10.1109/IC3ECSBHI67834.2026.11469093},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11329228,
  author={Özçelik, Melik Buğra and Şentaş, Ali and Koçyiğit, Berkecan and Özen, Sinan and Akmeşe, Arda},
  booktitle={2025 16th International Conference on Electrical and Electronics Engineering (ELECO)}, 
  title={A Study on Cross-Lingual Security Vulnerabilities in Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={In this study, we look at how Large Language Models (LLMs) trained mostly in English react to prompt injection (PI) attacks written in other languages, especially Turkish. We tested several open-weight models such as Gemma3n-e4b, Gemma3-27b, and Llama3.3-70b. In our tests, we compared direct and indirect attacks and tried simple defenses. The results show that direct attacks are usually stronger, reaching more than 90% success in bigger models. Indirect attacks are weaker but still a real risk. We also saw that English prompts often succeed more than Turkish ones, but this gap becomes smaller as the model size grows. Current defenses only lower the risk a little and sometimes even make it worse. Our study shows that LLM security depends on both language and model size, and that better multilingual defenses are needed.},
  keywords={Large language models;Cross lingual;Multilingual;Security},
  doi={10.1109/ELECO69582.2025.11329228},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11352474,
  author={Park, Leo Hyun and Kwon, Taekyoung},
  booktitle={2025 28th International Symposium on Research in Attacks, Intrusions and Defenses (RAID)}, 
  title={Red-Teaming LLMs with Token Control Score: Efficient, Universal, and Transferable Jailbreaks}, 
  year={2025},
  volume={},
  number={},
  pages={629-647},
  abstract={Large Language Models (LLMs) are vulnerable to jailbreak attacks, where adversaries craft malicious prompts to bypass safety mechanisms and elicit harmful, illegal, or unethical responses. To ensure robustness before deployment, red-teaming LLMs is essential. However, prior methods like GCG and AutoDAN rely on loss functions that only assess whether the output matches a fixed target, offering little insight into how well the prompt circumvents refusal behaviors. We introduce Token Control Score (TCS), a novel metric that quantifies how effectively a prompt steers the LLM toward compliance and away from refusal. TCS compares the logits of key tokens representing compliant and rejecting responses, and can be extended with gradient-based feedback into a Normalized Token Control Score (NTCS) to guide optimization. Using this metric, we propose LLM-CGF, a fuzzing-based framework that iteratively discovers effective jailbreak templates for prompt injection. LLM-CGF leverages NTCS as the fitness function to explore LLM behaviors and uncover vulnerabilities with high efficiency. Experiments show that LLM-CGF outperforms state-of-the-art methods such as LLM-Fuzzer, generating more universal, transferable, and query-efficient jailbreak prompts. These results demonstrate the utility of TCS and NTCS as new objectives for prompt injection, providing deeper insights into LLM safety and enabling more thorough red-teaming evaluations. Warning: This paper contains unfiltered content generated by LLMs that may be offensive to readers.},
  keywords={Measurement;Large language models;Impedance matching;Fuzzing;Robustness;Safety;Optimization;large language models;jailbreak;red-teaming},
  doi={10.1109/RAID67961.2025.00016},
  ISSN={},
  month={Oct},}@ARTICLE{11666482,
  author={Varol, Aygün and Shaikh, Asif and Jalo, Henri and Muchenje, Givemore and Cerqueira, José Siqueira de and Kemell, Kai-Kristian and Hossein Motlagh, Naser and Leino, Mirka and Pirkkalainen, Henri and Abrahamsson, Pekka and Virkki, Johanna},
  journal={IEEE Access}, 
  title={Evil-AI Benchmark: An Evaluation Framework for Adversarial Security Assessment of LLM Agents in Smart Environments}, 
  year={2026},
  volume={14},
  number={},
  pages={133098-133116},
  abstract={Smart environments increasingly integrate artificial intelligence (AI) to process sensor data, coordinate Internet of Things (IoT) devices, and actuate cyber-physical services. Within these environments, large language models (LLMs) are emerging as decision-making and interaction components. However, LLM integration expands the attack surface of these environments, and existing benchmarks focus largely on risks associated with text-based interactions and LLM-generated outputs, failing to capture cyber-physical risks that arise when models control physical actuators. This paper introduces Evil-AI Benchmark, an open-source evaluation framework for assessing LLM agents in smart environments through (i) five adversarial threat vectors—prompt injection, persuasion, attacker-in-the-middle (AITM) simulation, data leakage, and unsafe actions—and (ii) a capability validation that checks whether a model can correctly activate device-control tools. The benchmark instruments tool activations and forwards tool-trigger events to an external Arduino-driven servo actuator, providing physical verification of actuation events. To demonstrate the benchmark in practice, we evaluate eight representative LLMs using 350 executable scenarios: 250 adversarial tests spanning five smart-environment domains (smart home, healthcare IoT, industrial control, public infrastructure, and smart building), 50 capability checks, and 50 benign over-refusal tests. Responses are scored by two independent judge models and verified by a human evaluator. We report Evilness as the extent to which attacks succeed. The Evilness Score equals the number of successful attacks, and the Evilness Rate is the corresponding percentage. Across models, Evilness Rates range from 0.8% to 54.0% (2–135 successful attacks out of 250), while Defense Rates range from 46.0% to 99.2%. The most persistent weaknesses occur in persuasion, especially under sustained multi-turn pressure, and in prompt injection. Moreover, larger models are not necessarily more robust against adversarial attacks. We additionally quantify over-refusal on benign authorized requests, so that safety is not rewarded by indiscriminate refusal. Evil-AI Benchmark provides reproducible diagnostics and quantitative metrics that connect text-based safety evaluation with real-world cyber-physical operation.},
  keywords={Large language models;Modeling;Artificial intelligence;Safety;Tools;Internet of Things;Security;Testing;Turning;Generative Pre-trained transformer;Internet of Things;large language models;safety evaluation;cyber-physical systems},
  doi={10.1109/ACCESS.2026.3727159},
  ISSN={2169-3536},
  month={},}@ARTICLE{11479797,
  author={Goyal, Ishika and Sai, Siva and Gupta, Aahana and Chamola, Vinay},
  journal={IEEE Communications Standards Magazine}, 
  title={The Safety Frontier in LLMs: Risks, Defenses, and Open Challenges}, 
  year={2026},
  volume={},
  number={},
  pages={1-9},
  abstract={Large Language Models (LLMs) such as ChatGPT, Claude, and LLaMA are rapidly transforming domains including healthcare, education, law, and finance. However, their increasing adoption in high-stakes applications raises serious safety concerns. Without sufficient safeguards, LLM-powered AI systems are vulnerable to threats such as prompt injection, training data poisoning, model theft, denial-of-service through prompt abuse, misinformation generation, adversarial examples, model inversion, data leakage, and insider misuse. These vulnerabilities can produce harmful, biased, or misleading outputs, compromise privacy, and undermine trust. To address these risks, researchers have proposed safety approaches that aim to constrain and guide model behaviour, proactively detect and resist attacks, and incorporate ethical alignment into model design. Together, these methods form a multi-layered defence that combines preventive, detective, and corrective measures to improve LLM robustness and trustworthiness. This paper presents a comprehensive review of key safety mechanisms for LLMs, categorizing them into guardrails, red teaming, adversarial training, alignment techniques, jailbreak detection and prevention, watermarking, and fuzzing. For each category, recent advances are summarized, strengths and limitations are assessed, and open challenges are identified to support safer and more reliable real-world deployment of LLMs.},
  keywords={Feeds;Filtering;Filters;Feedback;Circuits;Circuits and systems;Communication systems;Internet of Things;Electronic mail;Internet},
  doi={10.1109/MCOMSTD.2026.3676030},
  ISSN={2471-2833},
  month={},}@INPROCEEDINGS{11603054,
  author={Osama, Mohamed and Tammam, Ashraf and Salah, Hisham and Gomaa, Ibrahim},
  booktitle={2026 IEEE International Conference on Smart Sustainable Systems for Computer and Engineering Applications (3SCEA)}, 
  title={Encoding Book Evasion Technique to Bypass LLMs Defenses}, 
  year={2026},
  volume={},
  number={},
  pages={466-475},
  abstract={The rise of LLMs has introduced a new opportunity in software devolvement, task automation, searching for information, etc. One of the cases where we find LLMs play a major role in web application and that makes LLMs a perfect attack vector for threat actors to use direct or indirect prompt injection attack to extract sensitive information about other users or other info that are not intended to be accessible and in other situation threat actors could try to jailbreak the model. One of the solution to outcome these attacks is to place an input filter that inspects the imputed prompt by the user and an output filter that inspects the response of the LLMs. Previous work in the field of Red Teaming AI had shown a different method for building prompts that can bypass the LLMs security, thus jailbreak the model, but when the model begins leaking sensitive information output filters will detect that and that could lead to operation failure. So the way to obfuscate the whole conversation between the adversary and the LLM in order to bypass input and output filter remain under research.},
  keywords={Large language models;Modeling;Encoding;Ciphers;Printing;Application programming interfaces;Filtering;Filters;Robots;Weighted sum model;LLMs;Jailbreak;SIEM;MITM;PII;WAF;Obfuscation;API;ASR},
  doi={10.1109/3SCEA68071.2026.11603054},
  ISSN={},
  month={April},}@INPROCEEDINGS{11717282,
  author={Singh, Vishwa Deep and Acharya, Siddhant and Kumar, Vishwas and Gupta, Shally},
  booktitle={2026 IEEE 5th World Conference on Applied Intelligence and Computing (AIC)}, 
  title={PhishRoute: Cost-Aware Multi-Agent Gating for Phishing Email Detection}, 
  year={2026},
  volume={},
  number={},
  pages={616-622},
  abstract={Published LLM-based phishing detectors route every inbound email through a frontier model, which is costly at enterprise scale and, less obviously, can be suboptimal: invoking an LLM on emails a cheap classifier already resolves confidently can add false positives rather than remove them. We present PhishRoute, a five-agent detector with a learned gating router that decides, per email, whether expensive LLM agents run at all. The cheap tier (URL heuristic, header authentication, 27-feature logistic regression, AUC 0.993) reaches F1=0.9780 at zero token cost on a sender-disjoint 4,131-email test set. The expensive tier (LLaMA 3.1-8B text agent; dual-corpus RAG over 8,085 legitimate / 7,819 phishing vectors) is invoked only when the router escalates. On an n=1,000 held-out sample, a gradient-boosting router (selected over logistic regression, decision trees, and an uncertainty-margin rule) matches always-invoking-the-LLM’s recall exactly (17 FN both) while improving precision (0.9857 vs. 0.9817) and cutting token cost 59.3% (917 vs. 2,254 tok/email); McNemar’s test finds zero cases where gating is wrong and always-LLM is right. This corrects an initial n=200 result whose apparent optimum did not survive a 5× -larger reevaluation – we report that correction transparently. We also report an adversarial-robustness probe (robust to HTML/URL obfuscation; vulnerable to LLM-generated phishing and prompt injection), calibration metrics, and a fine-tuned DistilBERT baseline that exceeds PhishRoute on raw F1 (0.9952) at the cost of requiring supervised fine-tuning. Temporal evaluation on 2023–2025 emails yields F1=0.9879 with no per-year degradation.},
  keywords={Electronic mail;Large language models;Phishing;Costing;Costs;Modeling;Printing;Testing;Retrieval augmented generation;Uniform resource locators;phishing detection;large language models;multi-agent systems;cost-aware routing;retrieval-augmented generation;email security},
  doi={10.1109/AIC70896.2026.11717282},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11593453,
  author={Malladi, Gayatri and Thamilarasu, Geethapriya},
  booktitle={2026 56th Annual IEEE International Conference on Dependable Systems and Networks (DSN)}, 
  title={RIPE-II: Retrieval In-Place Poisoning Evaluation with Indirect Injections}, 
  year={2026},
  volume={},
  number={},
  pages={800-812},
  abstract={Retrieval Augmented Generation (RAG) systems have enhanced the performance of Large Language Models (LLMs) by effectively addressing challenges such as hallucinations and generating irrelevant responses. However, integrating the RAG technique into LLMs introduces privacy risks and potential data leakage issues from the retrieval pipeline. Indirect Prompt Injections (IPIs) occur when hidden instructions inside retrieved documents slip into a model’s context as trusted evidence, exploiting weak guardrails in RAG systems and leading to unauthorized data leaks, ambiguous outcomes, and policy overrides. Existing defenses rely on brittle delimiter heuristics or limited retriever adjustments, leaving RAG systems vulnerable to adversarial directives blended seamlessly into retrieved content.In this paper, we present RIPE-II, a corpus-level benchmark that evaluates IPIs under a realistic content-poisoning threat model. RIPE-II constructs delimiter-free, position-aware poisoned corpora across multiple domains and includes both textual and visual injections. Our design explicitly models mid-document placement, chunking, truncation, and cross-component propagation, reflecting how enterprise RAG systems ingest and process content. We introduce a two-stage evaluation framework that separates retrieval exposure from generation-time compliance and distinguishes embedding-based similarity from semantic override using a calibrated LLM-based judge. Across biomedical, financial, scientific, open-domain question answering, including multi-hop reasoning and web passage retrieval settings, we find that poisoned documents can reach the final model context in up to 97% of queries and rank first in up to 94% of cases, showing that retriever and reranker choices substantially shape RAG security exposure. We further show that cosine-based attack scoring can underreport semantic compromise by more than 5×, demonstrating that lexical or embedding similarity alone is insufficient for evaluating indirect prompt injection risk.},
  keywords={Modeling;Toxicology;Ranking (statistics);Retrieval augmented generation;Erbium;Automatic speech recognition;Printing;Context;Optical character recognition;Large language models;Retrieval-Augmented Generation;Indirect Prompt Injections;Adversarial Retrieval;Multimodal Attacks},
  doi={10.1109/DSN69566.2026.00078},
  ISSN={2158-3927},
  month={June},}@ARTICLE{11627708,
