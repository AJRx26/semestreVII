@INPROCEEDINGS{11748581,
  author={Setu, Jahanggir Hossain and Sadik-Ul Islam Smaron, J. M. and Islam, Ashraful and Rahman, Rashedur and Amin, M. Ashraful},
  booktitle={2026 International Conference on Advanced Computing Technologies (ICACT)}, 
  title={Lightweight Transformer Models for Prompt Injection Detection: A Comparative Study of TinyBERT and ALBERT}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Large Language Models (LLMs) are embedded in chatbots, coding assistants and autonomous agents that accept untrusted user input as part of their operating context. This design creates an exploitable seam, prompt injection, where crafted text overrides or hijacks a model’s original instructions, has emerged as one of the most consequential attack vectors against deployed LLM systems. Yet, detection approaches are either heavyweight guard models unsuitable for low-latency deployment or heuristic filters with limited generalization. This study examines whether lightweight and computationally efficient transformer encoders can serve as effective detectors for prompt injection. Using the ‘deepset/prompt-injections’ corpus (662 prompts), language detection and machine translation were applied to unify a substantial non-English portion of the data, followed by Term Frequency-Inverse Document Frequency (TF-IDF) and t-distributed Stochastic Neighbor Embedding (t-SNE) projections to characterize class separability. Two compact architectures, e.g., Tiny Bidirectional Encoder Representations from Transformers (TinyBERT) and A Lite BERT (ALBERT), were fine-tuned on a stratified split and validated using 5-fold cross-validation to assess stability. A six-configuration ablation study further isolated the effects of class weighting, encoder freezing, sequence length, learning rate and weight decay on downstream performance. SHapley Additive exPlanations (SHAP)-based attribution was used to sanity-check whether predictions relied on semantically meaningful cues. ALBERT outperformed TinyBERT (0.990 vs. 0.980 test accuracy, 0.987 vs. 0.975 F1) and showed markedly lower cross-fold variance. The ablation results revealed that input truncation and elevated learning rates degraded performance more than class-weighting choices did. These findings indicate that methodological design is as consequential as architecture choice when building efficient, deployable prompt-injection detectors.},
  keywords={Modeling;Printing;Large language models;Training;Testing;Architecture;Computer architecture;Security;Tuning;Accuracy;Prompt Injection Detection;LLM Security;Adversarial NLP;ALBERT;TinyBERT;SHAP},
  doi={10.1109/ICACT70625.2026.11748581},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11681999,
  author={Behera, Abani Ranjan},
  booktitle={2026 International Conference on Emerging Technologies in Computing and Communication (ETCC)}, 
  title={Cloud Security Risks and Defense Architecture for Agentic AI Systems in Enterprise Environments}, 
  year={2026},
  volume={},
  number={},
  pages={1-5},
  abstract={The integration of cloud-hosted Large Language Models (LLMs) into enterprise agentic AI systems creates a significant new attack surface at the intersection of cloud security, network trust, and data privacy. Agentic AI systems—which autonomously invoke tools, query internal databases, and reason over multi-step workflows—risk exposing sensitive organisational data to external cloud providers, prompt injection via retrieved content, and unauthorised lateral tool access. This paper analyses the cloud and network security threat landscape for enterprise agentic AI deployments and proposes a defense-in-depth architecture comprising five controls: input guardrails, rolebased tool access control, output data loss prevention (DLP), end-to-end audit observability, and human-in-the-loop (HITL) oversight. A hybrid cloud/on-premise LLM deployment model is proposed for regulated workloads. The architecture is implemented using LangChain JS and mapped to GDPR, HIPAA, and ISO/IEC 27001:2022, providing a practical, standards-aligned security blueprint for enterprise cloud AI deployments.},
  keywords={Clouds;Modeling;Large language models;Tools;Architecture;Computer architecture;Artificial intelligence;Agentic AI;Cloud computing security;Network security;Cloud Security;Agentic AI;Large Language Models;Data Loss Prevention;Prompt Injection;Network Security;Zero Trust;LangChain JS;GDPR;HIPAA;ISO/IEC 27001},
  doi={10.1109/ETCC69750.2026.11681999},
  ISSN={},
  month={July},}@INPROCEEDINGS{11755134,
  author={Chokshi, Sunny},
  booktitle={2026 International Conference on Cybersecurity and AI-Based Systems (Cyber-AI)}, 
  title={Not All Adversarial Comments Are Equal: A Ranked Empirical Study of Twelve Comment Injection Attacks Against LLM-Based Code Vulnerability Detection}, 
  year={2026},
  volume={},
  number={},
  pages={779-784},
  abstract={Large language models are increasingly used to detect security vulnerabilities in source code, and prior work has shown that adversarial comments embedded in the code can suppress detection. What has not been established is whether different categories of adversarial comment differ in effectiveness, and which are most dangerous. This paper presents a controlled, statistically tested comparison of twelve adversarial comment injection strategies, organized into four mechanism families, against LLM-based code vulnerability detection. Using a benchmark of thirty code samples containing documented vulnerabilities across fourteen Common Weakness Enumeration categories, evaluated on two open-source code models for a total of 780 trials, we rank the twelve strategies by effectiveness and test whether the differences are significant. The strategies differ significantly (chi-square $=\mathbf{2 1. 6 0}, \mathbf{p}=\mathbf{0. 0 2 8}$). The most effective attacks were an authority claim (71.7% detection) and, notably, a simple assertion of personal authorial confidence (73.3%), which fooled the models nearly as often as a formal review claim despite asserting nothing verifiable about the code. Attacks that supplied a false premise of prior verification or safe context dominated the top of the ranking, while pressure-based and compliance-vocabulary attacks were largely ineffective. These results provide a ranked, mechanism-grouped taxonomy of adversarial comment attacks and identify which categories defenders should prioritize.},
  keywords={Codes;Modeling;Context;Signal detection;Ranking (statistics);Security;Testing;Reviews;Large language models;Vocabulary;vulnerability detection;adversarial machine learning;LLM code review;prompt injection;attack taxonomy;empirical evaluation;statistical analysis},
  doi={10.1109/Cyber-AI70573.2026.11755134},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11395658,
  author={Ahmad, Abid and Topu, Fayzuddin and Islam, Joyana and Gupta, Amit Banwari and Hassan, Md. Maruf},
  booktitle={2026 IEEE 5th International Conference on AI in Cybersecurity (ICAIC)}, 
  title={Identity-Spoofing Prompt Injection: Empirical Analysis of Instruction Leakage in Custom GPTs}, 
  year={2026},
  volume={},
  number={},
  pages={1-7},
  abstract={Custom GPTs allow creators to publish configurable large language model assistants by combining hidden system-level instructions with optional uploaded knowledge, concentrating sensitive creator-provided assets behind a conversational interface that is not a hardened security boundary. We measure confidentiality risk in store-prominent Custom GPTs under a prompt-only adversary model and focus on identity-spoofing prompt injection, where a user impersonates a privileged role (e.g., the creator) and frames disclosure as benign verification or debugging. Using a fixed four-stage protocol on a mid-May 2025 store snapshot (N=57), we observe unauthorised system-instruction disclosure in 87.7% (50/57) of targets, with consistently high rates across store categories. Conditional on Stage-1 success, 28/50 targets further exposed knowledge-base metadata and/or content when a knowledge base was available, indicating that instruction leakage can enable downstream disclosure steps. We further provide an evidence trace showing how identity claims and verification-style framing can shift targets into a compliance-oriented mode and accelerate cross-stage disclosure. Overall, the results position identity-spoofing as a distinct, reproducible prompt-injection strategy in store-prominent Custom GPTs and motivate layered mitigations spanning creator configuration and platform-level leakage monitoring.},
  keywords={Protocols;Large language models;Prevention and mitigation;Knowledge based systems;Focusing;Debugging;Metadata;Linguistics;Computer security;Monitoring;Large language models (LLMs);prompt injection;system prompt leakage;adversarial prompting;AI security},
  doi={10.1109/ICAIC67076.2026.11395658},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11337832,
  author={Obeng, Collins P and Narasinghe, Nethshan M and Striker, Ryan and Vazquez, Enrique Alvarez},
  booktitle={2025 Cyber Awareness and Research Symposium (CARS)}, 
  title={Security Framework for Agentic Home AI in Preventive Healthcare: Cyber Threats Worth Noting}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={The integration of agentic artificial intelligence (AI) into home-based preventive healthcare promises a new era of personalized, proactive wellness management. However, the autonomy of these systems introduces significant cybersecurity and data privacy challenges, particularly concerning the handling of Protected Health Information (PHI). This paper seeks to create awareness on some of the cyber threats' worth noting, and how a proposed locally hosted architectural model as a primary strategy can mitigate certain risks like prompt injection. The proposed architecture utilizes an open-source stacks-comprising n8n (an open-source workflow automation tool) for workflow orchestration, Ollama for serving Large Language Model (LLM) locally, and Supabase for on-premise vector data storage. A “dual-agent guardrail” system is introduced, featuring a dedicated input agent to detect and neutralize prompt injection attacks and an output agent to scan for and prevent PHI leakage, ensuring HIPAA compliance. Our findings conclude that while local hosting is a necessary foundation for establishing data sovereignty and mitigating external threats, it is insufficient on its own. It introduces new risks, including physical security vulnerabilities and a heightened insider threat potential. The dual-agent guardrail system provides a critical second layer of defense, addressing model-level vulnerabilities directly. This multi layered, defense-in-depth strategy, combining a sovereign infrastructure with intelligent, task-specific security agents, presents a risk reduction and practical framework for the secure deployment of agentic AI in personal healthcare.},
  keywords={Agentic AI;Data privacy;Automation;Large language models;Memory;Medical services;Vectors;Automobiles;Computer crime;LLM;agentic AI;cyber threats;cyber security;prompt injection;preventive health care;artificial intelligence},
  doi={10.1109/CARS67163.2025.11337832},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11647867,
  author={Abylkan, Batyrkhan and Serik, Darkan and Mussa, Askhar and Sapash, Syrym and Kurakbayev, Aibolat and Amanzholova, Saule},
  booktitle={2026 International Conference on Cybersecurity, Digital Forensics, and AI Applications (ICCSDFAI)}, 
  title={Agentic AI Security in IoMT: A PRISMA-Guided Scoping Review and Layered Threat–Defense Taxonomy}, 
  year={2026},
  volume={},
  number={},
  pages={991-996},
  abstract={The Internet of Medical Things (IoMT) enables continuous patient monitoring and clinical connectivity but substantially expands the healthcare cybersecurity attack surface. AI/ML is frequently proposed as a defense mechanism in IoMT literature, addressing intrusion detection, anomaly detection, authentication, privacy, and secure communication. Emerging Agentic AI integration may introduce a distinct risk layer through external retrieval, long-term memory, dynamic tool use, prompt-driven behavior, autonomous action, and multi-agent coordination. Because direct empirical evidence from live Agentic IoMT deployments remains limited, we conducted a PRISMA-ScR-guided scoping review to map anticipated vulnerabilities. The final corpus contained 19 academic sources plus four standards, frameworks, and guidance documents identified through a parallel targeted search, totaling 23 core sources. Findings indicate that AI/ML is primarily positioned defensively in IoMT literature, whereas agentic capabilities introduce transferred risks from broader LLM-agent security domains. We contribute a seven-layer threat–defense taxonomy and a focused research agenda for empirical validation rather than claims of real-world attack prevalence.},
  keywords={Artificial intelligence;Modeling;Tools;Reviews;Security;Large language models;Printing;Internet of Things;Memory;Medical services;Internet of Medical Things;agentic AI;cybersecurity;LLM agents;prompt injection;PRISMA-ScR;threat modeling;medical-device security},
  doi={10.1109/ICCSDFAI70505.2026.11647867},
  ISSN={},
  month={June},}@INPROCEEDINGS{11395764,
  author={Sudarsan, Shalini and Patel, Advait and Upadhyay, Charit and Gudur, Vaishnavi and Matam, Prashanthi},
  booktitle={2026 IEEE 5th International Conference on AI in Cybersecurity (ICAIC)}, 
  title={Secure Prompt Engineering Patterns for Cloud LLM Agents}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={There is a new security threat to be concerned with when using Large Language Model (LLM) agents on cloud platforms called prompt injection attacks. These injections have the ability to bait agents to perform unauthorized actions that end up exposing data, privilege escalation and the end-user misuse of resources. Although prompt injection in chatbots has been studied before, little focus has been put on the LLM agents, which could be integrated with cloud, where the effect is much stronger. The current paper proposes a type of Secure Prompt Engineering Patterns (SPEP) customized to cloud-specific use cases. We devise a taxonomy of threat vectors, both direct and indirect manipulations of prompts, and suggest reusable security patterns aimed at input sanitization, role-context separation, execution confirmation, capability restriction and chain-of-thought isolation. Organized testing on AWS, GCP, and Azure testbeds with over 200 adversarial prompts indicates that SPEP can decrease the success rates of attacks to below 8% (with negligible latency overhead (<50ms). These findings show that directed prompt engineering is an efficient, weightless protection when it comes to the LLM agents in cloud orchestration pipelines.},
  keywords={Cloud computing security;Pipelines;Taxonomy;Reinforcement learning;Time division multiplexing;Vectors;Real-time systems;Prompt engineering;Testing;Resilience;Prompt Injection;Secure Prompt Engineering;Cloud Security;LLM Agents;LLMSecOps;Adversarial Prompts;Zero-Trust Architecture;AI Safety;Cloud Orchestration;Trustworthy AI;Defense Patterns;Autonomous Agents},
  doi={10.1109/ICAIC67076.2026.11395764},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11773575,
  author={Charchaoui, Ilias and Zouhair, Abdelhamid and Ben Abdel Ouahab, Ikram},
  booktitle={2026 9th International Conference on Networking, Intelligent Systems & Security (NISS)}, 
  title={Cyber AI: A Review of Artificial Intelligence for Offensive and Defensive Web Security}, 
  year={2026},
  volume={},
  number={},
  pages={62-73},
  abstract={The rapid advancement of artificial intelligence (AI) is transforming modern cybersecurity, reshaping both offensive and defensive strategies in web application security. Recent developments enable automated vulnerability discovery, exploitation, and mitigation through machine learning, deep learning, reinforcement learning, and large language model–based agents. This study presents a systematic analysis of numerous research works addressing AI-driven techniques for detecting and exploiting common web vulnerabilities, including SQL injection, cross-site scripting, and command injection. The review highlights the growing adoption of intelligent penetration testing frameworks, autonomous agents, and data driven defense mechanisms that enhance scalability and accuracy compared to traditional security tools. At the same time, emerging risks associated with autonomous AI systems and prompt injection attacks introduce significant ethical, operational, and regulatory challenges. Current findings indicate that while AI powered security solutions improve threat detection and response capabilities, limitations related to dataset bias, real-world validation, and robustness against adversarial manipulation remain unresolved.},
  keywords={Modeling;Artificial intelligence;Security;Signal detection;Machine learning;Cross-site scripting;Accuracy;Computer security;Large language models;Deep learning;artificial intelligence;cybersecurity;offensive ai;defensive ai;web application security;vulnerability assess ment;autonomous agents},
  doi={10.23919/NISSCPS00007.2026.00018},
  ISSN={},
  month={April},}@INPROCEEDINGS{11008269,
  author={Brach, William and Petrik, Matej and Košt’ál, Kristián and Ries, Michal},
  booktitle={2025 37th Conference of Open Innovations Association (FRUCT)}, 
  title={Ghosts in the Markup: Techniques to Fight Large Language Model-Powered Web Scrapers}, 
  year={2025},
  volume={},
  number={},
  pages={37-46},
  abstract={The rise of large language models (LLMs) has revolutionized web scraping, creating new challenges for website owners seeking to protect valuable content. Traditional defenses such as CAPTCHAs and rate limiting are insufficient against sophisticated AI-driven scraping systems. Current state-of-the-art approaches primarily rely on server-side implementations requiring significant computational resources, IP-based blocking mechanisms, and complex pattern recognition systems that struggle to distinguish between legitimate users and advanced AI scrapers. This paper presents a two-step client-side defense strategy that combines content obfuscation and defensive prompt injection. Our approach dynamically alters HTML structure by wrapping characters in span elements with randomized content and strategic CSS rules while simultaneously injecting carefully crafted prompts designed to manipulate LLM extraction behavior. Experimental evaluation on three diverse datasets demonstrates the effectiveness of this combined approach, achieving near-zero extraction rates (0.6% Exact Match, 0.030 ROUGE-L) for structured content while maintaining a seamless user experience. Performance analysis shows that our method increases the HTML document file size by approximately 1773%, compared to over 6593% for alternative techniques such as Content Overload, providing a practical balance between security and usability while keeping rendering times comparable to unprotected pages. This lightweight implementation integrates seamlessly with existing Web infrastructure without requiring significant computational resources, addressing key limitations of server-side defenses while providing robust protection against unauthorized LLM-based content extraction. For further information, source code, and associated resources, please refer to the source code repository 1.},
  keywords={Source coding;Large language models;Rendering (computer graphics);User experience;HTML;Security;Resource management;Data mining;Protection;Wrapping},
  doi={10.23919/FRUCT65909.2025.11008269},
  ISSN={2305-7254},
  month={May},}@INPROCEEDINGS{11029790,
  author={Pedro, Rodrigo and Coimbra, Miguel E. and Castro, Daniel and Carreira, Paulo and Santos, Nuno},
  booktitle={2025 IEEE/ACM 47th International Conference on Software Engineering (ICSE)}, 
  title={Prompt-to-SQL Injections in LLM-Integrated Web Applications: Risks and Defenses}, 
  year={2025},
  volume={},
  number={},
  pages={1768-1780},
  abstract={Large Language Models (LLMs) have found widespread applications in various domains, including web applications with chatbot interfaces. Aided by an LLM-integration middleware such as LangChain, user prompts are translated into SQL queries used by the LLM to provide meaningful responses to users. However, unsanitized user prompts can lead to SQL injection attacks, potentially compromising the security of the database. In this paper, we present a comprehensive examination of prompt-to-SQL ($\mathbf{P}_{2} \mathbf{S Q L}$) injections targeting web applications based on frameworks such as LangChain and LlamaIndex. We characterize $\mathrm{P}_{2} \text{SQL}$ injections, exploring their variants and impact on application security through multiple concrete examples. We evaluate seven state-of-the-art LLMs, demonstrating the risks of $P_{2}$ SQL attacks across language models. By employing both manual and automated methods, we discovered $\mathrm{P}_{2} \text{SQL}$ vulnerabilities in five real-world applications. Our findings indicate that LLMintegrated applications are highly susceptible to $\mathrm{P}_{2} \text{SQL}$ injection attacks, warranting the adoption of robust defenses. To counter these attacks, we propose four effective defense techniques that can be integrated as extensions to the LangChain framework.},
  keywords={Large language models;Modeling;Structured Query Language;Databases;Generative Pre-trained transformer;Printing;Testing;Signal detection;Electronic mail;Security;SQL;Prompt Injection;Large Language Models;Prompt-to-SQL},
  doi={10.1109/ICSE55347.2025.00007},
  ISSN={1558-1225},
  month={April},}@INPROCEEDINGS{10827351,
  author={Kim, Minjae and Kwon, Taehyeong and Shim, Kibeom and Kim, Beonghoon},
  booktitle={2024 15th International Conference on Information and Communication Technology Convergence (ICTC)}, 
  title={Protection of LLM Environment Using Prompt Security}, 
  year={2024},
  volume={},
  number={},
  pages={1715-1719},
  abstract={The emergence of generative AI has also brought significant attention to large language models (LLMs). LLMs are a type of generative AI that can understand users' commands and respond accordingly by generating natural human language text. However, such advancements in LLM technology have also been accompanied by an increase in hostile attempts to use the technology for malicious attacks. For example, some may execute a jailbreak on an LLM, allowing it to generate malicious content, and others can use LLMs to generate vulnerability exploit codes, taking advantage of their powerful capabilities to attempt malicious attacks. Furthermore, there are increasing numbers of cases reported where, once inadvertently entered, personally identifiable information (PII) is used to train LLMs without consent. Preventing the malicious use of LLMs and their unauthorized use of PII requires thoroughly scanning their inputs and outputs. Specifically, LLMs' inputs and outputs need to be checked for the presence of PII, malicious codes, malicious URLs, and commands to execute prompt injections. This paper presents a comprehensive description of the LLM prompt detection system (LPDS) designed to detect the presence of PII, malicious codes, malicious URLs, and prompt injection commands in LLMs' inputs and outputs. The effectiveness of the LPDS in detecting LLMs' unauthorized use of PII and LLM-based malicious attacks is also assessed.},
  keywords={Data privacy;Codes;Generative AI;Large language models;Malware;Information and communication technology;Security;Protection;Identification of persons;Convergence;LLM;Privacy Protection;AI Security;Prompt Detection},
  doi={10.1109/ICTC62082.2024.10827351},
  ISSN={2162-1241},
  month={Oct},}@INPROCEEDINGS{11691927,
  author={Wang, Yizhu and Chen, Sizhe and Alkhudair, Raghad and Alomair, Basel and Wagner, David},
  booktitle={2026 IEEE Conference on Secure and Trustworthy Machine Learning (SaTML)}, 
  title={Defending Against Prompt Injection with DataFilter}, 
  year={2026},
  volume={},
  number={},
  pages={139-157},
  abstract={When large language model (LLM) agents are increasingly deployed to automate tasks and interact with untrusted external data, prompt injection emerges as a significant security threat. By injecting malicious instructions into the data that LLMs access, an attacker can arbitrarily override the original user task and redirect the agent toward unintended, potentially harmful actions. Existing defenses either require access to model weights (fine-tuning), incur substantial utility loss (detection-based), or demand non-trivial system redesign (system-level). Motivated by this, we propose DataFilter, a test-time model-agnostic defense that removes malicious instructions from the data before it reaches the backend LLM. DataFilter is trained with supervised fine-tuning on simulated injections and leverages both the user’s instruction and the data to selectively strip adversarial content while preserving benign information. Across multiple benchmarks, DataFilter consistently reduces the prompt injection attack success rates to near zero while maintaining the LLMs’ utility. DataFilter delivers strong security, high utility, and plug-and-play deployment, making it a strong practical defense to secure black-box commercial LLMs against prompt injection. Our DataFilter model is released here for immediate use, with the code to reproduce our results here.},
  keywords={Filtering;Filters;Large language models;Modeling;Security;Tools;Automatic speech recognition;Printing;Training;Generative Pre-trained transformer;Large Language Models (LLMs);Prompt Injection;Data Filtering;LLM Security},
  doi={10.1109/SaTML68715.2026.00017},
  ISSN={},
  month={March},}@INPROCEEDINGS{11573479,
  author={Wang, Yanting and Geng, Runpeng and Chen, Ying and Jia, Jinyuan},
  booktitle={2026 IEEE Symposium on Security and Privacy (SP)}, 
  title={AttnTrace: Contextual Attribution of Prompt Injection and Knowledge Corruption}, 
  year={2026},
  volume={},
  number={},
  pages={4320-4338},
  abstract={Long-context large language models (LLMs), such as GPT-5, Gemini-2.5-Pro, and Claude-Sonnet-4, are increasingly used to empower advanced AI systems, including retrievalaugmented generation (RAG) systems and autonomous agents. In these systems, an LLM receives an instruction along with a context-often consisting of texts retrieved from a knowledge database, memory, or the Internet-and generates a response that is contextually grounded by following the instruction. Many recent studies showed that these LLM-empowered systems are vulnerable to prompt injection and knowledge corruption attacks, where an attacker can inject malicious texts into the context such that the LLM generates an output as the attacker desires. One important research question is how to trace back to these malicious texts from a long context in leading to the attacker-desired output of the LLM. While significant efforts have been made, state-of-the-art solutions still achieve a sub-optimal performance and/or incur high computation cost. In this work, we propose AttnTrace, a new context traceback method based on the attention weights produced by an LLM for a prompt. To effectively utilize attention weights, we introduce two techniques designed to enhance the effectiveness of AttnTrace, and we provide theoretical insights for our design choice. We also perform a systematic evaluation for AttnTrace. The results demonstrate that AttnTrace is more accurate and efficient than existing state-of-the-art context traceback methods. We also show AttnTrace can improve state-of-the-art methods in detecting prompt injection under long contexts through the attribution-before-detection paradigm. As a real-world application, we demonstrate that AttnTrace can effectively pinpoint injected instructions in a paper designed to manipulate LLM-generated reviews. The code and data are available: https://github.com/Wang-Yanting/AttnTrace.},
  keywords={Context;Large language models;Modeling;Printing;Retrieval augmented generation;Equations;Reviews;Signal detection;Toxicology;Art;llm;prompt injection attack;knowledge corruption attack;contextual attribution},
  doi={10.1109/SP63933.2026.00198},
  ISSN={2375-1207},
  month={May},}@INPROCEEDINGS{11189427,
  author={Zhao, Yumei and Li, Xiaoming},
  booktitle={2025 IEEE 5th International Conference on Computer Communication and Artificial Intelligence (CCAI)}, 
  title={A Novel Security Framework against Prompt Injection Attacks}, 
  year={2025},
  volume={},
  number={},
  pages={509-514},
  abstract={Large Language Models (LLMs) have demonstrated remarkable capabilities in natural language processing, but their widespread adoption has introduced critical security vulnerabilities, particularly prompt injection attacks-where attackers design input prompts to induce the model to generate malicious or inappropriate content, potentially leading to sensitive information leakage, execution of malicious instructions, or other security risks. Traditional defense mechanisms, which typically rely on keyword filtering or simple rule matching, struggle to cope with the increasingly complex and dynamically evolving attack methods. To address these risks, researchers have developed defense mechanisms ranging from input sanitization and adversarial training to runtime monitoring.This paper proposes a security framework based on LLMs, aiming to conduct an in-depth analysis of the threat posed by prompt injection attacks and achieve comprehensive risk monitoring of model outputs. The framework analyzes input prompts from multiple dimensions to identify malicious prompts and their potential attack behaviors while simultaneously monitoring and evaluating the output generated by the LLM. Through in-depth analysis of attack techniques and monitoring of model outputs, the proposed framework can effectively recognize and defeat various types of attacks, reduce the potential threats posed by prompt injection attacks, and ensure the security and reliability of LLMs in practical applications. Experimental results show that the framework can achieve over 93% detection accuracy.},
  keywords={Training;Analytical models;Privacy;Accuracy;Runtime;Computational modeling;Natural language processing;Security;Reliability;Monitoring;Index Terms-Large Language Models;Prompt Injection Attacks;Security;Output Monitoring},
  doi={10.1109/CCAI65422.2025.11189427},
  ISSN={},
  month={May},}@INPROCEEDINGS{11508065,
  author={P, Nishith and Panda, Niharika},
  booktitle={2026 International Conference on Smart Futuristic Technology}, 
  title={PRISM: Prompt Red-teaming and Injection Simulation for Models – A Scalable Framework for Evaluating LLM Robustness Against Malicious Prompts}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={The rapid growth in the adoption of Large Language Models has brought with it some significant security vulnerabilities-one of which is prompt injection attacks. These attacks manipulate the behavior of LLMs using malicious user input, leading to the compromise of system integrity and the production of unintended or harmful output. Traditional detection approaches often cannot keep pace with the complexity and diversity of such attacks. We address this gap by presenting PRISM-Prompt Red-teaming and Injection Simulation for Models-a scalable framework designed to comprehensively assess the robustness of LLMs against adversarial prompts in a systematic manner. PRISM leverages a distributed computing architecture, utilizing Hadoop MapReduce and Ollama, to automatically assess LLM responses against a wide range of prompt variations, along with temperature configurations. It computes similarity-based measures from the large corpus of known prompt injection attempts that PRISM will process to describe model performance and identify successful attack vectors. The proposed work outlines the architecture of PRISM, reports on some initial exploratory data analysis of the HackAPrompt dataset, and demonstrates the ability of the framework to provide a complete, scalable, and automated solution for both LLM security auditing and red-teaming.},
  keywords={Modeling;Large language models;Security;Temperature;Manuals;Printing;Signal detection;Conferences;Distance measurement;Robustness;Large Language Models;LLM Security;Prompt Injection;Red-Teaming;Hadoop;Big Data;Cybersecurity;Model Robustness},
  doi={10.1109/ICSFT66733.2026.11508065},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{11729723,
  author={Gao, Yuan and He, Jinwen and Zhao, Yue and Chen, Kai},
  booktitle={2026 International Joint Conference on Neural Networks (IJCNN)}, 
  title={Context-Construction-Based Prompt Injection in Document-Centric LLM Decision Systems}, 
  year={2026},
  volume={},
  number={},
  pages={1-8},
  abstract={Large Language Models (LLMs) are increasingly deployed in document-centric workflows such as resume screening and academic peer review, where uploaded files are automatically parsed and converted into model input. This processing pipeline introduces new security risks: hidden content embedded in documents may be extracted by parsers and incorporated into the LLM context without being visible to human users.Most existing prompt injection research focuses on inserting explicit or obfuscated commands, and largely ignores how document structure and parser behavior affect whether injected content reliably enters the model’s context. In this work, we show that such placement instability significantly limits the effectiveness of document-level attacks in practice. To address this issue, we propose ConStruct, a context-construction-based prompt injection framework for text-extraction-based document pipelines that jointly considers structural placement and content formulation. ConStruct enforces structure-aware placement to ensure that injected text consistently appears at salient positions across common PDF parsers, and uses fact-based, non-imperative statements that blend naturally with task-relevant context.We evaluate ConStruct in two representative document-driven scenarios, resume screening and academic paper review, across multiple real-world systems, parsers, and detection mechanisms. Experimental results show that ConStruct achieves up to 67.4% higher resume matching scores and 94.1% higher paper review ratings relative to the original documents, while maintaining near-perfect evasion with rates above 99.47%.},
  keywords={Context;Modeling;Large language models;Resumes;Reviews;Construction;Signal detection;Printing;Manuals;Pipelines;large language models;document security;prompt injection attacks;natural language processing},
  doi={10.1109/IJCNN69854.2026.11729723},
  ISSN={2161-4407},
  month={June},}@ARTICLE{11675795,
  author={Ganapathi Kamath, H. and Sudhina Kumar, G. K. and Samanth, Snehal},
  journal={IEEE Access}, 
  title={A Systematic Literature Review of Intelligent Anomaly Detection and Threat Analysis Using LLMs in Quantum-Aware Cyber Systems}, 
  year={2026},
  volume={14},
  number={},
  pages={139573-139594},
  abstract={AI-driven cyber attacks are growing in number, precision, and complexity. Large Language Models (LLMs), which are AI systems capable of understanding and generating human language, and quantum computing are simultaneously reshaping the cybersecurity threat landscape, creating an urgent need for intelligent, quantum-aware cyber defense. This paper presents a Systematic Literature Review (SLR) following the Preferred Reporting Items for Systematic Reviews and Meta-Analyses (PRISMA) framework, yielding 74 peer-reviewed studies from 2015 to 2026 across five themes: AI-based threat analysis, LLM applications in cybersecurity, anomaly detection and Advanced Persistent Threat (APT) identification, deep-learning intrusion detection systems, and post-quantum cryptography (PQC). The review finds that LLMs are deployed not only to classify attacks but to reason about them reading logs, generating detection rules, and supporting incident response. Six critical gaps are identified: scarce public APT datasets (G1), hallucination risk in security-critical LLM deployments (G2), absence of lightweight PQC for IoT (G3), no unified quantum-aware AI framework (G4), insufficient real-time edge-detection latency guarantees (G5), and unverified LLM robustness against adversarial prompt injection in production pipelines (G6).},
  keywords={Modeling;Reviews;Artificial intelligence;Computer security;Security;Anomaly detection;Internet of Things;Surveys;Signal detection;Large language models;Large language models (LLMs);quantum-aware security;APT detection;post-quantum cryptography;intelligent cyber infrastructure;CRYSTALS-Kyber;FALCON-512;retrieval-augmented generation (RAG)},
  doi={10.1109/ACCESS.2026.3729667},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11126597,
  author={Rahman, Md Abdur and Shahriar, Hossain and Francia, Guillermo and Wu, Fan and Cuzzocrea, Alfredo and Rahman, Muhammad and Faruk, Md Jobair Hossain and Ahamed, Sheikh Iqbal},
  booktitle={2025 IEEE 49th Annual Computers, Software, and Applications Conference (COMPSAC)}, 
  title={Fine-tuned Large Language Models (LLMs): Improved Prompt Injection Attacks Detection}, 
  year={2025},
  volume={},
  number={},
  pages={1033-1039},
  abstract={Large language models (LLMs) are becoming a popular tool as they have significantly advanced in their capability to tackle a wide range of language-based tasks. However, LLMs applications are highly vulnerable to prompt injection attacks, which poses a critical problem. These attacks target LLMs applications through using carefully designed input prompts to divert the model from adhering to original instruction, thereby it could execute unintended actions. These manipulations pose serious security threats which potentially results in data leaks, biased outputs, or harmful responses. This project explores the security vulnerabilities in relation to prompt injection attacks. To detect whether a prompt is vulnerable or not, we follows two approaches: 1) a pre-trained LLM, and 2) a fine-tuned LLM. Then, we conduct a thorough analysis and comparison of the classification performance. Firstly, we use pre-trained XLM-RoBERTa model to detect prompt injections using test dataset without any fine-tuning and evaluate it by zero-shot classification. Then, this proposed work will apply supervised fine-tuning to this pre-trained LLM using a task-specific labeled dataset from deepset in huggingface, and this fine-tuned model achieves impressive results with 99.13% accuracy, 100% precision, 98.33% recall and 99.15% F1-score thorough rigorous experimentation and evaluation. We observe that our approach is highly efficient in detecting prompt injection attacks.},
  keywords={Training;Accuracy;Large language models;Prevention and mitigation;Computational modeling;Software;Security;Faces;Prompt injections;Large Language Models;Fine-Tuning LLMs},
  doi={10.1109/COMPSAC65507.2025.00134},
  ISSN={2836-3795},
  month={July},}@INPROCEEDINGS{11539212,
  author={Vijayakumar, Yuktha and J, Vishnu Praba A and Shunmuganathan, Saraswathi},
  booktitle={2026 12th International Conference on Communication and Signal Processing (ICCSP)}, 
  title={Detection of Prompt Attacks in LLMs}, 
  year={2026},
  volume={},
  number={},
  pages={875-880},
  abstract={LLMs (Large Language Models) used in practical implementations have been identified to be very vulnerable to direct prompt injection attacks: when hostile users trigger LLMs by providing input that leads to the LLM ignoring its own instruction and safety protocols/settings. LLMs with existing solutions meant to mitigate prompt injection from being successful, such as static filters and single-stage classifiers, would not be effective against obfuscated, adaptive, and multi-turn prompt injection attacks. This paper describes a new technique called Adversarial Robust Multi-layer Training (ARM-LT) which is real-time, model-agnostic, and designed to detect direct prompt injections at the prompt level. It uses structural prompt segmentation, canonical rewriting of multi-turn prompts, and perplexity based anomaly detection to identify hidden malicious intent before executing the LLM. The ARM-LT framework uses an iterative adversarial training loop in order to provide added robustness to the detection system against adaptive attackers by repeatedly reinforcing the detection system with semantically based adversarial prompt injection attempts. Evaluated a dataset with 78,558 direct prompt injection samples across 6 domains, ARM-LT produces significantly lower attack success rates than traditional machine learning baselines and also supports low inference overhead. This evidence shows that the need for dedicated security layers is critical to ensuring prompt injection is reliably prevented in any LLM integrated system.},
  keywords={Modeling;Signal detection;Arm;Turning;Printing;Generative Pre-trained transformer;Training;Equations;Security;Accuracy;prompt injection detection;LLM security;adversarial training;multi-turn attacks;perplexity analysis},
  doi={10.1109/ICCSP68173.2026.11539212},
  ISSN={2836-1873},
  month={April},}@INPROCEEDINGS{11703014,
  author={Vummaneni, Naga Sujitha and Kumar, Ishan and Mittal, Adarsh and Bharadwaj, Srilakshmi and Varshney, Himani},
  booktitle={2026 Technology and Innovation Conference (TIC)}, 
  title={Machine Learning for Modern Cybersecurity: Trend-Driven Architectures, Threat Models, and Quantitative Evaluation}, 
  year={2026},
  volume={},
  number={},
  pages={1-12},
  abstract={Machine learning (ML) has become a default substrate for contemporary cybersecurity—from network intrusion detection and malware classification to phishing defense and security analytics over cloud telemetry. At the same time, cybersecurity is now a first-class stress test for ML: adversaries actively manipulate inputs, labels, data pipelines, and even model supply chains. Recent trends amplify both promise and risk: transformer backbones that learn directly from raw traffic or byte streams; self-supervised pretraining over petabyte-scale logs; federated and privacy-preserving learning at the network edge; and agentic large language model (LLM) copilots that triage incidents and generate remediation steps. This paper presents a complete, quantitative research study of ML-for-cybersecurity under these trends. We propose a threat-aware end-to-end pipeline, GuardML, that integrates (i) representation learning for heterogeneous security signals, (ii) robustness layers against evasion/poisoning/extraction, and (iii) operational guardrails for deployment (calibration, abstention, provenance-aware retrieval for RAG). We develop reproducible experimental methodology and stage-wise energy/latency models, then evaluate on a curated multi-domain benchmark protocol (TRISHIELD) spanning network intrusion, malware, and phishing. Across tasks, a trendaligned transformer stack achieves macro-F1 scores of 0.91 for NIDS, 0.94 for malware, and 0.95 for phishing, representing improvements of 4–11 points over gradient-boosted decision tree baselines. Under adversarial evasion, our guardrail-enhanced models maintain true positive rates of 0.91 at 0.1% false positive rate for NIDS compared to 0.71 for undefended baselines. We show that lightweight, composable guardrails reduce attack success rates by 32–61% with only 7–9% latency overhead, and we derive five actionable design rules linking model choice, feature exposure, and security posture.},
  keywords={Modeling;Security;Labeling;Sequences;Sequential analysis;Signal detection;Retrieval augmented generation;Toxicology;Training;Transformers;Cybersecurity;machine learning;adversarial ML;intrusion detection;malware detection;prompt injection;retrieval poisoning;robust learning;transformer models},
  doi={10.1109/TIC68483.2026.11703014},
  ISSN={},
  month={June},}@INPROCEEDINGS{11708210,
  author={Gentyala, Sunil and Reddy, Y. Geetha and Pendyala, Manasa and Gatla, Vishnu and Manoj, Sundarigari and Shaik, Ruhisulthana},
  booktitle={2026 6th International Conference on Soft Computing for Security Applications (ICSCSA)}, 
  title={A Unified Mathematical Framework for Secure Multi-Agent Large Language Model Pipelines}, 
  year={2026},
  volume={},
  number={},
  pages={1-8},
  abstract={Modern AI systems rarely rely on a single model: a coder agent drafts a module, a QA agent reviews it, and a deployment agent ships it. Three LLMs share a pipeline with no cryptographic cross-verification, so an attack propagates silently to every downstream agent. We identify four coupled failure modes at this inter-agent surface: cascading alignment drift, identity spoofing, cross-agent prompt injection, and temporal adversarial manipulation, and introduce TRACE-MAS, a framework grounded in contraction theory, zero-knowledge cryptography, and statistical change detection that addresses all four with three composable guarantees: a chain-lengthindependent drift envelope, a per-round rogue-acceptance bound, and a temporal miss-probability bound. We validate the framework against an open-source reference implementation across more than 24,300 trials spanning nine experiment families, the original theorem-directed suites plus jailbreak, indirectinjection, malicious-tool-invocation, compromised-verifierquorum, and 1-to-50-agent scalability scenarios, surfacing and patching two genuine evasion vectors in the reference behavioral scorer. We show how the verifier-sidecar architecture maps onto AutoGen, CrewAI, LangGraph, and the OpenAI Agents SDK, with the LangGraph integration demonstrated as working, executed code, and compare TRACE-MAS against existing multiagent security proposals across six capability dimensions. We report a ZKP instantiation analysis (Groth16 vs. PLONK), a parameter-calibration guide with a worked example, and a discussion of deployment challenges and threats to validity.},
  keywords={Modeling;Signal detection;Security;Printing;Windows;Protocols;Tools;Pipelines;Large language models;Equations;multi-agent systems;alignment drift;zero-knowledge proofs;prompt injection;agent-to-agent authentication;temporal adversarial attacks;contraction theory;LLM pipeline security;empirical validation;multi-agent framework integration},
  doi={10.1109/ICSCSA69367.2026.11708210},
  ISSN={},
  month={Aug},}@ARTICLE{11563638,
  author={Yang, Yuchen and Li, Yiming and Yao, Hongwei and Yang, Bingrun and He, Yiling and Zhang, Tianwei and Tao, Dacheng and Qin, Zhan},
  journal={IEEE Transactions on Dependable and Secure Computing}, 
  title={ShadowCode: Toward (Automatic) External Prompt Injection Attack Against Code LLMs}, 
  year={2026},
  volume={23},
  number={5},
  pages={10527-10540},
  abstract={Recent advancements have led to the widespread adoption of code-oriented large language models (Code LLMs) for programming tasks. Despite their success in deployment, their security research is left far behind. This paper introduces a new attack paradigm: (automatic) external prompt injection against Code LLMs, where attackers generate concise, non-functional induced perturbations and inject them within a victim’s code context. These induced perturbations can be disseminated through commonly used dependencies (e.g., packages or RAG’s knowledge base), manipulating Code LLMs to achieve malicious objectives during the code completion process. Compared to existing attacks, this method does not necessitate control over the model’s training process, unlike backdoor attacks, and can achieve specific malicious objectives that are challenging for adversarial attacks. Furthermore, we propose ShadowCode, a simple yet effective method that automatically generates induced perturbations based on code simulation to achieve effective and stealthy external prompt injection. ShadowCode designs its perturbation optimization objectives by simulating the victim’s code contexts and employs a greedy optimization approach with two enhancement modules: forward reasoning enhancement and keyword-based perturbation design. We evaluate our method across 13 distinct malicious objectives, generating 31 threat cases spanning three popular programming languages. Our results demonstrate that ShadowCode successfully attacks three representative open-source Code LLMs (achieving up to a 97.9% attack success rate) and two mainstream commercial Code LLM-integrated applications (with over 90% attack success rate) across all threat cases, using only a 12-token non-functional induced perturbation.},
  keywords={Codes;Modeling;Automatic speech recognition;Large language models;Optimization;Design methodology;Context;Python;Java;Training;Code-oriented large language models;prompt injection attack;code security;AI security},
  doi={10.1109/TDSC.2026.3703498},
  ISSN={1941-0018},
  month={Sep.},}@INPROCEEDINGS{11491276,
  author={Islam, Md. Mazharul and Ahmed, Mubasshir and Khan, Niaz Ashraf},
  booktitle={2025 28th International Conference on Computer and Information Technology (ICCIT)}, 
  title={CPS-Guard: Defensive Architectures for Securing Large Language Models in Cyber-Physical Systems}, 
  year={2025},
  volume={},
  number={},
  pages={2802-2807},
  abstract={Cyber-physical systems (CPS) are increasingly adopting large language models (LLMs) for log analysis, operator support, and anomaly triage. While LLMs enable powerful reasoning and flexible natural-language interaction, their probabilistic and opaque behavior introduces new attack surfaces, including prompt injection, adversarial manipulation, and privacy leakage. Existing CPS defenses largely assume deterministic models and do not account for LLM-specific threats, whereas current LLM safety work rarely targets real-time, safety-critical control environments. To bridge this gap, we propose CPS-Guard, a defense-in-depth architecture for LLM-enabled CPS that operates under advisory-only semantics. CPS-Guard combines secure prompt handling, explicit threat modeling, a deterministic safety validator with policy and bounds checking, and anomaly-based veto over plant telemetry. We implement CPS-Guard as middleware between CPS controllers and an aligned LLM, and evaluate it on 300 synthetically generated adversarial inputs spanning prompt injection, adversarial perturbations, and poisoning-style triggers. Compared to an unprotected LLM advisory baseline, CPS-Guard reduces failure rates by more than 85 % while incurring only 10 18 % additional latency across small to large CPS workloads. These results indicate that system-level hardening can make LLM-assisted CPS substantially more robust without violating real-time constraints.},
  keywords={Telemetry;Aerospace and electronic systems;Filtering;Filters;Central Processing Unit;System-on-chip;Feedback;Circuits;Circuits and systems;Electronic circuits;Cyber-Physical Systems (CPS);Large Language Models (LLMs);Prompt Injection;Adversarial Robustness;Anomaly Detection;Defense-in-Depth;LLM Security},
  doi={10.1109/ICCIT68739.2025.11491276},
  ISSN={2474-9656},
  month={Dec},}@ARTICLE{11773338,
  author={Xu, Wenrui and Parhi, Keshab K.},
  journal={IEEE Circuits and Systems Magazine}, 
  title={A Survey of Attacks on Large Language Models [Feature]}, 
  year={2026},
  volume={26},
  number={4},
  pages={10-41},
  abstract={Large language models (LLMs) and LLM-based agents have been widely deployed in a wide range of applications in the real world, including healthcare diagnostics, financial analysis, customer support, robotics, and autonomous driving, expanding their powerful capability of understanding, reasoning, and generating natural language. However, the wide deployment of LLM-based applications exposes critical security and reliability risks, such as the potential for malicious misuse, privacy leakage, and service disruption that weaken user trust and undermine societal safety. This article provides a systematic overview of the details of adversarial attacks targeting both LLMs and LLM-based agents. These attacks are organized into three phases in LLMs: Training-Phase Attacks, Inference-Phase Attacks, and Availability & Integrity Attacks. For each phase, we analyze the details of representative and recently introduced attack methods along with their corresponding defenses. We hope our survey will provide a good tutorial and a comprehensive understanding of LLM security, especially for attacks on LLMs. We desire to raise attention to the risks inherent in widely deployed LLM-based applications and highlight the urgent need for robust mitigation strategies for evolving threats.},
  keywords={Large language models;Natural language processing;Risk management;Cyberattack;Computer security;Adversarial machine learning;Computer network management;Surveys;Tutorials;Threat assessment;LLM security;backdoor;jailbreaking;prompt injection;denial of service;watermarking;LLM-based agent},
  doi={10.1109/MCAS.2026.3708070},
  ISSN={1558-0830},
  month={Fourthquarter},}@INPROCEEDINGS{11745123,
  author={Erdoğan, Melike Nur and Kanburoğlu, Ali Buğra},
  booktitle={2026 11th International Conference on Computer Science and Engineering (UBMK)}, 
  title={BPI-Guard: A Bilingual Prompt Injection Detector for Turkish and English}, 
  year={2026},
  volume={},
  number={},
  pages={93-98},
  abstract={Prompt injection attacks have emerged as a major security threat for LLM-based systems, while existing detection approaches are predominantly developed and evaluated in English. This creates a substantial performance gap in low-resource languages such as Turkish, where publicly available prompt injection datasets are scarce and robust detection remains challenging. In this work, we address multilingual prompt injection detection by constructing a bilingual Turkish-English dataset and iteratively refining it through benchmark-driven error analysis and targeted data augmentation. The resulting dataset contains over 23,000 labeled samples covering a diverse range of prompt injection and benign scenarios. Using this dataset, we fine-tune XLM-RoBERTa for binary prompt injection classification and release the resulting model as BPI-Guard (Bilingual Prompt Injection Guard). We evaluate BPI-Guard on both our held-out test set and publicly released external benchmarks. Experimental evaluation demonstrates that BPI-Guard achieves balanced detection performance across Turkish and English while reducing the cross-lingual performance gap. Our results show that the proposed data-centric training strategy outperforms several evaluated open-source detectors on the evaluated benchmarks and provides lower inference cost than LLM-based detection methods. These results suggest that high-quality multilingual training data and iterative dataset refinement play a significant role in building accurate and efficient multilingual prompt injection detectors for practical deployment.},
  keywords={Modeling;Multilingual;Signal detection;Testing;Large language models;Training;Detectors;Labeling;Manuals;Printing;Prompt injection;large language models;multilingual security;text classification},
  doi={10.1109/UBMK71847.2026.11745123},
  ISSN={2521-1641},
  month={Sep.},}@INPROCEEDINGS{11647875,
  author={Manohar, Lokesh Prakash},
  booktitle={2026 International Conference on Cybersecurity, Digital Forensics, and AI Applications (ICCSDFAI)}, 
  title={Zero-Shot Prompt Injection Detection via N-gram Pooling of Token-Level Hidden States}, 
  year={2026},
  volume={},
  number={},
  pages={1198-1203},
  abstract={Retrieval-augmented generation (RAG) pipelines are vulnerable to prompt injection attacks, where adversaries embed malicious instructions inside retrieved documents. Existing embedding-based detectors rely on mean-pooled sentence vectors, which suppress short injection spans hidden within long benign text — a phenomenon we formalize as semantic dilution. We extract per-token hidden states from a frozen 22M-parameter sentence transformer already present in the pipeline and apply N-gram pooling over sliding windows to localize injection signals. On a controlled chunk-level benchmark (1,575 chunks, Enron corpus), our method achieves AUC=0.901 (95% CI [0.869, 0.930]), with confidence intervals non-overlapping with the mean-pool baseline (AUC=0.808). On the public xTRam1 dataset, zero-shot AUC=0.870 exceeds the supervised baseline of 0.764. All three scoring variants execute at identical CPU latency (≈44ms per 500-character chunk). The method requires no labeled data, no fine-tuning, and no access to the generative LLM at inference time.},
  keywords={Large language models;Training;Labeling;Equations;Retrieval augmented generation;Modeling;Poles and zeros;Windows;Signal detection;Manuals},
  doi={10.1109/ICCSDFAI70505.2026.11647875},
  ISSN={},
  month={June},}@INPROCEEDINGS{11050551,
  author={Kulkarni, Prashant and Namer, Assaf},
  booktitle={2025 IEEE Conference on Artificial Intelligence (CAI)}, 
  title={Temporal Context Awareness: A Defense Framework Against Multi-Turn Manipulation Attacks on Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={930-935},
  abstract={Many Large Language Models (LLMs) today are vulnerable to multi-turn manipulation attacks,where adversaries gradually build context through seemingly benign conversational turns to elicit harmful or unauthorized responses. These attacks exploit the temporal nature of dialogue to evade single-turn detection methods, posing a significant risk to the safe deployment of LLMs. This paper introduces the Temporal Context Awareness (TCA)framework, a novel defense mechanism designed to address this challenge by continuously analyzing semantic drift, cross-turn intention consistency, and evolving conversational patterns. The TCA framework integrates dynamic context embedding analysis, cross-turn consistency verification, and progressive risk scoring to detect and mitigate manipulation attempts effectively. Preliminary evaluations on simulated adversarial scenarios demonstrate the framework's potential to identify subtle manipulation patterns often missed by traditional detection techniques, offering a much-needed layer of security for conversational AI systems. In addition to outlining the design of TCA, we analyze diverse attack vectors and their progression across multi-turn conversations, providing valuable insights into adversarial tactics and their impact on LLM vulnerabilities. Our findings underscore the pressing need for robust, context-aware defenses in conversational AI systems and highlight the TCA framework as a promising direction for securing LLMs while preserving their utility in legitimate applications},
  keywords={Conversational artificial intelligence;Large language models;Semantics;Context awareness;Pressing;Oral communication;Vectors;Security;Manipulator dynamics;LLM Security;Multi-turn attacks;prompt security;obfuscation;prompt injection;security;trustworthy AI;jailbreak},
  doi={10.1109/CAI64502.2025.00164},
  ISSN={},
  month={May},}@INPROCEEDINGS{11463376,
  author={Zhong, Qidi and Liu, Siyang and Liu, Jiani and Pan, Kaikai and Cheng, Yushi and Xu, Wenyuan},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={IPI2: Mitigating Indirect Prompt Injections on Unmanned Aerial Vehicle Agents Using Physical Invariants}, 
  year={2026},
  volume={},
  number={},
  pages={14042-14046},
  abstract={Large language model (LLM)-powered unmanned aerial vehicle (UAV) agents enable natural human–machine interaction, broadening UAV applications in complex scenarios. However, these agents are vulnerable to indirect prompt injection (IPI) attacks, where adversaries exploit untrusted external data sources (e.g., corrupted knowledge bases) to redirect LLMs from legitimate instructions toward malicious ones. Existing defenses either rely on keyword filters or auxiliary LLMs, which are often computationally costly and insufficiently robust. In this paper, we present IPI2, a defense framework that mitigates IPI attacks by leveraging UAVs’ physical invariant properties. Our key insight is that, despite the diversity of UAV tasks and attack strategies, benign UAV logs consistently exhibit stable invariant patterns. IPI2 profiles these distributions from benign data and performs similarity analysis using Kullback–Leibler divergence to detect anomalies indicative of IPI corruption. Extensive experiments across 2 UAV agents, 3 tasks, 4 LLMs, and 5 attack types demonstrate that IPI2 achieves a 68.3% reduction (92.0%→23.7%) in average attack success rate. We further show that IPI2 remains robust against adaptive adversaries.},
  keywords={Filtering;Filters;Circuits and systems;Internet of Things;Communication systems;Internet;Internet of Vehicles;Protocols;Radio access networks;HTTP;LLM-integrated UAV Agents;Prompt Injection Attack;Physical Invariants},
  doi={10.1109/ICASSP55912.2026.11463376},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{11393850,
  author={Jena, Pratyush and Zad, Samira and Akbar, Rehan},
  booktitle={2026 IEEE 16th Annual Computing and Communication Workshop and Conference (CCWC)}, 
  title={Interaction-Centric Cybersecurity Risks in LLM-Powered Dialogue Systems}, 
  year={2026},
  volume={},
  number={},
  pages={0808-0814},
  abstract={Large Language Models (LLMs) have forever transformed human-AI interaction by enabling natural dialogue, reasoning, and autonomous task execution. Yet this interactioncentric paradigm introduces cybersecurity risks that traditional AI security frameworks fail to capture. This paper presents a conceptual framework and synthesis derived from a review (2015-2025) of security vulnerabilities in LLM-powered dialogue systems. We consolidate over forty studies spanning adversarial NLP, prompt injection, retrieval-augmented generation (RAG) poisoning, backdoors, and human trust exploitation. Although previous works have provided a list of isolated threats or generic LLM vulnerabilities, very few of them have looked at how interactive dialogue broadens the attack surface. Our study proposes a unified interaction-chain taxonomy distinguishing risks at input, processing, and output stages, and maps representative attacks and defenses accordingly. Drawing insights from classical adversarial literature and recent LLM surveys, we derive a layered defense pipeline integrating prompt sanitization, retrieval provenance tracking, backdoor detection, and output auditing. The resulting framework reframes cybersecurity in dialogue systems as an interactional problem bridging AI safety, NLP security, and human-computer interaction, providing a foundation for standardizing evaluation, developing cross-model benchmarks, and guiding the secure deployment of LLM agents.},
  keywords={Surveys;Reviews;Prevention and mitigation;Taxonomy;Retrieval augmented generation;Pipelines;Oral communication;Safety;Computer security;Surface treatment},
  doi={10.1109/CCWC67433.2026.11393850},
  ISSN={},
  month={Jan},}@ARTICLE{11108294,
  author={Shaikh, Asif and Varol, Aygün and Virkki, Johanna},
  journal={IEEE Access}, 
  title={From Prompts to Motors: Man-in-the-Middle Attacks on LLM-Enabled Vacuum Robots}, 
  year={2025},
  volume={13},
  number={},
  pages={137505-137513},
  abstract={The integration of large language models (LLMs) into robotic platforms is transforming human–robot interaction by enabling more natural communication and adaptive task execution. However, this advancement also introduces new security vulnerabilities, particularly in networked environments. In this study, we present a systematic analysis of man-in-the-middle (MITM) attacks targeting an LLM-enabled vacuum robot. Our research follows a three-phase development process: 1) command-line simulation of LLM–robot interactions, 2) tabletop setup, and 3) implementation of a physical robot using a commercial vacuum platform enhanced with a Raspberry Pi–hosted ChatGPT application programming interface (API) and you only look once (YOLO, v8) object detection. We define a gray-box threat model in which an attacker can intercept, inject, and manipulate JavaScript object notation (JSON)-formatted messages exchanged between the robot and the LLM. We evaluate four attack scenarios, two based on prompt injection and two on output manipulation, across three LLM configurations (ChatGPT-4, ChatGPT-4o mini, and ChatGPT-3.5 Turbo). While prior work on LLM security assumes secure communication channels and overlooks network-level threats, our experimental results demonstrate that a remote attacker can bypass safety protocols, override motor commands, and deliver deceptive feedback to users, ultimately leading to unsafe robot behavior. These findings reveal a critical and underexplored attack surface in LLM-integrated robotic systems and highlight the urgent need for secure-by-design communication architectures.},
  keywords={Robots;Collision avoidance;Chatbots;Vacuum systems;Security;Dogs;Cameras;Wireless fidelity;Protocols;Hardware;ChatGPT API;large language models (LLMs);household robotics;man-in-the-middle (MITM) attack;prompt injection;robotics security;you only look once (YOLO) object detection},
  doi={10.1109/ACCESS.2025.3595424},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11470531,
  author={Segireddy, Akshitha},
  booktitle={2026 International Conference on Visual Analytics and Data Visualization (ICVADV)}, 
  title={Cyb-LLM: A Unified Benchmark for Evaluating LLMs in Cyber Attack & Defense}, 
  year={2026},
  volume={},
  number={},
  pages={1647-1654},
  abstract={There is a growing use of large language models LLMs in security-related workflows. There is a gap in existing benchmarks for assessing dual-use capabilities of LLMs under safety constraints. We introduce a new, unified benchmark called CybLLM, which encompasses both offensive tasks (e.g., phishing generation, exploit request) and defensive tasks (e.g., secure coding, malware, and triage with built-in safety alignment metrics. Our framework integrates offense, Defense, and utility assessments using a composite CybScore metric that balances attack refusal quality, defensive task accuracy, and safety compliance. We include more than 1000 curated prompts that span a wide range of cybersecurity domains and filter them through both ethical and governance reviews. We tested six to ten leading models such as GPT-4/5, Claude, Gemini, LLaMA, etc. using standard conditions to compare zero-shot, few-shot, and toolaugmented settings. Our research finds an essential tradeoff in terms of utility and enforcement of refusal policies; models that are strictly enforced to limit dangerous output are less able to complete beneficial tasks, while those models that have looser guardrails to increase their ability to produce utility will be less compliant with safety constraints and therefore create unsafe outputs. We also report robustness to prompt variations and hallucination rates, and find that slight changes in input prompts can decrease accuracy by 5 percent. Additionally, we observe that the best models continue to produce unsupported information when attempting to explain security-related topics. For clarity, all of our data, evaluation code, and model output are made available for transparency purposes. A public leaderboard is also established to monitor progress. No harmful exploit content is generated for offensive tasks in Cyb-LLM; instead, offensive tasks are scored based on safe refusal and constructive guidance. The Benchmark, code, and a live evaluation platform are available open source.},
  keywords={Payloads;Telemetry;Ground support;Aerospace and electronic systems;Military aircraft;Space technology;Filtering;Filters;System-on-chip;Integrated circuits;Large Language Models (LLMs);Cybersecurity Benchmarking;Dual-Use AI;Safety Alignment;Jailbreak;Prompt Injection;Hallucination Detection},
  doi={10.1109/ICVADV67766.2026.11470531},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11746554,
  author={Gautam, Amit and Tiwary, Priya},
  booktitle={2026 International Conference on Secure IoT and Cybersecurity (ICOSICS)}, 
  title={A Survey on Security of the Model Context Protocol: Documented Incidents, Defense Frameworks, and Coverage Gaps in Agentic AI}, 
  year={2026},
  volume={},
  number={},
  pages={16-23},
  abstract={The Model Context Protocol (MCP), introduced by Anthropic, has rapidly become the standard interface between large language model (LLM) agents and the external tools they depend on. This rapid adoption has been accompanied by a growing number of documented security failures, including zeroclick data exfiltration (CVE-2025-32711), command injections (CVE-2025-6514), prompt-injection-driven remote code execution in coding agents (CVE-2025-53773), and large-scale vulnerability discovery across MCP servers. Several MCP gateways and academic defense frameworks have been proposed in response; none have addressed the inverse question: of the documented agentic-AI failures in the public record, what fraction would today's defenses have actually prevented? We address this gap by assembling a corpus of 95 documented incidents drawn from CVEs, peer-reviewed literature, and reproducible disclosures, coding each against a 10 -layer defense model. Our findings suggest that 46.3% fall within a broad data-plane band, with 25.3% concentrated at three layers that receive minimal coverage in the current frameworks. We formalize two control primitives - probe-augmented policy, session risk-budget composition, and demonstrate via three case-study reconstructions how each would have intercepted documented vulnerable call paths.},
  keywords={Modeling;Probes;Security;Tools;Servers;Codes;Cleaning;Printing;Artificial intelligence;Protocols;Model Context Protocol;agentic AI security;prompt injection;tool poisoning;gateway architecture;capability-based access control;defense in depth;CVE analysis},
  doi={10.1109/ICOSICS70095.2026.11746554},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10825267,
  author={Wang, Zhe and Tayebi, Mohammad A.},
  booktitle={2024 IEEE International Conference on Big Data (BigData)}, 
  title={AutoRed: Automated Attack Scenario Generation Framework for Red Teaming of LLMs}, 
  year={2024},
  volume={},
  number={},
  pages={2376-2383},
  abstract={Even though Large Language Models (LLMs) are highly beneficial, they pose significant security concerns, particularly in the realm of privacy protection. Sensitive information is often provided to LLMs during conversations and may be retained as in-context memory. This raises the risk of unintended data exposure. In the existing paradigm, a red team comprising human testers is tasked with generating input prompts (i.e., test cases) to provoke undesirable responses from LLMs. Yet, relying solely on human testers is both costly and time-intensive. This paper presents AutoRed, an innovative learning framework developed to automatically generate malicious attack scenarios for extracting sensitive information from LLMs. Our framework places particular emphasis on prompt injection—the process of injecting malicious prompts to extract conversation histories from LLMs to uncover private data. AutoRed comprises three key components: malicious prompt generator, sensitive information extractor, and stop point identifier. These components work together to enable prompt injection, ensuring a seamless process. Our extensive experimental evaluation, spanning diverse defense strategies and various LLMs, demonstrates the efficacy of AutoRed. This evaluation not only rigorously assesses the resilience of defense mechanisms but also measures the safety alignment of LLMs, thereby highlighting the potential of our automated framework as an efficient red teaming tool for identifying vulnerabilities and enhancing security within LLMs.},
  keywords={Privacy;Training data;Oral communication;Robustness;Security;Data mining;Scenario generation;Standards;Testing;Resilience;Large Language Model;Red Teaming;Prompt Injection;Reinforcement Learning;Supervised Fine-tuning},
  doi={10.1109/BigData62323.2024.10825267},
  ISSN={2573-2978},
  month={Dec},}@INPROCEEDINGS{11723810,
  author={Pandey, Varun},
  booktitle={2026 2nd International Conference on Advanced Machine Learning and Data Science (AMLDS)}, 
  title={Guardrailed Financial Decision Support with LLMs: A Practical Architecture and Pilot Evaluation on Public U.S. Regulatory Data}, 
  year={2026},
  volume={},
  number={},
  pages={68-71},
  abstract={Large language models are attractive in financial services because they can turn dense policy text, complaint narratives, and public filings into faster answers for analysts. The problem is that the same systems can also be manipulated, leak sensitive content, or sound confident when they are wrong. This paper presents a practical guardrail architecture for LLM-assisted financial decision support and evaluates it in a small but reproducible pilot built on public U.S. regulatory and consumer-finance sources. The prototype uses role-aware retrieval, prompt-injection screening, output redaction, evidence checks, and safe abstention. To keep the evaluation reproducible across institutions, the experiment isolates the guardrail plane with a local retrieval-and-policy harness over public financial text derived from CFPB, SEC, FinCEN, FFIEC, NIST, PCI DSS, and NYDFS materials. On an evaluation set of 18 in scope questions, 20 prompt-injection attacks, 20 leakage probes, and 12 out-of-scope prompts, the guarded system preserved in scope grounded accuracy at 94.4%, reduced prompt-injection success from 100% to 0%, reduced leakage from 100% to 0%, and lowered unsupported answers on out-of-scope prompts from 100% to 16.7%. The results are from a pilot prototype rather than a production bank deployment, but they show that useful financial AI systems become far more trustworthy when the control plane is engineered as seriously as the model itself.},
  keywords={Modeling;Large language models;Electronic mail;Prototypes;Artificial intelligence;Manuals;Planing;Financial technology;LLM guardrails;secure systems;prompt injection;data leakage prevention;hallucination resistance;retrieval-augmented generation;cybersecurity},
  doi={10.1109/AMLDS69611.2026.11723810},
  ISSN={},
  month={July},}@INPROCEEDINGS{11268746,
  author={Abdul Rasheed, Ashika Sameem and Mehedy Masud, Mohammad},
  booktitle={2025 IEEE 19th International Conference on Application of Information and Communication Technologies (AICT)}, 
  title={A Secure and Effective Framework for Key Concept Mining from Educational Content Using Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Large Language Models (LLMs) are increasingly prevalent in educational systems, with significant potential to enhance learning experiences through various applications. However, their integration into educational environments can introduce security vulnerabilities, thereby threatening the reliability and integrity of the learning process. Despite the growing adoption of LLMs in education, domain-specific threat assessment for educational applications remains significantly underexplored. To address this gap, we developed a secure educational LLM framework for lecture summarization through systematic threat modeling using the OWASP risk rating methodology. Our analysis identified five major vulnerabilities, among which “prompt injection” was ranked as the highest-severity risk, particularly affecting student interfaces, where malicious inputs could compromise system behavior and educational content integrity. We evaluated an effective defense mechanism known as semantic smoothing, against 20 adversarial prompts across five state-of-the-art LLM models, namely, GPT-4o, GPT-5, Mistral-7B-Instruct-v0.1, Deepseek-llm-7b-chat, Falcon-7b-instruct. The results show that defense effectiveness is highly dependent on the model. GPT-5 achieved optimal protection (HCR reduced from 45% to 30%), while Deepseek-llm-7b-chat showed counterproductive regression under perturbations. These findings demonstrate that robust mitigation strategies must consider the characteristics of individual models, as defenses may vary widely in effectiveness across different LLM architectures.},
  keywords={Threat modeling;Smoothing methods;Systematics;Large language models;Perturbation methods;Prevention and mitigation;Semantics;Security;Reliability;Protection;Large Language Models;OWASP;Semantic Smoothing;Risk Assessment},
  doi={10.1109/AICT67988.2025.11268746},
  ISSN={2472-8586},
  month={Oct},}@INPROCEEDINGS{11568651,
  author={Shatnawi, Amani and AlSobeh, Anas and Khamaiseh, Samer and Al-Abdullah, Muhammad},
  booktitle={2026 Intermountain Engineering, Technology and Computing (IETC)}, 
  title={Secure-by-Design Framework for Agentic AI: Mitigating Toxic Flows and Adversarial Exploits in Multi-Agent Ecosystems}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Large Language Model (LLM)-driven autonomous agents leveraging the Model Context Protocol (MCP) for tool interaction face a critical vulnerability class we term "Toxic Flows." These attacks propagate malicious instructions through untrusted data sources to compromise agent decision-making, enabling unauthorized actions and data exfiltration. We present a Secure-by-Design (SbD) framework centered on Toxic Flow Analysis (TFA), adapting source-to-sink reachability concepts to agentic workflows where non-deterministic LLM behavior precludes traditional dataflow assumptions. Our formal model employs a product lattice decomposing tool capabilities into orthogonal confidentiality, integrity, and side-effect dimensions, with explicit soundness properties under stated assumptions. We formalize trust propagation through information-flow lattices, introduce verifiable sanitizer specifications for constrained output domains, and handle cyclic agent loops through monotonic fixed-point iteration over the full lattice structure. We implement TFA as a Python framework and evaluate it on a synthetic benchmark (500 graphs, seed=42). Results demonstrate 94.2% attack detection with 3.1% false positive rate and 47ms average latency.},
  keywords={Modeling;Large language models;Tools;Lattices;Fluid flow;Security;Runtime;Printing;Signal detection;Labeling;Secure-by-Design;Agentic AI;Toxic Flow Analysis;Information Flow Control;Model Context Protocol;Indirect Prompt Injection},
  doi={10.1109/IETC69527.2026.11568651},
  ISSN={},
  month={May},}@INPROCEEDINGS{11024700,
  author={Chisty, Md. Main Oddin and Sakib, Abu Noman Md and Khan, Md Somir and Shuvo, Md. Badiuzzaman},
  booktitle={2024 13th International Conference on Electrical and Computer Engineering (ICECE)}, 
  title={Prompt Injection Detection Using Ensemble of BERT and LSTM with GloVe Embeddings}, 
  year={2024},
  volume={},
  number={},
  pages={453-458},
  abstract={The main contribution of this work is a new approach to prompt injection detection in NLP, done by ensembling BERT with LSTMs on top of GloVe embeddings that enhance them. We first show the efficiency of our approach on DeepSet Prompt Injections by comparing the performances of the models used in our study to the state-of-the-art on this dataset. Indeed, we obtained a final accuracy of $92.24 \%$ for an AUC-ROC of 0.994. Our approach leverages the strength of transformer-based models, besides better RNNs and larger vocabulary coverage, backed by pre-trained word embeddings that enable the learning of semantic relationships. We further extend the performance evaluation of individual components and their synergistic effect in the ensemble for a deeper analysis of results showing our approach with the use of the ensemble method beating single models, hence providing a robust solution for prompt injection detection. We discuss the implications of our findings for improving the security of AI-driven conversational systems and indicate likely future directions of research in this important area of AI safety.},
  keywords={Vocabulary;Accuracy;Semantics;Transformers;Solids;Safety;Ensemble learning;Artificial intelligence;Long short term memory;Research and development;Prompt Injection;LLM;BERT;LSTM;GloVe;Ensemble Learning;Natural Language Processing;Cybersecurity},
  doi={10.1109/ICECE64886.2024.11024700},
  ISSN={2771-7917},
  month={Dec},}@INPROCEEDINGS{11604974,
  author={Nkoro, Ebuka and Liao, Weixian and Qian, Cheng and Yu, Wei},
  booktitle={2026 International Conference on Smart Applications, Communications and Networking (SmartNets)}, 
  title={IDE-Sanitizer: A Prompt-Injection Cryptographic Context Guard for IDE Copilots}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={The integration of Large Language Models (LLMs) into Integrated Development Environments (IDEs) introduces a critical vulnerability to indirect Prompt Injection Attacks (PIAs). State-of-the-art coding models, such as Qwen-2.5-Coder, often embed malicious payloads within project configuration rules, resulting in alarmingly high Attack Success Rates (ASR) that compromise local developer environments. To mitigate this threat, this paper proposes IDE-Sanitizer, a preventive, dualmodel defense framework that establishes a zero-trust execution boundary. By combining an HMAC-SHA256 cryptographic state verifier with an air-gapped semantic gate (Llama-3-8B), IDESanitizer decouples intent classification from code generation, preventing attackers from overriding system guardrails. Extensive evaluations across diverse programming frameworks demonstrate that our approach achieves strong robustness, which reduces the ASR to near 0.0% against severe sabotage and exfiltration vectors, while maintaining a near 0.0% False Positive Rate (FPR) on benign workflows. Furthermore, by preemptively blocking malicious payloads before they reach the core generator, IDE-Sanitizer avoids computationally expensive inference loops, reducing average generation latency on adversarial inputs by 89.6%. Ultimately, this architecture offers a secure, efficient, and scalable solution for safeguarding LLM-assisted development cycles.},
  keywords={Modeling;Large language models;Codes;Payloads;Printing;Encoding;Security;Automatic speech recognition;Context;Conferences;Large Language Models;IDEs;Prompt Injection Attacks},
  doi={10.1109/SmartNets69662.2026.11604974},
  ISSN={2837-4940},
  month={July},}@INPROCEEDINGS{11463913,
  author={Ge, Ziyi},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={PromptHash: Robust Instruction Watermarks Against Paraphrase and Splicing in LLM Forensics}, 
  year={2026},
  volume={},
  number={},
  pages={14282-14286},
  abstract={Large language models (LLMs) increasingly operate in retrieval-augmented and multi-agent workflows where instruction provenance is critical, yet adversaries can exploit cross-context splicing with paraphrasing to evade attribution. Existing content/behavior detectors degrade once surface form changes, and output-side watermarks primarily target generations rather than instructions. We propose PromptHash, a self-authenticating, instruction-side watermark that normalizes and segments prompts, computes a position-sensitive keyed hash chain bound to session metadata, and renders tags via a compact, semantics-preserving codebook with fuzzy verification tolerant to paraphrase and tokenization jitter. PromptHash is model-agnostic, deploys as a lightweight pre/post-processor, and introduces negligible cost. On the Paraphrase Attack Corpus (PAC), Splice-and-Reflow Benchmark (SRB), and Indirect Injection Testbed (IIT), PromptHash achieves TAR 98.3±0.4%, FAR 0.8±0.2%, and 96.6±0.6% with sub-millisecond CPU latency and < 0.4% token inflation, consistently surpassing detectors and adapted output watermarks. These results position instruction-side watermarking as a robust solution for LLM session forensics.},
  keywords={Central Processing Unit;Electronic circuits;Internet of Things;Communication systems;Protocols;Radio access networks;Regional area networks;Internet;HTTP;Telecommunications;Information forensics;instruction watermarking;prompt injection defense;session provenance},
  doi={10.1109/ICASSP55912.2026.11463913},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{11545895,
  author={Farhana, Mst Habiba and Roy, Ridoy Kumar},
  booktitle={2026 IEEE 2nd International Conference on Quantum Photonics, Artificial Intelligence & Networking (QPAIN)}, 
  title={Multimodal Prompt Injection: A Formal 4D Taxonomy for Image and Document Pipelines}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Despite rapid advances in multimodal large language models (MLLMs), their cross-modal fusion architectures pose significant security concerns. Multimodal prompt injection (MPI) attacks enable adversaries to incorporate malicious instructions within non-textual inputs such as images, PDFs, and slides to manipulate model behavior, bypass controls, and exploit processes such as optical character recognition (OCR) and metadata parsing. Current research is fragmented due to a lack of a cohesive risk classification and consistent evaluation techniques. This paper introduces a formal 4D taxonomy $\mathcal{T}=\langle C, L, O, S\rangle$ that categorizes MPI attacks according to carrier type, pipeline location, attacker objective, and stealth level, resulting in 96 potentially unique attack classes and indicates that merely 7.3% are documented in existing research. Analysis indicates that no singular defense provides comprehensive coverage; a confirmed limit of 75% dimensional coverage is established across all deployable defenders. Layered architectures with provenance and standardized multimodal benchmarks are recognized as critical conditions for effective MPI mitigation.},
  keywords={Modeling;Taxonomy;Pipelines;Printing;Large language models;Security;Tools;Threat modeling;Context;Optical character recognition;Multimodal Prompt Injection;LLM Security;Attack Taxonomy;Cross-Modal Threats;Adversarial Stealth},
  doi={10.1109/QPAIN69676.2026.11545895},
  ISSN={},
  month={April},}@INPROCEEDINGS{11645927,
  author={G.Kavitha and M, Hishaam Ahamed and R, Premnath},
  booktitle={2026 4th International Conference on Sustainable Computing and Smart Systems (ICSCSS)}, 
  title={SecureContext EDU: An Open Source University Assistant using Dual - LLM Architecture}, 
  year={2026},
  volume={},
  number={},
  pages={1531-1538},
  abstract={Chatbots powered by LLMs have become popular due to their scalability and instant reply feature. There can be many security issues associated with LLM-based chatbots, which emerge in the interaction between the LLM-based model and other software components. One major problem is that chatbots can be attacked using prompt injection, jailbreaks, and harmful queries. These attacks can change the chatbot behavior and may lead to wrong answers or leakage of sensitive information. This makes security very important in such systems. Existing methods improve the chatbot performance using techniques like modular design, Retrieval-Augmented Generation (RAG) and input filtering for security. However, most of these methods use a single model and do not have strong real-time protection, making them weak against advanced attacks. Hence, this work proposes a Dual-LLM architecture where security is handled as a separate component for protection against real time threats. A classification model is designed to check the user input queries using threat categories and a confidence score is evaluated to block the harmful inputs. Only safe queries are sent to the response model, which uses a controlled RAG system to generate accurate answers. The system is built as a step-by-step pipeline combining classification and response generation. The results show an accuracy of 90% in detecting threats which leads to reduction of unsafe responses.},
  keywords={Large language models;Modeling;Retrieval augmented generation;Security;Chatbots;Printing;Filtering;Filters;Conferences;Timing;Large Language Models;Chatbot Security;LLM Security Prompt Injection;Retrieval-Augmented Generation;Threat Detection;Suspicious pattern;Similarity search},
  doi={10.1109/ICSCSS69635.2026.11645927},
  ISSN={},
  month={July},}@INPROCEEDINGS{11638709,
  author={Chugani, Hitesh},
  booktitle={2026 IEEE 11th International Conference on Smart Cloud (SmartCloud)}, 
  title={EB-AIOps: Evidence-Bound and Injection-Resilient Intelligent Triage for Cloud Security Logs}, 
  year={2026},
  volume={},
  number={},
  pages={7-12},
  abstract={Modern cloud platforms and large distributed systems generate massive volumes of logs that record failures, access behavior, and system states. These logs are central to security monitoring and reliability engineering. While recent log analysis models can detect anomalies with high accuracy, operational triage remains difficult. Security teams still need to manually inspect long log sequences, and emerging LLM-based assistants often produce explanations that lack sufficient evidence. More critically, cloud logs are untrusted inputs, and malicious strings embedded in logs can manipulate automated assistants and trigger unsafe outputs. This paper presents EB-AIOps, an evidence-bound and injection-resilient framework for intelligent cloud security triage. The proposed system integrates structured log parsing, risk-aware incident detection, evidence retrieval, and controlled language-model-based reporting. Only high-risk windows are forwarded for triage. For each suspected incident, the framework retrieves a small set of relevant historical logs and constrains the assistant to generate reports strictly grounded in this evidence. Raw log text is isolated from system instructions, which limits the effect of prompt injection hidden inside logs. Experiments on large-scale distributed log datasets show that EB-AIOps achieves strong detection performance, reaching 0.991 accuracy, 0.984 F1-score, and 0.993 AUC, outperforming deep sequence and transformer-based baselines. The framework also improves cross-system generalization, with F1-scores above 0.93 under domain shift. More importantly, EB-AIOps produces highly grounded triage outputs with 0.97 evidence precision and reduces prompt-injection attack success to 0.04, compared to 0.42 for unconstrained assistants. These results demonstrate that EB-AIOps enables accurate, verifiable, and secure incident triage for real cloud security operations.},
  keywords={Modeling;Clouds;Equations;Windows;Signal detection;Large language models;Printing;Cloud computing security;Labeling;Anomaly detection;Cloud security;distributed systems;log analysis;AIOps;evidence-based AI;large language models;incident triage;prompt injection;trustworthy cloud systems},
  doi={10.1109/SmartCloud69481.2026.00010},
  ISSN={},
  month={May},}@INPROCEEDINGS{11006851,
  author={Hao, Guozhi and Wu, Jun},
  booktitle={2025 IEEE 10th International Conference on Smart Cloud (SmartCloud)}, 
  title={Privacy-Preserving Prompt Injection Detection for Smart Cloud-Deployed Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={26-31},
  abstract={Large Language Models (LLMs) have recently gained popularity for tasks like text generation and automated reasoning, often hosted on cloud servers to handle large-scale user interactions. Yet this setup faces a critical challenge, prompt injection attacks, where adversaries craft malicious text to bypass an LLM’s safety constraints and policy filters. Attackers constantly evolve new injection tactics, rendering static defenses ineffective. While service providers may wish to store user inputs for security audits, this practice poses serious privacy and data-protection risks. User prompts can contain personal or confidential information subject to strict regulatory requirements. To address these conflicting demands of security monitoring and user privacy, we propose a privacy-preserving prompt injection detection scheme via hash and embedding-based auditing for smart cloud-deployed LLMs. Our approach segments each user prompt into smaller chunks and stores only non-invertible representations of them—cryptographic hashes for exact matches and vector embeddings for near-match detection. This enables robust identification of both verbatim and paraphrased threats without retaining any plaintext data. Furthermore, newly discovered injection patterns can trigger retrospective audits on previously stored chunks, greatly enhancing attack traceability. We also introduce an optional blockchain-based logging mechanism for tamper-proof event records. Empirical results show that our method achieves high detection accuracy against diverse injection techniques while safeguarding sensitive user information.},
  keywords={Privacy;Large language models;Rendering (computer graphics);Vectors;Real-time systems;Blockchains;Safety;Security;Servers;Tuning;large language models (LLMs);prompt injection;privacy-preserving;blockchain;smart cloud},
  doi={10.1109/SmartCloud66068.2025.00009},
  ISSN={},
  month={May},}@INPROCEEDINGS{11075247,
  author={Dinu, Ionuţ-Vlăduţ and Danciu, Gabriel-Mihail and Vintilă, Raul Cristian and Bălan, Titus-Constantin},
  booktitle={2025 International Aegean Conference on Electrical Machines and Power Electronics (ACEMP) & 2025 International Conference on Optimization of Electrical and Electronic Equipment (OPTIM)}, 
  title={Disrupting Large Language Models with Hidden Prompt Injection Attacks Embedded in HTML Pages}, 
  year={2025},
  volume={},
  number={},
  pages={1-10},
  abstract={This research evaluates the reliability of Large Language Models (LLMs) as collaborative tools for extracting information from various web sources, including standard websites, e-commerce platforms, blogs, landing pages, or even e-mails, where the content is much shorter and the processing language models have a higher chance of getting attacked. Prior to conducting model assessments, we present some methodologies involved in web-scraping approaches, prompt injection attack types, and datasets that evaluate the attack success rate (ASR) of LLMs. Our investigation subjects LLMs to rigorous testing using HTML pages containing concealed instructions designed to terminate response generation when users make queries. The evaluation dataset consists of HTML documents of varying sizes, containing randomly positioned prompt injection attacks programmed to direct the LLM to respond with a single specific key word. Using this benchmark, we assess locally deployed LLM models, revealing their ASR across multiple architectures. The defensive mechanism we propose demonstrates a significant reduction in ASR through the implementation of a filtering system with fixed-sized windows of tokens that analyzes HTML content and eliminates compromised data, reducing the success rate of the attacks, which proved to reduce the ASR.},
  keywords={Training;Filtering;Large language models;Computer architecture;Vectors;Reliability;Security;Data mining;Standards;Software development management;Large Language Models;HTML Documents;Prompt Injection;Attack Success Rate;Filtering;Compromised Data},
  doi={10.1109/OPTIM-ACEMP62776.2025.11075247},
  ISSN={2643-3958},
  month={May},}@INPROCEEDINGS{10866433,
  author={Maity, Sourav and Arora, Jatin},
  booktitle={2024 3rd Edition of IEEE Delhi Section Flagship Conference (DELCON)}, 
  title={The Colossal Defense: Security Challenges of Large Language Models}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={Large Language Models (LLMs) have become increasingly popular because of their strong capabilities and abilities in multiple fields, such as text generation, language translation, image, video, audio, and other forms of output generation. The ability of the model to analyze a complex input prompt and provide relevant and simplified responses, depending on its usage, elevates its desirability. LLM not only has a transformative effect on the interaction between humans and models and the usage of the models in different situations but also has a significant drawback. Although the main benefits of LLM are apparent, there is a potential landmine of security threats accompanying its existence. Exposure to artificial intelligence increases the security risk throughout its design, development, infrastructure, and incorporation. Threat actors can exploit existing vulnerabilities to control models and execute uncontrollable and divisive actions. This study thoroughly examines the fundamental security problems of prompt injection, data poisoning, and sensitive information extraction. The attacks and defenses arising from these issues related to LLM are summarized. Finally, we suggest future research directions to secure LLMs.},
  keywords={Analytical models;Translation;Landmine detection;Prevention and mitigation;Large language models;Information retrieval;Natural language processing;Security;Natural Language Processing (NLP);Large Language Models (LLMs);ChatGPT;Llama;Gemini;Transformer},
  doi={10.1109/DELCON64804.2024.10866433},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11507202,
  author={Ganu, Deepa and Gantayat, Sasanko Sekhar and Mishra, Brojo Kishore and Ganu, Abhishek and Atmakuri, Aparna Rajesh and Reddy, Tharun},
  booktitle={2026 IEEE International Conference for Convergence in Computing Technology (I3CTCON)}, 
  title={Two-Layer Input Filtering Framework for Large Language Model Security}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={GPT-4 and Mistral (Large Language Model) have strong language performance, but they are still susceptible to being hacked because of prompt injections, jailbreaking, or inappropriately using a playacting role in order to gain access to the LLM's built-in protections. Existing defenses are mainly closed, hard to test, and lack flexibility for being modified by any given deployment configuration. This paper presents a framework based on a modular system of two components: the pre-filtering of input, and the filtering of harmful patterns through the first module using regular expressions and the second by using heuristics to evaluate semantic or intonation meaning to discover other forms of threat. The framework supports deployment with mock models, Hugging Face transformers, and OpenAI APIs. Experiments with curated datasets show over 80% of malicious prompts are blocked, while false positives stay under 10%. The average filter-only latency remains low, between 15 and 20 milliseconds. This system offers a transparent, low-overhead baseline for secure LLM use and lays the groundwork for future research on adaptable, interpretable defenses.},
  keywords={Modeling;Filtering;Filters;Large language models;Printing;Security;Application programming interfaces;Large Language Models;Adversarial Robustness;Input Filtering;Prompt Injection;Security Guardrails},
  doi={10.1109/I3CTCON68242.2026.11507202},
  ISSN={},
  month={March},}@INPROCEEDINGS{11691803,
  author={Gill, Waris and Isak, Natalie and Dressman, Matthew},
  booktitle={2026 IEEE Conference on Secure and Trustworthy Machine Learning (SaTML)}, 
  title={BinaryShield: Cross-Service Threat Intelligence in LLM Services using Privacy-Preserving Fingerprints}, 
  year={2026},
  volume={},
  number={},
  pages={103-118},
  abstract={The widespread deployment of LLMs across enterprise services has created a critical security blind spot. Organizations operate multiple LLM services handling billions of queries daily, yet regulatory compliance boundaries prevent these services from sharing threat intelligence about prompt injection attacks, the top security risk for LLMs. When an attack is detected in one service, the same threat may persist undetected in others for months, as privacy regulations prohibit sharing user prompts across compliance boundaries.We present BinaryShield, the first privacy-preserving threat intelligence system that enables secure sharing of attack fingerprints across compliance boundaries. BinaryShield transforms suspicious prompts through a unique pipeline combining PII redaction, semantic embedding, binary quantization, and randomized response mechanism to potentially generate privacy-preserving fingerprints that preserve attack patterns while providing privacy. Our evaluations demonstrate that BinaryShield achieves an F1-score of 0.94, significantly outperforming SimHash (0.77), the privacy-preserving baseline, while achieving storage reduction and 38x faster similarity search compared to dense embeddings.},
  keywords={Fingerprint recognition;Privacy;Accuracy;Modeling;Conferences;Manuals;Large language models;Security;Distance measurement;Quantization (signal);prompt injection;llm security;jailbreak;differential privacy;threat intelligence},
  doi={10.1109/SaTML68715.2026.00015},
  ISSN={},
  month={March},}@INPROCEEDINGS{11293682,
  author={Tod-Raileanu, Gabriela and Axinte, Sabina-Daniela and Dincă, Ana-Maria and Bacivarov, Ioan C.},
  booktitle={2025 IEEE 31st International Symposium for Design and Technology in Electronic Packaging (SIITME)}, 
  title={Security Posture Evaluation of Model Context Protocol Servers Against Prompt Injection}, 
  year={2025},
  volume={},
  number={},
  pages={249-252},
  abstract={This study presents a security-oriented evaluation of the Model Context Protocol (MCP), an open standard enabling large language models (LLMs) to interface with external tools through structured interactions. The experiment was deployed in a controlled environment using an open-source MCP server with basic file manipulation tools. A set of prompt injection tests was designed to probe the system's ability to handle adversarial instructions, ambiguous input, and encoded payloads. Despite expectations, the system failed to reject adversarial instructions embedded in user input and did not detect anomalous tool usage patterns-such as suspicious parameters. These failures underscore the current vulnerability of LLM-tool integrations to prompt injection threats. The results highlight the urgent need for defense-in-depth strategies within MCP implementations, including stricter input validation, contextaware filtering, strong access control policies and transparent logging. Collectively, these measures are essential for securing AI-assisted tool chains against emerging adversarial techniques.},
  keywords={Protocols;Large language models;Supply chains;Servers;Reliability;Probes;Standards;Context modeling;Testing;Resilience;Artificial Intelligence;Model Context Protocol;Large Language Models;Cybersecurity;Secured Architecture},
  doi={10.1109/SIITME67657.2025.11293682},
  ISSN={2642-7036},
  month={Oct},}@INPROCEEDINGS{11382707,
  author={Reddy.A, Basi and Chandran, Mindala Sai Venkata and Chaithanya, Neerupaka and Koushik, Palagani Varun and Krishna, Nadella Sai},
  booktitle={2025 5th International Conference on Evolutionary Computing and Mobile Sustainable Networks (ICECMSN)}, 
  title={Explainable Transformer-based Detection of Adversarial Prompts in Chatbots}, 
  year={2025},
  volume={},
  number={},
  pages={1882-1887},
  abstract={The popularity of large language model (LLM)-based chatbots has increased their vulnerability to adversarial prompt attacks that programmable affect the model's behaviour and produce scripted responses. The paper introduces an Explainable Transformer-Based Detection (ETD) framework that is meant to detect and explain adversarial prompts on the fly. The proposed system offers a BERT-based contextual encoder and an attention-based explanation layer, which captures fine-grained semantical dependencies and assigns model decisions on attribute models to certain token influences. The experiment was done on a curated set of 12,000 benign and 8,000 adversarial prompts produced using paraphrasing, prompt injection, and contextual perturbation methods. The ETD framework attained an accuracy of 96.8, a precision of 95.4, a recall of 97.2, and an F1-score of 96.3, which are 5.7 and 8.1 points higher than the traditional LSTM- and CNN-based baselines, respectively. In addition, the built-in explainability component offers the visual interpretations at the token level, which makes it easier to be transparent in detecting adversarial intent. The findings prove that the given ETD model is rather effective in terms of balancing the performance of the detection and the interpretability of the system, which makes contemporary chatbot systems more robust and trustworthy.},
  keywords={Visualization;Accuracy;Statistical analysis;Large language models;Perturbation methods;Chatbots;Transformers;Real-time systems;Reliability;Context modeling;Adversarial prompts;Explainable AI (XAI);Transformer models;Chatbots;Prompt injection detection;Natural language processing (NLP)},
  doi={10.1109/ICECMSN68058.2025.11382707},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11636629,
  author={Mittal, Anshika and Kaur, Jaspreet and Chatterjee, Tarun Kumar},
  booktitle={2026 International Conference on Sustainable Engineering and Technology Innovations (ICSETI)}, 
  title={A Systematic Review of Jailbreaking Attacks and Defense Mechanisms in Large Language Models}, 
  year={2026},
  volume={},
  number={},
  pages={507-512},
  abstract={This paper is a systematic review of the current situation regarding jailbreaking attacks and defensive against Large Language Models (LLMs). The LLMs have performed very well in the field of software engineering and conversational systems. Nevertheless, regardless of such impressive capabilities, there are general weak points, namely, to prompt injection and jailbreaking attacks. Jailbreaking is the tactically designed control of input prompts to evade safety guardrails to cause adversarial or prohibited outputs. The current paper is proposing a comprehensive taxonomy that splits attacks into target visibility: White-Box, attack seeks the exploitation of inner architecture on the basis of gradient or logit exposure, and Black-Box, where the mechanisms of attack are grounded in prompt engineering and linguistic obfuscation. There are also the division of defense methods to Prompt-Level (pre-processing filtering) and Model-Level (intrinsic safety alignment). The findings describe the mathematical concepts of optimization-based attacks, including Greedy Coordinate Gradient (GCG) and inroads into novel deep learning-based advanced alignment models, including Deep Refusal. This proceeds on the background of emphasizing an everlasting adversarial arms race enabled by the current trade-off between robustly helpful and ultra-safe standards of the LLM and further underscoring the ultimate significance of defenses that are robustly anti-out-of-distribution (OOD) attack vectors.},
  keywords={Modeling;Large language models;Safety;Glass box;Printing;Retrieval augmented generation;Optimization;Filtering;Security;Equations;LLM;Out-of-Distribution;Jailbreaking Attacks;Defense Mechanisms},
  doi={10.1109/ICSETI67678.2026.11636629},
  ISSN={},
  month={Feb},}@ARTICLE{11366235,
  author={Özbay, Recep and Çelebı, Merve and Yavanoğlu, Uraz},
  journal={IEEE Access}, 
  title={The AI-Cybersecurity Nexus: How Large Language Models are Reshaping Threat Intelligence and Digital Defense}, 
  year={2026},
  volume={14},
  number={},
  pages={15558-15587},
  abstract={As cybersecurity threats become more sophisticated, the integration of Large Language Models (LLMs) into defensive and analytical systems is transforming the field. This paper presents a PRISMA-guided bibliometric and thematic review of 149 studies published between 2015 and 2025, including 117 peer-reviewed journal and conference articles, examining publication trends and dominant research themes in LLM-enabled cybersecurity, organized around five research questions: (i) secure incorporation of LLMs into cyber threat intelligence workflows; (ii) hybrid architectures for privacy-preserving and real-time threat detection; (iii) LLM-enabled secure code remediation; (iv) adversarial misuse and dual-use risks; and (v) multi-layer defense strategies addressing prompt injection, model inversion, and data poisoning. Drawing on over 100 primary studies, the analysis highlights key trends, methodological innovations, and recurring vulnerabilities. Notable developments include decentralized trust-enhanced frameworks, context-aware remediation systems, and simulation-based red teaming. However, gaps persist in adversarial robustness, standardization of evaluation, and ethical governance. By mapping research across technical, operational, and policy dimensions, this review provides a structured basis for advancing trustworthy, resilient, and secure LLM deployments in high-stakes cybersecurity contexts.},
  keywords={Computer security;Reviews;Large language models;Bibliometrics;Market research;Ethics;Cyber threat intelligence;Retrieval augmented generation;Intrusion detection;Computer architecture;Cybersecurity;large language models;artificial intelligence;cyber threat intelligence},
  doi={10.1109/ACCESS.2026.3658308},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11605296,
  author={Xiao, Haitao and Fu, Kun and Chen, Le and Yu, Daiyuan and Wen, Xuegang and Zhang, Xiaomin and Zhao, Wei and Lv, Zhenyun},
  booktitle={2026 3rd International Conference on Algorithms, Software Engineering and Network Security (ASENS)}, 
  title={A Concise Review of Security Challenges and Protection for LLM-based Agents in Telecom Information Systems}, 
  year={2026},
  volume={},
  number={},
  pages={102-106},
  abstract={Large language model based (LLM-based) agents are increasingly integrated into telecom information system workflows to translate natural-language intents into operational actions, improving automation across customer service, business support, and network operations. However, such integration expands the attack surface in environments that process sensitive subscriber data and expose high-privilege control interfaces. This concise review summarizes three primary security risks in telecom deployments of LLM-based agents: (i) prompt injection and instruction manipulation across multi-source context and tool-call chains, (ii) excessive agency and privilege abuse caused by over-broad capabilities and insufficient execution gating, and (iii) sensitive data exposure through model memorization, context leakage, and unconstrained retrieval. We also organize practical mitigations into a defense-in-depth strategy that integrates guardrails and output validation, least-privilege design with tool isolation, and continuous monitoring with human-in-the-loop control for high-impact actions.},
  keywords={Large language models;Telecommunications;Modeling;Tools;Security;Printing;Information systems;Authorization;Context;Conferences;LLM-based agents;Telecom Information Systems;Prompt Injection;Privilege Abuse;Sensitive Data Exposure},
  doi={10.1109/ASENS69964.2026.11605296},
  ISSN={},
  month={March},}@INPROCEEDINGS{11755183,
  author={Verma, Shubham},
  booktitle={2026 International Conference on Cybersecurity and AI-Based Systems (Cyber-AI)}, 
  title={A Structural Decomposition of Prompt Injection Threats Targeting Large Language Models}, 
  year={2026},
  volume={},
  number={},
  pages={434-439},
  abstract={Large language models (LLMs) are now widely used for text generation, summarization, and question answering. Their growing integration into applications and third-party services introduces new security risks. Among these, prompt injection is especially concerning: adversaries manipulate model behavior by embedding malicious instructions in user inputs or external data. This paper presents a structured decomposition of such attacks. We propose a three-dimensional taxonomy based on attack vector, mode of operation, and adversarial goal. Using this framework, we classify known attack patterns, including direct prompt manipulation, third-party channel exploitation, data poisoning, and human-assisted strategies. We also review defenses such as input sanitization, role-based access control, monitoring, and instruction-data separation. The taxonomy provides a foundation for systematic analysis and comparison of prompt injection vulnerabilities, supporting more robust defensive architectures.},
  keywords={Modeling;Large language models;Taxonomy;Codes;Security;Printing;Vectors;Architecture;Computer architecture;Training;Prompt Injection;Large Language Models (LLMs);Security Taxonomy;Adversarial Machine Learning;LLM Security},
  doi={10.1109/Cyber-AI70573.2026.11755183},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11510713,
  author={Reddy, Kandula Krishna Chaitanya and Lekha, Tiriveedhi Chandra and P, Thrisha and Arjun, Medam and Radhika, K and Naresh, P},
  booktitle={2026 9th International Conference on Inventive Computation Technologies (ICICT)}, 
  title={Enterprise Secure AI Execution Engine: A Zero-Trust Security Gateway for Enterprise LLM Systems}, 
  year={2026},
  volume={},
  number={},
  pages={2015-2021},
  abstract={Organizations are increasingly adopting Large Language Models (LLMs) for automated decision-making and employee support and secure handling of sensitive organizational data. The systems enabled by these technologies deliver substantial business productivity gains. The systems create major security problems because their implementation enables users to conduct prompt injection attacks and data exfiltration and privilege escalation and adversarial manipulation and policy override attacks. LLM systems operate through natural language interactions which create particular security problems because standard security methods cannot stop attackers who use designed prompts to access LLM systems. The paper introduces an Enterprise Secure AI Execution Engine which functions as a Zero-Trust AI Security Gateway that protects enterprise LLM deployments through its security framework. The proposed architecture combines multiple security mechanisms which include Role-Based Access Control (RBAC) and Data Loss Prevention (DLP) and adversarial prompt detection and deterministic tokenization to create a security system that enforces stringent access protection rules. The system considers all incoming user data to be untrusted and it requires several security checks before permitting model operation. The system demonstrated its capability to identify adversarial prompts while safeguarding sensitive data with minimal effect on processing efficiency. The results demonstrate the system effectively blocks major security threats while it maintains strong defenses against unauthorized data extraction attempts. The proposed framework establishes a secure deployment architecture for enterprise LLM systems and it works best for organizations that need to protect their most sensitive operations.},
  keywords={Modeling;Security;Artificial intelligence;Large language models;Printing;Engines;Architecture;Computer architecture;Tokenization;Poles and zeros;Large Language Models;AI Security;Prompt Injection;Zero-Trust Architecture;Data Loss Prevention;Role Based Access Control},
  doi={10.1109/ICICT68280.2026.11510713},
  ISSN={2767-7788},
  month={April},}@INPROCEEDINGS{11650697,
  author={Li, Xin and Zhao, Xiangmei and Weng, Ziheng and Zhang, Congcong and An, Shufei and He, Shaohang},
  booktitle={2026 3rd World Conference on Computer and Information Security (WCCIS)}, 
  title={IBBC-Guard: Intent-Bound Behavior-Chain Modeling for Unauthorized Tool-Call Detection and Dynamic Permission Control in LLM Agents}, 
  year={2026},
  volume={},
  number={},
  pages={237-244},
  abstract={Tool-integrated large language model (LLM) agents can call files, databases, email systems, web search, and code execution tools, which turns tool use into a runtime authorization problem. This paper presents IBBC-Guard, an intent-bound behavior-chain method for unauthorized tool-call detection and dynamic permission control. IBBC-Guard binds a candidate call $C_{i}$ to an intent constraint I, updates a behavior chain graph BCG, computes Risk $(C_{i})$ from intent deviation, tool sensitivity, resource sensitivity, chain anomaly, and parameter risk, and maps the score to Allow, Downgrade, HumanConfirm, or Deny through an intentscoped capability Capi. Under the OASB-800 controlled simulation, IBBC-Guard achieves ASR=0.000, UDR=1.000, FPR=0.011, BTCR=0.971, Overhead =14.2%, and SUS=0.728. Sandboxed live planning traces from gpt-5.4, gemini-3.1-propreview, deepseek-v4-flash, and kimi-k2.6 further test interception at the model-tool boundary. Claims remain limited to controlled benchmarks and sandboxed traces. The main innovation is an intent-bound behavior-chain authorization event enforced before executor access. The evaluation covers controlled guardrail baselines, per-call authorization latency, adversarial prompt robustness, and structural multi-agent scalability under controlled and sandboxed settings.},
  keywords={Tools;Authorization;Modeling;Large language models;Runtime;Planning;Printing;Electronic mail;Sensitivity;Automatic speech recognition;LLM agent security;tool-call authorization;prompt injection;behavior chain graph;dynamic permission control;runtime enforcement},
  doi={10.1109/WCCIS70285.2026.11650697},
  ISSN={},
  month={July},}@INPROCEEDINGS{10705238,
  author={Traykov, Kiril},
  booktitle={2024 IEEE 12th International Conference on Intelligent Systems (IS)}, 
  title={A Framework for Security Testing of Large Language Models}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={The purpose of this paper is to present a framework for testing of large language models (LLMs) for security vulnerabilities before their implementation to production environment. The paper discusses the latest developments in the Artificial Intelligence (AI) and Generative Artificial Intelligence (Generative AI) adoption in the industry, the expectations for further accelerated adoption and evolving regulatory landscape. An overview of the most significant risks and vulnerabilities of the LLMs such as prompt injection and denial of service have been presented with their mitigation strategies. A testing approach and testing framework have been developed and implemented with simple chatbot app. The test scenarios have been executed and results have been obtained for three open-source LLMs from which two pass the test and one failed and demonstrated the application of the proposed testing framework. Source code of the application and test script are published open source for reproducibility and reuse. In conclusion the with the confirmation of the results the limitation of the reliance on semantic similarity for the responses of the models was discussed together with three areas for further development: expanding the test scenarios to significant risks, integration with popular cloud continuous development platforms and integrating blockchain for transparent publication of the final test results.},
  keywords={Industries;Generative AI;Large language models;Prevention and mitigation;Source coding;Semantics;Reproducibility of results;Blockchains;Computer crime;Testing;Large language models (LLMs);Cybersecurity;LLM Security;LLM Risks;LLM Vulnerabilities;Secure Software Development;Software Testing},
  doi={10.1109/IS61756.2024.10705238},
  ISSN={2767-9802},
  month={Aug},}@INPROCEEDINGS{11588515,
  author={Deshmukh, Niharika and Rajurkar, Rani and Mamidwar, Piyush},
  booktitle={2026 International Conference on System, Computation, Automation and Networking (ICSCAN)}, 
  title={Agent Card Poisoning: Measuring Discovery-Layer Injection Attacks and Defenses in A2A Systems}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={The Agent-to-Agent (A2A) protocol enables LLMbased agents to advertise capabilities via JSON Agent Cards served at a well-known HTTP endpoint. Orchestrating agents consume these cards at discovery time without cryptographic verification, creating an uninvestigated injection surface. We present a pilot study of Agent Card Poisoning (T1-G1: task hijack), in which an attacker serves a card whose url field redirects the orchestrator's task routing to an attacker-controlled endpoint. We implement and evaluate three payload tiers-naive (plaintext override), structured (JSON-embedded), and 11m_gen (naturallanguage social engineering)-against five defense combinations spanning regex sanitization (D1), output filtering (D2), and LLMbased card auditing (D3), and propose this combination matrix as a reusable evaluation framework for future work. In pilot runs ($n=3$ per tier per combo), all three attack tiers succeeded against an undefended orchestrator. D1 blocked all syntactically explicit trials but was bypassed by all three 11 m_gen trials. D3 blocked all nine T1-G1 pilot trials with no false positives in 100 benign trials (95% CL upper bound: $\mathbf{F P R} \leq 3.6 \%$). We release the testbed, attack corpus, and defense implementations as an open evaluation platform, and outline the full study design needed to establish statistically rigorous rates.},
  keywords={Large language models;Modeling;Payloads;Protocols;Uniform resource locators;Printing;Planning;Design methodology;Surfaces;Social engineering (security);prompt injection;agent-to-agent protocol;agent card poisoning;LLM security;multi-agent systems;defense evaluation},
  doi={10.1109/ICSCAN66520.2026.11588515},
  ISSN={},
  month={June},}@INPROCEEDINGS{11648025,
  author={Lirsi, Meryem and Mandar, Meriem and Bnslimane, Yassine},
  booktitle={2026 International Conference on Cybersecurity, Digital Forensics, and AI Applications (ICCSDFAI)}, 
  title={CAL-CTI: A Continual Adversarial Learning Framework for LLM-Based Cyber Threat Intelligence Under Non-Stationary Distributions}, 
  year={2026},
  volume={},
  number={},
  pages={1081-1085},
  abstract={The cybersecurity threat landscape evolves continuously, requiring Cyber Threat Intelligence (CTI) systems to adapt to new attack techniques while retaining prior knowledge and resisting adversarial manipulation. We present CAL-CTI, a Continual Adversarial Learning framework integrating: (i) a two-stage OOD-Aware Adversarial Prompt Filter (APF) combining Mahalanobis distance over SecureBERT embeddings and predictive entropy; (ii) Elastic Weight Consolidation (EWC) applied to a fine-tuned SecureBERT backbone for 9-class MITRE ATT&CK tactic classification; and (iii) a preliminary federated aggregation module for multi-organizational CTI sharing, validated at a conceptual level. We formally identify the buffer poisoning problem and validate it empirically. Evaluated on 2,610 real MITRE ATT&CK v15 samples with 600 adversarial inputs across three difficulty tiers (seed=42), CAL-CTI achieves F1=0.9503 on real MITRE ATT&CK v15 data, with backward transfer (FR=−0.0423) and 73.9% adversarial blocking (ASR=26.1%). Ablation confirms the buffer poisoning hypothesis (+0.1119 FR degradation upon APF removal). CAL-CTI is the Pareto-optimal point on the security-utility frontier.},
  keywords={Cyber threat intelligence;Modeling;Toxicology;Automatic speech recognition;Large language models;Printing;Continuing education;Artificial intelligence;Filtering;Filters;Cyber Threat Intelligence;Continual Learning;Adversarial Robustness;OOD Detection;Federated Learning;Elastic Weight Consolidation;MITRE ATT&CK;Prompt Injection},
  doi={10.1109/ICCSDFAI70505.2026.11648025},
  ISSN={},
  month={June},}@ARTICLE{11643532,
  author={Xie, Yuanai and Chen, Jiaxin and Liu, Zhaozhi},
  journal={IEEE Communications Magazine}, 
  title={Beyond Wireless Security: Covert Communications in Large Language Model-Enabled Edge Networks}, 
  year={2026},
  volume={},
  number={},
  pages={1-7},
  abstract={Large language model (LLM)-enabled edge networks (LLMENs) offer mobile users high-quality and low-latency AI-generated content services in the 6G era. However, unlike typical edge networks, LLMENs present unique security challenges due to the inherent complexity of LLMs, their high computational overhead, and continuous interactions with users. Specifically, both frequent user interactions (i.e., queries and responses) over wireless channels and potential electromagnetic information leakage from intensive LLM computations make LLMENs susceptible to various security threats, such as eavesdropping, jamming, prompt poisoning, and prompt injection attacks. Since existing countermeasures against these attacks often incur prohibitive overhead, developing holistic, efficient, and secure privacy protections for LLMENs is crucial. This article first reviews the vulnerabilities of LLMENs, outlines various attacks, and analyzes the drawbacks of existing countermeasures. To overcome these limitations, we propose a covert communications (CC) and computations approach to enhance both the overall security and efficiency of LLMENs. Furthermore, various supplementary solutions are developed to improve the covertness of this framework. Finally, our approach is further evaluated through a case study where the total latency is minimized under stringent communication and computational security requirements. Numerical results demonstrate the proposed approach's effectiveness in enhancing both privacy protection and the execution efficiency of LLM tasks.},
  keywords={Modeling;Security;Large language models;Privacy;Central Processing Unit;Countermeasures (computer);Frequency;Joining processes;Timing;Signal detection},
  doi={10.1109/MCOM.001.2600036},
  ISSN={1558-1896},
  month={},}@INPROCEEDINGS{11736648,
  author={Ayappan, Kavitha and Thangakumar, J. and Balamurugan, M and Aagaash, K R},
  booktitle={2026 International Conference on Next-Gen Intelligent Computing and Applications (ICONICA)}, 
  title={Cyber security Integration Framework using Multi-Agent Reinforcement Learning for Agent OS : with Adaptive Threat Defence and Governance Compliance}, 
  year={2026},
  volume={1},
  number={},
  pages={1-6},
  abstract={LLM powered autonomous agents do not have principled middleware for lifecycle management, orchestration of multi-agent systems, and risk-tailored cybersecurity. We introduce Agent OS - a five-layer operating system abstraction with an Agent Kernel, Zero-Trust Permission Controller, integrity-checked Memory Management, and an ephemerally-sandboxed Tiered Tool Registry designed to address the agentic cybersecurity domain. The newly introduced Orchestration Layer trains a Multi-Agent Reinforcement Learning (MARL) policy with Contract-Based Compositional Shielding to avoid unsafe agent behaviors, circumventing the brittleness of hierarchical task planning while maintaining theoretical runtime safety guarantees. The Cybersecurity Integration Framework implements a novel approach to the MITRE ATT&CK for AI matrix, provisions Zero Trust Network Access between agents, and utilizes LoRA-adapted Small Language Models for zero-shot adversarial prompt detection with GRC-compliant audit logging capabilities for the EU AI Act and NIST AI RMF frameworks.Our initial implementation demonstrated on a proof-of-concept prototype across four use cases (two of which were adversarial redteam tests) achieved an 84.7% task success rate, reduced cybersecurity violations by 85.7%, decreased successful prompt injection attempts by 79.4% (from 68% to 11% of trials), and achieved a 12% reduction in latency versus uninstrumented baselines. We introduce the first formalism for a cybersecurity architecture in the domain of agentic AI systems and present a potential reference architecture for standardization within the community.},
  keywords={Tools;Security;Artificial intelligence;Modeling;Printing;Memory;Poles and zeros;Computer security;Permission;Large language models;Agentic AI;Agent Operating System;Cybersecurity;Zero Trust;MITRE ATT&CK;STRIDE;Prompt Injection;Privilege Escalation;GRC;NIST AI RMF;Threat Intelligence;Multi-Agent Systems;LLM Security},
  doi={10.1109/ICONICA70605.2026.11736648},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11023405,
  author={Labunets, Andrey and Pandya, Nishit V. and Hooda, Ashish and Fu, Xiaohan and Fernandes, Earlence},
  booktitle={2025 IEEE Symposium on Security and Privacy (SP)}, 
  title={Fun-tuning: Characterizing the Vulnerability of Proprietary LLMs to Optimization-Based Prompt Injection Attacks via the Fine-Tuning Interface}, 
  year={2025},
  volume={},
  number={},
  pages={411-429},
  abstract={We surface a new threat to closed-weight Large Language Models (LLMs) that enables an attacker to compute optimization-based prompt injections. Specifically, we characterize how an attacker can leverage the loss-like information returned from the remote fine-tuning interface to guide the search for adversarial prompts. The fine-tuning interface is hosted by an LLM vendor and allows developers to fine-tune LLMs for their tasks, thus providing utility, but also exposes enough information for an attacker to compute adversarial prompts. Through an experimental analysis, we characterize the loss-like values returned by the Gemini fine-tuning API and demonstrate that they provide a useful signal for discrete optimization of adversarial prompts using a greedy search algorithm. Using the PurpleLlama prompt injection benchmark, we demonstrate attack success rates between 65% and 82% on Google's Gemini family of LLMs. These attacks exploit the classic utility-security tradeoff - the fine-tuning interface provides a useful feature for developers but also exposes the LLMs to powerful attacks.},
  keywords={Training;Privacy;Prevention and mitigation;Large language models;Oral communication;Vectors;Internet;Security;Optimization;Faces;machine learning;computer security;attacks},
  doi={10.1109/SP61157.2025.00121},
  ISSN={2375-1207},
  month={May},}@INPROCEEDINGS{11594513,
  author={Hasan, Najmul and BusiReddyGari, Prashanth and Zhao, Haitao and Ren, Yihao and Xu, Jinsheng and Zhang, Shaohu},
  booktitle={2026 56th Annual IEEE International Conference on Dependable Systems and Networks Workshops (DSN-W)}, 
  title={LLM-PEA: Leveraging Large Language Models Against Phishing Email Attacks}, 
  year={2026},
  volume={},
  number={},
  pages={114-120},
  abstract={Large Language Models (LLMs) are increasingly deployed inside email-security pipelines, raising the question of how they behave not just on benign messages but on adversarially crafted phishing content. We present LLM-PEA, an evaluation framework that probes GPT-4o, Claude Sonnet 4, and Grok-3 under three prompting strategies (structured, zero-shot, chain-of-thought) across a clean baseline and three attack dimensions: adversarial rephrasing, prompt injection, and cross-lingual translation. The three models attain 95%, 94%, and 88% accuracy on the balanced baseline, but susceptibility depends on the attack. Adversarial rephrasing of 189 matched phishing samples yields attack success rates of 4.2% (GPT-4o), 12.7% (Claude Sonnet 4), and 0% (Grok-3); a separate single-template instruction-override on 1,000 original emails yields 4.2%, 1.3%, and 12.3% respectively—a different susceptibility ordering. Applying six injection templates to the same 189 rephrased samples yields 1.1%, 2.9%, and 1.6%, together with the adversarial-only results covering three of four cells of a 2×2 factorial on matched inputs. The sharpest degradation is cross-lingual: Claude Sonnet 4’s false-positive rate rises from 2.4% in English to a mean of 24.1% across Bangla, Chinese, and Hindi (a +904% relative increase), peaking at 30.6% in Bangla and erasing its baseline advantage. All runs use temperature 0; adversarial rephrases are generated by GPT-4o, itself one of the evaluated detectors. No single model is uniformly robust across these three attack dimensions.},
  keywords={Electronic mail;Modeling;Phishing;Multilingual;Signal detection;Large language models;Printing;Generative Pre-trained transformer;Poles and zeros;Conferences;Phishing email attack;LLM;prompt injection},
  doi={10.1109/DSN-W70714.2026.00038},
  ISSN={2325-6664},
  month={June},}@ARTICLE{11520232,
  author={Yazdinejad, Abbas and Karimipour, Hadis},
  journal={IEEE Access}, 
  title={Temporal Dynamics of Memory Poisoning in Web3-Style LLM Agents}, 
  year={2026},
  volume={14},
  number={},
  pages={76200-76221},
  abstract={Memory-enabled large language model (LLM) agents, particularly those deployed in long-horizon, tool-using settings such as Web3-style autonomous workflows, introduce security risks that extend beyond single-prompt injection. By persisting and reusing information across interaction steps and sessions, these agents enable memory poisoning attacks in which adversarial inputs modify persistent agent state and influence future decisions after benign intermediate interactions. Recent work on context manipulation and “fake memories” demonstrates that adversarial content can be injected into an agent’s prompt-visible inputs or persistent memory; however, existing evaluations largely analyze such attacks at isolated interaction steps or static context snapshots, obscuring their temporal dynamics. In this paper, we present the first large-scale, trajectory-level measurement framework for analyzing temporal memory poisoning in memory-enabled LLM agents. We construct a schema-constrained dataset of 2,614 multi-step attack trajectories spanning four attack families, chain poisoning, policy rewriting, backdoor triggering, and slow drift, executed over shared persistent memory. We define temporal risk metrics over multi-step interaction trajectories that capture delayed activation, non-monotonic escalation, and the earliest point at which attacks become distinguishable from benign behavior. Our empirical results show that a substantial fraction of attacks remain indistinguishable from benign behavior until late-stage activation, despite exhibiting low or medium risk at all earlier steps. Slow-drift and backdoor-trigger attacks, in particular, systematically evade step-local evaluation until terminal interactions, while chain poisoning and policy rewriting exhibit non-monotonic risk trajectories. These findings demonstrate that memory poisoning risk is inherently temporal and cannot be reliably assessed using prompt-level or step-isolated evaluation, motivating trajectory-aware benchmarks for agent security.},
  keywords={Trajectory;Memory;Modeling;Large language models;Labeling;Measurement;Toxicology;Delays;Security;Signal detection;LLM agents;memory poisoning;web3.0 agents;multi-step attacks},
  doi={10.1109/ACCESS.2026.3693560},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11395844,
  author={Dao, Ailene and VanGorder, Richard and Gebril, Mohamed and Abdelhamid, Sherif},
  booktitle={2026 IEEE 5th International Conference on AI in Cybersecurity (ICAIC)}, 
  title={A Comprehensive Assessment Tool for Prompt Injection Attacks in Large Language Models (LLMs)}, 
  year={2026},
  volume={},
  number={},
  pages={1-9},
  abstract={A prompt injection attack is a type of cyberattack that targets Large Language Models (LLMs), where attackers embed malicious instructions into a LLM with the intent of manipulating the model to the attacker’s desire. Due to the relevance, growth, and demand of LLMs within small to medium-sized businesses, it is essential that they have access to a tool that can comprehensively assess model vulnerabilities. Based on an established framework for Prompt Injection attacks, this paper introduces a tool that can simulate types of injection attacks across different widely used LLM models and versions, test different defenses against these attacks, and measure the performance and how vulnerable the LLM’s responses are. Additionally, this paper incorporates cost analysis, CPU utilization metrics, and a prompt hardening methodology for LLM personas. The results of these experiments provide deeper insights into testing and a comparative analysis against commonly used LLMs today.},
  keywords={Measurement;Large language models;Cost benefit analysis;Cyberattack;Testing;Business;Artificial intelligence;Cybersecurity;Large language models;Prompt injection attacks},
  doi={10.1109/ICAIC67076.2026.11395844},
  ISSN={},
  month={Feb},}@ARTICLE{11673101,
  author={Heydari, Vahid and Nyarko, Kofi and Alam, Syeda Sadia},
  journal={IEEE Access}, 
  title={RIPPLE: Differential Testing of Exact-Value Restoration Boundaries in Privacy-Preserving LLM Pipelines}, 
  year={2026},
  volume={14},
  number={},
  pages={134454-134478},
  abstract={Privacy-preserving large language model (LLM) pipelines often replace sensitive input values with placeholders before inference and later restore approved values in the generated response. This restoration step can itself introduce unauthorized sensitive values into the final output, yet standard evaluations often conflate values already produced by the model with values newly inserted by restoration. This article presents RIPPLE, a differential regression-testing methodology that attributes exact sensitive-value exposure to either raw model output or downstream restoration. Allow-only policy gating is treated as a baseline restoration obligation rather than as the methodological contribution. RIPPLE separately measures sensitive values present before restoration, values newly released by restoration, and sensitive values visible in the final output; it also distinguishes exact-value non-release from typed marker or placeholder category disclosure. In a matched 120-case attribution probe, RIPPLE distinguishes raw sensitive literals already present in model output from releases caused by placeholder restoration. In a designed 18,000-case controlled benchmark with no pre-existing unauthorized exact values, naive restoration causes unauthorized exact-value release in 78.2% of benchmark cases; this value is a regression-test stress rate for the constructed perturbation suite, not an estimate of deployment incidence. Under the same tested contract, the evaluated policy-gated engines produce zero measured restoration-induced releases. An 11-defect mutation study shows that final-exposure, differential-release, DLP, policy-gating, proxy, and audit signals detect different classes of restoration faults, and a marker/opaque-placeholder analysis shows how generic markers and opaque placeholders remove category-disclosure surfaces without changing exact-release outcomes. Evaluations using a public Gretel PII corpus adaptation and 360 frozen outputs from a Microsoft Presidio–LLM pipeline provide independently sourced synthetic and reproducible downstream checks. RIPPLE is an audit-oriented method for testing exact-value restoration boundaries, not a general privacy or prompt-injection defense.},
  keywords={Modeling;Testing;Labeling;Contracts;Engines;Syntactics;Human factors;Privacy;Stress;Poles and zeros;Data loss prevention;declassification;LLM security;placeholder provenance;pseudonymization;restoration failures;security regression testing},
  doi={10.1109/ACCESS.2026.3729141},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{10917640,
  author={Shan, Weijie and Long, Teng and Zhou, Zhangbing},
  booktitle={2024 International Conference on Identification, Information and Knowledge in the Internet of Things (IIKI)}, 
  title={Adversarial Attacks on IoT Systems Leveraging Large Language Models}, 
  year={2024},
  volume={},
  number={},
  pages={154-159},
  abstract={Internet of Things (IoT) devices have revolutionized various sectors by providing enhanced connectivity and automated services. However, the integration of these devices into complex networks has introduced significant security challenges. Concurrently, advancements in Language Model (LLM) technologies, exemplified by large-scale models like GPT-4, have given rise to sophisticated cyber-attack strategies. With the widespread use of various large language models, these models may generate a large amount of offensive and socially detrimental content during their use. In response, the primary focus of model developers is to adjust alignment models to prevent the generation of harmful content. Meanwhile, adversarial attackers focus on achieving “jailbreaks” to bypass the alignment measures of model developers, thereby generating harmful content and testing the effectiveness of model alignment. The main attack methods currently include prompt injection, unsafe output handling, denial of service, and general adversarial attacks. We selected the Llama-2-7b large language model as the experimental test model and constructed IoT related issues to achieve the generation of harmful content and desired responses.},
  keywords={Large language models;Complex networks;Internet of Things;Security;Cyberattack;Testing;Large Language Model;The Internet of Things;Adversarial Attacks},
  doi={10.1109/IIKI65561.2024.00035},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11498175,
  author={Kemnitzer, Jonas and Groth, Christian},
  booktitle={2026 International Conference on Advances in Artificial Intelligence and Machine Learning (AAIML)}, 
  title={Beyond Shared Embedding Spaces: Towards LLM Architectures with Explicit Authority Control for Prompt Security}, 
  year={2026},
  volume={},
  number={},
  pages={110-116},
  abstract={Large Language Models are highly susceptible to prompt injection because their architecture fails to separate system instructions from untrusted user data. Current defenses offer only superficial mitigation by addressing symptoms, not the root cause. This paper proposes a fundamental architectural shift to enforce this separation through mechanisms like authority-aware attention and segregated processing pathways. We outline existing vulnerabilities and present an architectural roadmap towards next-generation LLMs with structurally enforced instruction integrity and inherent resilience against prompt injection.},
  keywords={Payloads;Nuclear weapons;Military aircraft;Space technology;Broadcasting;Broadcast technology;Filtering;Filters;Feedback;Circuits;Large Language Models;prompt injection;LLM security;architectural design;trustworthy AI},
  doi={10.1109/AAIML67890.2026.11498175},
  ISSN={},
  month={March},}@INPROCEEDINGS{10903912,
  author={Rathod, Vishal and Nabavirazavi, Seyedsina and Zad, Samira and Iyengar, Sundararaja Sitharama},
  booktitle={2025 IEEE 15th Annual Computing and Communication Workshop and Conference (CCWC)}, 
  title={Privacy and Security Challenges in Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={00746-00752},
  abstract={Large Language Models (LLMs) are at the forefront of artificial intelligence advancements, demonstrating exceptional capabilities in natural language understanding and generation across diverse domains such as healthcare, finance, and customer service. However, their deployment introduces substantial secu-rity and privacy risks, including prompt injection, data leakage, and unauthorized data disclosures. These vulnerabilities highlight the need for robust frameworks to safeguard sensitive data and prevent misuse. This paper provides a comprehensive analysis of the security and privacy challenges in LLMs, examines existing mitigation strategies such as intelligent LLM firewalls, differen-tial privacy, and OW ASP-based security principles, and discusses future directions for ethical and secure LLM deployment. By addressing these challenges in detail, we identify gaps in current practices and propose a roadmap for the secure and responsible deployment of LLMs in high-stakes applications. Our findings underscore the importance of tailored security frameworks and privacy-preserving techniques to ensure the ethical and reliable use of LLMs in sensitive environments. Additionally, this pa-per emphasizes the significance of a human-in-the-loop (HITL) approach to ensure accountability and accuracy, particularly in critical domains. The discussion extends to emerging technologies such as retrieval-augmented generation (RAG) and adaptive threat detection systems, which hold promise for enhancing the security and ethical deployment of LLMs.},
  keywords={Industries;Ethics;Privacy;Technological innovation;Firewalls (computing);Large language models;Computational modeling;Medical services;Threat assessment;Security;Artificial intelligence;Natural language processing;Large language models (LLM);Privacy;OWASP;Data Protection;AI Ethics;Firewall;Threat Modeling;Data Leakage;Ethical Bias Mitigation;Federated Learning;Healthcare AI;Human-in-the-Loop (HITL);Adaptive Security Frameworks;Privacy-Preserving Computation},
  doi={10.1109/CCWC62904.2025.10903912},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{11389048,
  author={Yu, Lijia and Cao, Yan},
  booktitle={2025 IEEE 6th International Conference on Computer, Big Data, Artificial Intelligence (ICCBD+AI)}, 
  title={AdvAttack-LLM: Exploiting Elasticity in Large Language Models for Efficient Adversarial Attacks}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Despite significant advancements in safety alignment, Large Language Models (LLMs) remain vulnerable to adversarial attacks that manipulate their behavior through carefully crafted inputs. This paper investigates the inherent elasticity of LLMs—their tendency to revert to pre-training distributions when subjected to adversarial fine-tuning. We propose a novel adversarial attack framework, AdvAttack-LLM, that systematically exploits this elasticity to efficiently compromise model alignment. Through comprehensive experiments on LLaMA-3 models using the AdvBench dataset, we demonstrate that elasticity-based adversarial attacks achieve significantly higher success rates (54.8%) with substantially fewer queries (25.2 average queries) compared to state-of-the-art methods. Our theoretical analysis, grounded in compression theory with detailed physical interpretations, reveals that the effectiveness of adversarial attacks is inversely proportional to the KL divergence between pre-training and alignment distributions, explaining why minimal adversarial perturbations can subvert extensively aligned models. These findings highlight critical security vulnerabilities in current alignment approaches and underscore the need for elasticity-aware defense mechanisms.},
  keywords={Data privacy;Costs;Large language models;Perturbation methods;Computational modeling;Elasticity;Big Data;Data models;Safety;Computer security;Large Language Models;Adversarial Attacks;Model Elasticity;Compression Theory;AI Safety;Privacy Leakage;Prompt Injection},
  doi={10.1109/ICCBDAI66607.2025.11389048},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11755240,
  author={Romero, Daniel and Alonso, Chema},
  booktitle={2026 International Conference on Cybersecurity and AI-Based Systems (Cyber-AI)}, 
  title={Mitigation of Fragmentation Jailbreak Attacks in Multi-Agent Systems: An Architecture Based on Global Semantic Monitoring}, 
  year={2026},
  volume={},
  number={},
  pages={354-361},
  abstract={The integration of Large Language Models (LLMs) and Small Language Models (SLMs) into multi-agent and embodied artificial intelligence (Embodied AI) systems has significantly expanded the attack surface of digital services. Current safetyalignment mechanisms are increasingly effective against direct jailbreak attempts on individual agents, but multi-agent architectures remain vulnerable to fragmentation jailbreak attacks. In a fragmentation jailbreak, a malicious instruction is split into seemingly innocuous subtasks that are distributed across agents and processed in isolation. In this article, we present an empirical study and an architecture proposal aimed at mitigating this phenomenon, which we term “context washing”. To validate our hypothesis, we have developed a simulation environment based on a two-phase architecture: a Planning Phase, in which an uncensored LLM running locally via Ollama generates a structured attack plan in JSON, and an Execution Phase, in which domain-specific agents with safety guardrails execute the fragmented steps in isolation. We illustrate the threat in ten safety-critical, language-level Embodied AI scenarios spanning chemistry, aviation, diving, electrical maintenance, and hospital radiology, in which the fragmented plan culminates in actions that would violate Asimov's First Law. To address this risk, we introduce a Monitor Agent that supervises the execution chain in parallel, similar to an intrusion detection system in network security. This component audits the execution chain in real time and evaluates the semantic trace globally -augmented by a domainspecific knowledge base- to identify latent fragmentation tactics. This provides preliminary evidence that global monitoring can help mitigate confused-deputy failures in the evaluated scenarios by maintaining an analytical context of the activity of all agents in the system. All attacks and defenses are validated purely at the language level: no real actuators, robots, or external APIs are involved.},
  keywords={Modeling;Monitoring;Planning;Large language models;Printing;Artificial intelligence;Safety;Architecture;Computer architecture;Context;multi-agent systems;jailbreak;prompt injection;LLM security;embodied AI;confused deputy;semantic monitoring},
  doi={10.1109/Cyber-AI70573.2026.11755240},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11418030,
  author={Nagaraja, Neha and Bahsi, Hayretdin},
  booktitle={2025 Annual Computer Security Applications Conference Workshops (ACSAC Workshops)}, 
  title={Goal-Driven Risk Assessment for LLM-Powered Systems: A Healthcare Case Study}, 
  year={2025},
  volume={},
  number={},
  pages={290-297},
  abstract={While incorporating LLMs into systems offers significant benefits in critical application areas such as healthcare, new security challenges emerge due to the potential cyber kill chain cycles that combine adversarial model, prompt injection and conventional cyber attacks. Threat modeling methods enable the system designers to identify potential cyber threats and the relevant mitigations during the early stages of development. Although the cyber security community has extensive experience in applying these methods to software-based systems, the elicited threats are usually abstract and vague, limiting their effectiveness for conducting proper likelihood and impact assessments for risk prioritization, especially in complex systems with novel attacks surfaces, such as those involving LLMs. In this study, we propose a structured, goal driven risk assessment approach that contextualizes the threats with detailed attack vectors, preconditions, and attack paths through the use of attack trees. We demonstrate the proposed approach on a case study with an LLM agent-based healthcare system. This study harmonizes the state-of-the-art attacks to LLMs with conventional ones and presents possible attack paths applicable to similar systems. By providing a structured risk assessment, this study makes a significant contribution to the literature and advances the secure-by-design practices in LLM-based systems.},
  keywords={Threat modeling;Limiting;Trees (botanical);Conferences;Prevention and mitigation;Large language models;Medical services;Vectors;Safety;Cyberattack;healthcare;large language models;cyber threats;conversational attacks;adversarial attacks;risk analysis},
  doi={10.1109/ACSACW69556.2025.00037},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11644251,
  author={Uysal, Çağlar and Birinci, Baturay and Mutluergil, Süha Orhun and Çetin, Orçun},
  booktitle={2026 21st European Dependable Computing Conference Companion Proceedings (EDCC-C)}, 
  title={An Empirical Evaluation of Prompt Injection Vulnerabilities in Large Language Models Across Multilingual and Obfuscated Attack Scenarios}, 
  year={2026},
  volume={},
  number={},
  pages={73-80},
  abstract={Large Language Models (LLMs) have rapidly evolved, transforming industries by automating complex tasks and generating human-like content. However, as their adoption accelerates, prompt injection vulnerabilities have become increasingly apparent. Malicious actors exploit these weaknesses to generate phishing emails, deceptive websites, and malware, posing serious security risks. This paper presents an empirical evaluation of six state-of-the-art LLMs (DeepSeek, GPT, Gemini, Grok, Llama, and Qwen) under diverse adversarial prompt scenarios, including direct and multi-stage obfuscated attacks across multiple languages and character encodings. The proposed framework measures how effectively current LLMs resist manipulation into performing harmful actions. Our findings reveal systematic vulnerabilities across all tested models. Even direct prompt injections frequently induce the generation of phishing content, websites, and malware, while elaborate prompts achieve even higher malicious compliance rates, particularly for phishing. Models such as DeepSeek, Gemini, and Grok show especially high susceptibility under complex instructions. Notably, non-English languages consistently exhibit higher compliance rates than English, exposing significant gaps in multilingual safety alignment. Although simple character encodings reduce malicious outputs, they do not eliminate them. These results highlight persistent challenges in LLM safety and underscore the urgent need for stronger defenses and improved security mechanisms to support the ethical and secure deployment of LLMs in cybersecurity sensitive contexts.},
  keywords={Modeling;Phishing;Electronic mail;Large language models;Safety;Encoding;Malware;Multilingual;Security;Signal detection;AI security;LLM safety;phishing;malware;prompt engineering},
  doi={10.23919/EDCCCCPS00002.2026.00039},
  ISSN={},
  month={April},}@INPROCEEDINGS{11497133,
  author={Deepak, Samira and Shukla, Viha and Shetty, Ronit and Kolhe, Abhay and Tiwari, Manisha},
  booktitle={2026 IEEE International Conference on AI Engineering and Innovations (AIEI)}, 
  title={PromptFence: A Semantic Guardrail for Healthcare AI to Defend Against Prompt Injection Attacks}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={The use of large language models (LLMs) is increasingly growing in healthcare to perform valuable tasks, including summarizing clinical notes, extracting vital signs, and translating medical language. However, there is a serious patient safety and confidentiality risk associated with a user engaging in a prompt injection-a malicious instruction hidden in the input. In light of this challenge, we are introducing the concept of PromptFence, which is a semantic guardrail that captures and analyzes prompts before entering the core LLM. Using BERT-base embeddings and contrastive loss-based intent similarity, PromptFence checks inputs for alignment with an approved set of healthcare tasks and flags or sanitizes instructions that do not align with the safe intent of the task, or worse, are malicious.},
  keywords={Feeds;Antennas;Filtering;Filters;Integrated circuits;Circuits and systems;Protocols;HTTP;Receivers;Artificial intelligence;Large Language Models (LLMs);Prompt Injection Attacks;Semantic Drift Detection;Healthcare AI;Contrastive Fine-Tuning},
  doi={10.1109/AIEI69164.2026.11497133},
  ISSN={},
  month={March},}@INPROCEEDINGS{11366720,
  author={Sperlí, Giancarlo},
  booktitle={2025 International Symposium on Multimedia (ISM)}, 
  title={Exploring Privacy and Security Risks in LLMs: Data Leakage, Prompt Injection, and Membership Inference}, 
  year={2025},
  volume={},
  number={},
  pages={5-12},
  abstract={In this paper, we present an analysis of the dual role of Large Language Models (LLMs) in the context of multimedia security, examining how these models can both strengthen defensive capabilities and introduce new vulnerabilities within modern content ecosystems. As LLMs increasingly interface with multimedia workflows-ranging from text-image generation pipelines to cross-modal retrieval and content moderation-their susceptibility to attacks such as data leakage, prompt injection, and jailbreaks raises critical concerns for the integrity and trustworthiness of multimedia platforms. We focus our analysis on privacy-oriented threats, including model inversion and membership inference, and discuss their implications for systems that process or generate multimedia content. Building on this risk landscape, we outline principles for improving the robustness and resilience of LLM-driven multimedia applications, highlighting strategies suited to in-the-wild threat scenarios. Indeed, we explore the constructive application of LLMs within cybersecurity frameworks, such as the Cyber Kill Chain, demonstrating how these models can be leveraged for threat detection, risk assessment, and automated defensive operations.},
  keywords={Analytical models;Biological system modeling;Large language models;Multimedia systems;Pipelines;Ecosystems;Threat assessment;Robustness;Risk management;Resilience;Large Language Models;Security Risks;Model Inversion;Membership Inference},
  doi={10.1109/ISM66958.2025.00011},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11663676,
  author={Chugani, Hitesh},
  booktitle={2026 International Conference on Intelligent and Sustainable Electronics & Computing Technologies (INSECT)}, 
  title={EB-AIOps: Evidence-Bound and Injection-Resilient Intelligent Triage for Cloud Security Logs}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Modern cloud platforms and large distributed systems generate massive volumes of logs that record failures, access behavior, and system states. These logs are central to security monitoring and reliability engineering. While recent log analysis models can detect anomalies with high accuracy, operational triage remains difficult. Security teams still need to manually inspect long log sequences, and emerging LLM-based assistants often produce explanations that lack sufficient evidence. More critically, cloud logs are untrusted inputs, and malicious strings embedded in logs can manipulate automated assistants and trigger unsafe outputs. This paper presents EB-AIOps, an evidence-bound and injection-resilient framework for intelligent cloud security triage. The proposed system integrates structured log parsing, risk-aware incident detection, evidence retrieval, and controlled language-model-based reporting. Only high-risk windows are forwarded for triage. For each suspected incident, the framework retrieves a small set of relevant historical logs and constrains the assistant to generate reports strictly grounded in this evidence. Raw log text is isolated from system instructions, which limits the effect of prompt injection hidden inside logs. Experiments on large-scale distributed log datasets show that EB-AIOps achieves strong detection performance, reaching 0.991 accuracy, 0.984 F1-score, and 0.993 AUC, outperforming deep sequence and transformer-based baselines. The framework also improves cross-system generalization, with F1-scores above 0.93 under domain shift. More importantly, EB-AIOps produces highly grounded triage outputs with 0.97 evidence precision and reduces prompt-injection attack success to 0.04, compared to 0.42 for unconstrained assistants. These results demonstrate that EB-AIOps enables accurate, verifiable, and secure incident triage for real cloud security operations.},
  keywords={Modeling;Clouds;Equations;Windows;Signal detection;Printing;Large language models;Cloud computing security;Labeling;Anomaly detection;Cloud security;distributed systems;log analysis;AIOps;evidence-based AI;large language models;incident triage;prompt injection;trustworthy cloud systems},
  doi={10.1109/INSECT68872.2026.11663676},
  ISSN={},
  month={May},}@INPROCEEDINGS{11631471,
  author={Abdelhamid, Sherif E. and Aly, Mona M.},
  booktitle={2026 7th International Conference on Artificial Intelligence, Robotics, and Control (AIRC)}, 
  title={LLM Shield: Detecting and Mitigating Adversarial Prompt Attacks on Large Language Models Using Machine Learning}, 
  year={2026},
  volume={},
  number={},
  pages={307-314},
  abstract={Large Language Models (LLMs) have transformed multiple domains, including education, cybersecurity, healthcare, robotics, and the Internet of Things (IoT), by enabling natural communication, contextual understanding, and intelligent automation. As these models are increasingly embedded into many software applications, robotics, and connected systems, ensuring their robustness and trustworthiness has become critical. However, most existing research focuses on LLM performance, optimization, and applications, with limited attention to security vulnerabilities and adversarial threats. Emerging attacks such as jailbreaking, prompt injection, and multi-turn manipulation can override safety mechanisms and induce unintended or harmful behavior, posing serious risks to users and systems that rely on LLMs. This study addresses this gap by developing and analyzing a comprehensive dataset of different prompts, including safe and adversarial examples, collaboratively generated mostly by human experts and some by state-of-the-art LLMs such as GPT-4o and Claude 3.5 Sonnet. Using TF-IDF feature extraction and multiple machine learning classifiers, including K-Nearest Neighbors, Decision Tree, Logistic Regression, Random Forest, Naïve Bayes, Support Vector Machine (SVM), and an ensemble model, we trained our system to automatically detect adversarial intent in LLM prompts. The SVM model achieved the best performance with 99.85% accuracy, 99.87% F1-score, 99.84% Precision, and 99.91% Recall, indicating excellent discriminatory capability. Complementary linguistic, sentiment, and structural analyses revealed that adversarial prompts typically exhibit longer sentence structures, lower lexical diversity, and negative or neutral sentiment, along with manipulative n-gram patterns designed to bypass restrictions. To translate these findings into practice, we designed and implemented LLM Shield, a real-time web platform that monitors, classifies, and alerts users about potential adversarial prompts across connected systems and APIs. The platform visualizes threat types, injection frequencies, and system health through an interactive dashboard. Additionally, LLM Shield utilizes Claude 3.5 Sonnet for linguistic and contextual breakdowns and analyses of detected adversarial prompts. Together, this research contributes an empirical and practical foundation for detecting, mitigating, and monitoring adversarial attacks on LLMs, advancing the development of secure and resilient AI-driven ecosystems.},
  keywords={Modeling;Large language models;Labeling;Support vector machines;Machine learning;Machining;Printing;Real-time systems;Training;Signal detection;Large Language Models (LLMs);Adversarial Attacks;Prompt Injection;Machine Learning;Cybersecurity},
  doi={10.1109/AIRC69745.2026.11631471},
  ISSN={},
  month={April},}@INPROCEEDINGS{11635380,
  author={Zhou, Jun and Li, Hongying and Wang, Fan},
  booktitle={2026 IEEE 3rd International Conference on Big Data Science and Engineering (ICBDSE)}, 
  title={Ai SecureDataGuard: A Big Data Security, Privacy-Preserving and Visualization System for LLM-Powered Smart Homes}, 
  year={2026},
  volume={},
  number={},
  pages={1-7},
  abstract={Now large language models and that multi-agent frameworks are widely used, platforms like MOSS can let users talk to smart homes naturally and link up all kinds of household devices. But there’s a slew of tough issues hindering these products from practical commercial application IoT data from every device, constant user privacy leaks, intentional prompt injection and safety guardrail evasion attacks, plus no tool to monitor all risks instantly.For the resolution of all aforementioned drawbacks, I built a complete big data security framework named SecureDataGuard. It packs malicious input screening, differential privacy, federated lightweight anomaly tracking and real-time data visual monitoring into one set of tools. I built the whole system on top of MOSS AI’s multi-agent structure, and also adopted mature industrial AI security tools from Anquan Data Intelligence.First, I made a two-step intent recognition algorithm to block prompt injection and jailbreak attempts. Second, I put together a mixed privacy protection scheme, so we can use data normally without exposing raw user information. I also developed a slimmed-down Transformer model called LADT to catch abnormal device behaviors the second they happen. On top of that, I built a monitoring panel with StarRocks and ECharts, so administrators can track every risk across bird’s-eye view of the whole system.A large set of empirical experiments was implemented with real-world smart home operation records to corroborate the system’s performance.. Encouraging results are observed in our experiments. The system accurately recognizes user commands with an accuracy rate of 97.8%.Identifies anomalous activity within 18 ms and lowers privacy leakage probability by 92%. All 18 key security metrics on the dashboard update within milliseconds. This work delivers a practical, deployable technical solution to handle smart home data safety, privacy risks, Anomalous Event Detection and Visual Risk Control},
  keywords={Modeling;Security;Privacy;Smart homes;Visualization;Modules (abstract algebra);Large language models;Radio access networks;Regional area networks;Artificial intelligence;Smart Home;Big Data Security;Data Privacy;Differential Privacy;Federated Learning;Anomaly Detection;Data Visualization;LLM Security;Multi-Agent Collaboration},
  doi={10.1109/ICBDSE70225.2026.11635380},
  ISSN={},
  month={June},}@INPROCEEDINGS{11638153,
  author={Farin, Mashiat Amin and Thuraisingham, Bhavani},
  booktitle={2026 IEEE 12th Conference on Big Data Security on Cloud (BigDataSecurity)}, 
  title={A Four-Axis Systematization of AI and Cybersecurity in the Era of Large Language Models}, 
  year={2026},
  volume={},
  number={},
  pages={1-12},
  abstract={The convergence of artificial intelligence (AI) and cybersecurity has created a complex ecosystem of capabilities and threats. We systematize this space along four axes: AI-for-Cyber, Cyber-for-AI, LLM-for-Cyber, and Cyber-for-LLMs. Using a PRISMA-guided review of 422 recent works, we develop a unified taxonomy of AI–cyber interactions. AI-for-Cyber enables anomaly detection, intrusion detection, vulnerability analysis, and automated response. Cyber-for-AI highlights threats such as data poisoning, model extraction, and privacy leakage. Cyber-for-LLMs exposes vulnerabilities including prompt injection and jailbreaking, while LLM-for-Cyber introduces reasoning-driven capabilities for threat intelligence and offensive operations. We further identify compound cross-axis threats, where attackers combine techniques across axes (e.g., LLM-generated attacks exploiting AI defenses). This Systematization of Knowledge (SoK) consolidates fragmented literature, highlights systemic risks, and outlines open challenges for securing AI-enabled cyber systems.},
  keywords={Artificial intelligence;Computer security;Large language models;Machine learning;Modeling;Printing;Security;Conferences;Machining;Privacy;Artificial Intelligence;Cybersecurity;Large Language Models;AI for CyberSecurity;Cybersecurity for AI;LLMs for Cybersecurity;CyberSecurity for LLMs},
  doi={10.1109/BigDataSecurity69476.2026.00009},
  ISSN={},
  month={May},}@INPROCEEDINGS{11701777,
  author={Manohar, Lokesh Prakash},
  booktitle={2026 Technology and Innovation Conference (TIC)}, 
  title={Zero-Shot Prompt Injection Detection via N-gram Pooling of Token-Level Hidden States}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Retrieval-augmented generation (RAG) pipelines are vulnerable to prompt injection attacks, where adversaries embed malicious instructions inside retrieved documents. Existing embedding-based detectors rely on mean-pooled sentence vectors, which suppress short injection spans hidden within long benign text — a phenomenon we formalize as semantic dilution. We extract per-token hidden states from a frozen 22M-parameter sentence transformer already present in the pipeline and apply N-gram pooling over sliding windows to localize injection signals. On a controlled chunk-level benchmark (1,575 chunks, Enron corpus), our method achieves AUC = 0.901 (95 % CI [0.869, 0.930]), with confidence intervals non-overlapping with the mean-pool baseline (AUC = 0.808). On the public xTRam1 dataset, zero-shot AUC = 0.870 exceeds the supervised baseline of 0.764. All three scoring variants execute at identical CPU latency (≈44 ms per 500-character chunk). The method requires no labeled data, no fine-tuning, and no access to the generative LLM at inference time; zero-shot refers specifically to the absence of labeled injection training data, with the only domain knowledge being a small fixed reference set encoded offline.},
  keywords={Equations;Labeling;Large language models;Windows;Retrieval augmented generation;Training;Manuals;Signal detection;Poles and zeros;Modeling},
  doi={10.1109/TIC68483.2026.11701777},
  ISSN={},
  month={June},}@ARTICLE{11124871,
  author={Yang, Guan and Sun, Zhengzheng and Wang, Yu},
  journal={IEEE Access}, 
  title={ShellBox: Adversarially Enhanced LLM-Interactive Honeypot Framework}, 
  year={2025},
  volume={13},
  number={},
  pages={143618-143630},
  abstract={Honeypot technology is an active defence strategy designed to mitigate the asymmetry inherent in network attacks and defence dynamics. In recent years, honeypot systems powered by large language models (LLMs) have become a focal point of research owing to their ability to simulate complex network environments and generate highly deceptive virtual assets. However, response inconsistency in multi-turn dialogues and prompt injection vulnerabilities inherent to LLMs significantly reduce the deceptive capability of honeypots. This study first defines the threat model, and then introduces a relevance-based interaction history pruning algorithm and dynamic error simulation strategy to mitigate these challenges. Considering practical issues such as response latency and network instability, our experiments were conducted using multiple locally deployed open-source LLMs. The experimental results demonstrated that the proposed dynamic error simulation mechanism achieved a maximum accuracy of 81.63% for the DeepSeek-R1 model. Furthermore, applying the interaction history pruning algorithm improved the turn-level coherence score (TCS) by 34.5% compared with the baseline. Finally, this paper outlines potential future research directions for LLM-based honeypot technologies in active multi-turn mechanisms.},
  keywords={Heuristic algorithms;History;Databases;Chatbots;Linux;Large language models;Threat modeling;HTTP;Adaptation models;Prompt engineering;Network attack and multi-turn;honeypot;large language model;dynamic error simulation;interaction history pruning algorithm},
  doi={10.1109/ACCESS.2025.3598779},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11573506,
  author={Jia, Yuqi and Liu, Yupei and Shao, Zedian and Jia, Jinyuan and Gong, Neil Zhenqiang},
  booktitle={2026 IEEE Symposium on Security and Privacy (SP)}, 
  title={PromptLocate: Localizing Prompt Injection Attacks}, 
  year={2026},
  volume={},
  number={},
  pages={4243-4261},
  abstract={Prompt injection attacks deceive a large language model into completing an attacker-specified task instead of its intended task by contaminating its input data with an injected prompt, which consists of injected instruction(s) and data. Localizing the injected prompt within contaminated data is crucial for post-attack forensic analysis and data recovery. Despite its growing importance, prompt injection localization remains largely unexplored. In this work, we bridge this gap by proposing PromptLocate, the first method for localizing injected prompts. PromptLocate comprises three steps: ① splitting the contaminated data into semantically coherent segments, ② identifying segments contaminated by injected instructions, and ③ pinpointing segments contaminated by injected data. We show PromptLocate accurately localizes injected prompts across eight existing and eight adaptive attacks. Our code and data are available at: https://github.com/liu00222/Open-Prompt-Injection.},
  keywords={Large language models;Printing;Signal detection;Cleaning;Location awareness;Reviews;Detectors;Modeling;Optimization;Indexes},
  doi={10.1109/SP63933.2026.00105},
  ISSN={2375-1207},
  month={May},}@INPROCEEDINGS{11708929,
  author={Koneru, Naga Murali Krishna and Vadlamudi, Sai Krishna},
  booktitle={2026 International Conference on Natural Language Processing and Computer Vision (ICNPCV)}, 
  title={Secure Knowledge Extraction From Large Language Model}, 
  year={2026},
  volume={},
  number={},
  pages={1-10},
  abstract={Large Language Models (LLMs) have been found to excel in knowledge representation, reasoning and natural language understanding, useful for knowledge intensive applications. Yet, obtaining reliable knowledge from LLMs introduces numerous problems like hallucination, inconsistent answers, adversarial manipulation, and leakage of sensitive information. To ensure knowledge extraction is accurate, trustworthy, and privacy-preserving, this paper introduces a Secure Knowledge Extraction Framework (SKEF), which combines semantic prompt optimization, contextual validation, confidence-aware reasoning, retrieval augmentation, and security-driven filtering. To ensure the dissemination of generated knowledge, the proposed framework includes a hybrid architecture of prompt engineering, retrieval-based evidence verification, transformer-based semantic consistency analysis, confidence estimation, and policy-based security enforcement. In addition, an adaptive verification module is used to check the extracted knowledge against trusted external knowledge bases to reduce inconsistencies in factual knowledge and identify malicious or fabricated output. Experimental evaluation is carried out based on several benchmark datasets and a variety of extraction tasks, with the proposed framework being evaluated with precision, recall, F1-score, extraction accuracy, semantic consistency, response latency, and security robustness metrics. The results show that the proposed method achieves a high degree of reliability in knowledge extraction, decreases hallucination rates and increases the ability to resist prompt injection and adversarial attacks. The proposed framework outperforms traditional LLM-based extraction approaches in terms of knowledge quality and security, paving the way for its application in critical sectors like healthcare, cybersecurity, legal analysis, research, and enterprise knowledge management. The proposed framework offers a scalable and trustworthy approach to secure knowledge extraction from large language models with low computational overhead and meeting the current security standards and regulations for AI systems.},
  keywords={Large language models;Modeling;Equations;Security;Retrieval augmented generation;Accuracy;Modules (abstract algebra);Printing;Cognition;Cognitive systems;Large Language Models (LLMs);Knowledge Extraction;Secure Artificial Intelligence;Prompt Engineering;Retrieval-Augmented Generation (RAG);Semantic Validation;Hallucination Detection;Trustworthy AI;Adversarial Robustness;Knowledge Verification},
  doi={10.1109/ICNPCV69434.2026.11708929},
  ISSN={},
  month={July},}@INPROCEEDINGS{11746266,
  author={R, Laleet Krishna and V, Sowmya Narayanan and Udhayakumar, S.},
  booktitle={2026 2nd International Conference on Distributed Systems, Computer Networks and Cybersecurity (ICDSCNC)}, 
  title={Mcploit: a Model Context Protocol Enumeration and Exploitation Framework}, 
  year={2026},
  volume={},
  number={},
  pages={1-7},
  abstract={The Model Context Protocol (MCP), released by Anthropic in November 2024, has become the dominant integration layer connecting LLMs to external tools and data sources. Security tooling has not kept pace: existing scanners have no model of MCP primitives such as Tools, Resources, Prompts, or Sampling, leaving deployments effectively unassessed. MCPLOIT is an offensive security framework built specifically for MCP environments. It connects over STDIO, SSE, and HTTP transports and operates in five modes: interactive exploration, passive enumeration, vulnerability scanning, targeted exploitation, and autonomous assessment. Seven detection modules apply signature matching and a 15-factor heuristic scoring system across eight vulnerability classes: prompt injection, code execution, path traversal, secrets exposure, tool poisoning, token theft, typosquatting, and authentication bypass. The framework ships with 99 pre-built payloads across six categories and a CVE engine covering CVE-2025-67366, CVE-2026-0755, and CVE-2026-23744. Evaluated against the DVMCP benchmark and two live production MCP endpoints, MCPLOIT successfully enumerated complete tool and resource surfaces, confirmed network-level misconfigurations, and solved five of ten challenges through fully automated exploitation. All payloads are safe by default; active modes require explicit operator acknowledgement.},
  keywords={Tools;Servers;Modeling;Payloads;Security;Protocols;Large language models;Printing;Codes;Signal detection;Model Context Protocol;MCP;Vulnerability Assessment;Penetration Testing;LLM Security;Tool Poisoning;Prompt Injection},
  doi={10.1109/ICDSCNC70670.2026.11746266},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11446535,
  author={Guo, Qiming and Tang, Jinwen and Huang, Xingran},
  booktitle={2025 IEEE International Conference on Future Machine Learning and Data Science (FMLDS)}, 
  title={Attacking LLMs and AI Agents: Advertisement Embedding Attacks Against Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={674-679},
  abstract={We introduce Advertisement Embedding Attacks (AEA), a new class of LLM security threats that stealthily inject promotional or malicious content into model outputs and AI agents. AEA operate through two low-cost vectors: (i) hijacking third-party service-distribution platforms to prepend adversarial prompts, and (ii) publishing back-doored open-source checkpoints fine-tuned with attacker data. Unlike conventional attacks that degrade accuracy, AEA subvert information integrity, causing models to return covert ads, propaganda, or hate speech while appearing normal. We detail the attack pipeline, map five stakeholder victim groups, and present an initial prompt-based self-inspection defence that mitigates these injections without additional model retraining. Our findings reveal an urgent, under-addressed gap in LLM security and call for coordinated detection, auditing, and policy responses from the AI-safety community.},
  keywords={Publishing;Large language models;Pipelines;Hate speech;Machine learning;Vectors;Security;Stakeholders;Fake news;Information integrity;Large Language Models (LLMs);LLM Security;Prompt Injection;Backdoor;Advertisement Embedding Attack;AI Agents},
  doi={10.1109/FMLDS67896.2025.00111},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11463282,
  author={Liu, Yu and Chen, Ping},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={PromptPatch: Towards Precise and Stable Behavioral Patching in Large Language Models via Feedback-Driven Prompt Optimization}, 
  year={2026},
  volume={},
  number={},
  pages={14322-14326},
  abstract={The security and reliability of Large Language Model (LLM) applications are fundamentally dependent on the robustness of their system prompts. However, these prompts are often susceptible to adversarial attacks like prompt injection, leading to unpredictable and harmful model behavior. Existing defenses typically focus on runtime input filtering or model-level retraining, which can be costly and imprecise. In this work, we introduce PromptPatch, a novel framework that treats the system prompt as a software artifact and applies a feedback-driven optimization process to automatically discover and repair security vulnerabilities. Our methodology employs a "Critic-Repairer" architecture, where a Critic LLM performs a semantic security audit, and a Repairer LLM generates precise, surgical patches to harden the prompt. This offline, design-time approach aims to create intrinsically robust system prompts, enhancing behavioral stability at the source. We conduct a rigorous evaluation across five modern LLMs, demonstrating that PromptPatch dramatically reduces the average Attack Success Rate (ASR) from as high as 41.67% to as low as 0.00% on several models, while maintaining high functional integrity. Our analysis also reveals the varying efficacy of prompt hardening across different model architectures, highlighting the challenge of "one-size-fits-all" defenses and suggesting a need for model-aware repair strategies.},
  keywords={Feedback;Filtering;Circuits;Filters;Circuits and systems;Protocols;HTTP;Pins;Artificial intelligence;Large language models;Large Language Models;Prompt Injection;System Prompt Hardening;AI Safety},
  doi={10.1109/ICASSP55912.2026.11463282},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{11471500,
  author={Pawelek, Tom and Patel, Raj and Crowell, Charlotte and Golilarz, Noorbakhsh Amiri and Mittal, Sudip and Rahimi, Shahram and Perkins, Andy},
  booktitle={2025 International Conference on Machine Learning and Applications (ICMLA)}, 
  title={LLMZ+: Contextual Prompt Whitelist Principles for Agentic LLMs}, 
  year={2025},
  volume={},
  number={},
  pages={1396-1402},
  abstract={Compared to traditional models, agentic AI represents a highly valuable target for potential attackers as they possess privileged access to data sources and API tools, which are traditionally not incorporated into classical agents. Unlike a typical software application residing in a Demilitarized Zone (DMZ), agentic LLMs consciously rely on nondeterministic behavior of the AI (only defining a final goal, leaving the path selection to LLM). This characteristic introduces substantial security risk to both operational security and information security. Most common existing defense mechanism rely on detection of malicious intent and preventing it from reaching the LLM agent, thus protecting against jailbreak attacks such as prompt injection. In this paper, we present an alternative approach, LLMZ+, which moves beyond traditional detection-based approaches by implementing prompt whitelisting. Through this method, only contextually appropriate and safe messages are permitted to interact with the agentic LLM. By leveraging the specificity of context, LLMZ+ guarantees that all exchanges between external users and the LLM conform to predefined use cases and operational boundaries. Our approach streamlines the security framework, enhances its long-term resilience, and reduces the resources required for sustaining LLM information security. Our empirical evaluation demonstrates that LLMZ+ provides strong resilience against the most common jailbreak prompts. At the same time, legitimate business communications are not disrupted, and authorized traffic flows seamlessly between users and the agentic LLM. We measure the effectiveness of approach using false positive and false negative rates, both of which can be reduced to 0 in our experimental setting.},
  keywords={Payloads;Filtering;Filters;Feedback;Circuits;Central Processing Unit;Circuits and systems;Computer networks;Virtual private networks;Protocols;security;LLM;Prompt injection;Prompt jailbreak;Agentic AI;LLMZ+;Prompt whitelisting;Contextual whitelisting},
  doi={10.1109/ICMLA66185.2025.00213},
  ISSN={1946-0759},
  month={Dec},}@INPROCEEDINGS{11715075,
  author={Reswandana Musonip, Mochammad Latief and Girinoto and Hafidz Yuntanozra, M. Dja’Far Karzein and Zharfa, Agry},
  booktitle={2026 13th International Conference on ICT for Smart Society (ICISS)}, 
  title={Multi-Agent Architecture for Decision Support Systems in Agricultural Data Analysis}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Automated multi-step analysis over tabular crop-phase datasets demands systems that plan tasks, invoke tools, and reason adaptively—capabilities that static-workflow decision support systems cannot provide. This paper presents a multi-agent architecture for an AI-Powered Decision Support System (DSS) applied to paddy agricultural data analysis. The proposed system combines a web-based analytical dashboard with an orchestrator–router multi-agent architecture supporting structured task planning, dynamic tool invocation, and natural language interaction through five specialized sub-agents. A dual-layer Guardrails mechanism enforces input-stage prompt injection prevention and output-stage consistency. We evaluate the system using Task Completion Rate (TCR), Automation Rate (AR), Error Rate (ER), and System Usability Scale (SUS) across six functional modules comprising 65 TCR items, 30 AR items, and 30 ER items. The proposed system achieves TCR of 94.6%, AR of 86.7%, ER of 6.7%, and SUS of 88.9 (Excellent), showing higher performance than two directional baselines: a rule-based DSS (TCR: 62.0%, AR: 54.0%) and a tool-free LLM system (TCR: 74.0%, AR: 61.0%). These results confirm that orchestrated multi-agent specialization with integrated Guardrails improves both analytical task execution and automation coverage in agricultural decision support.},
  keywords={Printing;Argon;Tools;Artificial intelligence;Erbium;Modeling;Large language models;Modules (abstract algebra);Architecture;Computer architecture;agentic AI;decision support system;large language model;agricultural analysis;multi-agent system;Guardrails;orchestrator-worker;LangGraph},
  doi={10.1109/ICISS71466.2026.11715075},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11649278,
  author={Zhi, Xinyuan and Luo, Ting and Zhou, Xiaodong},
  booktitle={2026 IEEE 2nd International Conference on Electronics, Energy Systems and Power Engineering (EESPE)}, 
  title={A Gateway-Centric Architecture for Bidirectional Content Moderation in Large Language Models}, 
  year={2026},
  volume={},
  number={},
  pages={392-396},
  abstract={Large language model (LLM) applications deployed in regulated and high-risk environments face two coupled runtime risks: input-side prompt injection and output-side content compliance violations. Existing defenses are often either model-centric (alignment or fine-tuning) or application-local (keywords and regex), which limits auditability, policy agility, and cross-model portability. This paper proposes a gateway-centric framework that externalizes safety enforcement into a security side-chain. The framework integrates a unified LLM gateway with an external semantic guardrail service to perform bidirectional inspection before and after model invocation. We formalize the architecture with input-risk and output-compliance functions, define a comprehensive threat model and trust boundary, and present a reproducible evaluation protocol. To validate our approach, a prototype implementation based on LiteLLM and Prisma AIRS was evaluated on a rigorously balanced 2,000-sample adversarial dataset merged from diverse sources, including Deepset, wildjailbreak, and jailbreak-classification. Results demonstrate that the proposed architecture achieves an exceptional balance in detection capability, yielding an F1-score of 0.8322, a recall of 0.8531, and effectively maintaining a low False Positive Rate (FPR), thereby outperforming multiple state-of-the-art baselines including Llama Prompt Guard and Deepset DeBERTa. Furthermore, performance testing confirms practical deployability, showing an average added latency of only 320 ms under a 50-concurrent-user load. The paper concludes by discussing the side-chain advantages over model alignment mechanisms, guardrail bypass risks, and adaptive policy-evolution strategies for enterprise AI governance.},
  keywords={Modeling;Large language models;Security;Architecture;Computer architecture;Safety;Threat modeling;Artificial intelligence;Context;Printing;Large Language Models;LLM Gateway;Content Safety;Prompt Injection;Prisma AIRS;AI Governance},
  doi={10.1109/EESPE68405.2026.11649278},
  ISSN={},
  month={June},}@INPROCEEDINGS{11564888,
  author={Mathew, Alphin Kayalathu and Rajeev, Devi and Ravi, Akshara},
  booktitle={2026 International Conference on Innovations in Computational Intelligence (ICICI)}, 
  title={Privacy-Preserving Federated Transformer Framework for Detecting Adversarial Prompts in Healthcare Chatbots}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Prompt injection attacks is an important security problem in healthcare-specific large language model systems(LLMs). The injected prompt can be used to control the behavior of the model or to leak sensitive data. This vulnerability increases with centralized training pipelines that collect patient prompts on a single server, which leads to data leakage and model poisoning. In this work, we examine Federated Learning (FL) as a privacy-preserving and decentralized prompt injection detection defense for medical chatbots. Using the SPML Healthcare Chatbot Prompt Injection Dataset, we fine-tune a RoBERTa-base classifier in conditions of centralized, IID (Independent and Identically Distributed), federated and Non-IID (Non-Independent and Non-Identically Distributed) federated learning. The experimental results show that the federated model has comparable performance with centralized training, with accuracy of 0.957 and F1-score of 0.964 under IID conditions. The realistic case scenario of Non-IID client distribution was evaluated across 3 different client configurations, the model is able to maintain stable performance with an average performance accuracy of 0.956, precision of 0.942, recall of 0.987, F1-Score of 0.964 and AUC of 0.994. Moreover, the federated setup shows consistent convergence between the communication rounds despite the data heterogeneity. These results suggest that transformer-based federated learning provides an effective and privacy-preserving solution for detecting prompt injection attacks in distributed healthcare conversational AI systems. This work contributes to Sustainable Development Goal (SDG) 3: Good Health and Wellbeing, SDG 9: Industry, Innovation and Infrastructure, and SDG 16: Peace, Justice and Strong Institutions by enhancing the security and privacy of AI-driven healthcare technologies.},
  keywords={Modeling;Medical services;Federated learning;Privacy;Printing;Training;Signal detection;Accuracy;Servers;Security;Prompt Injection Attacks (PIA);Federated Learning (FL);Healthcare Chatbots;RoBERTa;Natural Language Processing (NLP);AI Security;Sustainable Development Goals (SDG 3;SDG 9;SDG 16)},
  doi={10.1109/ICICI68867.2026.11564888},
  ISSN={},
  month={April},}@INPROCEEDINGS{11452809,
  author={Patil, Kiran and Gupta, Poonam and Nagre, Harshal and Hadule, Harshad},
  booktitle={2025 1st International Conference on Advancement in Futuristic Technologies (ICAFT)}, 
  title={Layer Zero: The Safeguard against Malicious Prompts}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Large Language Models (LLMs) are widely adopted for their ability to perform complex language understanding and generation tasks.They can produce clear text, summarize detailed documents, answer questions, and reason across many contexts. However, LLMs are still sensitive to harmful inputs, which are carefully designed prompts that can evade safety measures and cause the model to produce harmful, biased, or misleading information. Examples include prompt injection, jailbreak attacks, security bypass and automated phishing attempts. If these threats aren’t handled well, they can put users at risk and reduce people’s trust in AI systems. To tackle this issue, we propose a protective wrapper that operates outside the LLM. This wrapper reviews user inputs before they reach the model, functioning as a safety filter. We employ two methods to identify risky prompts. The first one is a lightweight logistic regression model, which quickly detects simple malicious inputs with minimal computing power. The second method is a Bidirectional Encoder Representations from Transformers (BERT) classifier, which understands the meaning and context of more complex or hidden attacks. Depending upon the classification, the wrapper either allows the input to pass through to the LLM safely or blocks it while keeping the log of each action. This wrapper adds an extra layer of protection without altering how the LLM works. It keeps the system safe and dependable, so users can interact with it confidently. By catching harmful inputs early, the wrapper makes LLMs safer to use in everyday situations, striking the right balance between security and practicality.},
  keywords={Logistic regression;Reviews;Phishing;Computational modeling;Large language models;Bidirectional control;Transformers;Encoding;Security;Protection;prompt injection;jailbreak detection;phishing;logistic regression;BERT;wrapper;LLM security},
  doi={10.1109/ICAFT66710.2025.11452809},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11648021,
  author={Makhmetov, Altynbek and Dota, Yerkuat and Auyezov, Azamat and Abdigali, Arslan and Zhunussov, Kairat},
  booktitle={2026 International Conference on Cybersecurity, Digital Forensics, and AI Applications (ICCSDFAI)}, 
  title={Identity and Access Management for Agentic AI: A Zero-Trust Security Framework}, 
  year={2026},
  volume={},
  number={},
  pages={1228-1232},
  abstract={Agentic AI systems act autonomously across services, APIs, and data stores, creating identity and access management (IAM) challenges that traditional perimeter-based security frameworks do not address. Unlike human principals, AI agents spawn sub-agents dynamically, receive instructions from a language model vulnerable to prompt injection, and accumulate permissions through sequential tool calls. These properties invalidate the session-based, role-based access control model that existing IAM tools assume. This paper presents ZT-AgentIAM, a zero-trust security framework for managing AI agent identities and permissions at runtime. The framework defines four core components: dynamic token issuance with cryptographic scope binding, policy-based least-privilege enforcement via OPA Rego rules, behavioral attestation using an isolation forest anomaly detector, and continuous tamper-evident audit logging. We evaluate ZT-AgentIAM against five attack classes on a simulated AutoGen-based multi-agent orchestration environment. The framework achieves a mean attack detection rate of 93.4 percent across all threat categories with a full-pipeline latency overhead of 15.1 ms per request, confirming that zero-trust principles are operationally applicable to agentic AI deployments.},
  keywords={Modeling;Tools;Signal detection;Poles and zeros;Security;Zero Trust;Agentic AI;Printing;Large language models;Permission;agentic AI;zero-trust architecture;identity and access management;AI security;least privilege;behavioral attestation;prompt injection;access control;LLM security},
  doi={10.1109/ICCSDFAI70505.2026.11648021},
  ISSN={},
  month={June},}@ARTICLE{11695220,
  author={Deng, Xinhao and Zhang, Yixiang and Wu, Jiaqing and Bai, Jiaqi and Yi, Sibo and Zou, Zhuoheng and Xiao, Yue and Qiu, Rennai and Ma, Jianan and Chen, Jialuo and Du, Xiaohu and Yang, Xiaofang and Cui, Shiwen and Meng, Changhua and Wang, Weiqiang and Song, Jiaxing and Xu, Ke and Li, Qi},
  journal={IEEE Security & Privacy}, 
  title={Securing Autonomous Large Language Model Agents: Lessons From OpenClaw}, 
  year={2026},
  volume={},
  number={},
  pages={2-11},
  abstract={Autonomous LLM agents face lifecycle security risks arising from tools, memory, and long-term planning. Using OpenClaw, we examine five failure modes: skill poisoning, prompt injection, memory poisoning, intent drift, and staged command chain attacks. We also present five corresponding defenses covering initialization, input, inference, decision, and execution.},
  keywords={Security;Memory;Modeling;Planning;Educational institutions;Artificial intelligence;Tools;Context;Computers;Contacts},
  doi={10.1109/MSEC.2026.3727871},
  ISSN={1558-4046},
  month={},}@INPROCEEDINGS{11760887,
  author={Rahman, Mohammad Shahedur and Adnan, Md. Nasim and Bari, Mohammad Tahmid and Maharjan, Sujit and Parvez, Arshad},
  booktitle={2026 25th International Conference on Machine Learning and Applications (ICMLA)}, 
  title={AgentFuzz: Trace-Level Fuzzing for Prompt Spillover in LLM Multi-Agent Systems}, 
  year={2026},
  volume={},
  number={},
  pages={522-529},
  abstract={Modern large language models (LLMs) are increasingly deployed inside multi-agent systems (MAS), where specialized agents communicate through natural language to perform perception, memory retrieval, planning, verification, and execution. This collaboration improves capability but also creates a new attack surface: adversarial instructions injected into a low-trust upstream channel can silently propagate across agents and influence downstream high-privilege decisions. We call this phenomenon prompt spillover. Existing prompt fuzzers mainly target single-model jailbreaks and therefore fail to capture vulnerabilities that emerge from inter-agent communication. To address this gap, we present AgentFuzz, a framework for discovering prompt spillover attacks in LLM-based MAS. Given a target MAS, a low-trust injection channel, and a deterministic safety oracle, AgentFuzz searches for prompts that produce unsafe, executable, and verifier-approved action plans. The search uses MAS-native mutation operators selected online by a multi-armed bandit, while a trace-level composite reward, computed over the full inter-agent communication trace rather than only the final output, provides dense feedback on propagation, verifier bypass, and executable validity. We evaluate AgentFuzz across three LLM backbones, three MAS topologies, and five injection channels. On a five-agent linear MAS with no defense, AgentFuzz’s optimized attacks reach 35.2% ASR, outperforming PromptFuzz (26.8%) and LLM-Fuzzer (23.1%) on the same configuration. Similar improvements are observed in verifier bypass, executable validity, and spillover rate. Our results show that prompt spillover is a structural communication-layer vulnerability in MAS and motivate trace-aware defenses for secure MAS deployment.},
  keywords={Large language models;Modeling;Planning;Automatic speech recognition;Printing;Safety;Topology;Cognition;Cognitive systems;Equations;Large language models;multi-agent AI systems;prompt injection;security testing;fuzzing;AI security},
  doi={10.1109/ICMLA69890.2026.00079},
  ISSN={1946-0759},
  month={Oct},}@INPROCEEDINGS{11691650,
  author={Debenedetti, Edoardo and Shumailov, Ilia and Fan, Tianqi and Hayes, Jamie and Carlini, Nicholas and Fabian, Daniel and Kern, Christoph and Shi, Chongyang and Terzis, Andreas and Tramèr, Florian},
  booktitle={2026 IEEE Conference on Secure and Trustworthy Machine Learning (SaTML)}, 
  title={Defeating Prompt Injections by Design}, 
  year={2026},
  volume={},
  number={},
  pages={587-618},
  abstract={Large Language Models (LLMs) are increasingly deployed in agentic systems that interact with untrusted environments. However, LLM agents are vulnerable to prompt injection attacks when handling untrusted data. In this paper, we propose CaMeL, a robust defense that creates a protective system layer around the LLM, securing it even when underlying models are susceptible to attacks. To operate, CaMeL explicitly extracts the control and data flows from the (trusted) user query; therefore, untrusted data retrieved by the LLM can never affect the program flow. Moreover, to prevent the exfiltration of private data over unauthorized data flows, CaMeL enforces security policies over assigned flow tags for each tool call. We demonstrate the effectiveness of CaMeL by solving 77% of tasks in AgentDojo with security guarantees (compared to 84% with an undefended system). We release the code for CaMeL at https://github.com/google-research/camel-prompt-injection.},
  keywords={Electronic mail;Fluid flow;Large language models;Modeling;Security;Tools;Printing;Codes;Conferences;Tagging;prompt injection;defense},
  doi={10.1109/SaTML68715.2026.00040},
  ISSN={},
  month={March},}@INPROCEEDINGS{10679411,
  author={Johnson, Saul and Hassing, Remco and Pijpker, Jeroen and Loves, Rob},
  booktitle={2024 IEEE International Conference on Cyber Security and Resilience (CSR)}, 
  title={A Modular Generative Honeypot Shell}, 
  year={2024},
  volume={},
  number={},
  pages={387-394},
  abstract={In this work, we present Limbosh, a generative honeypot shell written in Python that places attackers in a conversation with a large language model (LLM) configured to behave like a real shell. The use of generative AI in place of traditional honeypot shell software admits the development of arbitrary honeypot configurations by adjusting the prompt used to seed the LLM context. Key features of Limbosh include: a flexible prompt generation system based on text templating and reusable prompt fragments; the ability to make use of arbi-trary LLMs; sophisticated prompt injection mitigation measures; and a highly modular and configurable architecture permitting straightforward expansion of its feature set and enhancement of its capabilities. To demonstrate its utility and practicality, we ran a single-blind, within-subjects study of the interaction of four cybersecurity professionals with Limbosh compared to a control shell. We find that Limbosh is capable of convincingly emulating real shell software, even when faced with professional users. We present our experimental results, and make the Limbosh software itself open-source and freely available.},
  keywords={Prevention and mitigation;Large language models;Computer architecture;Oral communication;Software;Software measurement;Prompt engineering;honeypot;shell;generative artificial intelligence;large language models},
  doi={10.1109/CSR61664.2024.10679411},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11546222,
  author={Mahmud, Emran and Murshid, Md Mahmud and Barua, Arpita and Nowsher Nisa, Nusrat Tabassum Binte and Arnob, Soumit Das and Turja, Mashrafi Tasnim},
  booktitle={2026 IEEE 2nd International Conference on Quantum Photonics, Artificial Intelligence & Networking (QPAIN)}, 
  title={Identifying Malicious and Benign Prompts in AI Agent Evasion Attacks Using Machine Learning}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={AI-driven agents are increasingly deployed for automation, customer service, cybersecurity operations, and decision support systems. However, these agents have become targets of prompt-based evasion attacks where adversaries craft malicious instructions to manipulate model behavior, extract sensitive information, or execute unauthorized commands. In this study, we present a machine learning-based framework for classifying malicious and benign prompts using both traditional NLP methods and deep contextual embeddings. A custom dataset of 1000 labeled prompts representing various attack types (social engineering, obfuscation, protocol abuse, multiturn manipulation, and normal queries) was used. We evaluated multiple models, including TF-IDF + XGBoost, BERT-based embeddings with Random Forest, Gaussian Naive Bayes, Decision Tree, and a deep Very Deep CNN (VDCNN) architecture. Experimental results show that Random Forest (BERT) and VDCNN (BERT) achieved the highest accuracy of 0.9793, outperforming other techniques. These findings highlight the importance of contextual embeddings in capturing linguistic patterns in adversarial instructions. The proposed approach can be integrated into real-world AI agent firewalls, autonomy systems, and LLM security monitors to detect prompt-based attacks effectively. Although the experiments are carried out on a curated dataset of 1,000 prompts, the study aims at assessing the efficacy of contextual embeddings and model robustness rather than generalization on a large scale. To ensure robustness and mitigate overfitting concerns, stratified train-test splitting, multi-metric evaluation, and K-fold crossvalidation were employed, confirming stable and consistent model performance across data partitions. The findings indicate that the proposed framework generalizes well within the evaluated scope and can serve as a practical defensive layer for AI agent security.},
  keywords={Modeling;Artificial intelligence;Bit error rate;Machine learning;Security;Printing;Machining;Training;Random forests;Signal detection;AI Agent Security;Prompt Injection;Machine Learning;BERT Embeddings;VDCNN;Cybersecurity;Evasion Attacks},
  doi={10.1109/QPAIN69676.2026.11546222},
  ISSN={},
  month={April},}@INPROCEEDINGS{11354603,
  author={Chen, Zheng and Yao, Buhui},
  booktitle={2025 IEEE 24th International Conference on Trust, Security and Privacy in Computing and Communications (TrustCom)}, 
  title={Goal Hijacking Attack on Large Language Models via Pseudo-Conversation Injection}, 
  year={2025},
  volume={},
  number={},
  pages={2552-2557},
  abstract={Goal hijacking constitutes a critical security vulnerability in Large Language Models (LLMs), enabling adversaries to manipulate models into generating specific outputs regardless of original user inputs. Existing approaches often rely on explicit instructions, limiting effectiveness and stealth. To overcome these constraints, we introduce a novel adversarial attack technique named Pseudo-Conversation Injection (PC-Inj), exploiting vulnerabilities in conversational context handling and role identification within LLMs. PC-Inj appends fabricated conversational contexts to original user prompts, misleading models into interpreting these as completed interactions and executing subsequent malicious instructions. Experimental evaluations using mainstream platforms—including ChatGPT (GPT4o, GPT4o-mini) and TongYiQianWen (Qwen2.5)—confirm our methods significantly surpass baseline techniques. We further propose targeted defense mechanisms, highlighting an urgent need to strengthen LLM security in practical deployments.},
  keywords={Privacy;Limiting;Large language models;Computer architecture;Chatbots;Security;Context modeling;Goal Hijacking;Prompt Injection;Large Language Model},
  doi={10.1109/Trustcom66490.2025.00300},
  ISSN={2324-9013},
  month={Nov},}@INPROCEEDINGS{11395808,
  author={Gudipati, Satya Karteek and Mishra, Naveen Anand and Mohammed, Akbar and Akkisetti, Sambasiva Rao and Ankam, Gopikanth and Ponugoti, Sateeshkumar},
  booktitle={2026 IEEE 5th International Conference on AI in Cybersecurity (ICAIC)}, 
  title={Confidential and Attack-Resilient Edge LLM Serving for Multilingual Chatbots}, 
  year={2026},
  volume={},
  number={},
  pages={1-9},
  abstract={Large Language Model (LLM) chatbots increasingly run at the network edge to reduce latency and cost, but edge deployments expand the attack surface and amplify privacy risk. We present Aegis-Edge, a confidential and attack-resilient serving stack for multilingual LLM inference on untrusted edge nodes. Aegis-Edge combines (i) remote attestation to verify the serving runtime before model and key release, (ii) confidential inference using trusted execution environments with a sealed key–value cache and tenant-scoped encryption, (iii) policy-as-code guardrails for locale-aware PII redaction and tool-use restrictions, and (iv) a lightweight adversarial input filter targeting multilingual prompt-injection and cache-poisoning attempts. We formalize security invariants over the request–response path and show how they compose across edge, gateway, and KMS. Our implementation supports common edge accelerators and multilingual tokenizers. We empirically evaluate security (attack success rate, leakage proxies, integrity violations), privacy (PII detection/retention bounds), and systems overhead (added latency, throughput, energy) under red-team workloads spanning diverse languages and scripts. Results demonstrate that robust privacy and integrity guarantees can be enforced at the edge while maintaining application-level service objectives. We discuss limitations (e.g., side-channels) and pathways for incremental deployment.},
  keywords={Privacy;Runtime;Image edge detection;Large language models;Logic gates;Chatbots;Throughput;Multilingual;Encryption;Edge computing;security and privacy;confidential inference;remote attestation;edge computing;multilingual NLP;policy enforcement},
  doi={10.1109/ICAIC67076.2026.11395808},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11334709,
  author={Gomez-Rangel, Julia and Lee, Young and Liu, Bozhen},
  booktitle={2025 2nd IEEE/ACM International Conference on AI-powered Software (AIware)}, 
  title={Security in the Wild: An Empirical Analysis of LLM-Powered Applications and Local Inference Frameworks}, 
  year={2025},
  volume={},
  number={},
  pages={149-159},
  abstract={The rapid rise of open-source applications and frameworks powered by large language models (LLMs) has introduced new and complex security risks. While recent studies have explored prompt injection, model misuse, and runtime vulnerabilities in isolated cases, the system-wide security risks of this ecosystem remain underexamined. In this paper, we present an empirical study of security advisories reported through GitHub for popular LLM-Powered Applications (LPAs) and their underlying Local Inference Frameworks (LIFs, such as llama.cpp and vLLM), aiming to surface system-wide security risks across the LLM software stack. We curate and analyze a dataset of $\mathbf{5 0}$ real-world vulnerabilities, classifying them by type, severity, and root cause. Our analysis reveals different risk profiles: LPAs tend to suffer from input-driven web vulnerabilities, while LIFs exhibit memory safety and dependency-related issues. We also identify common and unique characteristics of security vulnerabilities in LPAs and LIFs when compared to traditional open-source projects. Our findings highlight the urgent need for systematic security practices, better disclosure mechanisms, and lifecycleaware defenses across the rapidly evolving LLM software stack.},
  keywords={Systematics;Runtime;Ecosystems;Pipelines;Full stack;Safety;Maintenance;Security;Open source software;Software development management;LLM-Powered Application;Local Inference Framework;GitHub Security Advisory;Open-Source Software Development},
  doi={10.1109/AIware69974.2025.00024},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11521941,
  author={Raj, Saravanan},
  booktitle={2026 International Conference on Multidisciplinary Innovations For Smart & Sustainable Future (MISSF)}, 
  title={A Secure Retrieval-Augmented LLM Framework for Cloud-Based Incident Response}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={The response to a cloud incident is characterized by the need to make fast decisions and maintain evidentiary integrity, tenant isolation, and adherence to policies. In this paper, the authors introduce SRAG-IR, a secure retrievalaugmented LLM framework governing an incident response on the cloud that interconnects a controlled evidence lake and an attested retrieval and action layer. SRAG-IR builds a timeindexed part of incident memory over logs, alerts, tickets, and certified threat intelligence and determines only those fragments that are policy authorized through attribute-based access control and tenant-bound vector indices. A context firewall removes untrusted instructions in text accessed and enforces schema constrained prompts to minimize prompt injection and data exfiltration. Chunks of evidence are hash-chained and signed and produce verifiable cites and auditable respondent provenance. To have containment and recovery, sandboxed tool broker runs approved cloud actions as per playbook templates, producing change plans and rollback hints. The design enhances trust, privacy, and operational safety and does not need model retraining with multi-tenant production clouds. Dual retrieval integrates semantic search and asset-dependency graphs allowing root-cause hypothesis and prioritized triage suggestions should there be strict latency and cost budget limits.},
  keywords={Modeling;Clouds;Equations;Security;Large language models;Cognition;Cognitive systems;Printing;Machine learning;Signal detection;Retrieval-Augmented Generation;Large Language Models;Cloud Incident Response;Secure AI;Evidence Governance;Zero-Trust Retrieval},
  doi={10.1109/MISSF68264.2026.11521941},
  ISSN={},
  month={April},}
