@article{TAHERDOOST20262212,
title = {Adversarial Machine Learning Framed by Threat Models, Attack Vectors and Defense Strategies},
journal = {Procedia Computer Science},
volume = {283},
pages = {2212-2219},
year = {2026},
note = {International Conference on Machine Learning and Data Engineering},
issn = {1877-0509},
doi = {https://doi.org/10.1016/j.procs.2026.06.293},
url = {https://www.sciencedirect.com/science/article/pii/S1877050926019253},
author = {Hamed Taherdoost and Khadija Slimani},
keywords = {Adversarial Machine Learning, Threat Models, Attack Vectors, Defense Strategies, Model Robustness, Training-Time Attacks, Inference-Time Attacks, Machine Learning Security, Input Manipulation, Poisoning Attacks},
abstract = {Machine learning (ML) systems are increasingly integrated into critical real-world applications, from healthcare diagnostics to financial decision-making and network security. However, the growing reliance on ML has exposed inherent vulnerabilities to adversarial attacks—carefully crafted inputs that intentionally deceive models, leading to incorrect predictions and potentially harmful outcomes. These attacks threaten the reliability, integrity, and safety of ML systems, particularly in safety-critical and security-sensitive domains. Understanding adversarial threats and designing robust defenses requires a systematic classification of attack strategies, attacker capabilities, and defensive measures. This study presents a comprehensive taxonomy of adversarial ML threats, categorized by attacker knowledge (white-box, black-box, no-box), attack timing (training-time or inference-time), and adversarial intent (sabotage, espionage, competitive gain, or research purposes). It reviews key adversarial techniques, including evasion, poisoning, and model extraction attacks, and examines state-of-the-art defense mechanisms, organized into input-level, model-level, and detection-based strategies. By providing a structured framework that links threat models to applicable defenses, this work offers researchers and practitioners a practical guide to assess vulnerabilities, prioritize mitigation strategies, and enhance model robustness against evolving adversarial methods. This study contributes to the development of resilient ML systems that maintain both performance and security in complex, adversarial environments.}
}
@article{CHAARIFOURATI2026103890,
title = {Foundations, vulnerabilities, and GenAI-driven defenses in Cognitive Internet of Medical Things systems},
journal = {Journal of Systems Architecture},
volume = {178},
pages = {103890},
year = {2026},
issn = {1383-7621},
doi = {https://doi.org/10.1016/j.sysarc.2026.103890},
url = {https://www.sciencedirect.com/science/article/pii/S1383762126002080},
author = {Lamia {Chaari Fourati}},
keywords = {Internet of Medical Things, Generative Artificial Intelligence, Vulnerability assessment, Security threats, Attack taxonomy, Risk mitigation, Healthcare cybersecurity},
abstract = {The Cognitive Internet of Medical Things (CIoMT) is reshaping healthcare by enabling continuous monitoring, personalized disease management, and intelligent clinical decision support. CIoMT systems improve diagnostic accuracy, reduce operational costs, and enhance the quality of experience for patients, and healthcare providers. Heterogeneous devices and vendors, multi-layer architectures make CIoMT systems vulnerable to security and privacy breaches. In parallel, the rapid emergence of Generative AI (GenAI), introduces a new duality for CIoMT security: GenAI can both amplify existing threats (e.g., automated exploit generation, sophisticated phishing...) and empower powerful new defense mechanisms (e.g., LLM-assisted vulnerability assessment, log analysis, GenAI-based Security-Operation-Centers, and adaptive policy generation). In this paper, we examine foundations, vulnerabilities, and GenAI-driven defenses in CIoMT systems. We first formalize the CIoMT architectural and data-flow foundations and derive a multi-layer taxonomy of threats and vulnerabilities spanning devices, communication, data, models, and clinical applications. We then analyze how GenAI can be used both to discover and to mitigate vulnerabilities, highlighting concrete defensive use cases as well as GenAI-specific risks. Building on this analysis, we propose a unified security framework for CIoMT in the GenAI era and we identify open research challenges and future directions fostering trustworthy, resilient, and privacy-preserving intelligent healthcare ecosystems.}
}
@article{HSU2026101155,
title = {A generative AI driven interactive narrative serious game for stress relief and its randomized controlled pilot study},
journal = {Entertainment Computing},
volume = {58},
pages = {101155},
year = {2026},
issn = {1875-9521},
doi = {https://doi.org/10.1016/j.entcom.2026.101155},
url = {https://www.sciencedirect.com/science/article/pii/S1875952126000777},
author = {Ting-Chen Hsu},
keywords = {Generative AI, Serious games, Stress relief, Digital mental health, Pilot study},
abstract = {Background
Stress has become a widespread phenomenon, and serious games are increasingly recognized as engaging tools for stress relief. However, despite the rapid advancement of Generative Artificial Intelligence (Gen-AI), its integration into stress-relief serious games remains insufficiently explored.
Objective
This study aimed to address this gap by developing “Reverie”, an Gen-AI driven serious game powered by the Unity engine and ChatGPT, and to preliminarily evaluate its effectiveness in stress reduction, user experience, and cognitive emotion regulation.
Methods
A 14-day pilot study was conducted with 20 students experiencing moderate to high levels of stress. Participants used “Reverie” as a stress-relief intervention. Stress levels, user experience, and cognitive emotion regulation strategies were assessed to examine the game’s feasibility and preliminary efficacy.
Results
The results showed that “Reverie” significantly reduced participants’ stress levels over the intervention period (p=.016*), indicating a cumulative positive effect. In addition, the game demonstrated excellent user experience and was associated with improvements in cognitive emotion regulation strategies.
Conclusions
This study proposes a Gen-AI driven design framework for serious games for stress relief. Besides, this pilot study provides initial support for the feasibility and promise of combining LLM-driven gameplay in a personalized digital intervention context.}
}
@article{HUANG2025100948,
title = {Foundation models and intelligent decision-making: Progress, challenges, and perspectives},
journal = {The Innovation},
volume = {6},
number = {6},
pages = {100948},
year = {2025},
issn = {2666-6758},
doi = {https://doi.org/10.1016/j.xinn.2025.100948},
url = {https://www.sciencedirect.com/science/article/pii/S2666675825001511},
author = {Jincai Huang and Yongjun Xu and Qi Wang and Qi (Cheems) Wang and Xingxing Liang and Fei Wang and Zhao Zhang and Wei Wei and Boxuan Zhang and Libo Huang and Jingru Chang and Liantao Ma and Ting Ma and Yuxuan Liang and Jie Zhang and Jian Guo and Xuhui Jiang and Xinxin Fan and Zhulin An and Tingting Li and Xuefei Li and Zezhi Shao and Tangwen Qian and Tao Sun and Boyu Diao and Chuanguang Yang and Chenqing Yu and Yiqing Wu and Mengxian Li and Haifeng Zhang and Yongcheng Zeng and Zhicheng Zhang and Zhengqiu Zhu and Yiqin Lv and Aming Li and Xu Chen and Bo An and Wei Xiao and Chenguang Bai and Yuxing Mao and Zhigang Yin and Sheng Gui and Wentao Su and Yinghao Zhu and Junyi Gao and Xinyu He and Yizhou Li and Guangyin Jin and Xiang Ao and Xuehao Zhai and Haoran Tan and Lijun Yun and Hongquan Shi and Jun Li and Changjun Fan and Kuihua Huang and Ewen Harrison and Victor C.M. Leung and Sihang Qiu and Yanjie Dong and Xiaolong Zheng and Gang Wang and Yu Zheng and Yuanzhuo Wang and Jiafeng Guo and Lizhe Wang and Xueqi Cheng and Yaonan Wang and Shanlin Yang and Mengyin Fu and Aiguo Fei},
keywords = {artificial intelligence, intelligent decision-making, foundation models, agent, large language model},
abstract = {Intelligent decision-making (IDM) is a cornerstone of artificial intelligence (AI) designed to automate or augment decision processes. Modern IDM paradigms integrate advanced frameworks to enable intelligent agents to make effective and adaptive choices and decompose complex tasks into manageable steps, such as AI agents and high-level reinforcement learning. Recent advances in multimodal foundation-based approaches unify diverse input modalities—such as vision, language, and sensory data—into a cohesive decision-making process. Foundation models (FMs) have become pivotal in science and industry, transforming decision-making and research capabilities. Their large-scale, multimodal data-processing abilities foster adaptability and interdisciplinary breakthroughs across fields such as healthcare, life sciences, and education. This survey examines IDM’s evolution, advanced paradigms with FMs and their transformative impact on decision-making across diverse scientific and industrial domains, highlighting the challenges and opportunities in building efficient, adaptive, and ethical decision systems.}
}
@incollection{SAYA2026551,
title = {Chapter 35 - Minimizing vulnerability of artificial intelligence (AI) programs from cyberattacks},
editor = {Debasis Bagchi and Samudra Prosad Banik and Anand Swaroop and Sunny {Edet Ohia}},
booktitle = {Applications of Artificial Intelligence in Healthcare},
publisher = {Academic Press},
pages = {551-571},
year = {2026},
isbn = {978-0-443-43934-6},
doi = {https://doi.org/10.1016/B978-0-443-43934-6.00025-0},
url = {https://www.sciencedirect.com/science/article/pii/B9780443439346000250},
author = {Laishram Saya and Deepanshu Vasuja and Gauri Jha and Atreyee Bagchi and Shivam Saini and  Pooja and Sunita Hooda},
keywords = {AI security, Adversarial machine learning, Data poisoning attacks, AI lifecycle security, Cybercrime-as-a-service},
abstract = {As artificial intelligence (AI) systems continue to transform critical sectors such as healthcare, finance, autonomous transportation, and national security, their increasing autonomy and complexity have introduced novel cybersecurity vulnerabilities. This paper offers a comprehensive analysis of the evolving threat landscape surrounding AI programs, tracing risk vectors across the full AI lifecycle, from data ingestion and model training to inference and deployment. We explore how foundational features of AI systems, such as large-scale data dependency, black-box model architectures, and automated decision pipelines, inadvertently expand the attack surface. The study categorizes threats into two primary domains: data-centric attacks, including data poisoning and adversarial examples, and model-centric threats, such as backdoor insertion, model inversion, and intellectual property theft via model extraction. Through real-world case studies, including Microsoft’s Tay chatbot, adversarial misclassification of traffic signs, and model leakage from large language models, we illustrate the tangible consequences of unmitigated vulnerabilities. In response, we propose a layered defense strategy grounded in the detect–prevent–predict (DPP) model. This framework advocates for real-time anomaly detection, proactive architectural hardening (e.g., adversarial training, differential privacy, certified robustness), and forward-looking risk prediction through behavioral analytics and monitoring for concept drift. We further discuss the implications of traditional cybersecurity risks, such as phishing, misconfiguration, and Application Programming Interface (API) abuse, as they evolve within AI-specific contexts. Finally, the paper emphasizes that achieving trustworthy AI cannot rely on technical defenses alone. Ethical foresight, regulatory compliance, and interdisciplinary collaboration are essential to developing AI systems that are not only performant, but also resilient, interpretable, and secure. As AI becomes increasingly integrated into sociotechnical ecosystems, this research underscores the urgency of embedding cybersecurity at every stage of the AI design and deployment process.}
}
@article{ZHANG2026276,
title = {From AI-generated content to agentic action: Security and safety threats in generative AI},
journal = {Journal of Information and Intelligence},
volume = {4},
number = {4},
pages = {276-297},
year = {2026},
issn = {2949-7159},
doi = {https://doi.org/10.1016/j.jiixd.2026.05.002},
url = {https://www.sciencedirect.com/science/article/pii/S2949715926000405},
author = {Zelin Zhang and Qi Li and Jie Cao and Lingshuang Liu and Jianbing Ni},
keywords = {AI safety, AI security, AI alignment, AI governance, Agentic AI},
abstract = {Generative AI systems are increasingly used not only to produce content but also to retrieve data, invoke tools, and execute actions. This work examines the security and safety implications of that shift across content-level, model-level, and agentic threats. We analyze how attacker access requirements, system autonomy, and the scope of potential harm change as models move from generating artifacts to executing operations through tool chains and external APIs. We then assess technical countermeasures including detection, watermarking, alignment, and emerging agentic safeguards, and show that several depend on forms of institutional coordination that current governance arrangements do not yet provide. Across the cases examined, capability deployment and attack-surface expansion repeatedly outpace defensive responses as systems move from generating content to executing real-world actions.}
}
@article{ZHUANG2026104695,
title = {An Agentic AI-Empowered product family configuration approach for personalizing rehabilitation assistive devices with Multi-Faceted wearing experience},
journal = {Advanced Engineering Informatics},
volume = {74},
pages = {104695},
year = {2026},
issn = {1474-0346},
doi = {https://doi.org/10.1016/j.aei.2026.104695},
url = {https://www.sciencedirect.com/science/article/pii/S1474034626003873},
author = {Weibin Zhuang and Xingchen Lv and Xing Wu and Congmao Chen and Wenjie Xiao and Ji Wang and Cong Jiang and Jie Yao and Jinsong Bao and Xinyu Li},
keywords = {Rehabilitation assistive devices, Multi-faceted wearing experience, Product family configuration, Personalized product design, Large language model, Agentic AI},
abstract = {The growing burden of population aging and chronic diseases has driven increasing demand for personalized rehabilitation assistive devices, for which product-family–based configuration has become a prevalent approach. However, existing methods often overlook cross-faceted inconsistencies when fusing verbal reports, facial expressions, and sEMG signals, leading to unreliable requirement representations; meanwhile, multi-requirement conflicts under strongly coupled constraints are difficult to resolve, resulting in configuration solutions that deviate from users’ true requirements. To address these challenges, this study proposes an Agentic AI–driven product-family configuration approach based on multi-faceted wearing experiences for personalizing rehabilitation assistive devices. First, a wearing-experience representation model integrating language, sEMG, and facial expressions is constructed, with sEMG serving as an anchor to calibrate linguistic and facial descriptions, yielding complete and reliable wearing-requirement representations. Second, a configuration knowledge graph is built on the FBS—ENV—product-family framework; subsequently, an agent reasoning chain based on path exploration and neighborhood completion is designed to produce traceable configuration evidence. Third, a collaborative configuration framework integrating TRIZ principles with product-family constraints is proposed, which decomposes the customization process into five stages and employs multi-agent interactions to identify and resolve structure–performance conflicts induced by multiple requirements, generating executable configurations under multiple constraints. Finally, a knee rehabilitation brace case study is conducted, with comparisons against MetaGPT, AutoAgents, and AutoTRIZ. Ablation and comparative results demonstrate that the proposed approach derives more complete and reliable wearing-requirements from multi-faceted wearing experiences and generates feasible configuration solutions under multi-requirement constraints.}
}
@article{TIAN2025100810,
title = {From past to present: A survey of malicious URL detection techniques, datasets and code repositories},
journal = {Computer Science Review},
volume = {58},
pages = {100810},
year = {2025},
issn = {1574-0137},
doi = {https://doi.org/10.1016/j.cosrev.2025.100810},
url = {https://www.sciencedirect.com/science/article/pii/S1574013725000863},
author = {Ye Tian and Yanqiu Yu and Jianguo Sun and Yanbin Wang},
keywords = {Malicious URL detection, Algorithm benchmarking, URL datasets, Detection taxonomy, Open-source tools},
abstract = {Malicious URLs persistently threaten the cybersecurity ecosystem, by either deceiving users into divulging private data or distributing harmful payloads to infiltrate host systems. The detection of malicious URLs is a protracted arms race between defenders and attackers. Gaining timely insights into the current state of this ongoing battle holds significant importance. However, existing reviews suffer from four critical limitations: 1) Their reliance on algorithm-centric taxonomies obscures understanding of how detection approaches exploit specific modal information channels; 2) They fail to incorporate pivotal LLM/Transformer-based defenses; 3) No open-source implementations are collected to facilitate benchmarking; 4) Insufficient dataset coverage. This paper presents a comprehensive review of malicious URL detection technologies, systematically analyzing methods from traditional blacklisting to advanced deep learning approaches (e.g., Transformer, GNNs, and LLMs). Unlike prior surveys, we propose a novel modality-based taxonomy that categorizes existing works according to their primary data modalities (e.g., lexical URL features, HTML structure, JavaScript behavior, visual layout).For instance, we group models that parse DOM trees and extract HTML tag paths into the HTML modality, while those using rendered webpage screenshots are classified under the visual modality. This taxonomy reveals how distinct input channels inform model design, offering new perspectives that are obscured in algorithm-based classifications. This hierarchical classification enables both rigorous technical analysis and clear understanding of multimodal information utilization. Furthermore, to establish a profile of accessible datasets and address the lack of standardized benchmarking (where current studies often lack proper baseline comparisons), we curate and analyze two key resources: 1) publicly available datasets (2016–2024), and 2) open-source implementations from published works (2013–2025). To facilitate cross-method comparison and support future benchmarking efforts, we compile a comparative table summarizing key performance metrics (e.g., Accuracy, F1 Score, AUC) as reported in the original works or open-source repositories. While no formal evaluation protocol is proposed, this effort provides a practical reference point and highlights the need for more standardized benchmarking practices in malicious URL detection research. The review concludes by examining emerging challenges and proposing actionable directions for future research. We maintain a GitHub repository for ongoing curation of datasets and open-source implementations: https://github.com/sevenolu7/Malicious-URL-Detection-Open-Source/tree/master.}
}
@article{CASTILLOVILLAR2026112244,
title = {Cybersecurity for smart and resilient manufacturing and supply chains: A systematic review of the evolving knowledge base},
journal = {Computers & Industrial Engineering},
volume = {220},
pages = {112244},
year = {2026},
issn = {0360-8352},
doi = {https://doi.org/10.1016/j.cie.2026.112244},
url = {https://www.sciencedirect.com/science/article/pii/S0360835226004456},
author = {Krystel K. Castillo-Villar and Huijuan Dai and Gonzalo {Martinez Medina} and Hamed Mehrzadi},
keywords = {Cybersecurity, Manufacturing, Operational technology (OT), Industrial control systems (ICS), Cyber risk management, Supply chain security},
abstract = {Securing smart manufacturing increasingly requires a resilience-oriented cybersecurity perspective that extends beyond the factory floor to include digitally connected assets, operational dependencies, and supply-chain interfaces. In this paper, smart manufacturing refers to the digitally enabled production environment, resilience refers to the ability of that environment to anticipate, withstand, recover from, and adapt to cyber–physical disruption, and supply chains are treated as an extension of the same risk surface through which trust, traceability, software, components, and operational dependencies propagate. This paper synthesizes peer-reviewed literature and authoritative guidance to characterize threats, defenses, and operational gaps at the system level of manufacturing systems. Using a PRISMA-style protocol, we map evidence across hardware/firmware, software/data pipelines, and AI security; evaluate detection and response mechanisms (digital twins, anomaly/intrusion recognition, zero-trust patterns); and relate these to standards and sector profiles relevant to OT/IT interoperability. Building on the synthesis, we propose a six-pillar framework for cyber–physical resilience: (1) cyber–physical risk engineering design for secure manufacturing; (2) federated testbeds for verifiable trust and secure interoperability; (3) adaptive cyber–physical threat response; (4) risk-informed decision-making and cyber-risk communication; (5) adoption pathways and operational implementation; and (6) embedded cybersecurity culture and engineering literacy. The framework aligns technology, governance, and workforce levers to reduce downtime risk, improve recoverability, and support scalable deployment across heterogeneous assets and supply networks. We conclude with a research agenda that prioritizes traceability and verification, testbed-driven validation, quantification of cyber risk and value-at-risk, lifecycle management standards, and field evaluations, providing actionable steps to advance resilient, efficient, and sustainable manufacturing systems, anchored in verifiable evidence and practical validation.}
}
@article{WIECHA2024101129,
title = {Deep learning for nano-photonic materials – The solution to everything!?},
journal = {Current Opinion in Solid State and Materials Science},
volume = {28},
pages = {101129},
year = {2024},
issn = {1359-0286},
doi = {https://doi.org/10.1016/j.cossms.2023.101129},
url = {https://www.sciencedirect.com/science/article/pii/S1359028623000748},
author = {Peter R. Wiecha},
abstract = {Deep learning is currently being hyped as an almost magical tool for solving all kinds of difficult problems that computers have not been able to solve in the past. Particularly in the fields of computer vision and natural language processing, spectacular results have been achieved. The hype has now infiltrated several scientific communities. In (nano-) photonics, researchers are trying to apply deep learning to all kinds of forward and inverse problems. A particularly challenging problem is for instance the rational design of nanophotonic materials and devices. In this opinion article, I will first discuss the public expectations of deep learning and give an overview of the quite different scales at which actors from industry and research are operating their deep learning models. I then examine the weaknesses and dangers associated with deep learning. Finally, I’ll discuss the key strengths that make this new set of statistical methods so attractive, and review a personal selection of opportunities that shouldn’t be missed in the current developments.}
}
