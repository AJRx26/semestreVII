abstract = {
Purpose This study, a commentary, aims to review and discuss the implications of applying generative AI (GenAI) technology to auditing.

Design/methodology/approach The authors review the most recent surveys, reports, news articles and academic research on the applications of GenAI technology in auditing practices.

Findings The authors present the emerging opportunities and practical use cases of incorporating GenAI into audit practices while also discuss the associated challenges and risks. The authors synthesize insights from recent surveys, media reports and early accounting literature on the topic. Finally, they highlight critical avenues for further research to deepen the understanding of the implications, challenges and opportunities that GenAI presents within the auditing field.

Originality/value Based on the review and discussion, this commentary identifies 15 underexplored or unanswered research topics and calls for further research in these important areas.}
}
@article{GAO2026112335,
title = {Differential privacy for data sharing: evolution and full-lifecycle applications in generative AI},
journal = {Computer Networks},
volume = {284},
pages = {112335},
year = {2026},
issn = {1389-1286},
doi = {https://doi.org/10.1016/j.comnet.2026.112335},
url = {https://www.sciencedirect.com/science/article/pii/S1389128626003476},
author = {Boyan Gao and Lichuan Wang and Yuan Yu and Aimin Yang},
keywords = {Differential Privacy, Data Sharing, Generative AI, Full Lifecycle Defense, Knowledge Sharing},
abstract = {Data sharing is a critical pathway for unlocking the value of data assets, yet it faces significant privacy risks. Differential Privacy (DP), with its rigorous mathematical guarantees, has become a pivotal technology for balancing data utility and privacy protection. This paper systematically reviews the evolution of DP in the context of data sharing, tracing its technological development. Building on theoretical frameworks and applications in typical data-sharing scenarios, we propose an innovative model that shifts the privacy value from "sample sharing" to "knowledge sharing." In response to the unique challenges posed by large models, particularly memory-related threats, we develop a comprehensive, generative AI-based lifecycle defense architecture that encompasses model training, interactive inference, and data flow. This paper further explores the intrinsic logic behind the evolution of privacy protection technologies, from early gradient constraints to parameter-efficient fine-tuning (PEFT) and agent-based system-level defenses. We also examine the academic and industrial progress in extending these technologies from general infrastructure to cutting-edge generative AI applications. Finally, we outline the current challenges and propose future research directions.}
}
@article{SAVASTANO2025101374,
title = {Artificial intelligence in ophthalmology: Progress, challenges, and ethical implications},
journal = {Progress in Retinal and Eye Research},
volume = {107},
pages = {101374},
year = {2025},
issn = {1350-9462},
doi = {https://doi.org/10.1016/j.preteyeres.2025.101374},
url = {https://www.sciencedirect.com/science/article/pii/S1350946225000473},
author = {Maria Cristina Savastano and Clara Rizzo and Claudia Fossataro and Daniela Bacherini and Fabrizio Giansanti and Alfonso Savastano and Giovanni Arcuri and Stanislao Rizzo and Francesco Faraldi},
keywords = {Artificial intelligence in ophthalmology, AI ethical considerations, Black-box problem, Patient safety, Data privacy, Liability, Trustworthy AI},
abstract = {The adoption of artificial intelligence (AI) in ophthalmology holds great promise for improving diagnostic accuracy, optimizing workflows, and enhancing patient care. However, regulatory, ethical, and technical challenges must be addressed to ensure its safe and effective implementation. Bias in AI can lead to disparities in healthcare delivery, while the “black-box problem” raises concerns about transparency and trust. Ethical principles must guide AI integration, particularly regarding patient safety, accountability, and liability. Privacy risks related to data collection and security are especially critical in ophthalmology, where large imaging datasets are essential. Additionally, AI-generated inaccuracies, or “hallucinations,” pose potential risks to clinical decision-making. Cybersecurity threats targeting AI-powered healthcare systems further emphasize the need for robust protections. Despite these challenges, AI has the potential to improve access to ophthalmic care, particularly in underserved regions, as seen in AI-assisted diabetic retinopathy screening. However, financial and infrastructural barriers remain significant obstacles to widespread adoption. Addressing these issues requires collaboration among stakeholders, including regulators, healthcare providers, AI developers, and policymakers, to establish clear guidelines and promote trustworthy AI systems. This review explores key regulatory and ethical concerns and highlights strategies to ensure the responsible integration of AI into ophthalmology.}
}
@article{FAROOQ2026104444,
title = {Evaluating and regulating agentic AI: A study of benchmarks, metrics, and regulation},
journal = {Information Fusion},
volume = {136},
pages = {104444},
year = {2026},
issn = {1566-2535},
doi = {https://doi.org/10.1016/j.inffus.2026.104444},
url = {https://www.sciencedirect.com/science/article/pii/S1566253526003246},
author = {Azib Farooq and Shaina Raza and Nazmul Karim and Hasan Iqbal and Athanasios V. Vasilakos and Christos Emmanouilidis},
keywords = {Agentic AI, Autonomous agents, Responsible AI, Evaluation frameworks, Benchmarks, Metrics, Governance, Trustworthiness, Human alignment, Multi-agent systems, Ethical AI, Reliability, Transparency, Auditable AI, AI evaluation},
abstract = {Agentic AI represents a new generation of Artificial Intelligence (AI) systems capable of perceiving, reasoning, planning, and acting toward achieving goals with a degree of autonomy. Unlike traditional AI models that merely generate outputs, these systems maintain memory, interact with their environment, and adapt over time. However, evaluating such interactive and evolving behavior remains a significant challenge. While several recent surveys have examined agentic AI architectures, components, and applications, few have systematically reviewed their evaluation, particularly with respect to performance, reliability, and governance across an evolving agentic AI ecosystem. This survey paper addresses that gap by reviewing recent progress in the evaluation and assessment of agentic AI, focusing on three core dimensions: benchmarks, metrics, and governance. We analyze how current evaluation frameworks capture reasoning, planning, collaboration, and ethical alignment across single- and multi-agent systems. Ultimately, this study aims to establish a unified foundation for building trustworthy, auditable, and human-aligned AI agents. Project Link}
}
@article{AMIN2025103657,
title = {Generative AI personas considered harmful? Putting forth twenty challenges of algorithmic user representation in human-computer interaction},
journal = {International Journal of Human-Computer Studies},
volume = {205},
pages = {103657},
year = {2025},
issn = {1071-5819},
doi = {https://doi.org/10.1016/j.ijhcs.2025.103657},
url = {https://www.sciencedirect.com/science/article/pii/S1071581925002149},
author = {Danial Amin and Joni Salminen and Bernard J. Jansen and Joongi Shin and Dae Hyun Kim},
keywords = {Personas, Generative AI personas, Harmful, Human-centered AI},
abstract = {Generative AI personas (GenAIPs) promise user-centred design efficiency, but their impact on different persona challenges remains unexplored. Inspired by Dijkstra’s classic essay on harmful programming constructs, we analyze twenty challenges in persona development using Human-Centered AI principles. Through literature review and expert survey (n = 17), we find that GenAIPs transform rather than eliminate traditional persona challenges. Experts rated all challenges as problematic for GenAIPs (M > 4.0), with the highest concerns for hallucinations (M = 5.94), over-sanitization (M = 5.82), and lack of standardization (M = 5.59). 12 out of 20 challenges are considered more problematic for GenAIPs than conventional personas, particularly bias amplification, validation challenges, and accessibility without expertise. We provide HCAI-grounded guidelines demonstrating that effective GenAIP implementation requires human-AI collaboration rather than automation and prioritizing user welfare over technical efficiency.}
}
@article{ZHU2026101629,
title = {Commercial poisoning in AI search: Economic incentives and vulnerability persistence in retrieval-augmented generation},
journal = {Electronic Commerce Research and Applications},
volume = {79},
pages = {101629},
year = {2026},
issn = {1567-4223},
doi = {https://doi.org/10.1016/j.elerap.2026.101629},
url = {https://www.sciencedirect.com/science/article/pii/S156742232600058X},
author = {Yuxuan Zhu and Wan Mohd Hirwani Wan Hussain},
keywords = {Commercial poisoning, AI-mediated commerce, Retrieval-augmented generation, Generative engine optimization, Deceptive marketing, Consumer decision quality},
abstract = {AI search is increasingly becoming an interface through which consumers discover and compare products, and the retrieval layer supplying these systems is open to paid manipulation that carries no disclosure. This study terms such manipulation commercial poisoning and assesses it across three major providers (Google, OpenAI, Anthropic) in controlled experiments comprising 1800 observations. Six economy-tier models were evaluated over two cohorts using a synthetic corpus of consumer product content with contamination varied from 0 to 5%. Economy-tier models prove highly susceptible: 1% contamination produces bias rates of 50%–100%, and susceptibility rises sharply with query specificity, peaking on the product comparisons consumers rely on most. Contamination effects are governed by a threshold rather than a dose, so minimal investment secures near-maximal influence. Contextual poisoning circumvents explicit neutrality instructions in RLHF models at rates of 47.50% to 66.38%, against 4.17% under Constitutional AI (Cohen’s h=1.11 to 1.49). Testimonial content consistently outperforms fabricated statistics in this retrieval setting, supporting the narrative-transportation account under AI-mediated product discovery. The proposed Commercial Poisoning Framework attributes these vulnerabilities to attacker economics that make manipulation self-financing, provider underinvestment arising from externalized security benefits, and the asymmetry between per-campaign attack and per-query defence. The findings identify commercial poisoning as undisclosed advertising that circumvents the separation between paid placement and organic content on which consumer discounting depends, distorts competition in favour of firms investing in retrieval optimization irrespective of product quality, and concentrates exposure among price-sensitive consumers and merchants.}
}
@article{MENDONCA2026101343,
title = {Human-in-the-loop formative assessment with smaller language models: An equivalence testing study in programming education},
journal = {Computers in Human Behavior Reports},
volume = {24},
pages = {101343},
year = {2026},
issn = {2451-9588},
doi = {https://doi.org/10.1016/j.chbr.2026.101343},
url = {https://www.sciencedirect.com/science/article/pii/S2451958826004173},
author = {Pedro C. Mendonça and Filipe Quintal and Mário Figueiredo and Fábio Mendonça},
keywords = {Automated grading, Large language models, Small language models, Formative assessment, Programming education, Human-AI collaboration},
abstract = {Formative assessment supports student learning when feedback is timely and consistent, but its delivery at scale is constrained by instructor workload, student-data privacy, and uneven access to cloud-based AI services across higher education institutions. These conditions affect which students receive regular formative feedback and under what supervision their work is evaluated. This study examined whether smaller language models (≤32B parameters), which are more likely to be deployable on institutional infrastructure, can support human evaluators in formative programming assessment under a human-in-the-loop configuration and how they compare with larger models (≥70B). Eleven models (six smaller, five larger) were compared against the consensus of four trained instructors across 308 response-level evaluations from three assignments in a Data Structures and Algorithms course, covering text and code questions. The ±5 and ± 10 point equivalence bounds were calibrated against the pairwise disagreement observed between the four evaluators, providing course-specific anchors. Inter-rater reliability, based on Intraclass Correlation Coefficient (ICC), was high for single evaluators, ICC(2,1) = 0.901, and the four-evaluator consensus mean, ICC(2,k) = 0.973. On text, two smaller models reached strict ±5 point equivalence with the human consensus, against one of five larger models. On code, three smaller and one larger model reached moderate ±10 point equivalence. Across question types, smaller models showed higher instructor review rates than larger models. These findings indicate that specific smaller models can match larger models in formative programming assessment under instructor review, with open-source options available as a viable on-premise alternative for institutions of different resource levels.}
}
