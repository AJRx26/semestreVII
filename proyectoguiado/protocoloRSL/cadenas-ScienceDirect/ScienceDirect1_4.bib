@article{BENTAHER2026100940,
title = {GAI & cybersecurity: Bi-visions},
journal = {Computer Science Review},
volume = {61},
pages = {100940},
year = {2026},
issn = {1574-0137},
doi = {https://doi.org/10.1016/j.cosrev.2026.100940},
url = {https://www.sciencedirect.com/science/article/pii/S1574013726000481},
author = {Amina {Ben Taher} and Lamia {Chaari Fourati} and Samiha Ayed},
keywords = {Cybersecurity, GAI, Attacks, Deepfake, Adversarial attacks, GAI-enabled cyberattacks, Automated defense systems GAI in cyber defense},
abstract = {This survey investigates the dual impact of Generative Artificial Intelligence (GAI) on cybersecurity by analyzing over two hundred studies published between 2020 and 2025. Our findings show that GAI acts both as a defense enabler by automating anomaly detection, accelerating incident response, and simulating attacks for system hardening, and as a threat vector powering advanced phishing, deepfake impersonation, model poisoning, and adversarial exploits. Based on this analysis, we propose a structured taxonomy with three core dimensions: GAI for cyber defense, GAI as a source of threats, and mitigation strategies. Unlike prior surveys, this taxonomy highlights research asymmetries: while phishing detection and synthetic media threats are extensively studied, defensive strategies against adversarial poisoning or large-scale model exploitation remain underexplored. We further identify that malicious uses of GAI are evolving more rapidly than defensive countermeasures, creating a critical gap in cybersecurity readiness. These insights underscore that GAI is not simply a technological advancement but a disruptive force reshaping both offensive and defensive practices, and they call for targeted research efforts to address uncovered areas.}
}
@article{SEBASTIAN2026,
title = {Smarter tools, weaker minds? Introducing the CTRL theory of Youth–AI dependency},
journal = {Journal of Information, Communication and Ethics in Society},
year = {2026},
issn = {1477-996X},
doi = {https://doi.org/10.1108/JICES-07-2025-0191},
url = {https://www.sciencedirect.com/science/article/pii/S1477996X2600008X},
author = {Glorin Sebastian and Shaliet Rose Sebastian and Bichu P. Babu},
keywords = {Digital ethics, AI chatbots, Trust in AI, Cognitive offloading, CTRL theory, Youth behavior},
abstract = {
Purpose This study aims to examine how trust in generative AI chatbots shapes reliance-related behaviors among young adults, focusing on verification and ethical concerns. It introduces the cognitive trust, reliance, learning erosion (CTRL) theory to explain how fluent AI interactions can normalize reduced verification and, over time, weaken learning autonomy.

Design/methodology/approach A survey of participants aged 18–36 across regions was analyzed using exploratory and confirmatory factor analysis and structural equation modeling. Open-ended responses were used only for illustrative context and triangulation of quantitative patterns; the core theoretical development and hypothesis testing are based on quantitative analysis.

Findings Results show 77% of youth/young adults frequently use chatbots for academic and personal tasks. While 69% associate them with academic dishonesty and 59% with privacy concerns, higher trust predicted reduced verification (p < 0.001), showing a trade-off between convenience and reasoning. Privacy concern was prevalent in the sample; however, higher perceived model quality predicted lower privacy concern (H4), consistent with a convenience–vigilance trade-off. These patterns support the CTRL theory: cognitive trust → reliance → learning erosion.

Research limitations/implications The youth-focused sample limits generalizability across ages and cultures. Future work could explore longitudinal and cross-cultural impacts.

Practical implications Findings highlight the need for AI literacy programs, ethics-focused chatbot design and guidelines for responsible use in education.

Social implications Generative AI influences youth cognition, raising questions about digital dependency, critical thinking and academic ethics.

Originality/value This paper introduces CTRL theory as a novel framework linking AI trust, cognitive offloading and learning erosion.}
}
@article{ZHOU2027105059,
title = {All Is Heard: Mitigating conformity bias via dual-branch collaboration in group recommendation},
journal = {Information Processing & Management},
volume = {64},
number = {1, Part A},
pages = {105059},
year = {2027},
issn = {0306-4573},
doi = {https://doi.org/10.1016/j.ipm.2026.105059},
url = {https://www.sciencedirect.com/science/article/pii/S0306457326004498},
author = {Menghao Zhou and Peipei Wang and Xiaohui Han and Guangqi Liu and Lin Li},
keywords = {Group recommendation, Variational attention, Prompt learning, Graph neural networks},
abstract = {Group recommendation aims to integrate members’ preferences for consensus-aligned recommendations. However, conformity bias often leads to a “pseudo-consensus” where active members dominate the aggregation process, suppressing the latent preferences of inactive members. To address this, we propose VAPrompt, a dual-branch collaborative framework that unifies member-level variational debiasing and group-level prompting consensus. Specifically, the member-level variational debiasing branch utilizes a variational hypergraph encoder and an efficient variational attention mechanism to capture member preference diversity and prevent active members from dominating the group representation. Furthermore, the group-level prompting consensus branch introduces a heterogeneity-aware prompt to guide a multi-view gating fusion mechanism, dynamically balancing contributions from different views to focus on the intersection of members’ real intentions. We evaluate the proposed method on four real-world datasets: Mafengwo, Mafengwo-S, Weeplaces-S, and CAMRa2011. Extensive experiments demonstrate that VAPrompt outperforms state-of-the-art baselines across all evaluation metrics. In particular, compared with the best baseline, VAPrompt achieves average improvements on the Weeplaces-S dataset, with gains of 18.26% in HR@10 and 16.84% in NDCG@10. These results validate the effectiveness of the proposed framework in mitigating conformity bias and improving group recommendation accuracy. The source code is available at github11https://anonymous.4open.science/r/VAPrompt-main-43DB/..}
}
@article{JON2026106414,
title = {Disaggregating artificial intelligence training: a transatlantic framework for copyright and generative AI},
journal = {Computer Law & Security Review},
volume = {63},
pages = {106414},
year = {2026},
issn = {2212-473X},
doi = {https://doi.org/10.1016/j.clsr.2026.106414},
url = {https://www.sciencedirect.com/science/article/pii/S2212473X26001550},
author = {WooJung Jon and Jason Schultz},
keywords = {Generative AI, Copyright, Fair use, Text and data mining, Market substitution, Data provenance, EU AI Act, Territoriality},
abstract = {Generative AI disputes are often framed as a single question: whether training a model on copyrighted works is lawful. This article argues that the framing is misleading. AI training is a pipeline that begins with acquisition and preprocessing. It continues through intermediate copying during optimisation, retention and deployment, and each stage raises distinct copyright questions. Recent US decisions diverge in result but share a stage-specific method. Bartz v Anthropic separated transformative optimisation from a pirated library. Kadrey v Meta made market harm turn on evidence. Thomson Reuters v Ross Intelligence rejected fair use where copied editorial content supported a directly competing product. The English High Court’s Getty Images judgment likewise distinguished upstream copying, the legal character of model weights and downstream outputs. Together they support analysis through provenance, purpose and substitution. This article develops that comparative US–UK framework, situates it within the DSM Directive and EU AI Act, and translates it into proposals for pleading, discovery and documentation. It also develops proposals for retention, output controls and remedies. A South Korean survey serves only as contextual evidence of bounded compensation preferences. The central claim is methodological: liability should attach to the relevant operation, copy, actor and territory. The analysis should separately address the resulting market effect rather than ‘training’ in the aggregate.}
}
@article{YANG2025103148,
title = {Instruction-driven fusion of Infrared–visible images: Tailoring for diverse downstream tasks},
journal = {Information Fusion},
volume = {121},
pages = {103148},
year = {2025},
issn = {1566-2535},
doi = {https://doi.org/10.1016/j.inffus.2025.103148},
url = {https://www.sciencedirect.com/science/article/pii/S1566253525002210},
author = {Zengyi Yang and Yafei Zhang and Huafeng Li and Yu Liu},
keywords = {Infrared and visible image fusion, Diverse downstream tasks, Instruction driven},
abstract = {The primary value of infrared and visible image fusion technology lies in applying the fusion results to downstream tasks. However, existing methods face challenges such as increased training complexity and significantly compromised performance of individual tasks when addressing multiple downstream tasks simultaneously. To tackle this, we propose Task-Oriented Adaptive Regulation (T-OAR), an adaptive mechanism specifically designed for multi-task environments. Additionally, we introduce the Task-related Dynamic Prompt Injection (T-DPI) module, which generates task-specific dynamic prompts from user-input text instructions and integrates them into target representations. This guides the feature extraction module to produce representations that are more closely aligned with the specific requirements of downstream tasks. By incorporating the T-DPI module into the T-OAR framework, our approach generates fusion images tailored to task-specific requirements without the need for separate training or task-specific weights. This not only reduces computational costs but also enhances adaptability and performance across multiple tasks. Experimental results show that our method excels in object detection, semantic segmentation, and salient object detection, demonstrating its strong adaptability, flexibility, and task specificity. This provides an efficient solution for image fusion in multi-task environments, highlighting the technology’s potential across diverse applications. The source code is available at https://github.com/YR0211/IDF-TDDT.}
}
@article{COMEAUX2026302050,
title = {Ex Machina: A forensic evaluation of AI companion applications and their evidentiary value},
journal = {Forensic Science International: Digital Investigation},
volume = {56},
pages = {302050},
year = {2026},
note = {DFRWS EU 2026 - Selected Papers from the 13th Annual Digital Forensics Research Conference Europe},
issn = {2666-2817},
doi = {https://doi.org/10.1016/j.fsidi.2026.302050},
url = {https://www.sciencedirect.com/science/article/pii/S2666281726000077},
author = {Kendall J. Comeaux and Trevor T. Spinosa and Ali Ghosn and Ibrahim Baggili},
keywords = {AI companion, Mobile forensics, Network forensics, Disk forensics, Undocumented APIs},
abstract = {Artificial intelligence (AI) companion applications have emerged as a new class of conversational systems that blur the line between entertainment, intimacy, and sensitive personal data collection. Their rapid adoption and reliance on opaque cloud infrastructures create novel challenges for digital forensics, yet systematic analysis of these platforms has been limited in both academic and practitioner communities. In this paper, we present a cross-application forensic study of leading AI companion applications, combining device acquisition, network interception, and file system analysis within a rooted Android emulator to ensure reproducibility. We developed custom tools to extract and correlate artifacts such as plain-text conversation logs, authentication tokens, profile data, and hidden API calls. We also characterized third-party tracking, session management, and basic encryption, enabling automated forensic user-profile generation. Our evaluation across six applications, representing over 25 million combined downloads, reveals that sensitive user information is often retained locally, transmitted via undocumented APIs, and inconsistently protected by safeguard mechanisms, with cross-app identifiers sometimes enabling correlation of user activity. These findings demonstrate both the evidentiary potential and the privacy risks of AI companions. They offer initial guidance for evidence preservation and lawful access, while laying the groundwork for standardized forensic methodologies in this emerging domain.}
}
