@article{T2026100983,
title = {Cognitive Autonomous Memory Security (CAMS) against injection and extraction attacks in long-term memory of AI agents},
journal = {Egyptian Informatics Journal},
volume = {34},
pages = {100983},
year = {2026},
issn = {1110-8665},
doi = {https://doi.org/10.1016/j.eij.2026.100983},
url = {https://www.sciencedirect.com/science/article/pii/S1110866526001003},
author = {Dhivyasree T. and Saravanan S. and Arun Kumar Ramamoorthy and Uma Maheswari Balasubramanian},
keywords = {Artificial Intelligence agents, Large language models, Memory security, Memory injection, Memory poisoning, Memory extraction, Long-term memory},
abstract = {Artificial Intelligence (AI) agents interact, reason, and assist across sessions by maintaining Long-Term Memory (LTM). Although this memory allows personalized behavior, it creates a fundamental vulnerability by allowing attackers to either implant malicious knowledge or extract sensitive information, as was the case with recent studies revealing such attacks as MINJA (Memory INJection Attack) and MEXTRA (Memory EXTRaction Attack). To counter such attacks, this paper provides a Cognitive Autonomous Memory Security (CAMS) model that focuses on enhancing the security of long-term memory in AI agents. The CAMS middleware solution is an effective protection of the long term memory of the LLM agents, by use of a five layer defense architecture comprising of Multi-Stage Semantic Intent Engine for deep semantic interception of injection and extraction attempts, Temporal Memory Monitoring module to monitor embedding drift, sequence evolution to identify slow poisoning and progressive manipulation, a Graph-Based Multi-Memory Attack Reconstruction system to identify cross-memory relationships, a Zero-Trust Memory Architecture that imposes WriteGuard pipelines and maintains tamper-evident provenance, and a LTM Scanner that periodically re-evaluates all stored memories using the previous detection layers. The complete CAMS pipeline proved to be very resistant to the two attacks in experimental evaluation. For 640 MINJA sequences, and 560 MEXTRA querying probes, CAMS attained a total end-to-end attack prevention of 92.3%, which is far from the 38.6% and 67.4% by the classical keyword filters and LLM-only baselines, respectively. This provides an effective strategy for securing AI agent memory and addressing vulnerabilities that are currently impregnable to traditional scanners.}
}
@article{BAHI2027101076,
title = {Towards sustainable and energy-efficient agentic AI via small language models: A comprehensive survey},
journal = {Computer Science Review},
volume = {63},
pages = {101076},
year = {2027},
issn = {1574-0137},
doi = {https://doi.org/10.1016/j.cosrev.2026.101076},
url = {https://www.sciencedirect.com/science/article/pii/S157401372600184X},
author = {Abderaouf Bahi and Amel Ourici},
keywords = {Agentic AI, Small language models, Energy-efficient AI, Sustainable AI, Autonomous agents, Edge AI},
abstract = {The proliferation of agentic AI is generating an energy consumption crisis that neither incremental hardware improvements nor renewable energy procurement alone can resolve. This survey argues that the most viable pathway toward sustainable autonomous intelligence lies not in making Large Language Models (LLMs) greener, but in fundamentally rethinking the unit of agency: replacing monolithic frontier models with Small Language Models (SLMs) that are purpose-designed for the constrained, repetitive, and specialized task profiles that characterize the vast majority of deployed agentic workloads. A structured review of the small-model landscape collates published evidence that 4-bit quantized models in the 1B–7B range approach LLM-scale performance on several classes of agentic sub-tasks, with energy-per-token reductions of about one order of magnitude reported by individual studies for the specific model pairs, hardware, and workloads they evaluate, while unlocking edge deployment on sub-watt neuromorphic and embedded hardware that frontier models cannot approach. Multiple application domains are surveyed, open research challenges are identified across the agentic stack, and the concept of intelligence-per-watt (IPW) is introduced as the central organizing metric for sustainable autonomous intelligence research. This comprehensive survey provides a conceptual analysis of the literature, utilizing order-of-magnitude estimations based on published data, without conducting original physical measurements.}
}
@article{WANG2026131535,
title = {CogTrust: Cognitive Logic-Based framework for dynamic trust evaluation in multi-agent systems},
journal = {Expert Systems with Applications},
volume = {313},
pages = {131535},
year = {2026},
issn = {0957-4174},
doi = {https://doi.org/10.1016/j.eswa.2026.131535},
url = {https://www.sciencedirect.com/science/article/pii/S0957417426004483},
author = {Jiye Wang and Shiduo Yang and Jianbin Li and Yuanhe Zhao and Yu Wang and Sixing Wu},
keywords = {Large language models, Multi-agent systems, Cognitive logic, Agent security, Trust evaluation},
abstract = {As large language models (LLMs) enhance the capabilities of multi-agent systems, they also introduce security risks that existing evaluation methods struggle to address in dynamic and complex interaction scenarios. This paper presents CogTrust, a cognitive logic-based framework for dynamic trust evaluation in LLM-based multi-agent systems. CogTrust analyzes three key dimensions of an agent’s consciousness, generation of content and actions based on cognitive logic. The framework incorporates a multi-weight subjective logic model with a time decay memory factor to balance short-term attack detection with long-term trust trends. The implementation accurately represents the trustworthiness of an agent in terms of dynamic reputation value quantification. To enhance system robustness, we embed reputation value into a resilient random perturbation defense mechanism that adapts to additive noise based on trust levels, effectively mitigating attacks while preserving system performance. Experiments conducted on popular LLM-based collaborative multi-agent systems with various LLMs demonstrate that CogTrust accurately indicates agents’ trust states, reducing the percentage of dangerous examples to 14% while maintaining a task success rate over 93%. We hope this research offers valuable insights into the research of trust systems within multi-agent environments.}
}
@article{WOLF2026112850,
title = {Key-augmented neural triggers for knowledge sharing},
journal = {Journal of Systems and Software},
volume = {237},
pages = {112850},
year = {2026},
issn = {0164-1212},
doi = {https://doi.org/10.1016/j.jss.2026.112850},
url = {https://www.sciencedirect.com/science/article/pii/S0164121226000841},
author = {Alex Wolf and Marco {Edoardo Palma} and Pooja Rani and Harald C. Gall},
keywords = {Large language models, Deep learning, Repository-level, Code comprehension, Information-seeking},
abstract = {Repository-level code comprehension and knowledge sharing remain core challenges in software engineering. Large language models (LLMs) have shown promise by generating explanations of program structure and logic. Retrieval-Augmented Generation (RAG), the state-of-the-art (SOTA), improves relevance by injecting context at inference time. However, these approaches still face limitations: First, semantic fragmentation across structural boundaries impairs comprehension, as relevant knowledge is distributed across multiple files within a repository. Second, retrieval inefficiency and attention saturation degrade performance in RAG workflows, where long, weakly aligned contexts overwhelm model attention. Third, repository specific training data is scarce, often outdated, incomplete or misaligned. Finally, proprietary LLMs hinder industrial adoption due to privacy and deployment constraints. To address these issues, we propose Key-Augmented Neural Triggers (KANT), a novel approach that embeds knowledge anchors, symbolic cues linking code regions to semantic roles, into both training and inference. Unlike prior methods, KANT enables internal access to repository specific knowledge, reducing fragmentation and grounding inference in localized, semantically structured memory. Moreover, we synthesize specialized instruction tuning data directly from code, eliminating reliance on noisy or outdated documentation and comments. At inference, knowledge anchors replace verbose context, reducing token overhead and latency while supporting efficient, on premise deployment. We evaluate KANT via: a qualitative human evaluation of the synthesized dataset’s intent coverage and quality across five dimensions; compare against SOTA baselines across five qualitative dimensions and inference speed; and replication across different LLMs to assess generalizability. Results show that the synthetic training data aligned with information-seeking needs: over 90% of questions and answers were rated relevant and understandable; 77.34%, 69.53%, and 64.58% of answers were considered useful, accurate, and complete, respectively. KANT achieved over 60% preference from human annotators and a LocalStack expert over the baselines (e.g., 21% RAG) and notably the expert preferred KANT in over 79% of cases. Also, KANT reduced inference latency by up to 85% across all models. Overall, KANT demonstrated its effectiveness across all evaluated areas, implying that it is well-suited for scalable, low-latency, on-premise deployments, providing a strong foundation for repository-level code comprehension.}
}
@article{NJEH20254243,
title = {Content Safety and Response Quality in LLMs: A Data-Centric Refinement Approach},
journal = {Procedia Computer Science},
volume = {270},
pages = {4243-4252},
year = {2025},
note = {29th International Conference on Knowledge-Based and Intelligent Information & Engineering Systems (KES 2025)},
issn = {1877-0509},
doi = {https://doi.org/10.1016/j.procs.2025.09.549},
url = {https://www.sciencedirect.com/science/article/pii/S1877050925032223},
author = {Chaima Njeh and Haïfa Nakouri and Fehmi Jaafar},
keywords = {Large Language Models, BART fine-tuning, Toxicity, Bias mitigation, data-centric approach},
abstract = {Recent advancements in large language models (LLMs) have significantly impacted natural language processing. However, ensuring the safety and quality of responses generated by LLMs remains a challenge. Building on previous work with a Corrective-BART Model, which demonstrated significant reductions in toxicity, this paper addresses the trade-of between safety and response quality. A data-centric refinement paradigm is introduced, proactively generating high-quality, safe responses during training. A dynamic dataset is curated using Llama2, where toxic prompt-response pairs are contextually regenerated into safe, relevant alternatives. The enhanced Corrective-BART model employs a multi-threshold correction pipeline, leveraging multiple metrics to detect implicit and explicit harms. For the Type-Token Ratio, the enhanced model paired with GPT-4 achieves an 11% improvement. Similarly, improvements of 8.2% and 8.6% are observed when paired with Gemma-2b-it and Mistral-7B, respectively. In terms of Readability Score, the enhanced BART model paired with GPT-4 shows an 8% improvement while demonstrating a 21% improvement when paired with Mistral-7B and an 8.4% improvement with Gemma-2b-it. For Coherence Score, the enhanced BART model achieves a 6% improvement when paired with GPT-4, a 7% improvement with Mistral-7B, and a 12.7% improvement with Gemma-2b-it. Notably, the Refusal Rate exhibits a 23.4% improvement when the enhanced BART model is paired with GPT-4. Furthermore, impressive increases of 10.5× and 21.3× are observed when paired with Mistral-7B and Gemma-2b-it, respectively. These results demonstrate that the enhanced BART consistently enhances performance across all LLMs, improving lexical diversity, readability, coherence, and safety.}
}
@article{YANG2026113586,
title = {EmoRAct: A neuro-symbolic framework coupling acoustic tokens with prosody semantics for emotion recognition},
journal = {Pattern Recognition},
volume = {179},
pages = {113586},
year = {2026},
issn = {0031-3203},
doi = {https://doi.org/10.1016/j.patcog.2026.113586},
url = {https://www.sciencedirect.com/science/article/pii/S0031320326005522},
author = {Minqiang Yang and Hui Bai and Mingwen Zhang and Yongfeng Tao and Changsheng Ma and Bin Hu},
keywords = {Multimodal emotion recognition, Multimodal large language models, Discretization},
abstract = {Comprehensive dialogue understanding and effective cross-modal interaction remain challenging in Multimodal Emotion Recognition in Conversations (ERC). Although emotion-aware Multimodal Large Language Models (MLLMs) show promise, they often struggle to bridge the gap between continuous acoustic signals and discrete linguistic semantics, resulting in information loss and limited fine-grained prosody perception. To address these limitations, we propose EmoRAct, a novel emotion-enhanced multimodal framework that extends the capabilities of Vision-Language Models (VLMs) by projecting audio, visual, and textual inputs into a unified symbolic space. Unlike traditional methods that rely on shallow feature concatenation, EmoRAct employs a dual-layer acoustic representation, integrating discretized acoustic tokens with prosody descriptions as affective constraints. To efficiently align these new acoustic symbols with the pre-trained semantic space, we employ a structured multimodal prompting strategy and parameter-efficient fine-tuning, enabling deep interaction among heterogeneous modalities. Extensive experiments demonstrate that EmoRAct outperforms existing state-of-the-art methods, achieving 68.58% and 79.76% accuracy on the MELD and MER2025 datasets, respectively, validating the critical role of acoustic discretization in robust and interpretable emotion understanding.}
}
@article{GE2026132023,
title = {PrivTabRAG: A data-model co-design framework for privacy-preserving retrieval-augmented generation on tabular data},
journal = {Expert Systems with Applications},
volume = {321},
pages = {132023},
year = {2026},
issn = {0957-4174},
doi = {https://doi.org/10.1016/j.eswa.2026.132023},
url = {https://www.sciencedirect.com/science/article/pii/S095741742600936X},
author = {Yinchi Ge and Hui Zhang and Haohang Sun and Zhenyuan Huang and Haijun Yang},
keywords = {Privacy-preserving RAG, Differential privacy, Tabular data synthesis, Embedding optimization},
abstract = {Inherent conflicts between privacy risks and retrieval accuracy hinder the effectiveness of Retrieval Augmented Generation (RAG) for tabular data. Standard row linearization leaks sensitive information while failing to capture relational dependencies. Existing privacy strategies are insufficient: privacy-enhanced Large Language Models training is computationally prohibitive, while inference-time filtering creates a trade-off between utility and protection. We propose PrivTabRAG, a novel framework that decouples privacy from retrieval by generating and querying Differentially Private (DP) synthetic data. To overcome the utility limitations of standard DP synthesis in RAG tasks, we introduce Retrieval-Augmented Table Generation (RATG) to align synthetic data with semantic embedding spaces, and Sequential Consistency Embedding (SCE) to optimize the retriever for synthetic distributions. Experiments demonstrate that PrivTabRAG achieves utility competitive with non-private baselines while reducing Membership Inference Attack (MIA) success rates from over 90% to near-random chance ( ∼ 50%). By adopting a ”generate once, query infinitely” paradigm, PrivTabRAG provides a scalable, query-agnostic privacy guarantee with minimal utility cost.}
}
@article{MA2026100403,
title = {What breaks embodied AI security: LLM vulnerabilities, CPS flaws, or something else?},
journal = {High-Confidence Computing},
volume = {6},
number = {2},
pages = {100403},
year = {2026},
issn = {2667-2952},
doi = {https://doi.org/10.1016/j.hcc.2026.100403},
url = {https://www.sciencedirect.com/science/article/pii/S266729522600022X},
author = {Boyang Ma and Hechuan Guo and Peizhuo Lv and Minghui Xu and Xuelong Dai and Yechao Zhang and Yijun Yang and Yue Zhang},
keywords = {Embodied intelligence security, Embodied AI security, LLM security, IoT security},
abstract = {Embodied AI systems (e.g., autonomous vehicles, service robots, and LLM-driven interactive agents) are rapidly transitioning from controlled environments to safety-critical real-world deployments. Unlike disembodied AI, failures in embodied intelligence lead to irreversible physical consequences, raising fundamental questions about security, safety, and reliability. While existing research predominantly analyzes embodied AI through the lenses of Large Language Model (LLM) vulnerabilities or classical Cyber–Physical System (CPS) failures, this survey argues that these perspectives are individually insufficient to explain many observed breakdowns in modern embodied systems. We posit that a significant class of failures arises from embodiment-induced system-level mismatches, rather than from isolated model flaws or traditional CPS attacks. Specifically, we identify four core insights that explain why embodied AI is fundamentally harder to secure: (i) semantic correctness does not imply physical safety, as language-level reasoning abstracts away geometry, dynamics, and contact constraints; (ii) identical actions can lead to drastically different outcomes across physical states due to nonlinear dynamics and state uncertainty; (iii) small errors propagate and amplify across tightly coupled perception–decision–action loops; and (iv) safety is not compositional across time or system layers, enabling locally safe decisions to accumulate into globally unsafe behavior. These insights suggest that securing embodied AI requires moving beyond component-level defenses toward system-level reasoning about physical risk, uncertainty, and failure propagation.}
}
@article{NORASET2026100527,
title = {Evaluating lab assistant chatbot on student learning and behaviors in a programming short course},
journal = {Computers and Education: Artificial Intelligence},
volume = {10},
pages = {100527},
year = {2026},
issn = {2666-920X},
doi = {https://doi.org/10.1016/j.caeai.2025.100527},
url = {https://www.sciencedirect.com/science/article/pii/S2666920X25001675},
author = {Thanapon Noraset and Akara Supratak and Chaiyong Ragkhitwetsagul and Nubthong Worathong and Suppawong Tuarob},
keywords = {Programming Education, Chatbot, Prompt Engineering, Empirical Study},
abstract = {The rise of generative AI has increased interest in its application as an intelligent lab assistant in programming education, but concerns persist over its educational value and potential exploitation. While previous work supports using a customized chatbot as an assistant that provides specific guidance rather than allowing students to prompt responses freely, empirical evidence directly comparing these approaches is still lacking. This study evaluates the impact of two chatbot designs, Unrestricted and Assistant, on student learning and behavior in a short Python programming course. Through a controlled experiment involving 42 participants, we found that students using the Assistant chatbot, which provided guidance through preset and free-text prompts without offering direct solutions, showed significantly greater improvement from pre- to post-test than those using an Unrestricted chatbot. Analysis of over 1000 chatbot interactions revealed a strong preference for free-text input and a high rate of attempted exploits among participants. Additionally, prompt injection tests demonstrated the Assistant chatbot’s partial vulnerability to hijacking attempts. These findings highlight the benefits and limitations of AI assistants in programming education, underscoring the importance of guided interaction design to support learning while minimizing exploitation.}
}
@article{CHO2026116335,
title = {Internalizing persona knowledge in small language models via multi-objective contrastive learning},
journal = {Knowledge-Based Systems},
volume = {347},
pages = {116335},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116335},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010610},
author = {Suhyun Cho and Sewon Park and Jang Hyun Kim},
keywords = {Large language models, Persona knowledge, Human simulation, Knowledge internalization, Name dependence},
abstract = {This study proposes a multi-objective training framework that internalizes persona knowledge — an individual’s beliefs, judgment criteria, and speech patterns — directly into the parameters of small language models (sLLMs), eliminating the need for lengthy context injection at inference time. A 12B sLLM trained with the proposed method and performing zero-context inference outperformed GPT-4o and Claude 3.5 Sonnet under random-sampled context, and remained competitive against the stronger BM25-retrieved variants of these SOTA APIs at the same 1500-token budget—outperforming both on utterance verification (QB-YN, QB-YN-v2) with statistical significance against GPT-4o+BM25 at the speaker level, exceeding GPT-4o+BM25 numerically on value judgment (LLM-Gen), while being slightly surpassed by Claude+BM25 on this task. The 12B model also surpassed a 27B base model with random-sampled in-context learning by +0.193 on value judgment under a fixed mean-over-epochs evaluation protocol. Most existing approaches to individual simulation rely on injecting past utterances into the prompt, an approach that increases token costs and readily undermines persona consistency when contextual cues conflict. To address these limitations, we combine classification, contrastive learning, and language modeling losses to simultaneously optimize correctness, discriminability, and fluency, and propose an evaluation protocol that systematically varies context availability and name dependence. Experiments on 15 public figures drawn from QuoteBank-family corpora demonstrate that internalization training simultaneously improves both efficiency and robustness over context-based imitation, while name dependence analysis reveals that a substantial portion of SOTA models’ zero-shot accuracy stems from pretraining memorization rather than from utterance-level reasoning about the persona.}
}
@article{CHEN2026109192,
title = {Fine-grained hierarchical multi-round iterative semantic optimization attack method for RAG systems},
journal = {Neural Networks},
volume = {203},
pages = {109192},
year = {2026},
issn = {0893-6080},
doi = {https://doi.org/10.1016/j.neunet.2026.109192},
url = {https://www.sciencedirect.com/science/article/pii/S0893608026006532},
author = {Qidong Chen and Vasile Palade and Zihao Yu and Ruixiang Deng and Jun Sun and Hao Wu},
keywords = {RAG systems, Knowledge corruption attacks, Fine-grained, Hybrid scaled similarity},
abstract = {Knowledge corruption attacks occur when an attacker injects a small amount of malicious text into the knowledge database of a retrieval-augmented generation (RAG) system, thereby inducing the Large Language Model (LLM) to generate attacker-chosen target answers for specific target questions. Traditional knowledge corruption attacks are susceptible to semantic deviation and interference due to their single-generation strategy, in which malicious text is directly injected into the RAG system after generating it, resulting in limited concealment. This paper proposes a novel fine-grained, hierarchical, multi-round iterative semantic optimization attack method (FHM-ISO) for RAG systems. This method can continuously optimize the generated text by selecting different prompts based on the semantic relationships between the original question and the generated content, thereby guiding RAG systems to generate effective malicious texts. Meanwhile, we introduce a hybrid similarity scaling mechanism in FHM-ISO that integrates non-linear activation and linear scaling to optimize the evaluation of semantic distances, thereby overcoming the limitations of conventional rigid metrics in optimization. Experimental results demonstrate that the proposed method significantly improves the effectiveness of attacks against RAG systems across multiple public datasets, achieving an average attack success rate of 68% when only one piece of malicious text is injected per question.}
}
@article{SUN2026112567,
title = {CoRe-DoS: Inference-time denial-of-service attack against retrieval-augmented generation},
journal = {Computer Networks},
volume = {287},
pages = {112567},
year = {2026},
issn = {1389-1286},
doi = {https://doi.org/10.1016/j.comnet.2026.112567},
url = {https://www.sciencedirect.com/science/article/pii/S1389128626005797},
author = {Haocheng Sun and Deyu Yuan and Mingfeng Li and Yuyang Deng},
keywords = {Large language models, Retrieval-augmented generation, Denial-of-service attack, Context replacement},
abstract = {Retrieval-Augmented Generation (RAG) technology significantly mitigates the hallucination problem in large language models by integrating external knowledge bases, but its distributed architecture also introduces new security risks. Existing research on attacks against RAG systems primarily focuses on knowledge poisoning, which directly contaminates external knowledge bases and requires attackers to have permission to modify the knowledge base. However, these methods overlook the interceptability of retrieved context during the inference phase of RAG systems, leaving the inference-time attack vector insufficiently explored. To address this issue, this paper proposes CoRe-DoS, an inference-time denial-of-service attack framework for retrieval-augmented generation. Rather than poisoning the knowledge base, this framework intercepts and manipulates retrieved context during inference, exploiting the instruction-following characteristics and position bias of large language models to induce the model to refuse answering legitimate queries. Meanwhile, it introduces a black-box capacity inference mechanism and an instruction-preserving compression mechanism to ensure the integrity of attack payloads under unknown context window constraints. Experimental results demonstrate that CoRe-DoS achieves attack success rates ranging from 84.6% to 100% across two benchmark datasets and multiple mainstream models, significantly outperforming baseline methods. It also maintains relatively high effectiveness under mainstream defense mechanisms, including perplexity filtering, document rewriting, knowledge expansion, and a RAGuard-style composed defense.}
}
@article{BOROUJENI2026105944,
title = {All you need for object detection: From pixels, points, and prompts to Next-Gen fusion and multimodal LLMs/VLMs in autonomous vehicles},
journal = {Image and Vision Computing},
volume = {169},
pages = {105944},
year = {2026},
issn = {0262-8856},
doi = {https://doi.org/10.1016/j.imavis.2026.105944},
url = {https://www.sciencedirect.com/science/article/pii/S0262885626000508},
author = {Sayed Pedram Haeri Boroujeni and Niloufar Mehrabi and Hazim Alzorgan and Mahlagha Fazeli and Abolfazl Razi},
keywords = {Autonomous vehicle (AV), Computer Vision (CV), Vision Transformers (viTs), Large Language Models (LLMs), Vision Language Models (VLMs), Sensor fusion},
abstract = {Autonomous Vehicles (AVs) are transforming the future of transportation through advances in intelligent perception, decision-making, and control systems. However, their success is tied to one core capability, reliable object detection in complex and multimodal environments. While recent breakthroughs in Computer Vision (CV) and Artificial Intelligence (AI) have driven remarkable progress, the field still faces a critical challenge as knowledge remains fragmented across multimodal perception, contextual reasoning, and cooperative intelligence. This survey bridges that gap by delivering a forward-looking analysis of object detection in AVs, emphasizing emerging paradigms such as Vision-Language Models (VLMs), Large Language Models (LLMs), and Generative AI rather than re-examining outdated techniques. We begin by systematically reviewing the fundamental spectrum of AV sensors (camera, ultrasonic, LiDAR, and Radar) and their fusion strategies, highlighting not only their capabilities and limitations in dynamic driving environments but also their potential to integrate with recent advances in LLM/VLM-driven perception frameworks. We also review autonomous vehicle simulators as a critical layer for safe development, scalable testing, and reproducible benchmarking of perception and detection pipelines before real-world deployment. Next, we introduce a structured categorization of AV datasets that moves beyond simple collections, positioning ego-vehicle, infrastructure-based, and cooperative datasets (e.g., V2V, V2I, V2X, I2I), followed by a cross-analysis of data structures and characteristics. Ultimately, we analyze cutting-edge detection methodologies, ranging from 2D and 3D pipelines to hybrid sensor fusion, with particular attention to emerging transformer-driven approaches powered by Vision Transformers (ViTs), Large and Small Language Models (SLMs), and VLMs. By synthesizing these perspectives, our survey delivers a clear roadmap of current capabilities, open challenges, and future opportunities, highlighting underexplored avenues such as multimodal reasoning, cooperative perception, and foundation-model integration. We aim to establish this work as a definitive reference for researchers, practitioners, and developers, fostering accelerated innovation toward safer and more intelligent autonomous driving systems.}
}
@article{MENG2027109562,
title = {The adversarial game between detection and evasion: A survey of anti-detection techniques for machine-generated texts},
journal = {Neural Networks},
volume = {205},
pages = {109562},
year = {2027},
issn = {0893-6080},
doi = {https://doi.org/10.1016/j.neunet.2026.109562},
url = {https://www.sciencedirect.com/science/article/pii/S0893608026010191},
author = {Deyu Meng and Tad Gonsalves},
keywords = {Large language models, Survey, MGTD, Attack, Defense},
abstract = {With the explosive growth of large language models (LLMs), research on machine-generated text detection (MGTD) has also proliferated. Alongside these developments, a wide range of attack algorithms targeting MGTD systems have emerged. While previous studies have surveyed detection techniques, few have examined the dynamic interplay between attack and defense. Following PRISMA 2020, this paper systematically synthesizes 27 studies of attacks against MGTD and the available evidence on corresponding defenses. We categorize existing research into four major types of evasion strategies: watermark attacks, paraphrasing attacks, prompt-based attacks, and adversarial-text attacks, and summarize the available defense evidence. Furthermore, to better understand the practical implications of these methods, we compile the reported performance results of attack and defense techniques across different detectors. Finally, we highlight the current challenges in this area and outline potential future research directions. A companion repository containing the categorized literature, paper links, and available code, data, and project repositories is provided at https://github.com/AIGC1999/A-Survey-of-Anti-Detection-Techniques-for-Machine-Generated-Texts.}
}
@article{LI2026116700,
title = {Semantic-aware resource orchestration and context-driven task scheduling for heterogeneous distributed edge computing networks},
journal = {Applied Soft Computing},
pages = {116700},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.116700},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626021484},
author = {Mengyu Li},
keywords = {Network optimization, Resource orchestration, Semantic-aware scheduling, Distributed edge computing},
abstract = {Modern distributed edge computing systems face escalating challenges in resource allocation and task scheduling across geographically dispersed, computationally heterogeneous nodes while satisfying diverse quality-of-service requirements and adaptation to dynamic network conditions. Traditional optimization approaches, operating on rigid mathematical formulations, fail to capture the semantic complexity and contextual nuances inherent in contemporary distributed workloads where tasks carry implicit requirements expressed through natural language specifications. We present a novel semantic-aware orchestration framework that interprets task semantics, reasons about resource trade-offs, and generates intelligent scheduling decisions through natural language understanding. Our hierarchical architecture integrates global semantic reasoning for network-wide coordination with localized controllers for real-time regional execution. The LLM acts as a semantic policy generator that outputs relaxed placement scores and natural-language directives, whereas feasibility with respect to hard constraints is enforced by a deterministic ADMM projection. By embedding task descriptions into semantic vector spaces and employing retrieval-augmented decision making, the system achieves intelligent task co-location, minimizes data transfer overhead, and naturally enforces constraints expressed in natural language. Comprehensive evaluation on a 500-node distributed testbed processing 60,000 heterogeneous tasks demonstrates 37% reduction in average completion time, 42% improvement in resource utilization efficiency, and 28% decrease in deadline violations compared to state-of-the-art baselines including reinforcement learning and graph neural network approaches. When all learned baselines are re-tuned under matched training budgets and given the same semantic embeddings, the completion-time reduction against the strongest baseline remains 23.3%. Production deployment in distributed medical imaging infrastructure over 30 days indicates practical viability in this setting, with zero constraint violations and 82% reduction in manual interventions, and points to semantic understanding as a promising direction for autonomous resource management in large-scale distributed computing environments, subject to the cost, privacy and availability conditions analysed in the paper.}
}
@article{LI2025114634,
title = {AI-generated content in cross-domain applications: Research trends, challenges and propositions},
journal = {Knowledge-Based Systems},
volume = {330},
pages = {114634},
year = {2025},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2025.114634},
url = {https://www.sciencedirect.com/science/article/pii/S0950705125016739},
author = {Jianxin Li and Liang Qu and Taotao Cai and Zhixue Zhao and Nur {Al Hasan Haldar} and Aneesh Krishna and Xiangjie Kong and Flavio {Romero Macau} and Tanmoy Chakraborty and Aniket Deroy and Binshan Lin and Karen Blackmore and Nasimul Noman and Jingxian Cheng and Ningning Cui and Jianliang Xu},
keywords = {Artificial intelligence generated content (AIGC), Generative AI, Large language models (LLMs), Content detection, Online marketing},
abstract = {Artificial Intelligence Generated Content (AIGC) has rapidly emerged with the capability to generate different forms of content, including text, images, videos, and other modalities, which can achieve a quality similar to content created by humans. As a result, AIGC is now widely applied across various domains such as digital marketing, education, and public health, and has shown promising results by enhancing content creation efficiency and improving information delivery. However, there are few studies that explore the latest progress and emerging challenges of AIGC across different domains. To bridge this gap, this paper brings together 16 scholars from multiple disciplines to provide a cross-domain perspective on the trends and challenges of AIGC. Specifically, the contributions of this paper are threefold: (1) It first provides a broader overview of AIGC, spanning the training techniques of Generative AI, detection methods, and both the spread and use of AI-generated content across digital platforms. (2) It then introduces the societal impacts of AIGC across diverse domains, along with a review of existing methods employed in these contexts. (3) Finally, it discusses the key technical challenges and presents research propositions to guide future work. Through these contributions, this vision paper seeks to offer readers a cross-domain perspective on AIGC, providing insights into its current research trends, ongoing challenges, and future directions.}
}
@article{LIN2026100726,
title = {An empirical study of knowledge modelling for healthcare chatbots: From RAG to GraphRAG},
journal = {Smart Health},
volume = {42},
pages = {100726},
year = {2026},
issn = {2352-6483},
doi = {https://doi.org/10.1016/j.smhl.2026.100726},
url = {https://www.sciencedirect.com/science/article/pii/S2352648326000942},
author = {Yuqing Lin and Tao Tan and Xiao Chen and Jawaher Alghamdi and Heidi Janssen},
keywords = {Knowledge graph, Retrieval-augmented generation, Entity–relationship extraction, Large language models, Domain specific question answering, Post-stroke driving},
abstract = {Large language models (LLMs) are increasingly used in healthcare chatbots; however, they are prone to hallucination and lack reliable domain knowledge without external grounding. This paper presents an empirical study of knowledge modelling approaches for healthcare chatbots, using a corpus of Australian post-stroke driving guidelines. We evaluate the performance of raw LLMs, retrieval-augmented generation (RAG), and knowledge-graph-based retrieval (GraphRAG). Experimental results show that knowledge augmentation improves accuracy, with GraphRAG achieving the best performance among retrieval-based methods. However, our findings also indicate that neither RAG nor GraphRAG provides a complete solution, highlighting the need for more robust and hybrid strategies to support reliable healthcare chatbot systems.}
}
@article{RODRIGUEZ2026100834,
title = {Towards safer chatbots: Automated policy compliance evaluation of custom GPTs},
journal = {Array},
volume = {30},
pages = {100834},
year = {2026},
issn = {2590-0056},
doi = {https://doi.org/10.1016/j.array.2026.100834},
url = {https://www.sciencedirect.com/science/article/pii/S2590005626001578},
author = {David Rodriguez and William Seymour and Jose M. {Del Alamo} and Jose Such},
keywords = {Policy compliance, Large language models, Automated auditing, Red-teaming, LLM-as-a-judge, Custom GPTs},
abstract = {User-configured chatbots built on top of large language models are increasingly available through centralized marketplaces such as OpenAI’s GPT Store. While these platforms enforce usage policies intended to prevent harmful or inappropriate behavior, the scale and opacity of customized chatbots make systematic policy enforcement challenging. As a result, policy-violating chatbots continue to remain publicly accessible despite existing review processes. This paper presents a fully automated method for evaluating the compliance of Custom GPTs with its marketplace usage policy using black-box interaction. The method combines large-scale GPT discovery, policy-driven red-teaming prompts, and automated compliance assessment using an LLM-as-a-judge. We focus on three policy-relevant domains explicitly addressed in OpenAI’s usage policies: Romantic, Cybersecurity, and Academic GPTs. We validate our compliance assessment component against a human-annotated ground-truth dataset, achieving an F1 score of 0.975 for binary policy violation detection. We then apply the method in a large-scale empirical study of 782 Custom GPTs retrieved from the GPT Store. The results show that 58.7% of the evaluated GPTs exhibit at least one policy-violating response, with substantial variation across policy domains. A comparison with the base models (GPT-4 and GPT-4o) indicates that most violations originate from model-level behavior, with customization tending to amplify these tendencies rather than create new failure modes. Our findings reveal limitations in current review mechanisms for user-configured chatbots and demonstrate the feasibility of scalable, behavior-based policy compliance evaluation.}
}
@article{NDUM2027113057,
title = {A retrieval-augmented, domain-intelligent agentic framework for reliable decision support in safety-critical nuclear engineering},
journal = {Reliability Engineering & System Safety},
volume = {277},
pages = {113057},
year = {2027},
issn = {0951-8320},
doi = {https://doi.org/10.1016/j.ress.2026.113057},
url = {https://www.sciencedirect.com/science/article/pii/S0951832026008665},
author = {Zavier Ndum Ndum and Jian Tao and John Ford and Mansung Yim and Yang Liu},
keywords = {Large language models, Visual retrieval-augmented generation, Multi-modal knowledge management, Advanced nuclear energy},
abstract = {Reliable decision support in nuclear engineering requires traceable retrieval from technical documentation, yet conventional deployment of pretrained large language models (LLMs) in specialized workflows remains vulnerable to fragmented source access, weak traceability, and hallucination. This paper presents RADIANT-LLM (Retrieval-Augmented, Domain-Intelligent Assistant for Nuclear Technologies using LLMs), a training-free, local-first multimodal visual retrieval-augmented generation (Visual-RAG) framework for nuclear safety, security, and safeguards applications. The framework integrates multimodal PDF ingestion, structured local knowledge-base construction, metadata-aware retrieval, and agentic tool orchestration to answer questions over documents containing text, equations, tables, figures, and schematics. By retaining documents, parsed content, embeddings, and knowledge-base assets on user-controlled infrastructure, and transmitting only retrieved evidence when external models are used, the framework is designed to reduce broad document exposure while preserving page- and figure-level traceability. The framework was evaluated using expert-curated benchmarks derived from authoritative technical PDFs, including guidance for Used Nuclear Fuel Storage Facility (UNFSF) design, and five domain-aware metrics: Context Precision (CoP), Citation Precision (CiP), Citation Hit (CiH), Hallucination Rate (HR), and Visual Recall (ViR). A two-stage evaluation first identified a strong multimodal RAG configuration and then assessed performance as the knowledge base expanded from 1 to 250 sources. Across corpus expansion, retrieval quality and visual grounding remained strong (CoP: 0.813–0.956; CiP: 0.893–0.964; CiH: 0.900–0.989; ViR: 0.802–0.983), while hallucination remained low (HR: 0.024–0.094), with no statistically significant monotonic degradation. Compared with general-purpose LLM use without a dedicated RAG layer, RADIANT-LLM produced more reliable, citation-aligned, page- and figure-grounded responses.}
}
@article{TZANIS20267,
title = {Agentic systems in radiology: Principles, opportunities, privacy risks, regulation, and sustainability concerns},
journal = {Diagnostic and Interventional Imaging},
volume = {107},
number = {1},
pages = {7-16},
year = {2026},
issn = {2211-5684},
doi = {https://doi.org/10.1016/j.diii.2025.10.002},
url = {https://www.sciencedirect.com/science/article/pii/S2211568425001858},
author = {Eleftherios Tzanis and Lisa C. Adams and Tugba {Akinci D’Antonoli} and Keno K. Bressem and Renato Cuocolo and Burak Kocak and Christina Malamateniou and Michail E. Klontzas},
keywords = {Agent, Agentic systems, Artificial intelligence, Large language models, Prompting, Radiology},
abstract = {The rapid rise of transformer-based large language models (LLMs) has introduced new opportunities for automation and decision support in radiology, particularly in applications such as report generation, protocol optimization, and structured interpretation. Despite their impressive performance in producing contextually coherent text, conventional LLMs remain limited by their inability to interact autonomously with external systems, retrieve data, or execute code, restricting their role in real-world clinical and research workflows. To address these limitations, agentic systems have emerged as a new paradigm. By embedding LLMs within frameworks that enable reasoning, planning, and action, agentic systems extend LLM capabilities to dynamic interaction with users, tools, and data sources. This review provides a comprehensive overview of the foundations, architectures, and operational mechanisms of agentic systems, focusing on their applications in medical imaging and radiology. It summarizes key developments in the literature, including recent multi-agent frameworks for automated radiomics pipelines, and discusses the potential benefits of these systems in enhancing the reproducibility, interpretability, and accessibility of AI-driven workflows. The review critically examines current regulatory considerations, ethical implications, and sustainability challenges to highlight essential gaps that must be addressed for the safe and responsible clinical integration of these systems.}
}
@article{ZHANG2026106318,
title = {MultiGraph-vet: A multimodal knowledge-augmented decision-support framework for safe dairy cow disease assessment on a curated benchmark},
journal = {Research in Veterinary Science},
volume = {210},
pages = {106318},
year = {2026},
issn = {0034-5288},
doi = {https://doi.org/10.1016/j.rvsc.2026.106318},
url = {https://www.sciencedirect.com/science/article/pii/S0034528826002729},
author = {Cunjin Zhang and Maoxu Wang and Xu You and Zhixin Gu},
keywords = {Multimodal large language models, Precision livestock farming, Dairy cow diagnosis, Hallucination mitigation, Retrieval-augmented generation, Knowledge graph},
abstract = {Rapid and reliable disease assessment is essential for dairy cow health management, but field-level clinical inputs are often colloquial, noisy, visually ambiguous, and context-dependent. These characteristics make large language model (LLM)-based veterinary decision-support systems vulnerable to factual errors, unsafe recommendations, and cross-modal hallucinations. To address this problem, we propose MultiGraph-Vet, a multimodal knowledge-augmented decision-support framework for safer dairy cow disease assessment. MultiGraph-Vet integrates a bovine veterinary knowledge graph, visual lesion parsing, colloquial symptom normalization, environmental context fusion, and a multimodal safety gate. It performs cross-modal consistency checking across text, image-derived lesion evidence, and environmental context, retrieves candidate diseases through a dual-path knowledge graph strategy, and generates evidence-grounded diagnostic suggestions through rule-constrained reasoning. We evaluated MultiGraph-Vet on a curated bovine clinical benchmark containing 338 cases, including 275 non-safety diagnostic decision-support cases, 132 real image-associated cases, and 63 safety-challenge scenarios involving contradictory, incomplete, non-bovine, or adversarial inputs. Compared with generic multimodal LLM baselines, MultiGraph-Vet achieved 80.36% diagnostic accuracy, 87.27% candidate recall@K, 96.83% safe interception rate, and 3.35% hallucination-related commitment rate. These results indicate that explicit veterinary knowledge grounding, visual lesion standardization, and multimodal conflict checking can improve reliability and safety control in AI-assisted dairy cow disease decision support. MultiGraph-Vet is intended to support preliminary assessment and risk-aware decision-making rather than replace professional veterinary diagnosis.}
}
@article{LIU2027133921,
title = {Retrieval is NOT always needed: Exploring the timing of retrieval in dynamic retrieval-augmented generation},
journal = {Expert Systems with Applications},
volume = {333},
pages = {133921},
year = {2027},
issn = {0957-4174},
doi = {https://doi.org/10.1016/j.eswa.2026.133921},
url = {https://www.sciencedirect.com/science/article/pii/S0957417426028289},
author = {Yuhang Liu and Heyan Huang and Yizhe Yang and Zhizhuo Zeng and Youchao Zhou and Zhijing Wu and Yang Gao},
keywords = {Large language model, Retrieval-augmented generation, Retrieval timing, Confidence, Query-response},
abstract = {Retrieval-augmented Generation (RAG) has been proven to expand knowledge boundaries of large language models (LLMs). However, indiscriminate retrieval throughout the generation process can increase costs and lead to potentially incorrect answers. To identify the optimal retrieval timing within the generation process, we introduce a novel framework named SC-DRAG, which employs sentence-level confidence estimation. Based on the estimated confidence of each reasoning sentence, SC DRAG adopts a set of adaptive strategies that correspond to different confidence levels, including retrieval, reflection and progression. A key aspect of our framework is the accurate estimation of confidence, which is enhanced by considering not only the generated responses but also the semantics of the query, thereby improving confidence evaluation. This dual consideration ensures that the retrieval process is activated only when truly beneficial, preventing unnecessary retrievals that may introduce noise into the generation. Furthermore, SC-DRAG provides a flexible solution that adapts to the evolving demands of the generation process, enhancing its robustness in complex knowledge-intensive tasks. Compared to previous works, our framework exhibits exceptional adaptability across a variety of white-box and black-box models. Experimental results on three knowledge-intensive datasets show that the proposed framework achieves favorable accuracy-efficiency trade-offs and competitive performance across the evaluated settings by improving retrieval timing. Code will be avaliable at https://gitub.com/yifraternity/conf-rag.git.}
}
