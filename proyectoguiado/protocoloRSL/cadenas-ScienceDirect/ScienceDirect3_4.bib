Design/methodology/approach The authors review the most recent surveys, reports, news articles and academic research on the applications of GenAI technology in auditing practices.

Findings The authors present the emerging opportunities and practical use cases of incorporating GenAI into audit practices while also discuss the associated challenges and risks. The authors synthesize insights from recent surveys, media reports and early accounting literature on the topic. Finally, they highlight critical avenues for further research to deepen the understanding of the implications, challenges and opportunities that GenAI presents within the auditing field.

Originality/value Based on the review and discussion, this commentary identifies 15 underexplored or unanswered research topics and calls for further research in these important areas.}
}
@article{GAO2026112335,
title = {Differential privacy for data sharing: evolution and full-lifecycle applications in generative AI},
journal = {Computer Networks},
volume = {284},
pages = {112335},
year = {2026},
issn = {1389-1286},
doi = {https://doi.org/10.1016/j.comnet.2026.112335},
url = {https://www.sciencedirect.com/science/article/pii/S1389128626003476},
author = {Boyan Gao and Lichuan Wang and Yuan Yu and Aimin Yang},
keywords = {Differential Privacy, Data Sharing, Generative AI, Full Lifecycle Defense, Knowledge Sharing},
abstract = {Data sharing is a critical pathway for unlocking the value of data assets, yet it faces significant privacy risks. Differential Privacy (DP), with its rigorous mathematical guarantees, has become a pivotal technology for balancing data utility and privacy protection. This paper systematically reviews the evolution of DP in the context of data sharing, tracing its technological development. Building on theoretical frameworks and applications in typical data-sharing scenarios, we propose an innovative model that shifts the privacy value from "sample sharing" to "knowledge sharing." In response to the unique challenges posed by large models, particularly memory-related threats, we develop a comprehensive, generative AI-based lifecycle defense architecture that encompasses model training, interactive inference, and data flow. This paper further explores the intrinsic logic behind the evolution of privacy protection technologies, from early gradient constraints to parameter-efficient fine-tuning (PEFT) and agent-based system-level defenses. We also examine the academic and industrial progress in extending these technologies from general infrastructure to cutting-edge generative AI applications. Finally, we outline the current challenges and propose future research directions.}
}
@article{SAVASTANO2025101374,
title = {Artificial intelligence in ophthalmology: Progress, challenges, and ethical implications},
journal = {Progress in Retinal and Eye Research},
volume = {107},
pages = {101374},
year = {2025},
issn = {1350-9462},
doi = {https://doi.org/10.1016/j.preteyeres.2025.101374},
url = {https://www.sciencedirect.com/science/article/pii/S1350946225000473},
author = {Maria Cristina Savastano and Clara Rizzo and Claudia Fossataro and Daniela Bacherini and Fabrizio Giansanti and Alfonso Savastano and Giovanni Arcuri and Stanislao Rizzo and Francesco Faraldi},
keywords = {Artificial intelligence in ophthalmology, AI ethical considerations, Black-box problem, Patient safety, Data privacy, Liability, Trustworthy AI},
abstract = {The adoption of artificial intelligence (AI) in ophthalmology holds great promise for improving diagnostic accuracy, optimizing workflows, and enhancing patient care. However, regulatory, ethical, and technical challenges must be addressed to ensure its safe and effective implementation. Bias in AI can lead to disparities in healthcare delivery, while the “black-box problem” raises concerns about transparency and trust. Ethical principles must guide AI integration, particularly regarding patient safety, accountability, and liability. Privacy risks related to data collection and security are especially critical in ophthalmology, where large imaging datasets are essential. Additionally, AI-generated inaccuracies, or “hallucinations,” pose potential risks to clinical decision-making. Cybersecurity threats targeting AI-powered healthcare systems further emphasize the need for robust protections. Despite these challenges, AI has the potential to improve access to ophthalmic care, particularly in underserved regions, as seen in AI-assisted diabetic retinopathy screening. However, financial and infrastructural barriers remain significant obstacles to widespread adoption. Addressing these issues requires collaboration among stakeholders, including regulators, healthcare providers, AI developers, and policymakers, to establish clear guidelines and promote trustworthy AI systems. This review explores key regulatory and ethical concerns and highlights strategies to ensure the responsible integration of AI into ophthalmology.}
}
@article{FAROOQ2026104444,
title = {Evaluating and regulating agentic AI: A study of benchmarks, metrics, and regulation},
journal = {Information Fusion},
volume = {136},
pages = {104444},
year = {2026},
issn = {1566-2535},
doi = {https://doi.org/10.1016/j.inffus.2026.104444},
url = {https://www.sciencedirect.com/science/article/pii/S1566253526003246},
author = {Azib Farooq and Shaina Raza and Nazmul Karim and Hasan Iqbal and Athanasios V. Vasilakos and Christos Emmanouilidis},
keywords = {Agentic AI, Autonomous agents, Responsible AI, Evaluation frameworks, Benchmarks, Metrics, Governance, Trustworthiness, Human alignment, Multi-agent systems, Ethical AI, Reliability, Transparency, Auditable AI, AI evaluation},
abstract = {Agentic AI represents a new generation of Artificial Intelligence (AI) systems capable of perceiving, reasoning, planning, and acting toward achieving goals with a degree of autonomy. Unlike traditional AI models that merely generate outputs, these systems maintain memory, interact with their environment, and adapt over time. However, evaluating such interactive and evolving behavior remains a significant challenge. While several recent surveys have examined agentic AI architectures, components, and applications, few have systematically reviewed their evaluation, particularly with respect to performance, reliability, and governance across an evolving agentic AI ecosystem. This survey paper addresses that gap by reviewing recent progress in the evaluation and assessment of agentic AI, focusing on three core dimensions: benchmarks, metrics, and governance. We analyze how current evaluation frameworks capture reasoning, planning, collaboration, and ethical alignment across single- and multi-agent systems. Ultimately, this study aims to establish a unified foundation for building trustworthy, auditable, and human-aligned AI agents. Project Link}
}
@article{KO2025259,
title = {Security Strategy of Digital Medical Contents Based on Blockchain in Generative AI Model},
journal = {Computers, Materials and Continua},
volume = {82},
number = {1},
