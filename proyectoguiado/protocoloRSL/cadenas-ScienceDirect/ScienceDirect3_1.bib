@article{GENG2026112782,
title = {A white-box prompt injection attack on embodied AI agents driven by large language models},
journal = {Journal of Systems and Software},
volume = {235},
pages = {112782},
year = {2026},
issn = {0164-1212},
doi = {https://doi.org/10.1016/j.jss.2026.112782},
url = {https://www.sciencedirect.com/science/article/pii/S0164121226000166},
author = {Tongcheng Geng and Yubin Qu and W. Eric Wong},
keywords = {Embodied AI agent, Prompt injection attacks, Large language model, White-box attack},
abstract = {With the widespread deployment of embodied AI agents in safety-critical scenarios, LLM-based decision-making systems face unprecedented risks. Existing prompt injection attacks, designed for general conversational systems, lack semantic contextual adaptability for embodied agents and fail to address scenario-specific semantics and safety constraints. This paper proposes SAPIA (Scenario-Adaptive white-box Prompt Injection Attack), integrating an adaptive context prompt generation module with an enhanced GCG algorithm to dynamically produce scenario-targeted adversarial suffixes. We build a multi-scenario dataset of 40 dangerous instructions across four application domains–autonomous driving, robotic manipulation, drone control, and industrial control–establishing a standardized benchmark for embodied AI safety. Large-scale white-box experiments on three mainstream open-source LLMs show SAPIA substantially outperforms traditional GCG and improved I-GCG, with notably high effectiveness on extremely high-risk instructions. Transferability analysis reveals distinctive properties in embodied settings: cross-architecture transfer is extremely limited, while high cross-version transferability exists within model series, contrasting with cross-model transfer observed in conventional adversarial research. Ablation studies confirm both the adaptive context module and enhanced GCG are critical and synergistic for optimal attack performance. Robustness analyses indicate SAPIA strongly resists mainstream defenses, effectively evading input perturbation, structured self-examination, and safety prefix prompting. This work exposes serious security vulnerabilities in current embodied AI agents and underscores the urgency of scenario-based protection mechanisms for safety-critical deployments.}
}
@article{DASAKLIS2026124800,
title = {Large Language Models in human resource management: A systematic literature review of applications, open issues and future research directions},
journal = {Technological Forecasting and Social Change},
volume = {231},
pages = {124800},
year = {2026},
issn = {0040-1625},
doi = {https://doi.org/10.1016/j.techfore.2026.124800},
url = {https://www.sciencedirect.com/science/article/pii/S0040162526002775},
author = {Thomas K. Dasaklis and Panagiotis G. Giannopoulos and Dimitris Koutras and Vangelis Malamas and Panos T. Chountalas},
keywords = {Large language models (LLMs), Human resource management (HRM), Artificial intelligence (AI) in HRM, Systematic literature review},
abstract = {The rapid adoption of Artificial Intelligence (AI), particularly Large Language Models (LLMs), in Human Resource Management (HRM) is transforming core functions including recruitment and selection, training and development and performance evaluation. Although prior studies provide conceptual discussions, empirical findings and methodological debates on AI in HRM, existing reviews largely examine AI at a broad level and lack a unified synthesis of LLM-specific contributions, risks and governance implications. To address this gap, this paper presents a systematic literature review of LLM-enabled HRM that integrates both technical and theoretical perspectives into a common analytical framework. Specifically, we classify the retrieved literature along two intersecting axes: (a) the technical footprint of LLMs (discriminative versus generative models) mapped to concrete HRM functions and (b) the theoretical lenses underpinning LLM adoption and use across five major research streams. Based on this synthesis, we identify recurring limitations, unresolved tensions and open issues that require deeper context-sensitive investigation. We further provide governance check-lists for practitioners, researchers and regulators, alongside a four-lane roadmap and a six-point future research agenda. Overall, the review contributes a structured and LLM-specific conceptualization of AI-enabled HRM that connects technological capabilities, organizational implications and governance requirements. Converting LLM promise into trustworthy and equitable HRM practice will require co-evolving robustness metrics, layered human oversight and harmonized audit standards.}
}
@article{CHERNYSHEV2026302043,
title = {Large language models in digital forensics: capabilities, challenges and future directions},
journal = {Forensic Science International: Digital Investigation},
volume = {56},
pages = {302043},
year = {2026},
issn = {2666-2817},
doi = {https://doi.org/10.1016/j.fsidi.2025.302043},
url = {https://www.sciencedirect.com/science/article/pii/S2666281725001830},
author = {Maxim Chernyshev and Zubair Baig and Naeem Syed and Robin Doss and Malcolm Shore},
keywords = {Generative artificial intelligence, Large language models, LLM, Digital forensics},
abstract = {The rapid advancement of large language models (LLMs) has simultaneously created opportunities and challenges for digital forensic science. This survey systematically examines the emerging intersection between generative artificial intelligence and digital forensics through our analysis of 33 peer-reviewed works. We map LLM capabilities across the established Digital Forensic Research Workshop (DFRWS) process model, identifying three strategic integration points where these technologies demonstrate measurable benefits – pattern recognition during the examination phase, evidence analysis during the analysis phase, and evidence presentation and reporting during the presentation phase. Our findings show that LLMs achieve substantial performance improvements across diverse forensic tasks, but critical challenges persist, including the fundamental tension between the probabilistic nature of LLM outputs and deterministic forensic requirements, alongside concerns regarding explainability, reproducibility, and legal admissibility. We identify significant research gaps in validation frameworks, forensic-ready architectures, and standardised evaluation protocols. The survey establishes a comprehensive research agenda spanning technical, methodological, and legal domains, emphasising the necessity for interdisciplinary collaboration and human-AI collaborative approaches to preserve forensic integrity when leveraging LLM capabilities.}
}
@article{SATO2026,
title = {Addressing Prompt Injection in Large Language Models via In-Context Learning},
journal = {Computers, Materials and Continua},
volume = {87},
number = {2},
year = {2026},
issn = {1546-2218},
doi = {https://doi.org/10.32604/cmc.2026.078188},
url = {https://www.sciencedirect.com/science/article/pii/S1546221826002146},
author = {Go Sato and Shusaku Egami and Yasuyuki Tahara and Akihiko Ohsuga and Yuichi Sei},
keywords = {Large language models (LLMs), prompt injection, in-context learning (ICL), multi-agent system},
abstract = {While Large Language Models (LLMs) possess the capability to perform a wide range of tasks, security attacks known as prompt injection and jailbreaking remain critical challenges. Existing defense approaches addressing this problem face challenges such as the over-refusal of prompts that contain harmful vocabulary but are semantically benign, and the limited accuracy improvement in machine learning-based approaches due to the ease of distinguishing benign prompts in existing datasets. Therefore, we propose a multi-LLM agent framework aimed at achieving both the accurate rejection of harmful prompts and appropriate responses to benign prompts. Distinct from prior studies, the proposed method adopts In-Context Learning (ICL) during the learning phase, presenting a novel approach that obviates the need for computationally expensive parameter updates required by conventional fine-tuning. To demonstrate the proposed method’s capability for rapid and easy deployment, this study targets LLMs with insufficient alignment. In the experiments, macro-averaged binary classification metrics were used to comprehensively evaluate harmfulness detection. Experimental results using three LLMs demonstrated that the proposed method achieved performance that surpassed four baselines across all evaluation metrics for the target LLMs, evidencing significant effectiveness with an average improvement of 16.6 points in F1-score compared to the vanilla models. The significance of this study lies in the proposal of a novel approach based on ICL that does not require parameter updates. This framework offers high sustainability in practical deployment, as it allows for the adaptive enhancement of detection performance against continuously evolving attack methods solely through the accumulation of logs, without the necessity of retraining the LLM itself. By mitigating the trade-off between safety and utility, this research contributes to the implementation of robust LLMs.}
}
@incollection{TEDESCO2026127,
title = {7 - Privacy and security in large language models and data},
editor = {Anitha S. Pillai and Roberto Tedesco and Vincenzo Scotti},
booktitle = {Challenges and Applications of Generative Large Language Models},
publisher = {Morgan Kaufmann},
pages = {127-152},
year = {2026},
isbn = {978-0-443-33592-1},
doi = {https://doi.org/10.1016/B978-0-443-33592-1.00011-5},
url = {https://www.sciencedirect.com/science/article/pii/B9780443335921000115},
author = {Roberto Tedesco},
keywords = {Privacy, security, large language models, artificial intelligence, machine learning},
abstract = {This chapter explores privacy leaks and security misbehaviors affecting large language models (LLMs). The chapter outlines various attacks that can affect all stages of the LLM lifecycle and their effect on privacy. While there are mitigation strategies available, they must be implemented cautiously to avoid creating new vulnerabilities, and none of them can guarantee complete protection.}
}
@article{MUSAMIH2026131100,
title = {Blockchain for Large Language Models (LLMs): Applications, challenges, and framework implementation},
journal = {Expert Systems with Applications},
volume = {308},
pages = {131100},
year = {2026},
issn = {0957-4174},
doi = {https://doi.org/10.1016/j.eswa.2026.131100},
url = {https://www.sciencedirect.com/science/article/pii/S095741742600014X},
author = {Ahmad Musamih and Ibrar Yaqoob and Khaled Salah and Raja Jayaraman and Mohammed Omar},
keywords = {Blockchain, Large language models, Explainable AI, Trustworthy AI, Intelligent systems, Data governance},
abstract = {Large Language Models (LLMs) are increasingly embedded in intelligent systems across domains such as healthcare, finance, and smart infrastructure. However, their reliance on centralized data pipelines raises unresolved challenges concerning provenance, accountability, and verifiable trust. As the demand for transparent and regulation-aligned AI grows, these challenges have become central to the responsible deployment of intelligent systems. This review examines how blockchain technology can address them by introducing decentralized integrity, immutable audit trails, and cryptographic verification into the LLM lifecycle. Through a structured synthesis of current research, we identify conceptual and architectural gaps that limit trustworthy data management, inference authentication, and explainability. To bridge these gaps, a methodological framework is proposed that integrates blockchain mechanisms across the LLM pipeline using smart contracts, Merkle-based commitments, and decentralized storage. The framework’s feasibility is demonstrated through an illustrative prototype, confirming its practical applicability for building verifiable and transparent AI infrastructures. We further outline application domains such as healthcare, smart cities, Industry 4.0, and supply-chain management, where blockchain-anchored LLMs can enhance auditability and regulatory compliance. The review concludes by highlighting key insights and challenges for future research, emphasizing the need for decentralized attestation models, scalable verification protocols, and governance mechanisms that advance accountable and privacy-preserving intelligent systems.}
}
@article{MOIA2026100916,
title = {LLM in the middle: A systematic review of threats and mitigations to real-world LLM-based systems},
journal = {Computer Science Review},
volume = {61},
pages = {100916},
year = {2026},
issn = {1574-0137},
doi = {https://doi.org/10.1016/j.cosrev.2026.100916},
url = {https://www.sciencedirect.com/science/article/pii/S1574013726000250},
author = {Vitor Hugo Galhardo Moia and Igor Jochem Sanz and Gabriel Antonio Fontes Rebello and Rodrigo Duarte {de Meneses} and Briland Hitaj and Ulf Lindqvist},
keywords = {Cybersecurity, Threats, Risks, Mitigations, Defenses, Threat modeling, Generative AI, Large language models, LLM, Real-world deployment},
abstract = {The success and wide adoption of generative AI (GenAI), particularly large language models (LLMs), have attracted the attention of cybercriminals seeking to abuse models, steal sensitive data, or disrupt services. Moreover, providing security to LLM-based systems is a significant challenge, as both traditional threats to software applications and threats targeting LLMs and their integration must be mitigated. In this survey, we shed light on the security and privacy concerns of such LLM-based systems by performing a systematic review and comprehensive categorization of threats and defensive strategies considering the entire software and LLM life cycles. We analyze real-world scenarios with distinct characteristics of LLM usage, spanning from development to operation. In addition, threats are classified according to their severity level and the scenarios to which they pertain, facilitating the identification of the most relevant threats. Recommended defense strategies are systematically categorized and mapped to the corresponding life cycle phase and possible attack strategies they mitigate. This work paves the way for consumers and vendors to understand and efficiently mitigate risks during the integration of LLMs in their respective solutions or organizations. It also enables the research community to benefit from the discussion of open challenges and edge cases that may hinder the secure and privacy-preserving adoption of LLM-based systems.}
}
@article{YU2026100006,
title = {Artificial intelligence and large language models in laboratory medicine: Applications and future perspectives},
journal = {Integrated Diagnostics},
volume = {1},
number = {1},
pages = {100006},
year = {2026},
issn = {3117-5899},
doi = {https://doi.org/10.1016/j.intdia.2026.100006},
url = {https://www.sciencedirect.com/science/article/pii/S3117589926000065},
author = {Shaobo Yu and Xiao Gu and Yuzhen Gao and Feng Zhao and Jun Zhang},
keywords = {Large-scale AI models, Laboratory medicine, Multimodal data, Intelligent diagnostics},
abstract = {Large artificial intelligence (AI) models are advancing rapidly across scientific and technological fields. AI-enabled big-data methods are also expanding their scope through large-scale data processing and analysis. In laboratory medicine, intelligent diagnostics based on AI integration of multi-omics and multimodal data are becoming an important direction of research. By combining different data types, investigators aim to achieve more precise disease diagnosis. Meanwhile, a new generation of diagnostic agents has emerged, such as sequential diagnostic orchestrators. In simulated cases, benchmark datasets, and controlled multispecialty evaluations, some systems have achieved diagnostic accuracy approaching or exceeding that of non-specialist physicians. These findings indicate proof-of-concept potential for coordinated decision support, but they do not establish autonomous end-to-end clinical readiness. Moreover, the central role of AI in laboratory medicine is not merely to interpret an abnormal value. It is to support the entire testing process across the pre-analytical, analytical, and post-analytical phases. Key applications therefore include multimodal data interpretation, discovery of new diagnostic indicators, laboratory report generation, optimization of personalized reference intervals, and development of diagnostic AI agents. Major challenges remain, including data standardization, privacy and security, model interpretability, clinical validation, and post-deployment monitoring. Research that aligns laboratory medicine with advances in AI will be an important priority over the next decade.}
}
@article{JUN2026116609,
title = {Beyond question and answer: Practical applications of multimodal and multifunctional large language models in ophthalmology with a scoping review and future directions},
journal = {Engineering Applications of Artificial Intelligence},
volume = {186},
pages = {116609},
year = {2026},
issn = {0952-1976},
doi = {https://doi.org/10.1016/j.engappai.2026.116609},
url = {https://www.sciencedirect.com/science/article/pii/S0952197626028939},
author = {Hye Won Jun and Dongjin Nam and Joon Yul Choi and Tae Keun Yoo},
keywords = {Multimodal large language model, Multifunctional large language model, Artificial intelligence, Ophthalmic image analysis, Visual question answering, Clinical workflow support},
abstract = {Multimodal large language models (MLLMs) connect language understanding with image-based reasoning and are increasingly explored as artificial intelligence systems for ophthalmic image analysis, workflow support, research prototyping, and education. This scoping review synthesizes 21 peer-reviewed studies that moved beyond text-only question answering to evaluate visual question answering (VQA), domain-adapted or fine-tuned ophthalmic models, retrieval-augmented generation (RAG), and low- or no-code tools for analytics and prototype development. Across studies, the evidence suggests early feasibility for image-conditioned explanations, triage support, documentation assistance, structured data extraction, and rapid tool creation. However, the evidence base remains heterogeneous and preliminary, with mixed diagnostic performance, variable prompts and model versions, limited external validation, and persistent risks including reasoning errors, hallucinations, session variability, privacy concerns, and security threats. To illustrate potential workflows not yet fully covered by the literature, we also provide clearly labeled author-built demonstrations, which are non-evidentiary, for fundus and optical coherence tomography (OCT)-based VQA, optical character recognition (OCR) tabulation, code-free analytics, automated software programming, and web-based risk calculators. Future priorities include extending image-conditioned reasoning to additional ophthalmic modalities, strengthening RAG with curated corpora and provenance, evaluating few-shot and in-context learning for rare conditions, and using controlled generative imaging for education and data augmentation. Overall, MLLMs may support supervised ophthalmic artificial intelligence applications in selected clinical, research, and educational workflows. Clinical deployment will require external validation, prospective human-in-the-loop evaluation, standards-based workflow integration, privacy-preserving infrastructure, audit logging, cybersecurity, and post-deployment monitoring.}
}
@article{POKHREL2024686,
title = {An Adversarial Machine Learning Approach on Securing Large Language Model with Vigil, an Open-Source Initiative},
journal = {Procedia Computer Science},
volume = {246},
pages = {686-695},
year = {2024},
note = {28th International Conference on Knowledge Based and Intelligent information and Engineering Systems (KES 2024)},
issn = {1877-0509},
doi = {https://doi.org/10.1016/j.procs.2024.09.486},
url = {https://www.sciencedirect.com/science/article/pii/S1877050924025316},
author = {Kushal Pokhrel and Cesar Sanin and Md. Kowssar {Hossain Sakib} and Md Rafiqul Islam and Edward Szczerbicki},
keywords = {Adversarial Machine Learning, Large Language Model, Information Security, Prompt Injection, Synthetic Prompt Generation, Natural Language Processing},
abstract = {Several security concerns and efforts to breach system security and prompt safety concerns have been brought to light as a result of the expanding use of LLMs. These vulnerabilities are evident and LLM models have been showing many signs of hallucination, repetitive content generation, and biases, which makes them vulnerable to malicious prompts that raise substantial concerns in regard to the dependability and efficiency of such models. It is vital to have a complete grasp of the complex behaviours of malicious attackers in order to build effective strategies for protecting modern artificial intelligence (AI) systems through the development of effective tactics. The purpose of this study is to look into some of these aspects and propose a method for preventing devastating possibilities and protecting LLMs from potential threats that attackers may pose. Vigil is an open-source LLM prompt security scanner, that is accessible as a Python library and REST API, specifically to solve these problems by employing a sophisticated adversarial machine-learning algorithm. The entire objective of this study is to make use of Vigil as a security scanner. and asses its efficiency. In this case study, we shed some light on Vigil, which effectively recognises and helps LLM prompts by identifying two varieties of threats: malicious and benign.}
}
@article{LIU2027103361,
title = {Transforming remanufacturing automation with large language models: A forward-looking analysis with case studies},
journal = {Robotics and Computer-Integrated Manufacturing},
volume = {103},
pages = {103361},
year = {2027},
issn = {0736-5845},
doi = {https://doi.org/10.1016/j.rcim.2026.103361},
url = {https://www.sciencedirect.com/science/article/pii/S0736584526001833},
author = {Chang Liu and Sara Behdad and Prabhakar Pagilla and Xiao Liang and Minghui Zheng},
keywords = {Remanufacturing, Large language models, Automation},
abstract = {With growing concerns about resource scarcity and environmental degradation, remanufacturing of end-of-life (EoL) products within the circular economy is attracting increasing attention. Remanufacturing can preserve most of the original manufacturing value and materials while transforming EoL products into like-new condition. However, the variability and uncertainty of EoL products make remanufacturing highly dependent on human expertise. Although recent advances in robotics and artificial intelligence have improved automation in isolated remanufacturing tasks, existing methods are often task-specific and struggle to generalize to heterogeneous EoL conditions. Recently, large language models (LLMs) have demonstrated remarkable capabilities in learning from massive, unstructured datasets, generating expert-level output across various tasks, and communicating with humans in natural language for interpretation. These advantages can align closely with the complex demands of remanufacturing, thereby mitigating the reliance on specialized expertise. However, their roles and research progress in this domain remain underexplored. In this paper, we present a forward-looking review and analysis of the role of LLMs in remanufacturing automation, grounded in a brief critical review of existing LLM-related studies relevant to remanufacturing. Building on this foundation, we introduce ReManGPT as a conceptual framework and use three representative case studies to illustrate selected modules of the framework in practical remanufacturing scenarios. We also analyze three representative remanufacturing applications, electric vehicle batteries, electronic waste, and electric motors, to illustrate how the proposed framework could address their domain-specific challenges. Finally, we discuss the current barriers to deploying this framework in practice and outline future research directions, including LLM-assisted human operation and language–action models for robotic automation.}
}
@article{KIM2026132508,
title = {Conversational recommender systems with large language models: A review of current developments},
journal = {Expert Systems with Applications},
volume = {324},
pages = {132508},
year = {2026},
issn = {0957-4174},
doi = {https://doi.org/10.1016/j.eswa.2026.132508},
url = {https://www.sciencedirect.com/science/article/pii/S0957417426014211},
author = {Yeong-Hyeon Kim and Yoon-Sik Cho},
keywords = {Conversational recommender system, Large language models},
abstract = {Conversational Recommender System (CRS) aims to understand users’ real-time preferences through natural language interactions and provide personalized recommendations with explanations. The recent advent of Large Language Models (LLMs) has shown promising potential for effectively capturing users’ subtle and implicit preferences through human-like fluent interactions, leading to rapid progress in CRS research. Notably, the application of LLMs is expanding beyond the singular role of a recommendation engine, with multifaceted integrations across various components of the CRS architecture-such as data augmentation, system control, and evaluation. To systematize this diverse and rapidly evolving landscape, this survey provides the first comprehensive review of LLM-based CRS, categorizing research according to their utilization purposes and integration approaches. We classify and analyze three key paradigms: (1) LLM as Conversational Recommender, which directly utilizes LLMs as core recommendation engines; (2) LLM-Augmented CRS, which leverages LLMs to enhance specific system components and processes; (3) LLM-Assisted CRS Evaluation, which utilizes LLMs for user simulation and CRS performance assessment. We provide in-depth analysis by further subdividing each paradigm into detailed categories, discussing their key approaches and advancements. Furthermore, we analyze technical and ethical challenges and outline promising research directions for advancing LLM-based CRS development.}
}
@article{HAN20261470,
title = {Large language models for porous materials: from text mining to autonomous laboratory},
journal = {Digital Discovery},
volume = {5},
number = {4},
pages = {1470-1500},
year = {2026},
issn = {2635-098X},
doi = {https://doi.org/10.1039/d5dd00578g},
url = {https://www.sciencedirect.com/science/article/pii/S2635098X26000926},
author = {Seunghee Han and Taeun Bae and Junho Kim and Younghun Kim and Jihan Kim},
abstract = {Porous materials such as metal–organic frameworks (MOFs), covalent organic frameworks (COFs), zeolites, and porous carbons play central roles in gas storage, separation, catalysis, and environmental technologies. However, their design and discovery remain resource-intensive, relying heavily on expert intuition and fragmented knowledge distributed across the literature. Recent advances in large language models (LLMs) present new opportunities to accelerate these workflows by integrating scientific text mining, domain reasoning, and experimental planning. In this review, we outline the emerging role of LLMs across the porous materials research ecosystem. We first introduce the foundations of LLMs, followed by a discussion of NLP-based text mining for literature analysis. We then examine LLM adaptation including prompt engineering and fine-tuning, and autonomous research systems from human-in-the-loop to self-driving laboratories. For each domain, we summarize how LLM architectures are integrated with research systems, highlighting their applications, advantages, and limitations. Additionally, we discuss the current challenges of applying LLMs to porous materials, trade-offs between prompt engineering and fine-tuning, the influence of generation parameters such as temperature, and safety considerations in autonomous laboratory systems. Finally, we expect LLMs to advance toward multimodal reasoning, tighter integration with structured knowledge bases, and safer autonomous experimental workflows. Together, these developments suggest emerging LLM-driven paradigms that could transform the conceptualization, design, and synthesis of porous materials.}
}
@article{PELAEZGONZALEZ2026133534,
title = {A domain-based taxonomy of jailbreak vulnerabilities in large language models},
journal = {Neurocomputing},
volume = {683},
pages = {133534},
year = {2026},
issn = {0925-2312},
doi = {https://doi.org/10.1016/j.neucom.2026.133534},
url = {https://www.sciencedirect.com/science/article/pii/S0925231226009318},
author = {Carlos Peláez-González and Andrés Herrera-Poyatos and Cristina Zuheros and David Herrera-Poyatos and Virilo Tejedor and Francisco Herrera},
keywords = {AI safety, Jailbreak, LLMs, Model alignment},
abstract = {The study of large language models (LLMs) is a key area in open-world machine learning. Although LLMs demonstrate remarkable natural language processing capabilities, they also face several challenges, including consistency issues, hallucinations, and jailbreak vulnerabilities. Jailbreaking refers to the crafting of prompts that bypass alignment safeguards, leading to unsafe outputs that compromise the integrity of LLMs. This work specifically focuses on the challenge of jailbreak vulnerabilities and introduces a novel taxonomy of jailbreak attacks grounded in the training domains of LLMs. It characterizes alignment failures as arising from gaps in generalization, objectives, and robustness. Our primary contribution is a perspective on jailbreak, framed through the different linguistic domains that emerge during LLM training and alignment. This viewpoint highlights the limitations of existing approaches and enables us to classify jailbreak attacks in terms of the underlying model deficiencies they exploit. Unlike conventional classifications that categorize attacks based on prompt construction methods (e.g., prompt templating), our approach provides a deeper understanding of LLM behavior. We introduce a taxonomy with four categories—mismatched generalization, competing objectives, adversarial robustness, and mixed attacks— offering insights into the fundamental nature of jailbreak vulnerabilities. Finally, we present key lessons derived from this taxonomic study.}
}
@article{LIU2026104544,
title = {SEAttack: A self-evolving jailbreak attack to induce toxic responses for non-toxic queries in large language models},
journal = {Information Processing & Management},
volume = {63},
number = {3},
pages = {104544},
year = {2026},
issn = {0306-4573},
doi = {https://doi.org/10.1016/j.ipm.2025.104544},
url = {https://www.sciencedirect.com/science/article/pii/S0306457325004856},
author = {Huijun Liu and Shasha Li and Bin Ji and Xiaohu Du and Xiaopeng Li and Jun Ma and Jie Yu},
keywords = {Large language model, Adversarial attack, Prompt, Jailbreak, Toxicity},
abstract = {To prevent Large Language Models (LLMs) from being misused by bad actors, model developers delve into designing safety mechanisms to guarantee LLMs generate helpful, honest, and harmless responses. To disclose flaws in the safety mechanisms, researchers conduct adversarial attacks against LLMs to circumvent the safety mechanisms, which are called “jailbreak attack”. Existing jailbreak attacks solely focus on engineering toxic queries and adversarial prompts to induce LLMs to generate toxic responses, losing sight of the study starting from engineering non-toxic queries and adversarial prompts, which also plays an important role in disclosing flaws in safety mechanisms. To fill the research gap, we propose SEAttack, a self-evolving jailbreak attack method to induce LLMs to generate toxic responses for non-toxic queries. Given a non-toxic query, SEAttack initially generates a response, which is more likely to be non-toxic due to the safety mechanisms. Then, it uses multiple iterations of self-evolving to evolve the non-toxic response to a toxic one. To evaluate SEAttack, we construct JailChat, a dataset containing 3000 non-toxic queries. We drive SEAttack to attack eighteen state-of-the-art LLMs, including five closed-source and thirteen open-source LLMs. Experimental results demonstrate that SEAttack achieves up to 89.07 % attack success rate, revealing non-negligible flaws in LLMs’ safety mechanisms. Moreover, we track the changes in the safety mechanisms of four ChatGPT variants. Extensive analyses and human evaluation further validate the effectiveness and rationality of SEAttack.}
}
@incollection{PATRA2027157,
title = {Chapter 9 - Large language models in healthcare semantics},
editor = {Sonali Vyas and Samiya Khan and Priyadarsan Patra and Korhan Cengiz},
booktitle = {Intelligent Semantic Analysis for Healthcare},
publisher = {Academic Press},
pages = {157-176},
year = {2027},
isbn = {978-0-443-33512-9},
doi = {https://doi.org/10.1016/B978-0-443-33512-9.00009-3},
url = {https://www.sciencedirect.com/science/article/pii/B9780443335129000093},
author = {Priyadarsan Patra},
keywords = {Agentic workflows, Clinical AI safety, Clinical NLP, Hallucination mitigation, Healthcare semantics, Large language models, Medical ontologies, Multimodal GenAI, Prompt engineering, Retrieval-augmented generation, Small language models},
abstract = {The rapid emergence of generative artificial intelligence has fundamentally reshaped semantic representation in healthcare informatics. Traditionally, clinical semantics relied on symbolic knowledge structures — ontologies, controlled vocabularies, and rule-based mappings — to encode clinical meaning and ensure interoperability across health information systems. Large Language Models (LLMs) introduce a complementary paradigm in which semantic meaning is encoded within high-dimensional probabilistic embedding spaces learned from vast biomedical and natural language corpora. This chapter examines the role of LLMs and Small Language Models (SLMs) in capturing, interpreting, and generating clinically meaningful information from heterogeneous healthcare data, tracing their evolution from passive text generators into cognitive assistants capable of supporting clinical decision-making, diagnostic reasoning, and patient engagement. The chapter details the mechanics of Retrieval-Augmented Generation (RAG) as a principled solution to model hallucinations, grounding AI outputs in verifiable, continuously updated medical literature. A layered defense-in-depth strategy for hallucination mitigation is presented, encompassing self-reflection, ensemble cross-checking, and ontology-grounded knowledge graph guarding. Prompt engineering is examined as a tool for constraining probabilistic models toward structured, guideline-adherent clinical reasoning, and the strategic trade-offs between fine-tuning and RAG for domain adaptation are discussed. Adversarial threats such as prompt injection and data exfiltration are cataloged within a broader discussion of regulatory compliance — spanning HIPAA, the EU AI Act, and India's DPDP Act — and ethical deployment considerations, including algorithmic bias and transparency. The chapter concludes by examining agentic clinical workflows as the emerging frontier of clinical AI, where multi-step reasoning, evidence retrieval, and human oversight converge to deliver safer, more reliable healthcare systems.}
}
@article{JELODAR2026104390,
title = {Large language model (LLM) for software security: Code analysis, malware analysis, reverse engineering},
journal = {Journal of Information Security and Applications},
volume = {98},
pages = {104390},
year = {2026},
issn = {2214-2126},
doi = {https://doi.org/10.1016/j.jisa.2026.104390},
url = {https://www.sciencedirect.com/science/article/pii/S2214212626000207},
author = {Hamed Jelodar and Samita Bai and Parisa Hamedi and Hesamodin Mohammadian and Roozbeh Razavi-Far and Ali Ghorbani},
keywords = {Large language model, Software security, Source code analysis, Large concept model, Knowledge-Enhanced pretrained, Reverse engineering},
abstract = {Large Language Models (LLMs) have recently emerged as powerful tools in cybersecurity, offering advanced capabilities in malware detection, generation, and real-time monitoring. Numerous studies have explored their application in cybersecurity, demonstrating their effectiveness in identifying novel malware variants, analyzing malicious code structures, and enhancing automated threat analysis. Several transformer-based architectures and LLM-driven models have been proposed to improve malware analysis, leveraging semantic and structural insights to recognize malicious intent more accurately. This study presents a comprehensive review of LLM-based approaches in malware code analysis, summarizing recent advancements, trends, and methodologies. We examine notable scholarly works to map the research landscape, identify key challenges, and highlight emerging innovations in LLM-driven cybersecurity. Additionally, we emphasize the role of static analysis in malware detection, introduce notable datasets and specialized LLM models, and discuss essential datasets supporting automated malware research. This study serves as a valuable resource for researchers and cybersecurity professionals, offering insights into LLM-powered malware detection and defense strategies while outlining future directions for strengthening cybersecurity resilience.}
}
@article{YANG2026104020,
title = {Towards robust privacy unlearning in edge-hosted large language models via attack-aware preference optimization},
journal = {Journal of Systems Architecture},
volume = {181},
pages = {104020},
year = {2026},
issn = {1383-7621},
doi = {https://doi.org/10.1016/j.sysarc.2026.104020},
url = {https://www.sciencedirect.com/science/article/pii/S1383762126003383},
author = {Shuhan Yang and Peng Chen and Rongzhen Li and Shijing Hu and Hengqi Guo and Simon Fong and Qiang Duan},
keywords = {LLM-based edge intelligence, LLM unlearning, Privacy protection, Adversarial robustness, Preference optimization},
abstract = {Large language model (LLM)-based edge intelligence enables LLM services to run closer to users and data sources, reducing latency, bandwidth consumption, and privacy risks in a cloud–edge-client architecture. In such deployments, edge-hosted LLMs are often adapted with local enterprise or user data, such as customer records in financial services, which may later require removal to satisfy privacy regulations or user requests. However, simple storage deletion is insufficient as LLMs may still reveal memorized protected facts. Full retraining can remove such information but is too expensive for resource-constrained edge environments, while existing lightweight unlearning methods are often vulnerable to adversarial prompts that recover forgotten facts. To address these challenges, we propose Attack-Aware Preference Optimization (A2PO), a localized privacy unlearning framework for LLM-based edge intelligence. A2PO improves data removal robustness through three coordinated steps: attack-aware query augmentation, privacy-preserving response rewriting, and reference-anchored adapter preference optimization. This localized design eliminates cloud privacy data transmission and latency-intensive inference filters. Experiments on the TOFU benchmark with Llama-2-7B-chat and Llama-3.1-8B-Instruct show A2PO achieves forgetting F-scores of 0.89 and 0.95, respectively, preserving model utility and generation quality. Furthermore, A2PO provides stable adversarial protection over baselines and reduces update time by around 70% compared to full retraining, enabling efficient and privacy-preserving edge intelligence.}
}
@article{WAN2026115126,
title = {Large language models-driven fuzzing: A systematic survey},
journal = {Engineering Applications of Artificial Intelligence},
volume = {178},
pages = {115126},
year = {2026},
issn = {0952-1976},
doi = {https://doi.org/10.1016/j.engappai.2026.115126},
url = {https://www.sciencedirect.com/science/article/pii/S0952197626014090},
author = {Yuxian Wan and Minhuan Huang and Xiang Li and Yuanping Nie and Wenyu Zhen and Fan Zhong},
keywords = {Fuzzing, Large language models, Software security, Vulnerability discovery, Test generation, Prompt engineering},
abstract = {Conventional fuzzing techniques are hampered by a fundamental semantic gap, limiting their ability to generate inputs that can penetrate complex program logic and discover deep vulnerabilities. The recent advent of Large Language Models (LLM), with their sophisticated code understanding and generation capabilities, offers a paradigm shift to overcome this limitation, ushering in the new field of LLM-driven Fuzzing. To structure this burgeoning area, we present a comprehensive survey of LLM-driven fuzzing, covering 47 representative studies from 2022 to the present. We introduce a novel taxonomy that organizes the field by the role LLM play in the fuzzing lifecycle – namely test case generation and feedback loop optimization – and systematically review existing works, from fine-tuning and prompt engineering to Fusion strategies. Quantitatively, Prompt Engineering accounts for over one-third of surveyed methods, and Fusion approaches constitute another substantial portion, reflecting a field-wide shift toward training-free LLM utilization. Our analysis synthesizes the state of the art and identifies key challenges at the intersection of Artificial Intelligence (AI) and security, including the inherent tension between LLM inference latency and fuzzing throughput, the conflict between the semantic fidelity of LLM and the adversarial nature of fuzzing, and the granularity mismatch in feedback mechanisms. Finally, we chart a roadmap for future research, advocating for specialized lightweight models, multi-modal context fusion, and adaptive, intelligent fuzzing frameworks to accelerate innovation. This work provides a crucial knowledge map for researchers and practitioners aiming to advance this new frontier.}
}
@article{FAN2027105375,
title = {RP-LLM: A semantically conditioned cross-modal large language model framework for remaining useful life prediction},
journal = {Advanced Engineering Informatics},
volume = {77},
pages = {105375},
year = {2027},
issn = {1474-0346},
doi = {https://doi.org/10.1016/j.aei.2026.105375},
url = {https://www.sciencedirect.com/science/article/pii/S1474034626010670},
author = {Zimeng Fan and Lei Song and Naipeng Li and Yaguo Lei and Hongfei Wang and Xuzhi Li},
keywords = {Predictive maintenance, Remaining useful life prediction, Cross-modal learning, Large language models},
abstract = {Remaining useful life (RUL) prediction supports maintenance decision-making and risk control in industrial systems, but its performance is often limited by few-shot and cross-domain scenarios. Recent progress in large language models (LLMs) offers a flexible interface for instruction generation and contextual modeling. However, current LLM-based studies for RUL prediction either use large models as powerful regressors or rely on textualized signal descriptions, while the intermediate organization of degradation states before value generation remains insufficiently explored. To address this issue, this paper develops RP-LLM, a cross-modal large language model framework with health-state semantic conditioning for multivariate time series RUL prediction. RP-LLM first learns degradation representations through contrastive pretraining between time series windows and structured textual descriptions. It then maps these representations to an ordered health prototype space encoded by text, where the resulting membership distribution serves as a semantic bridge between temporal patterns and value generation. Finally, a Prompt Learner converts the prototype distribution into soft prompts, and an LLM adapted with LoRA generates structured RUL responses under a numeric-aware training objective. The framework is evaluated under few-shot and cross-domain transfer protocols on public battery and aero-engine datasets, together with a strict zero-shot case study on a private on-orbit cryocooler trajectory. Across the evaluated protocols, it achieves up to 27.1% lower prediction error while supporting natural-language RUL queries and structured textual prediction beyond conventional scalar regression.}
}
@article{GIRI20261168,
title = {Interactive multimodal quality assessment in laser powder bed fusion using vision-large language models},
journal = {Journal of Manufacturing Processes},
volume = {174},
pages = {1168-1181},
year = {2026},
issn = {1526-6125},
doi = {https://doi.org/10.1016/j.jmapro.2026.08.008},
url = {https://www.sciencedirect.com/science/article/pii/S1526612526007607},
author = {Sandesh Giri and Qiaojie Zheng and Xiaoli Zhang and Sen Liu},
keywords = {Additive manufacturing, Laser powder bed fusion, Vision-large language models, Defect analysis, Interactive interface, In-situ monitoring},
abstract = {This paper presents a vision-large language model (V-LLM) framework for interactive quality assessment in laser powder bed fusion (LPBF) additive manufacturing (AM). The system enables natural language querying of multimodal manufacturing data, including 3D geometry reconstruction, in-situ defect segmentation, and spatially-registered mechanical property data. The framework integrates high-resolution layer-wise imaging data from the Peregrine dataset at Oak Ridge National Laboratory with 3D geometric models and comprehensive defect classification results across 10 anomaly categories within a 12-class semantic segmentation schema. A V-LLM (Llama 3.2-Vision with 11B parameters) interprets user queries and generates contextual responses with on-demand visualizations including defect spatial maps, property details, and interactive 3D model exploration. The system demonstrated interactive exploration of 39 parts across 3500+ layers and achieved an overall 95% query interpretation accuracy across six functional categories. Natural language queries achieved accurate responses for defect identification, spatial distribution analysis, and multi-part comparisons without requiring specialized software expertise. Ablation studies across three system configurations demonstrate that domain-specific preprocessing, rather than the LLM backbone alone, drives system performance, increasing query success from 20% to 95% compared to direct data access. This represents one of the first implementations of a vision-large language model framework for LPBF AM quality assessment, bridging the gap between complex manufacturing data and human-interpretable insights. The framework demonstrates practical utility for process engineers, quality inspectors, and researchers in rapid defect identification, quantification, and data retrieval for quality inspection workflows.}
}
