@article{RASHEED2027113142,
title = {LLM-based multi-agent systems for code generation: A multi-vocal literature review},
journal = {Journal of Systems and Software},
volume = {244},
pages = {113142},
year = {2027},
issn = {0164-1212},
doi = {https://doi.org/10.1016/j.jss.2026.113142},
url = {https://www.sciencedirect.com/science/article/pii/S0164121226003754},
author = {Zeeshan Rasheed and Muhammad Waseem and Kai-Kristian Kemell and Mika Saari and Pekka Abrahamsson},
keywords = {Large language models, Multi-agent systems, Automation, Multi-vocal literature review},
abstract = {Large Language Models (LLMs) have enabled multi-agent systems to perform autonomous code generation for complex tasks. Despite the recent growth in research and industrial applications in this area, there is little work on synthesizing evidence from both academic and industrial sources to capture the current state of research on LLM-based multi-agent systems for code generation. To this end, we conducted a Multi-Vocal Literature Review (MLR), combining insights from both academia and industry, including peer-reviewed studies and grey literature. The aim of this study is to systematically synthesize and analyze existing knowledge on LLM-based multi-agent systems for code generation. Specifically, the review examines the motivations for their use, employed benchmarks and models, key challenges, proposed solutions, and potential directions for future research. We selected and reviewed 114 studies, and the key findings are: (1) the identified reasons for adopting multi-agent systems for code generation were classified into nine categories; (2) the models and evaluation benchmarks utilized across the studies were systematically analyzed to provide a structured overview of commonly adopted LLM configurations and assessment practices; (3) the reported challenges and corresponding solutions were synthesized into seven main categories and 26 subcategories; and (4) future research directions were identified and organized into six main categories and 18 subcategories. The results of this MLR will assist researchers and practitioners in pursuing further studies and supporting the real-world adoption of multi-agent systems in industrial settings.}
}
@article{KHAN2026102137,
title = {LLM-augmented semantic edge intelligence in wireless sensor networks and IoT: a review-led evidence synthesis and conceptual framework},
journal = {Internet of Things},
volume = {40},
pages = {102137},
year = {2026},
issn = {2542-6605},
doi = {https://doi.org/10.1016/j.iot.2026.102137},
url = {https://www.sciencedirect.com/science/article/pii/S2542660526002672},
author = {Koffka Khan},
keywords = {Wireless sensor networks, Internet of Things, Semantic communication, Edge intelligence, Large language models, Digital twins, Security, Permissioned blockchain, Device identity, Homomorphic encryption},
abstract = {Wireless sensor networks (WSNs) increasingly support sensing-to-decision loops in which the value of a transmission depends on task utility, freshness, uncertainty, privacy, and safety rather than on bit fidelity alone. This article presents a review-led evidence synthesis and, as a secondary contribution, an author-proposed conceptual framework; it does not report a validated control algorithm. The review analyzes a 178-record evidence corpus, complemented by seven separately logged mathematical-outlook references, across WSN and IoT foundations, semantic communication, TinyML and split inference, federated learning, generative AI, retrieval-augmented generation (RAG), digital twins, wireless foundation models, and language-model-assisted operations. The supplementary materials release a machine-readable extraction sheet with one row per record, a field codebook, a reference and screening ledger, qualification and completeness audits, and an integrity manifest. A work qualifies as LLM-augmented semantic edge intelligence only when an identifiable large language model (LLM) consumes task-relevant WSN/IoT state or operator intent and can affect sensing, communication, diagnosis, resource allocation, or control through a typed and auditable path. Under this boundary, only one retained work supplies direct E2 simulation evidence of an LLM-mediated communication or control path. Most LLM/RAG evidence is bridging or adjacent and remains at E0–E2. The synthesis therefore distinguishes the roles and maturity of the component technologies instead of treating them as an interchangeable stack. It identifies bounded examples of LLM/RAG utility in communication-policy generation, cross-task networking adaptation, global evidence synthesis, tool orchestration, and natural-language formulation for an external solver. It does not support a general claim of superiority over rules, exact optimization, structured retrieval, or task-specific machine learning and reinforcement learning. To translate the documented gaps into testable requirements, the article proposes an IoT-native reference architecture, a seven-axis taxonomy, a threat model, a formal synthesis and selection/cost model, typed cross-layer interface contracts, and an eight-phase benchmark protocol. These normative artifacts are proposed by the author. They are not established methods extracted from the corpus, consensus standards, a deployable solver or controller, or experimentally validated results. An explicitly hypothetical wildfire-monitoring case makes the formalism inspectable: it defines semantic distortion, normalizes and elicits the penalty weights, evaluates a finite candidate set under hard constraints, applies the non-dominance and LLM-admission rules, reports switch-point sensitivity, and exercises one LLM-to-optimizer interface contract. Its values are tutorial inputs, not measurements. A provenance audit separates cited evidence, author-defined review and coding constructs, conventional notation, and proposed framework artifacts. Each contribution is linked to measurable outcomes and a minimum support condition, but these quantities define future tests rather than imply new performance gains. An LLM is retained only when it closes a declared open-vocabulary or heterogeneous-knowledge capability gap, satisfies hard energy, deadline, privacy, safety, and verifier constraints, and provides positive incremental value over the strongest feasible simpler baseline. Resource-constrained nodes continue to handle sensing, routing, medium access control, and lightweight inference. Grounded LLM/RAG components operate at gateway, edge, cloud, or digital-twin tiers, and their outputs are limited to evidence-linked, tool-checked, reversible proposals. The review remains the evidentiary core; the conceptual framework converts its gaps into falsifiable design and evaluation requirements for future semantic IoT systems.}
}
@article{ZHAO2027115005,
title = {Exploring backdoor attack and defense algorithms in LLMS: Enhancing in-context learning security},
journal = {Pattern Recognition},
volume = {183},
pages = {115005},
year = {2027},
issn = {0031-3203},
doi = {https://doi.org/10.1016/j.patcog.2026.115005},
url = {https://www.sciencedirect.com/science/article/pii/S0031320326019692},
author = {Shuai Zhao and Zhongliang Guo and Luwei Xiao and Cong-Duy Nguyen and Yanhao Jia and Xinyi Wu and Luu Anh Tuan},
keywords = {Backdoor attack, Large language models, In-context learning, Backdoor defense, Model ensemble},
abstract = {In-context learning, a paradigm bridging the gap between pre-training and fine-tuning, has demonstrated high efficacy in several NLP tasks, especially in few-shot settings. Despite being widely applied, in-context learning is vulnerable to malicious attacks. In this work, we raise security concerns regarding this paradigm. Our studies demonstrate that an attacker can manipulate the behavior of large language models (LLMs) by poisoning the demonstration context, without the need for fine-tuning the model. Specifically, we design a new backdoor attack method, named ICLAttack, to target large language models based on in-context learning. Our method encompasses two types of attacks: poisoning demonstration examples and poisoning demonstration prompts, which can make models behave in alignment with predefined intentions. ICLAttack does not require additional fine-tuning to implant a backdoor, thus preserving the model’s generality. Crucially, we also explore a novel defense algorithm named ICLDefense aimed at ICLAttack, which utilizes model ensembles to defend against backdoor attacks. ICLDefense employs a lightweight auxiliary model to refine the outputs of LLMs through an ensemble-based strategy, achieving significant efficiency and scalability. Extensive experimental results across several language models, ranging in size from 1.3B to 180B parameters, demonstrate the effectiveness of our attack method, exemplified by a high average attack success rate of 95.0% across the three datasets on OPT models. Moreover, our ICLDefense algorithm substantially reduces the attack success rate compared to existing methods, while preserving model performance on the same settings.}
}
@article{ABUSALIH2025819,
title = {Using large language models for semantic interoperability: A systematic literature review},
journal = {ICT Express},
volume = {11},
number = {4},
