@article{LI2026117118,
title = {Adaptive multimodal prompt learning: Dynamic handling of missing modalities for robust emotion recognition},
journal = {Knowledge-Based Systems},
volume = {353},
pages = {117118},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.117118},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126018447},
author = {Jian Li and Junhui Gong and Junyi Chen and Ruoyu Chen and Yufan Wang and Yu Fu and Yuliang Zhao},
keywords = {Missing modality, Multimodal learning, Cross-modal attention, Parameter-efficient fine-tuning},
abstract = {Multimodal learning typically assumes all modalities are available during training and inference. However, challenges like equipment failure, privacy issues, and data corruption often result in missing modalities, which limits the performance of existing multimodal models. While past methods, including prompt learning, have attempted to address missing modality problems, they lack the dynamic adaptation needed to handle varying missing data effectively. To address this, we propose Adaptive Multimodal Prompt Learning (AMPL), which combines efficient fine-tuning of pre-trained unimodal models with dynamic prompt learning. AMPL builds upon standard fully-paired multimodal training data and does not demand additional unpaired samples. AMPL leverages available modalities to predict missing modality embeddings using dynamic prompts and cross-modal attention mechanisms, enabling seamless inference of missing data. This dynamic adaptation ensures more robust and accurate emotion recognition, even when certain modalities are missing. Compared to existing methods, AMPL introduces a dynamic adaptation layer, making it more efficient, scalable, and adaptable to real-world multimodal applications. Evaluations on three benchmark datasets show that AMPL consistently outperforms state-of-the-art methods in terms of both robustness and efficiency under missing modality scenarios.}
}
@article{GAO2024109557,
title = {Security threats to agricultural artificial intelligence: Position and perspective},
journal = {Computers and Electronics in Agriculture},
volume = {227},
pages = {109557},
year = {2024},
issn = {0168-1699},
doi = {https://doi.org/10.1016/j.compag.2024.109557},
url = {https://www.sciencedirect.com/science/article/pii/S0168169924009487},
author = {Yansong Gao and Seyit A. Camtepe and Nazatul Haque Sultan and Hang Thanh Bui and Arash Mahboubi and Hamed Aboutorab and Michael Bewong and Rafiqul Islam and Md Zahidul Islam and Aufeef Chauhan and Praveen Gauravaram and Dineshkumar Singh},
keywords = {Artificial intelligence, Agriculture, Adversarial example, Poisoning availability, Backdoor},
abstract = {In light of their remarkable predictive capabilities, artificial intelligence (AI) models driven by deep learning (DL) have witnessed widespread adoption in the agriculture sector, contributing to diverse applications such as enhancing crop management and agricultural productivity. Despite their evident benefits, the integration of AI in agriculture brings forth security risks, a concern further exacerbated by the comparatively lower security awareness among agriculture stakeholders. This position paper endeavors to amplify the security consciousness among stakeholders (e.g., end-users such as farmers and governmental bodies) engaged in the implementation of AI systems within the agricultural sector. In our systematic categorization of security threats to AI systems, we delineate three primary avenues of attack: (1) Adversarial Example Attacks, (2) Poisoning Attacks, and (3) Backdoor Attacks. Adversarial example attacks manipulate inputs during the model’s inference phase to induce incorrect predictions. Poisoning attacks corrupt the training data, compromising the model’s availability by indiscriminately degrading its performance on legitimate inputs. Backdoor attacks, typically introduced during the training phase, undermine the model’s integrity, enabling attackers to trigger specific behaviors or outputs through predetermined hidden patterns. An example of compromising AI integrity for malicious purposes is DeepLocker, highlighted by IBM researchers. A detailed examination of attacks in each category is provided, emphasizing their tangible threats to real-world agricultural applications. To illustrate the practical implications, we conduct case studies on specific agricultural applications, focusing on precise irrigation schedules and plant disease detection, utilizing authentic agricultural datasets. Comprehensive countermeasures against each attack type are presented to assist agriculture stakeholders in actively safeguarding their AI applications. Additionally, we address challenges inherent in securing agriculture AI and offer our perspectives on mitigating security threats in this context. This work aims to equip agriculture stakeholders with the knowledge and tools necessary to fortify their AI systems against evolving security challenges. The artifacts of this work are released at https://github.com/garrisongys/Casestudy.}
}
@article{SHI2026,
title = {SecuAudit: Integrity-Preserving Metadata Compliance Auditing for Secure Data Circulation in MCP-Enabled AI Agents},
journal = {Computers, Materials and Continua},
volume = {89},
number = {1},
year = {2026},
issn = {1546-2218},
doi = {https://doi.org/10.32604/cmc.2026.085633},
url = {https://www.sciencedirect.com/science/article/pii/S1546221826007496},
author = {Yufa Shi and Jiaxing Hu and Lipeng Wang and Rui Ma and Mengyao Wang and Zhijuan Jia},
keywords = {Privacy enhancing computing, secure data circulation, model context protocol, metadata compliance, decentralized data auditing},
abstract = {AI agents frequently access external files, databases, and application programming interfaces (APIs) through the Model Context Protocol (MCP). However, these external resources typically lie outside the security boundary of the agent. During data circulation, attackers can not only tamper with the external data but also manipulate critical metadata, such as access permissions, validity periods, and authorization scopes. Even when the underlying data remains intact, such attacks can cause proxies to ingest expired or policy-violating resources, leading to severe privacy breaches and risks of unauthorized execution. To address these challenges, we propose SecuAudit, a privacy-enhancing decentralized data auditing scheme tailored for the MCP architecture. Leveraging Shamir’s Secret Sharing mechanism, key management is securely decentralized across multiple servers, effectively mitigating sub-threshold collusion attacks. Furthermore, by introducing a supervised hash mechanism, dynamic access policies and metadata constraints are cryptographically bound to the user’s private keys and file tags. Finally, based on a carefully designed randomized challenge-response protocol, third-party auditor (TPA) can efficiently verify both data integrity and metadata compliance without accessing the sensitive raw data. Security analysis demonstrates that SecuAudit can effectively resist data forgery, metadata tampering, and sub-threshold collusion attacks under the defined threat model. Experimental results obtained from our implementation under the evaluated configurations show that: (i) at (t=30, m=59), SecuAudit reduces Keygen latency by 54.6% relative to our implementation of the Pedersen-based Threshold Label-Aggregating Remote Data Auditing scheme (Ped-TLARDA), while maintaining comparable online auditing performance; (ii) metadata binding introduces an average additional Signblock overhead of 2.5%; and (iii) the local EVM evaluation requires approximately 770 bytes of on-chain storage per file and 499,021 gas for the evaluated contract-interaction lifecycle; (iv) the theoretical cumulative detection probability for 1% data loss exceeds 99.9% after 23 independent audits, while all six implemented attack cases were detected in the controlled evaluation. These results indicate the feasibility of SecuAudit under the evaluated settings. In conclusion, SecuAudit establishes a feasible framework for secure data circulation under the evaluated deployment assumptions.}
}
@article{OSMAN2026105038,
title = {Governing the human-machine identity continuum: An integrated framework for cybersecurity risk management in financial services},
journal = {Computers & Security},
volume = {170},
pages = {105038},
year = {2026},
issn = {0167-4048},
doi = {https://doi.org/10.1016/j.cose.2026.105038},
url = {https://www.sciencedirect.com/science/article/pii/S0167404826002142},
author = {Muez Osman},
keywords = {Identity governance, Cybersecurity, Artificial intelligence, Financial services, Accountability, Zero trust, Authentication},
abstract = {The proliferation of artificial intelligence, robotic process automation, and agentic systems in financial services has created a structural governance gap that existing cybersecurity identity frameworks were not designed to address: the human-machine identity continuum. Where traditional identity governance separated human users and machine accounts into discrete, separately managed domains, contemporary financial technology environments increasingly feature hybrid agents - systems that act with delegated human authority, make autonomous decisions within policy bounds, and generate audit trails that conflate human intent with machine execution. This paper identifies the human-machine identity blur as a distinct and critical cybersecurity governance challenge, and proposes the first integrated framework specifically designed to govern identity across the full continuum from human-controlled to fully autonomous agents. Using a structured comparative methodology, the paper evaluates six established identity governance frameworks - NIST SP 800–63, ISO/IEC 27,001:2022, FIDO2/WebAuthn, FATF Recommendation 16, the Zero Trust Architecture model, and PSD2/Open Banking standards - against six governance dimensions derived from the human-machine identity literature. The analysis demonstrates that no existing framework addresses more than two of six dimensions necessary for governing hybrid identity systems, and that all six frameworks fail to address accountability attribution and adaptive assurance calibration - the two dimensions most critical for managing identity risk in AI-augmented financial environments. The proposed framework introduces four governance components: identity classification taxonomy, contextual assurance calibration, accountability attribution mechanisms, and adaptive governance feedback. Scenario-based validation across four financial services identity failure archetypes - automated payment fraud, AI advisory overreach, deepfake social engineering, and insider-AI collusion - demonstrates that cross-layer identity governance misalignment explains systemic failures more completely than technical control analysis alone. The framework provides actionable guidance for cybersecurity practitioners, compliance officers, and regulators governing identity risk in AI-augmented financial services environments.}
}
@article{ZENG2026113959,
title = {Heterogeneous Patent Graph Prompt Learning},
journal = {Engineering Applications of Artificial Intelligence},
volume = {167},
pages = {113959},
year = {2026},
issn = {0952-1976},
doi = {https://doi.org/10.1016/j.engappai.2026.113959},
url = {https://www.sciencedirect.com/science/article/pii/S095219762600240X},
author = {Xi Zeng and Pei-Yuan Lai and Chang-Dong Wang and Qing-Yun Dai},
keywords = {graph prompt learning, heterogeneous patent graphs, patent clustering, metapath, prompt learning},
abstract = {Heterogeneous graph neural networks (HGNNs) are powerful tools for heterogeneous graph mining, yet they face critical limitations when applied to cold-start patent analysis scenarios: existing HGNNs rely on predefined metapaths with poor cross-domain generalization, fail to align pre-training and downstream tasks, and perform poorly with limited labeled data; prompt-based graph methods, originally designed for homogeneous graphs, cannot capture the complex heterogeneous semantics inherent in patent data. To address these issues, this paper proposes Heterogeneous Patent Graph Prompt Learning (HPGPL), a graph framework that integrates heterogeneous graph neural networks with prompt learning to tackle cold-start challenges in patent classification and clustering. HPGPL constructs heterogeneous patent graphs by connecting application numbers, patentees, and claim keywords via bidirectional relationships, effectively linking diverse patents across technical domains. It learns transferable metapath semantics through self-supervised pre-training and adapts to downstream tasks using learnable prompt vectors, eliminating the need for metapath adjustment and full model retraining. Experiments on four real-world datasets show HPGPL outperforms state-of-the-art baselines, it achieves an average 19.34% gain in patent clustering, a 4.37% average gain in patent classification, and a maximum 111.53% improvement in Adjusted Rand Index (ARI) under cold-start conditions. This framework effectively overcomes label scarcity in patent analysis, enhancing generalization across technical domains and providing a practical solution for intellectual property knowledge discovery.}
}
@article{SEGOVIAHERNANDEZ2026110841,
title = {The AI–PI nexus: Leveraging artificial intelligence for industrial process intensification–Applications, challenges, and future potential},
journal = {Chemical Engineering and Processing - Process Intensification},
volume = {225},
pages = {110841},
year = {2026},
issn = {0255-2701},
doi = {https://doi.org/10.1016/j.cep.2026.110841},
url = {https://www.sciencedirect.com/science/article/pii/S0255270126001455},
author = {Juan Gabriel Segovia-Hernández and Maricruz Juárez-García and Jesús Manuel Núñez-López and Enrique Cossio-Vargas and Eduardo Sánchez-Ramírez},
keywords = {Artificial intelligence, Process intensification, Industrial automation, Smart manufacturing},
abstract = {The integration of Artificial Intelligence (AI) with Process Intensification (PI) offers significant potential to enhance efficiency, sustainability, and operational flexibility in process industries. This work presents a structured critical review of AI applications in intensified processes, combining a systematic screening of recent literature with the analysis of representative industrial case studies. The methodology involves the classification of reported contributions according to application domain, AI technique and Technology Readiness Level (TRL), enabling the identification of gaps between academic developments and industrial deployment. Selected case studies, including AI-assisted optimization of dividing wall columns, predictive maintenance in petrochemical systems, real-time quality control in continuous pharmaceutical manufacturing, and adaptive optimization in biorefineries, demonstrate improvements in energy efficiency (10–30%), reduction of off-spec products (up to 70%), and enhanced process robustness under variable operating conditions. Despite these advances, most implementations remain at intermediate TRLs due to limitations in data infrastructure, model generalization, cybersecurity, and workforce capabilities. The analysis reveals that the lack of standardized validation frameworks and digital integration remains a key bottleneck for large-scale adoption. To overcome these challenges, this work proposes strategic directions focused on hybrid modeling approaches, standardized data architectures, and AI integration within process safety and control frameworks.}
}
@article{SAHOO2027101069,
title = {Artificial general intelligence architectures and evaluation methodologies: A comprehensive review and future research roadmap},
journal = {Computer Science Review},
volume = {63},
pages = {101069},
year = {2027},
issn = {1574-0137},
doi = {https://doi.org/10.1016/j.cosrev.2026.101069},
url = {https://www.sciencedirect.com/science/article/pii/S1574013726001772},
author = {Kailasha Chandra Sahoo and Aurobindo Kar and Vineeta Khemchandani},
keywords = {Artificial general intelligence, Systematic review, Cognitive architectures, Neuro-symbolic systems, AGI evaluation benchmarks, Value alignment},
abstract = {Artificial General Intelligence (AGI) seeks to create machines with broad, human-like cognition. However, rapid advances in narrow AI make it clear that general intelligence remains unresolved. This systematic review synthesises AGI research in five dimensions: definitions, enabling technologies, envisioned applications, evaluation methodologies, and open challenges. We performed a systematic search of major academic databases and search engines up to January 2026. After deduplication, two reviewers independently screened 927 records and included 393 studies that met the predefined criteria. We extracted data to address five research questions for each dimension and conducted a qualitative synthesis, as the evidence base did not support a meta-analysis. Across the literature, AGI is primarily characterised by broad adaptability and cross-domain generalisation. The main approaches include symbolic knowledge-based methods, machine learning, cognitively inspired architectures, hybrid neuro-symbolic systems, and brain-inspired or theoretical models Raman et al. (2025) [302]; each contributes partial capabilities, but exhibits limitations in isolation. The proposed application areas include healthcare, education, finance, transportation, smart cities, defence, scientific research, and more. Evaluation practices span multidimensional scales, cognitive test batteries, and safety-oriented benchmarks for alignment and autonomy. However, many benchmarks are saturated rapidly and do not fully capture real-world generality. Persistent challenges include the absence of a unified empirical theory of intelligence; the integration and scalability of heterogeneous methods; symbol grounding and embodiment; value alignment and control of highly capable agents; and the development of rigorous yet comprehensive evaluation protocols. In general, AGI research remains fragmented, with no approach that demonstrates the full spectrum of general cognitive competence. We operationalise “integration” as a system-level property in which learning, reasoning, memory, and social-ethical constraints are coupled through shared representations and closed-loop control so that each component can shape the others during task execution. We also describe two integrative candidate architectures proposed in the literature: (i) a Self-Evolving Binary-Symbolic AGI framework and (ii) the Cohomological Active Inference Architecture (CAIA). Whether a proposed architecture achieves this integration can be measured empirically using multidimensional AGI benchmarks and safety or alignment evaluations discussed in AGI assessment methodologies.}
}
@article{FRUEHAUF2026103255,
title = {User perspectives on LINK: A generative AI chatbot for academic libraries},
journal = {The Journal of Academic Librarianship},
volume = {52},
number = {4},
pages = {103255},
year = {2026},
issn = {0099-1333},
doi = {https://doi.org/10.1016/j.acalib.2026.103255},
url = {https://www.sciencedirect.com/science/article/pii/S0099133326000571},
author = {Evan Fruehauf and LeEtta Schmidt and Amanda Boczar},
keywords = {Generative AI, Chatbot, Academic libraries},
abstract = {This article presents a case study on the development, phased testing, and user evaluation of Library Information & Knowledge (LINK), a generative AI–enabled library chatbot created by the University of South Florida Libraries. Built using Microsoft Copilot Studio, LINK integrates conversational AI with structured knowledge documents to extend library services, improve efficiencies, and support user navigation of library resources. Development required extensive groundwork, including web content mapping, knowledge base restructuring, and iterative refinement informed by internal staff, faculty, and student testing. An IRB-approved survey captured user perceptions of ease of use, accuracy, usefulness, and trust. Respondents valued LINK’s 24/7 availability and conversational flexibility, but noted limitations tied to its ethical design constraints, particularly its inability to access licensed databases. These findings reflect broader trends in the literature, which highlight the tension between user expectations and the actual capabilities of AI chatbots in academic settings. The study identifies priorities for future development, including reducing the database access gap, expanding knowledge coverage, improving accuracy with structured and source-linked responses, and strengthening pathways to human assistance. Despite technical and structural challenges, the project demonstrates how low-code generative AI tools can enhance academic library service ecosystems while reinforcing transparency and user trust.}
}
@article{ALSHAMRANI2026105,
title = {Zero-shot attack detection in UAV networks using foundation models},
journal = {Alexandria Engineering Journal},
volume = {136},
pages = {105-124},
year = {2026},
issn = {1110-0168},
doi = {https://doi.org/10.1016/j.aej.2025.12.065},
url = {https://www.sciencedirect.com/science/article/pii/S1110016825012463},
author = {Adel Alshamrani and Ahmed M. Alghamdi},
keywords = {UAV cybersecurity, Intrusion detection, Zero-shot learning, Foundation models, Cross-modal attention},
abstract = {Traditional intrusion detection systems require extensive training data for each attack type, creating vulnerabilities in UAV networks where novel threats frequently emerge. We present ZeroUAV, a zero-shot attack detection framework using foundation models to identify unseen attack patterns without labeled examples. Our transformer-based architecture employs cross-modal attention to align network traffic with semantic attack descriptions, enabling classification based on conceptual similarity. The framework incorporates attack ontology, contrastive learning, and meta-learning for rapid adaptation. Evaluation on UAV-NIDD dataset shows 87.3 % zero-shot accuracy and 94.6 % accuracy with five examples per attack type, significantly outperforming supervised methods. The system achieves under 10 ms inference latency for real-time UAV deployment. Our contributions include the first foundation model for UAV cybersecurity, a novel zero-shot learning framework, and validation demonstrating practical viability for evolving threat landscapes.}
}
@article{JU2027110247,
title = {A patent-driven SCOR-IFCM framework to prioritize generative AI adoption for supply chain resilience},
journal = {International Journal of Production Economics},
volume = {303},
pages = {110247},
year = {2027},
issn = {0925-5273},
doi = {https://doi.org/10.1016/j.ijpe.2026.110247},
url = {https://www.sciencedirect.com/science/article/pii/S0925527326003385},
author = {Chunhua Ju and Ke Li and Chonghuan Xu and Hongli Liu},
keywords = {Generative AI adoption, Supply chain resilience, Intuitionistic fuzzy cognitive maps, SCOR model, Technological risks, Patent mining},
abstract = {Generative artificial intelligence (Gen AI) has considerable potential to enhance supply chain resilience (SCR), but its effective adoption remains subject to technological uncertainty. This study integrates BERTopic, the Supply Chain Operations Reference (SCOR) model, intuitionistic fuzzy sets (IFS), and clamped intuitionistic fuzzy cognitive map (IFCM) simulation to develop a patent-driven framework for screening and prioritizing potential Gen AI applications. Based on 139,661 Gen AI patent abstracts associated with Chinese listed firms, the framework identifies 870 fine-grained technology topics, maps them onto 29 SCOR-oriented nodes, and uses patent-text evidence to construct a technology propagation structure and a 29×5 technology-performance allocation matrix. Four main findings emerge. First, patent portfolio analysis focuses on enabling, data-processing, and infrastructure capabilities, with semantic evidence linking these capabilities to SCR dimensions such as reliability, responsiveness, agility, cost, and asset management. Second, counter- and unresolved evidence reveal constraining pathways, with negative propagation concentrated in limited cross-node relationships. Third, sustained support for selected driver nodes creates selective spillovers rather than uniform gains; under the soft-clamped scenario, engineering quality and progress management, order lifecycle management, and intelligent logistics path planning achieve the highest non-driver activation. Fourth, SCOR contributions depend jointly on steady-state activation and patent-semantic associations, so strong semantic support alone does not guarantee high modeled contribution. Overall, the framework provides patent-evidence-based decision support for screening candidate technologies, prioritizing staged evaluation, and comparing conditional SCOR performance profiles.}
}
@article{LI2027135143,
title = {DynaCLIP: Dynamic prompt alignment and hierarchical semantic aggregation for zero-shot industrial anomaly detection},
journal = {Neurocomputing},
volume = {708},
pages = {135143},
year = {2027},
issn = {0925-2312},
doi = {https://doi.org/10.1016/j.neucom.2026.135143},
url = {https://www.sciencedirect.com/science/article/pii/S0925231226025415},
author = {Yuxi Li and Haitao Wu and Ziqi Liu and Xiaobo Chen and Juntong Xi},
keywords = {Zero-shot anomaly detection, Vision-language models, Adaptive prompt alignment, Hierarchical semantic aggregation},
abstract = {Zero-shot anomaly detection (ZSAD) based on vision-language models has shown strong cross-category transferability, making it attractive for open-world inspection scenarios. In this work, zero-shot refers to zero target-domain supervision: DynaCLIP is trained on labeled source-domain anomaly data and evaluated on unseen target categories and datasets without target images, labels, or masks during training. However, when CLIP is directly applied to this setting, it often aligns global object semantics more reliably than it aligns subtle local defects, leading to insufficient pixel-level localization accuracy. To address this issue, we propose DynaCLIP, a dynamic CLIP-based framework that performs sample-adaptive semantic alignment at inference time. DynaCLIP contains three tightly coupled components: (i) Localized Attention Enhancement (LAE), which re-focuses visual attention on defect-relevant regions; (ii) Adaptive Prompt Alignment (APA), which generates dynamic text–visual prompts conditioned on each input image; and (iii) Hierarchical Semantic Aggregation (HSA), which consolidates multi-scale anomaly cues by selecting the most anomalous patches and semantically grouping them with K-Means. On MVTec AD, DynaCLIP obtains 91.7%/96.4% image-level AUROC/AP and 93.3%/85.6% pixel-level AUROC/PRO; on VisA, it obtains 86.1%/89.9% image-level AUROC/AP and 96.0%/87.2% pixel-level AUROC/PRO. It also achieves 98.40% AUROC and 99.65% AP on a real-world high-speed railway defect dataset, showing practical potential for railway inspection. The code is available at https://github.com/cloudesean/DynaCLIP_.}
}
@article{ALHASHIMI2025100509,
title = {Exploring the role of generative AI in enhancing cybersecurity in software development life cycle},
journal = {Array},
volume = {28},
pages = {100509},
year = {2025},
issn = {2590-0056},
doi = {https://doi.org/10.1016/j.array.2025.100509},
url = {https://www.sciencedirect.com/science/article/pii/S2590005625001365},
author = {Hussein A. Al-Hashimi and Rafiq Ahmad Khan and Hathal S. Alwageed and Asaad M. Algarni and Sarra Ayouni and Alaa Omran Almagrabi},
keywords = {Generative artificial intelligence, Cybersecurity, Software development lifecycle, Risks and practices, Systematic literature review, Survey},
abstract = {Context
The rapid integration of Generative AI (GenAI) technologies in various sectors has introduced new opportunities and challenges. One of the areas where GenAI is gaining prominence is cybersecurity, particularly within the Software Development Life Cycle (SDLC). As cyber threats evolve, there is a growing need to explore innovative solutions to mitigate vulnerabilities during software development.
Objectives
This study investigates the role of GenAI in enhancing cybersecurity in the SDLC. It examines current security practices, recent advancements in AI-driven security solutions, and the potential of GenAI to strengthen threat detection, vulnerability management, and risk mitigation. Additionally, the research identifies key opportunities and challenges associated with integrating GenAI into SDLC processes, highlighting its implications for secure software development and future industry practices.
Methods
This research employs a mixed-methods approach to investigate the role of GenAI in cybersecurity. Specifically, it combines a Systematic Literature Review (SLR) with questionnaire-based data collection targeting software development and cyber defense experts. The SLR aims to identify prevailing themes and gaps, while the questionnaire gathers insights from IT professionals about their experiences and perspectives on GenAI systems.
Results
Our research shows that GenAI technology enhances SDLC security by supporting development through vulnerability detection, threat modeling, secure coding practices, and incident response. However, our review shows that AI adoption introduces ethical risks alongside reliability issues with AI-created results and challenges to integrate it into standard development methods.
Conclusion
The integration of GenAI into the SDLC offers significant potential for enhancing cybersecurity. While challenges such as algorithm transparency and the need for skilled professionals remain, the benefits of AI in proactive threat detection and response make it a promising tool for future cybersecurity strategies in software development.}
}
@article{CANEDO2026105026,
title = {Cybersecurity risks, DevSecOps challenges, and emerging security priorities: An empirical study across Brazilian organizations},
journal = {Computers & Security},
volume = {170},
pages = {105026},
year = {2026},
issn = {0167-4048},
doi = {https://doi.org/10.1016/j.cose.2026.105026},
url = {https://www.sciencedirect.com/science/article/pii/S0167404826002026},
author = {Edna Dias Canedo and Stefano Luppi Spósito and Laerte Peotta and Rafael Rabelo Nunes and Marcelo Ladeira},
keywords = {Cybersecurity governance, Secure software development, DevSecOps, AI security, Cyber resilience},
abstract = {Context:
Cybersecurity has become increasingly intertwined with organizational resilience, digital transformation, and regulatory pressure. Yet, many institutions still struggle to assess their structural risks, integrate secure-by-design practices, and prepare for emerging technologies such as AI-enabled cyber operations.
Goal:
This study aims to examine how Brazilian organizations perceive their cybersecurity posture across three dimensions: (i) infrastructure and governance risks, (ii) secure software development and DevSecOps challenges, and (iii) strategic priorities for emerging cybersecurity research and innovation.
Method:
We conducted a mixed-method survey with 88 practitioners from public, private, and critical infrastructure sectors. The instrument combined Likert scale assessments, multiple choice questions, and open-ended items. Quantitative data were analyzed using descriptive statistics, and qualitative responses were examined using inductive coding and thematic analysis.
Results:
Organizations report structural vulnerabilities linked to supply-chain dependencies, legacy systems, governance gaps, insider threats, and insufficient patch and vulnerability management. Challenges in secure development center on data exposure, limited security culture and training, insufficient security automation within Continuous Integration and Continuous Deployment (CI/CD) pipelines, and fragmented compliance integration. Emerging priorities include adversarial machine learning, AI security, cloud and hybrid architecture protection, cyber resilience, Governance, Risk, and Compliance (GRC) modernization, and Zero Trust adoption.
Conclusion:
Findings reveal systemic cybersecurity weaknesses and uneven DevSecOps maturity across sectors, underscoring the need for stronger governance, continuous workforce development, and resilience oriented security architectures. The study also identifies strategic research directions particularly in AI security, supply-chain defense, and cloud resilience that can guide national cybersecurity capacity building and policy making initiatives. This study also provides an evidence-based foundation to guide capability building programs, governance modernization, and future research collaborations across the Brazilian cybersecurity ecosystem.}
}