@inproceedings{10.1145/3699682.3727572,
author = {Ferrato, Alessio},
title = {Integrating Indoor Positioning, Recommendation, and Personalization to Enhance Museum Visitor Experiences},
year = {2025},
isbn = {9798400713132},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3699682.3727572},
doi = {10.1145/3699682.3727572},
abstract = {Personalization in Cultural Heritage (CH) settings is crucial for transforming visitor experiences into meaningful interactions accommodating diverse expectations and preferences. This research presents a holistic framework to enhance visitor experiences in CH physical institutions, like Galleries, Libraries, Archives, and Museums, through the combination of Indoor Positioning Systems (IPS), Recommender Systems, and Large Language Models (LLMs). Our Bluetooth beacon-based IPS implementation has been successfully deployed in a major gallery in Rome. The system covers 17 rooms and over 100 artworks and provides the user’s position with high accuracy. We conceptualized a recommendation algorithm to optimize visitor engagement by progressively increasing mean dwell time while considering spatial and temporal constraints. Moreover, our experiments with LLM-generated audioguides demonstrate that visitors prefer content tailored to established visitor categories, validating our approach to personalization. These findings provide empirical support for personalized digital interpretation in GLAM contexts, though challenges remain regarding IPS precision over time and LLM hallucination mitigation. Future work will focus on collecting visitor interaction data, implementing the recommender system, and potentially releasing datasets to address the scarcity of CH-specific positioning and recommendation data.},
booktitle = {Proceedings of the 33rd ACM Conference on User Modeling, Adaptation and Personalization},
pages = {388–392},
numpages = {5},
keywords = {Personalization, Indoor Positioning System, Bluetooth, Recommender System, Large Language Models, Cultural Heritage},
location = {New York City, USA},
series = {UMAP '25}
}

@inproceedings{10.1145/3819765.3819778,
author = {Ye, Qiangqiang and Jiang, Rui},
title = {Tri-Color Guard: Securing Large-Scale Network Infrastructures via Semantics-Enhanced Incremental Vulnerability Detection},
year = {2026},
isbn = {9798400725234},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3819765.3819778},
doi = {10.1145/3819765.3819778},
abstract = {Modern network infrastructures face a critical security dilemma: exhaustive vulnerability scanning is too slow for continuous integration and delivery pipelines, while file-level incremental scanning suffers from “semantic blind spots”, leading to severe false negatives. We propose Tri-Color Guard, a semantics-enhanced incremental framework to break this dichotomy. By combining syntax node equivalence filtering with a novel tri-color state machine, it achieves (O( Delta ) ) efficiency, effectively identifying functions perturbed by code changes. To resolve static analysis limitations, we leverage large language models to distill implicit inter-procedural behaviors, enabling cross-modal neural reasoning via CodeBERT. Evaluations on the DIVE dataset and BigVul benchmark demonstrate that Tri-Color Guard significantly boosts the efficacy of underlying detectors. By injecting structured semantic summaries, the framework improves the F1-score of baseline neural models by up to 2.83%. Furthermore, the collaborative architecture ensures that the scan volume is shrunk from over 29,000 functions to merely 2.03 per commit while maintaining detection integrity. The results indicate that Tri-Color Guard effectively bridges semantic gaps in evolving codebases, providing an efficient and enhanced auditing paradigm for large-scale network software.},
booktitle = {Proceedings of the 2026 2nd International Conference on Communication Technology and Data Security},
pages = {86–91},
numpages = {6},
keywords = {Incremental Vulnerability Detection, Large Language Models, Semantic Completion},
location = {Guangzhou, China},
series = {CTADS 2026}
}

@inproceedings{10.1145/3786579.3804938,
author = {Rodriguez, Danissa V and Mastrianni, Angela and Andreadis, Katerina and Xu, Lynn and Gonzalez, Javier and Chen, Ji and Mann, Devin},
