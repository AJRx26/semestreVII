address = {New York, NY, USA},
abstract = {Welcome to the 1st International Workshop on Agentic Engineering (AGENT 2026), co-located with the 48th International Conference on Software Engineering (ICSE 2026).Agentic Engineering is an emerging discipline focused on the design, development, and operation of systems that exhibit goal-directed autonomy. While Foundation Models (FMs) have significantly accelerated progress in this area, transitioning these models into reliable, production-ready systems requires rigorous software engineering.},
