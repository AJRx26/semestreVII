abstract = {We present the AI Brain, a GenAI layer integrated into a remote patient monitoring program to support patient engagement and clinical documentation. Developed as an operational initiative in a large academic medical center in New York, this system emphasizes access, security, and clinical integration as main requirements. We describe lessons learned from deploying a fully automated GenAI tool in a real-world clinical setting, highlighting the importance of usefulness, trust-building, and continuous monitoring.},
booktitle = {Proceedings of the 2026 ACM Interactive Health Conference},
articleno = {47},
numpages = {5},
keywords = {GenAI, Remote Patient Monitoring, Hypertension, Digital Healthcare},
location = {Porto, Portugal},
series = {IH '26}
}

