@proceedings{10.1145/3733802,
editor = {Jianying Zhou, Dani{\"e}l Reijsbergen and Eyasu Getahun Chekole},
title = {WPES '25: Proceedings of the 24th Workshop on Privacy in the Electronic Society},
year = {2025},
isbn = {9798400718984},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
abstract = {It is with great pleasure that I reflect on my role as Program Committee Chair for WPES 2025. The success of this conference is a testament to the collective dedication and tireless efforts of many individuals. First and foremost, I extend my heartfelt gratitude to all the authors whose innovative research and contributions form the foundation of this year's program. I am equally indebted to the Program Committee members and reviewers, whose expertise, rigor, and commitment ensured the high quality of the accepted submissions. Your thoughtful evaluations and constructive feedback have been invaluable. I would like to particularly thank the Publication Chair, Dani{\"e}l Reijsbergen, for taking care of the proceedings, and the Web Chair, Eyasu Getahun Chekole, for creating and maintaining the conference website. Finally, I wish to express my sincere appreciation to the steering committee for their guidance and support throughout this journey. Their leadership has been crucial in navigating challenges and realizing our goals.It is with great excitement that we see such a large number of high-quality submissions from all over the world. Many submissions present novel contributions related to real-world aspects of digital privacy, demonstrating accessible and compelling results to general computer security researchers. A total of 37 submissions were received, of which 31 were full papers and 6 were short papers. After a rigorous review process, 18 submissions were accepted for publication, of which 15 were full papers (acceptance rate: ≈48.39%) and 3 were short papers (acceptance rate: 50%). As such, the total acceptance rate was ≈48.64%. For the first time, WPES will feature a best paper award: the result will be announced at the closing session of WPES’25.},
location = {Taipei, Taiwan}
}

@inproceedings{10.1145/3801487.3802805,
author = {Kurshan, Eren},
title = {Architecturally Aligned Trustworthy AI: Substrate and System Design Strategies for Next Generation AI: Keynote},
year = {2026},
isbn = {9798400725685},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3801487.3802805},
doi = {10.1145/3801487.3802805},
abstract = {Recent advances in AI have led to strong benchmark performance on increasingly complex tasks. However, progress in building trustworthy AI systems has lagged behind, creating significant safety challenges and potentially slowing the path toward AGI. As AI systems are deployed in high-stakes real-world settings, deficiencies in their reliability, safety and alignment pose substantial risks. State-of-the-art approaches, often based on reinforcement learning variants, have been shown to produce superficial alignment, primarily shaping output style and surface-level behavior. In this paper, we argue that safety, reliability, security and alignment challenges are caused by the same missing piece: the absence of full-stack architectural design incorporating key functionalities for trustworthiness. This gap creates a simulated and superficial alignment instead of an intrinsic alignment. We propose evolutionary meta-architecture learning (EMAL), substrate and system design strategies for structurally trustworthy AGI.},
booktitle = {Proceedings of the 23rd ACM International Conference on Computing Frontiers},
pages = {1–8},
numpages = {8},
keywords = {Artificial Intelligence, AI Systems, Artificial General Intelligence, AI Safety},
location = {Catania, Italy},
series = {CF '26}
}

@inproceedings{10.1145/3637528.3671467,
author = {Kenthapadi, Krishnaram and Sameki, Mehrnoosh and Taly, Ankur},
title = {Grounding and Evaluation for Large Language Models: Practical Challenges and Lessons Learned (Survey)},
year = {2024},
isbn = {9798400704901},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3637528.3671467},
doi = {10.1145/3637528.3671467},
abstract = {With the ongoing rapid adoption of Artificial Intelligence (AI)-based systems in high-stakes domains, ensuring the trustworthiness, safety, and observability of these systems has become crucial. It is essential to evaluate and monitor AI systems not only for accuracy and quality-related metrics but also for robustness, bias, security, interpretability, and other responsible AI dimensions. We focus on large language models (LLMs) and other generative AI models, which present additional challenges such as hallucinations, harmful and manipulative content, and copyright infringement. In this survey article accompanying our &lt;u&gt;tutorial&lt;/u&gt;, we highlight a wide range of harms associated with generative AI systems, and survey state of the art approaches (along with open challenges) to address these harms.},
booktitle = {Proceedings of the 30th ACM SIGKDD Conference on Knowledge Discovery and Data Mining},
pages = {6523–6533},
numpages = {11},
keywords = {bias and fairness, model robustness and security, calibration and confidence, copyright infringement, evaluations, generative ai, grounding, large language models, model disgorgement and unlearning, privacy, responsible ai, safety and alignment, transparency and causal interventions, truthfulness},
location = {Barcelona, Spain},
series = {KDD '24}
}

