@inproceedings{10.1145/3837730.3837744,
author = {Farrell, Steven and Lei, Zijie and Konate, Kadidia and Timalsina, Madan and Ding, Pengfei and Naylor, Andrew and Demeure, Nestor and Deng, Siqi},
title = {An Agentic Toolkit and Comparative Study for HPC Operations and User Support},
year = {2026},
isbn = {9798400722639},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3837730.3837744},
doi = {10.1145/3837730.3837744},
abstract = {High-performance computing (HPC) centers are experiencing increasing operational complexity driven by heterogeneous architectures, rapidly evolving software stacks, and the growing integration of AI-driven workflows. These trends place sustained pressure on operations and user support teams, who must diagnose failures, manage incidents, and assist users across fragmented systems and data sources. Agentic AI systems—large language models augmented with tools and orchestration logic—offer a promising approach to augmenting these activities, but their effective design and evaluation in HPC environments remain open challenges. This paper presents ATHOS, a model-agnostic agentic toolkit for HPC operations and user support, and uses it as a platform for a comparative study of agent designs, models, and frameworks on realistic HPC tasks. The evaluation reported in this paper focuses on curated datasets for HPC knowledge question answering and user support troubleshooting scenarios. The study compares open-weight models, including GPT-OSS–class models, with proprietary frontier models from the Claude family, and includes a focused external coding-agent comparison. We report results using metrics relevant to HPC operations, including task success, response quality, latency, and token cost, highlighting tradeoffs between agent autonomy, tool grounding, model capability, and operational efficiency. Experiments conducted using NERSC-derived datasets and integrations inspired by production environments indicate that carefully constrained, tool-grounded agents can deliver meaningful operational value, and that evaluation infrastructure is essential for guiding reliable deployment. This work provides both a reusable toolkit and empirical guidance for adopting agentic AI in HPC operations.},
booktitle = {Proceedings of the Cray User Group},
pages = {155–167},
numpages = {13},
keywords = {HPC, operations, agentic AI, user support},
location = {Nice, France},
series = {CUG '26}
}

