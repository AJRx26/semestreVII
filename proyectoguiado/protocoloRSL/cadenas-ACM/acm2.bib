editor = {M.A.P. Chamikara, Thilina Ranbaduge, Mohan Baruwal Chhetri and Ming Ding},
title = {LM-SHIELD '26: Proceedings of the Workshop on Privacy in Large Language Models (LLM) and Natural Language Processing (NLP) 2026},
