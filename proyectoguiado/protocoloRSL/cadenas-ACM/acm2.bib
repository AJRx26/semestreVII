@inproceedings{10.1145/3775073.3775188,
author = {Li, Zhengxian and Chen, Bao and Ling, Ziying and Wu, Rixi and Ling, Da},
title = {Continuation Wing 1.0 - A Deepseek-Assisted Feedback Platform for Continuation Writing Assessment},
year = {2025},
isbn = {9798400715792},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3775073.3775188},
doi = {10.1145/3775073.3775188},
abstract = {Continuation writing assessment is often slow, inconsistent, and hard to scale in real classrooms. We present Continuation Wing 1.0, a DeepSeek-assisted platform that couples an interpretable scoring framework with targeted feedback generation for secondary-school continuation tasks. The scorer integrates semantic matching, grammatical error density, and discourse coherence to produce aligned sub-scores for Content, Language, and Coherence, along with an overall score; the feedback module triages issues with a random-forest classifier and delivers template-guided, actionable suggestions prioritized by impact. A lightweight prompt-tuning setup ensures classroom-level latency. On a balanced evaluation set, the system reaches QWK 0.81 (Content) and 0.79 (Language), approaching a stronger LLM baseline while running substantially faster (128 tok/s vs. 22 tok/s) and reducing feedback false positives to 12%. In an eight-week teaching intervention, students who used the platform showed clear gains in content development, language accuracy, and discourse coherence, accompanied by a steady decline in error density and improved perceived usefulness and time efficiency for teachers. These results indicate that Continuation Wing 1.0 delivers reliable, human-aligned scoring and concrete feedback at classroom speed, providing a practical path to close the loop between assessment and instruction without altering existing teaching routines.},
booktitle = {Proceedings of the 2025 2nd International Symposium on Artificial Intelligence for Education},
pages = {737–742},
numpages = {6},
keywords = {Automated feedback, Continuation writing, Deepseek},
location = {Changsha, China},
series = {ISAIE '25}
}

