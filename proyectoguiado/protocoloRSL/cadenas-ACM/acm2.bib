@inproceedings{10.1145/3803784.3816849,
author = {Chiappucci, Nicolas and Lechelt, Susan},
title = {A Neurosymbolic Architecture for Semiotic Screenplay Interpretation},
year = {2026},
isbn = {9798400725838},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3803784.3816849},
doi = {10.1145/3803784.3816849},
abstract = {Recent computational approaches have opened up new possibilities in filmmaking, particularly in the narrative analysis of screenplays and early-stage development materials. Neurosymbolic methods offer the potential to leverage Large Language Models while anchoring them within a well-defined theoretical framework. In this paper, we explore the construction of ontologies grounded in semiotic narrative theory, and then present cases of screenplay textual analysis that employ this approach. Subsequently, we hypothesize how such approach could benefit the development of creativity support tools for textual analysis through the generation of specialized annotations based on a narrative theory. The experiment represents an intermediate stage of this research: its results will inform a subsequent phase in which the proposed approach will be tested under controlled experimental conditions involving a panel of experts in screenplay analysis.},
booktitle = {Proceedings of the 2026 Conference on Creativity and Cognition},
pages = {1593–1597},
numpages = {5},
keywords = {Screenplay, Creativity Support Tools, HCI, ontologies},
location = {London, United Kingdom},
series = {C&amp;C '26}
}

@inproceedings{10.1145/3772363.3790074,
author = {Duchowski, Andrew and Stefik, Andreas and Ralph, Paul and Dix, Alan and Krejtz, Krzysztof and Myers, Brad A and Jorge, Joaquim and Wehbe, Rina R.},
title = {Does Peer Review Need to Change? A Panel on Reporting Standards and Checklists in the Age of AI},
year = {2026},
isbn = {9798400722813},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3772363.3790074},
doi = {10.1145/3772363.3790074},
abstract = {Many scientific fields of study use formally established reporting standards to foster research and experimental design, transparency, replicability, peer review, and student training. Examples include CONSORT in medicine, the What Works Clearinghouse in education, JARS in psychology. Such standards yield agreement on study reporting and evaluation, even if using different methodologies. CHI has not adopted reporting standards. Like other fields, CHI has seen an increased number of low-quality submissions and reviews fueled by AI. This panel’s objective is to discuss advantages and barriers of adopting reporting standards for SIGCHI. Panelists include representatives with significant experience creating, adopting and operationalizing reporting standards in adjacent fields: software engineering, CS education, and Programming Languages. The panel will include an overview of the history of reporting standards, a live demo of a standards-based peer review system, discussions of opportunities, challenges, limitations for SIGCHI reporting standards, and an interactive discussion between attendees and panelists.},
booktitle = {Proceedings of the Extended Abstracts of the 2026 CHI Conference on Human Factors in Computing Systems},
articleno = {988},
numpages = {5},
keywords = {evidence standards, reporting templates, review checklists},
location = {Barcelona, Spain},
series = {CHI EA '26}
}

