@inproceedings{10.1145/3803784.3807556,
author = {Chen, Yang and Xu, Zhuonan and Yang, Hao and Liu, Kairan},
title = {Playable Archives: Balancing Historical Accuracy and Player Freedom via RAG-Enhanced AI Game Mechanics},
year = {2026},
isbn = {9798400725838},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3803784.3807556},
doi = {10.1145/3803784.3807556},
abstract = {A fundamental tension exists in digital heritage: strict adherence to historical authenticity often results in passive experiences, while unconstrained interactivity risks distortion and hallucination. We present Playable Archives, a system where players experience Grounded Imagination, exploring counterfactual history while staying anchored to authentic constraints. Our RAG-enhanced architecture employs a knowledge graph derived from classical texts to constrain AI generation within historical boundaries. Central to our approach is AI Game Mechanics, where AI drives core game mechanisms, including generating skill cards, synthesizing narratives, and adjudicating outcomes, so that storytelling directly determines gameplay results. Evaluation of an AI-powered Three Kingdoms card game suggests this approach can encourage critical historical speculation; participants reported that constraints “actually stimulated imagination.” We contribute Playable Archives as an approach for cultural heritage games that shifts engagement from passive memorization to active, speculative inquiry, demonstrated through the Three Kingdoms card game.},
booktitle = {Proceedings of the 2026 Conference on Creativity and Cognition},
pages = {239–256},
numpages = {18},
keywords = {Games/Play; Cultural Heritage/History; Human-AI Creativity/Co-creativity; Storytelling},
location = {London, United Kingdom},
series = {C&amp;C '26}
}

@inproceedings{10.1145/3784013.3784082,
author = {Qiu, Chen},
title = {Discrete Temporal Prompting and Cross-Modal Alignment for Cloud Resource Forecasting},
year = {2026},
isbn = {9798400720185},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3784013.3784082},
doi = {10.1145/3784013.3784082},
abstract = {Cloud resource prediction is important for keeping flexibility and performance in large cloud systems. However, common time series models have problems with multimodal data, long-term patterns, and fast inference. This paper presents CloudLLaMA-TS, a Llama 3 text-backbone framework for multivariate time series forecasting. It connects continuous signals and discrete token spaces and supports two temporal modalities (metrics &amp; logs), not visual/audio alignment, and expert decoding. It builds a discrete temporal codebook through learnable quantization and time prompts that include frequency features and position encodings. A sliding-window attention with adaptive stride lowers computation cost to (mathcal {O}(T!cdot !w)) with window size w, and a cross-modal time attention network aligns asynchronous logs and metrics. A hierarchical mixture-of-experts with knowledge-guided routing chooses experts for different workload types. The model also uses parameter-efficient tuning and inference improvements like caching, quantization, and Bloom filtering. CloudLLaMA-TS gives a practical and accurate solution for fast and reliable cloud resource forecasting.},
booktitle = {Proceedings of the 2025 2nd Symposium on Big Data, Neural Networks, and Deep Learning},
pages = {429–434},
numpages = {6},
keywords = {Cloud resource forecasting; large language models; multivariate time series; cross-modal alignment; expert routing},
location = {Jinan, China},
series = {BDNNDL '25}
}

